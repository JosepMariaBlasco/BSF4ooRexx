import org.apache.bsf.

mgr       =BSFManager()
rexxEngine=mgr.loadScriptingEngine("rexx")
rexxCode  ="SAY 'Rexx was here!'"
do
   rexxEngine.exec("rexx",0,0,rexxCode)
catch e=BSFException
   e.printStackTrace
finally
   mgr.terminate() -- let BSFManager terminate the Rexx intepreter instance
end

