#!/usr/bin/rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-12 */
/* Pre-requisite: p.84 of the Bachelor Thesis:
   "First one has to import the Thunderbird address book into OpenOffice.org. For this open
    the Address Data Source assistent (which can be found in File/Wizards/Address Data
    Source...). There one has to choose Thunderbird, as shown in Figure.38."

    necessary pre-requisites therefore:
       database (datasource) name: addresses
       table name                : addressmozilla
       column name               : E-mail
*/

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)     /* get the xScriptContext object, if any        */
if scriptContext<>.nil then                     /* o.k., we are invoked as a macro from OOo     */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
else              /* this program was called from outside of OOo, e.g. from the commandline     */
   xContext = UNO.connect()                     /* get a connection to OOo server               */

   /* ------------------------------------------------------------ */
XMcf = xContext~getServiceManager               /* retrieve the XMultiComponentFactory */

   /* create a RowSet service, get its XRowSet interface */
xRowSet = xMcf~createInstanceWithContext("com.sun.star.sdbc.RowSet", xContext)~XRowSet

xRowSetProps = xRowSet~XPropertySet    /* get access to the service's properties */
xRowSetProps~setPropertyValue("DataSourceName", "addresses")   /* define database */

   /* set SQL command type (can be: TABLE, QUERY or COMMAND) */
command=box("int", bsf.getStaticValue("com.sun.star.sdb.CommandType", "COMMAND"))
xRowSetProps~setPropertyValue("CommandType", command)

   /* define the SQL query */
xRowSetProps~setPropertyValue("Command", 'SELECT' ' "E-mail" ' 'FROM addressmozilla' )
xRowSet~execute      /* execute the SQL command */
xRow = xRowSet~XRow  /* get the XRow interface  */

/* [hint] to fetch row count: xRowSetProps~getPropertyValue("RowCount") */

   /* sending e-mail to every address listed in the table addressmozilla */
SimpleMailSystem=XMcf~createInstancewithContext("com.sun.star.system.SimpleSystemMail", xContext)
xSimpleMailClient = SimpleMailSystem~XSimpleMailClientSupplier~querySimpleMailClient

-- flag = bsf.getConstant("com.sun.star.system.SimpleMailClientFlags", "NO_USER_INTERFACE")
flag = bsf.getConstant("com.sun.star.system.SimpleMailClientFlags", "DEFAULTS")

do while xRowSet~next > 0     /* process all found e-mail addresses */
   emailAddress = xRow~getString(1)    /* get recipient's e-mail address */
   mail = XSimpleMailClient~createSimpleMailMessage
      /* set Recipient and Subject */
   mail~setRecipient(emailAddress)
   mail~setSubject("Mail from OpenOffice.org on" pp(.DateTime~new))
   XsimpleMailClient~sendSimpleMailMessage(mail, flag)
end

::requires UNO.CLS   -- load UNO support for OpenOffice.org
