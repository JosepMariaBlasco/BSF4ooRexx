#!/usr/bin/rexx
/*
   name:             getStaticValue testGroup
   author:           Michael Lex
   version:          1.0.0
*/
/*

  Due to the circumstance that the error codes were change from
  BSF4Rexx version 2.8 to version 4.0 the following local variable
  indicates the current used version.

  For version 4.0:
	.local~ver = 4

  For version 2.8:
	.local~ver = 2 -- or any other value since the check is only if 4 is present
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.getStaticValue.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::class "getStaticValue.testGroup" subclass ooTestCase public

::method "test_1"
	.local~ver = 4

	m=bsf("getStaticValue","java.lang.Integer", "MAX_VALUE")
	self~assertEquals(m, 2147483647)

::method "test_2"
	m=bsf("getStaticValueStrict","java.lang.Integer", "MAX_VALUE")
	self~assertEquals(m, 2147483647)

::method "test_3"
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	m=bsf("getStaticValue","java.lang.Integer", "foo")

::method "test_4"
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	m=bsf("getStaticValue","java.lang.Integer", )

::method "test_5"
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	m=bsf("getStaticValue","java.lang.Integer", "")

::method "test_6"
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	m=bsf("getStaticValueStrict","java.lang.Integer", "foo")

::method "test_7"
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	m=bsf("getStaticValueStrict","java.lang.Integer", )

::method "test_8"
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	m=bsf("getStaticValueStrict","java.lang.Integer", "")

return

