	g++ -dynamiclib $(LFLAGS) -o $(BSF_ORX_TARGET_32) $(BSF_OBJ_ORX_32) $(ORX_LIBS_32) -framework JavaVM -arch i386

	cp -p $(BSF_ORX_TARGET_32) $(BSF4REXX)
	cp -p $(BSF_ORX_TARGET_32) $(TGT_LIB_DIR)
