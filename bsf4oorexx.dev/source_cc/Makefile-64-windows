	$(del_cmd)  $(BLD_PATH)\*.obj $(BLD_PATH)\*.ilk $(BLD_PATH)\*.lib $(BLD_PATH)\*.exp  $(BLD_PATH)\*.cod $(BLD_PATH)\*.res $(BLD_PATH)\*.map 1>nul 2>&1

