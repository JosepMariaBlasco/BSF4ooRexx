; 2001-06-01, ---rgf, definition file for creating the "BSF4Rexx.dll" with
; 2003-04-16, ---rgf, definition file for creating the "BSF4Rexx.dll" for Apache's BSF (2.3) with
;             the linker under OS/2 (IBM's VACPP) and Windows (MS's VS-CPP)
; 2004-04-04, ---rgf, created BSF-neutral Rexx engine
; 2008-10-21, ---rgf, new MSVC (2008), version: 15.00.21022.08 for 80x86
; 2009-09-11, ---rgf, increased stack and heap size from 40KB (40960B) to 128KB (131072B)
; 2017-01-08, ---rgf, adjusted LIBRARY name the one the Makefile-32-windows uses for the link step

LIBRARY   BSF4ooRexx.dll-32-x86
; LIBRARY   BSF4ooRexx-32

HEAPSIZE  131072
STACKSIZE  131072

; ooRexx 4.0.0 (and later) related function, which allows the interpreter to load all external functions
EXPORTS
        RexxGetPackage
