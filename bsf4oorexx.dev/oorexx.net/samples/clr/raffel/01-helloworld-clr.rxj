console = clr.import("System.Console")  -- import .Net/CLR class/type "System.Console" to access its static members
console~WriteLine("Hello World from ooRexx.NET (via BSF4ooRexx and jni4net)") -- invoke static method "WriteLine"

::REQUIRES CLR.CLS  -- get ooRexx.NET support