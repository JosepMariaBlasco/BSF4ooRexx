   fn="A1.test"; type="jpg";
   say "creating a full screen shot, result in file:" fn "save as graphic type:" type
   image=fullScreenShot(); call saveScreenShot image, fn, type

   fn="A2.test"; type="png";
   say "creating a full screen shot, result in file:" fn "save as graphic type:" type
   image=fullScreenShot(); call saveScreenShot image, fn, type

   fn="A3.test.gif"
   say "creating a full screen shot, result in file:" fn "(no graphic type given, default: 'gif')"
   image=fullScreenShot(); call saveScreenShot image, fn

   fn="A4.test"; type="gif";
   say "creating a full screen shot, result in file:" fn "save as graphic type:" type
   image=fullScreenShot(); call saveScreenShot image, fn, type

   fn="A5.test"; type="bmp";
   say "creating a full screen shot, result in file:" fn "save as graphic type:" type
   image=fullScreenShot(); call saveScreenShot image, fn, type

   say "... done. Look at the just produced files in this directory."

::requires "bsfScreenShot.cls"      -- get public routines for taking screen shots