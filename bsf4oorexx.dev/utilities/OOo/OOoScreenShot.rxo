#!/usr/bin/env rexx
/*
   name:    OOoScreenShot.rxo
   purpose: allow taking screenshots, even of OOo components or document windows
   author:  Rony G. Flatscher
   date:    2010-03-15
   changes: 2010-03-18, ---rgf, added optional condition propagating

   License: Apache Software Foundation (ASF) License 2.0 [cf. at the end of this program]
            LGPL 3.0 [cf. at the end of this program]

   usage:   - save as an OOo macro:

              Tools -> Macro -> Organize Macros... -> ooRexx -> Create...
              give any name, copy this entire program into the macro editor, save

              - Now everytime you run this macro (Tools -> Macro -> Run Macro ...) a screen
                shot of the current document window is taken and saved in the user's home directory
                under the name "ScreenShot_*.png", where "*" is replaced by the GMT date and time.

                One could also use "Tools -> Customize" to assign this macro a key shortcut,
                a menu entry or an entry in one of the toolbars.

              - Using OOo dispatch interface one can use this macro from any programming
                language, here the arguments to supply:

                     OOoComponent[,fileName=.nil[,bContainerWindow=.true[,bWindowDecoration=.true]]]

                Will return the filename where the screenshot got saved to or the empty string, if
                something went wrong.

            - invoking this script directly or after calling or requiring this file, invoking the
              public routines

                 fileName=OOoScreenShot(OOoComponent[,fileName=.nil[,bContainerWindow=.true[,bWindowDecoration=.true]]])

                 img=screenShotByPosSize( posSize | x, y, width, height)
                 img=takeScreenShot(x, y, width, height)
                 fileName=saveScreenShot(img[,filename=.nil[,imageType="png"]])

            - by default the screenshot is saved in the user's home directory

*/

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org; will always be the very last argument, if
                     invoked by OOo's dispatch mechanism                                        */

call setup        /* setup .bsf.util, if necessary */

if .bsf.util~hasEntry("screenShot.bPropagateConditions")=.true then
   signal on any  /* activate condition handling   */

/* <debug>
bDebug=.true      -- if invoked from commandline, create document to work on
.bsf.util~screenShot.targetDirectory=.java.lang.System~getProperty("user.dir")   -- save in current dir
-- </debug> */


scriptContext=.nil   /* default: no script context (not invoked via Dispatch interface          */

argNr=arg()          /* get number of args            */
if argNr>0 then      /* invoked as a macro from OOo?  */
do
   slotArg=arg(argNr)   /* get last argument; if invoked as macro, then it is a java.util.Hashtable   */
   scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object                */
end

if scriptContext<>.nil then                     /* o.k., we are invoked as a macro from OOo     */
do
   if argNr=1 then                              /* invoked as a macro without further arguments */
   do
      oDoc=getDocument(scriptContext~getDocument)  /* get the document service (a XModel) object*/
      fileName=OOoScreenShot(oDoc)              /* take and save screenshot                     */
   end
   else              /* invoked as a macro, but arguments got supplied  */
   do
      fileName   =.nil,
      bContainerWindow =.bsf.util~screenShot.bContainerWindow
      bWindowDecoration=.bsf.util~screenShot.bWindowDecoration
         /* fetch supplied arguments, argNr includes appended Hashtable argument from OOo       */
      select
         when argNr=2 then use arg OOoComp
         when argNr=3 then use arg OOoComp, fileName
         when argNr=4 then use arg OOoComp, fileName, bContainerWindow=(.bsf.util~screenShot.bContainerWindow)
         when argNr=5 then use arg OOoComp, fileName, bContainerWindow=(.bsf.util~screenShot.bContainerWindow), -
                                                      bWindowDecoration=(.bsf.util~screenShot.bWindowDecoration)
         otherwise
            parse source . . s
            raise syntax 40.4 array (filespec("name",s), 4) /* maximum number of arguments   */
      end

      fileName=OOoScreenShot(OOoComp, fileName, bContainerWindow, bWindowDecoration)   /* take and save screenshot   */
   end

   if fileName="" then
      .bsf.dialog~messageBox("Screenshot could not be taken!", "Warning", "warn")
   else if .bsf.util~screenShot.bOOoShowMacroPopup=.true then
   do                   /* show location and name of screenshot file    */
      info="Location:" pp(filespec("Location", filename)) || "0a"x || "Filename:" pp(filespec("Name",     filename))
      .bsf.dialog~messageBox(info, "Screenshot Taken & Saved", "info")
   end

   return fileName
end
else  /* this program was called from outside of OOo, e.g. from the commandline  */
do
   if arg()>0 then   /* maybe called directly from another rxo-program, if so fetch arguments   */
   do
      /* targetFileName: fully qualified filename to which this programs adds date/time plus extension "png"   */
      use strict arg oDoc, targetFileName=.nil, bContainerWindow=(.bsf.util~screenShot.bContainerWindow), -
                                                bWindowDecoration=(.bsf.util~screenShot.bWindowDecoration)

      return OOoScreenShot(oDoc, targetFileName, bContainerWindow, bWindowDecoration)
   end
   else     -- branch for debugging purposes (otherwise return "" to indicate no screenshot was taken)
   do
      if bDebug<>.true then
         return ""

      xComponentContext = UNO.connect()         /* get a connection to OOo server                  */
      service = "com.sun.star.frame.Desktop"    /* create the Desktop service:                     */
      oDesktop = xComponentContext~getServiceManager~XMultiServiceFactory~createInstance(service)
      xDesktop = oDesktop~XDesktop
         /* create a word processor document    */
      oDoc=xDesktop~XComponentLoader~loadComponentFromURL("private:factory/swriter", "_blank", 0, .UNO~noProps)
      fileName=OOoScreenShot(oDoc)    /* take and save screenshot   */
      say "screenshot saved to:" pp(fileName)
      return fileName
   end
end
return .nil



/* this is a sample of how one could exploit ooRexx and BSF4Rexx error information */
any:
   if scriptContext=.nil then /* not started as a macro from OOo, just propagate    */
      raise propagate

            /* create and display condition/exception information in a popup dialog */
   co=condition("O")    -- get condition object, describing the condition/exception
   LF="0a"x             -- the line-feed character
   TAB="        "       -- blanks simulating a tab character

   tmpStr=""            -- set to empty string
   do idx over co~makeArray~sort /* sort the directory indexes and iterate over them */
      val=co[idx]       -- get the associated value from the condition object (a directory)
      tmpStr=tmpStr || (idx || ":")~left(25) pp(val) LF

      if val~hasmethod("items") then   -- a collection? show its content
      do item over val
         tmpStr=tmpStr || tab || tab || pp(item) || LF
      end
   end

   if length(tmpStr)>750 then tmpStr=left(tmpStr,750)"..." -- show only the first 750 chars

   /* Are there any Java error messages/stack traces available, if so, show them */
   if var("BSF_ERROR_MESSAGE") | .local~hasEntry("BSF_ERROR_MESSAGE") then -- a BSF error message ?
   do
      if var("BSF_ERROR_MESSAGE") then errStr=BSF_ERROR_MESSAGE   -- variable from this scope
                                  else errStr=.bsf_error_message  -- value from .local environment

      tmpStr=tmpStr LF LF || "-"~copies(80) LF   -- extend the string
      tmpStr=tmpStr          "*** BSF4Rexx Error Information: ***" LF LF
      if length(errStr)>1000 then
         tmpStr=tmpStr || left(errStr,1000)"..."
      else
         tmpStr=tmpStr || errStr
   end

   -- if invoked from the macro editor, then show/point to error line
   scriptModel=uno.getScriptSourceModel(slotArg)
   if scriptModel<>.nil then scriptModel~indicateErrorLine(co~position)
   call SysSleep 0.001  -- let Java awt/swing get its time to update

   .bsf.dialog~messageBox(tmpStr, "Runtime error #" co~code, "error") -- display the string



/* take OOo screenshot, return filename of saved screenshot;

   arguments:
      OOoCOmponent      ... any OOo awt component or OOo document
      fileName          ... optional fileName to store screenshot to (should be fully qualified)
      bContainerWindow  ... .true (default): take screen shot of encompassing containerWindow, componentWindow otherwise
      bWindowDecoration ... .true (default): if a document component, add surrounding insets to get the full Window decoration

   returns filename where screenshot got stored to or empty string
*/
::routine OOoScreenShot public
   use strict arg OOoComponent,                                              -
                  fileName=.nil,                                             -
                  bContainerWindow =(.bsf.util~screenShot.bContainerWindow), -
                  bWindowDecoration=(.bsf.util~screenShot.bWindowDecoration)

      /* an OfficeDocument or some OOo-component   */
   bOfficeDocument=OOoComponent~uno.supportsService("com.sun.star.document.OfficeDocument")

   xModel=OOoComponent~XModel    /* get XModel interface */
   if xModel=.nil then
      return ""

   xFrame=xModel~getCurrentController~getFrame  /* get XFrame interface */
   if xFrame=.nil then
      return ""

   win=xFrame~getContainerWindow /* get containerWindow, save its position & size   */
   containerWin=win              /* save this container window                      */
   pos1=win~getPosSize           /* get position and size                           */

      /* get appropriate window  */
   if bContainerWindow=.true then
   do
       pos2=win~getPosSize       /* get position and size                           */

         /* include Window decoration? if so, then only if we have an OfficeDocument component in hand   */
       if bWindowDecoration=.true, OOoComponent~uno.supportsService("com.sun.star.document.OfficeDocument") then
       do
          insets=.bsf.util~insets   /* get operating system's Window decoration border widths in pixels  */

               /* adjust position and size to take screenshot of  */
          pos2~x      -= insets~left
          pos2~Y      -= insets~top
          pos2~width  += insets~left + insets~right
          pos2~height += insets~top  + insets~bottom
       end
   end
   else
   do
       win=xFrame~getComponentWindow   /* get componentWindow, save its size  */
       pos2=win~getPosSize

         /* get x,y coordinates of screen */
       pos2~x += pos1~x
       pos2~y += pos1~y
   end

   -- say "/ pos1:" (pos1~x"@"pos1~y)~right(10) pos1~width"x"pos1~height
   -- say "/ pos2:" (pos2~x"@"pos2~y)~right(10) pos2~width"x"pos2~height

   xCurrFrame=xFrame
   xTopFrame =xCurrFrame~findFrame("_top", 1)   /* find top frame if this subtree   */

      /* add x, y values of the component and its container window until we arrive at
         the root's ("_top") XFrame                                                 */
   do while xCurrFrame<>.nil, uno.areSame(xCurrFrame, xTopFrame)<>.true
      xCurrFrame= xCurrFrame~findFrame("_parent", 1)  /* get parent frame           */
      if xCurrFrame=.nil then leave    /* no parent               */

      do tmpWin over .array~of(xCurrFrame~getComponentWindow, xCurrFrame~getContainerWindow)
         if tmpWin=.nil then iterate   /* no window received      */
         tmpPos=tmpWin~getPosSize      /* get position & size     */
         pos2~x += tmpPos~x            /* add x                   */
         pos2~y += tmpPos~y            /* add y                   */
      end
   end


   -- say "\ pos1:" (pos1~x"@"pos1~y)~right(10) pos1~width"x"pos1~height
   -- say "\ pos2:" (pos2~x"@"pos2~y)~right(10) pos2~width"x"pos2~height

   img=screenShotByPosSize(pos2)
   if img=.nil then           /* no image taken    */
      return ""

   filename=saveScreenShot(img, fileName)
   -- say "filename="pp(filename)
   return filename



::requires UNO.CLS         /* load UNO support (OpenOffice/StarOffice) for ooRexx   */
-- ::requires "rgf_util2.rex" /* load the rgf utilities version 2                      */

/* OOo >= 3.0: get the invocation context (a XScriptInvocationContext) object; if not .nil, then
               use this document instead of the result of scriptContext~getDocument!            */
::routine getDocument
   use arg oDoc
   signal on any
   xInvocationContext=scriptContext~getInvocationContext
   if xInvocationContext<>.nil then          /* this script got invoked for a different document*/
      return xInvocationContext              /* use the supplied document instead               */
any:
  return oDoc                                /* either not 3.0 or script context document to use*/




/* Routine that expects an OOo posSize object which determines the area of which a screen
   shot should be done:
   - if the area is not located on-screen, .nil is returned.
   - if the area is not fully on-screen, then the co-ordinates are adjusted accordingly,
     before taking the screenshot
*/
::routine screenShotByPosSize public
  signal on any                     /* intercept exceptions */
  if arg()=1 then
  do
     use strict arg posSize
     /* create local variables with the values of posSize   */
     x     =posSize~x
     y     =posSize~y
     width =posSize~width
     height=posSize~height
  end
  else
     use strict arg x=0, y=0, width=0, height=0



  screenSize=.bsf.util~defaultToolkit~getScreenSize
  screenWidth =screenSize~width     /* extract screen width    */
  screenHeight=screenSize~height    /* extract screen height   */

  /* component fully on screen?  */
  if x>=0, x+width<=screenWidth, y>=0, y+height<=screenHeight then
     return takeScreenShot(x, y, width, height)

  /* calculatate visibleComponent component's screen co-ordinates and dimensions: x, y, width, height to use   */
  sX=x
  sY=y
  visibleComponentWidth =width
  visibleComponentHeight=height

  if x<0 then                       /* beyond left border?        */
  do
     visibleComponentWidth=width+x  /* subtract off-screen pixels */
     sX=0
  end

  if y<0 then                       /* beyond upper border?       */
  do
     visibleComponentHeight=height+y/* subtract off-screen pixels */
     sY=0
  end

  nrPixels=sX+visibleComponentWidth
  if screenWidth <= nrPixels then   /* is component's width not fully on-screen? */
     visibleComponentWidth=screenWidth-sX    /* adjust nr. of pixels    */

  nrPixels=sY+visibleComponentHeight
-- say "--> screenHeight="screenHeight "nrPixels="nrPixels "sY="sY
  if screenHeight <= nrPixels then  /* is component's height not fully on-screen? */
     visibleComponentHeight=screenHeight-sY  /* adjust nr. of pixels    */

-- debug:
  posSize~x     =sX
  posSize~y     =sY
  posSize~width =visibleComponentWidth
  posSize~height=visibleComponentHeight

  return takeScreenShot(sX, sY, visibleComponentWidth, visibleComponentHeight)

any:     /* an exception occurred, return .nil     */
  return .nil




/* Routine to take any screen shot, returning an image object. */
::routine takeScreenShot public
  use strict arg x, y, width, height
      /* take the screenshot     */
  robot    =.bsf~new('java.awt.Robot')
  rectangle=.bsf~new("java.awt.Rectangle", x, y, width, height)
  image    =robot~createScreenCapture(rectangle)
  return image




/* Convenience routine to save image in a file in a certain image type.  */
::routine saveScreenShot public
  use strict arg image, filename=.nil, imageType="png"

  if fileName=.nil | fileName="" then
  do
     fileName=.bsf.util~screenShot.targetDirectory || .bsf4rexx~file.separator || .bsf.util~screenShot.baseFileName
         /* append current date/time and image typename  */
     fileName=fileName || translate(.dateTime~new~string, '-', ':') ~changeStr('-','') || -
                   "." || .bsf.util~screenShot.imageTypeName
  end
  else
  do
         /* save the screenshot (image) in file */
     lpos=fileName~lastPos(".")        /* maybe a file extension already given?  */
     if lpos>0, filename~subStr(lpos+1)=imageType then/* correct imageType already in file extension? */
        NOP                            /* do nothing  */
     else
        fileName=fileName"."imageType  /* define image type by file extension    */
  end

  signal on any
  jFile=.bsf~new("java.io.File", fileName)            /* create file object      */
  .bsf.util~ImageIO~write(image, imageType, jFile)    /* save image              */
  return fileName

any:     /* if an exception gets raised, indicate failure   */
-- call dump2 condition("o"), "saveScreenShot()-error"

  if .bsf.util~hasEntry("screenShot.bPropagateConditions")=.true then   /* propagate condition  */
     raise propagate

  return ""



/* Setup .bsf.util entries for this Rexx instance  */
::routine setup
   if \.local~hasEntry("BSF.UTIL") then   /* if no .bsf.util, then create directory object   */
      .local~bsf.util=.directory~new

      /* import those Java classes that we might need multiple times  */
   if \.bsf.util~hasEntry("ImageIO") then
      .bsf.util~ImageIO=bsf.import("javax.imageio.ImageIO",   .nil)

   if \.bsf.util~hasEntry("JFrame") then
      .bsf.util~JFrame=bsf.import("javax.swing.JFrame",      .nil)

   if \.bsf.util~hasEntry("Insets") then
   do
      f  = .bsf.util~jframe~new~~pack  /* create a JFrame, pack it      */
      .bsf.util~insets=f~getInsets     /* get and save the insets       */
      f~dispose                        /* dispose JFrame                */
   end


   if \.bsf.util~hasEntry("defaultToolkit") then
      .bsf.util~defaultToolkit=bsf.loadClass("java.awt.Toolkit")~getDefaultToolkit


      /* define defaults   */
      /* set default path to store screenshots to user's home directory             */
   if \.bsf.util~hasEntry("screenShot.targetDirectory") then
      .bsf.util~screenShot.targetDirectory=.java.lang.System~getProperty("user.home")

      /* set default name for screenshot file names   */
   if \.bsf.util~hasEntry("screenShot.baseFileName") then
      .bsf.util~screenShot.baseFileName="ScreenShot_"

      /* image type for screenshot: default to "png" (could be "jp[e]g" and "gif")  */
   if \.bsf.util~hasEntry("screenShot.imageTypeName") then
      .bsf.util~screenShot.imageTypeName="png"

      /* default: make screen shot of the ContainerWindow, not from the therin contained ComponentWindow */
   if \.bsf.util~hasEntry("screenShot.bContainerWindow") then
      .bsf.util~screenShot.bContainerWindow=.true

      /* default: enlarge OfficeDocument containerWindow to include opsys' Window decoration (like title bar)  */
   if \.bsf.util~hasEntry("screenShot.bWindowDecoration") then
      .bsf.util~screenShot.bWindowDecoration=.true

      /* default: if invoked as a macro without arguments, communicate the fully qualified filename
                  of the screenshot                                                 */
   if \.bsf.util~hasEntry("screenShot.bOOoShowMacroPopup") then
      .bsf.util~screenShot.bOOoShowMacroPopup=.true

      /* default: if runtime conditions occur, propagate the raised condition       */
   if \.bsf.util~hasEntry("screenShot.bPropagateConditions") then
      .bsf.util~screenShot.bPropagateConditions=.true

   return


