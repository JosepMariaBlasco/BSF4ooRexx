#!/usr/bin/env rexx
desktop          = UNO.createDesktop()
xDesktop         = desktop~XDesktop
xComponentLoader = xDesktop~XComponentLoader
writerComponent  = xcomponentLoader~loadComponentFromURL("private:factory/swriter", "_blank", 0, .UNO~noProps)
xTextDocument    = writerComponent~xTextDocument
xText            = xTextDocument~getText
xTextCursor      = xText~createTextCursor
xTextRange       = xText~getEnd
xTextRange~setString("Hello, this is ooRexx speaking on:" date("S") time())
writerComponent~XModifiable~setModified(.false)

-- call directly public routine in UNO_API_info.rxo
options=.directory~new
options~NrOfLayers          =1   -- one layer deep only
options~View                =4   -- save odt, create pdf
call analyzeAndCreateReference writerComponent, options

-- now change options for the next run
options~NrOfLayers          =2   -- two layers deep
options~View                =4   -- save as odt and pdf
options~DocumentationSource =1   -- Internet
options~NumberingTypeLevel_1=0   -- uppercase letters
options~NumberingTypeLevel_2=4   -- arabic numbers
options~NumberingTypeLevel_3=1   -- lowercase letters
options~FontName            ="Times New Roman"
call analyzeAndCreateReference writerComponent, options

::requires "UNO_API_info.rxo" -- get the reflective documentation support for OOo


