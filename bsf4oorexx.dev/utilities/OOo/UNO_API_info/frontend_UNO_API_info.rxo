  userData~tf_uno_idl_name~text=userData~cf_uno_idl~getSelectedItem~word(2)



/* ------------------------------------------------------------------------ */
/* Create a TerminateListener to prevent exiting OpenOffice as long as this frontend runs.
   This will cause at least one OOo document (or the OOo desktop) to remain active, such that
   all cached OOo-UNO-objects remain intact.
*/
::class TerminateListener
::method unknown
  use arg methName, args
  say self": unknown - method="pp(methName) "eventObject="pp(args[1]~toString)

::method queryTermination  /* throw a TerminationVetoException */
  parse source . . s
  say s": vetoing termination of last OOo instance as long as this program runs!" pp(.dateTime~new)
  t=.BSF~new("com.sun.star.frame.TerminationVetoException")
  call BsfJavaException "throw", t  -- throw this exception on the Java side
  return

/* from: <http://wiki.services.openoffice.org/wiki/Documentation/DevGuide/OfficeDev/Using_the_Desktop>

  import com.sun.star.frame.TerminationVetoException;
  import com.sun.star.frame.XTerminateListener;

  public class TerminateListener implements XTerminateListener {

      public void notifyTermination (com.sun.star.lang.EventObject eventObject) {
          System.out.println("about to terminate...");
      }

      public void queryTermination (com.sun.star.lang.EventObject eventObject)
          throws TerminationVetoException {

          // test if we can terminate now
          if (TerminationTest.isAtWork() == true) {
              System.out.println("Terminate while we are at work? No way!");
              throw new TerminationVetoException() ; // this will veto the termination,
                                                     // a call to terminate() returns false
          }
      }

      public void disposing (com.sun.star.lang.EventObject eventObject) {
      }
  }
*/

