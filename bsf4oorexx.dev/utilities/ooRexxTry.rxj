/**
* name: Csplitcontentp
* attributes: p1... the window area, a scrollable subwindow
*             splitpane the GUI is organized by four splitwindows
* functionality: the type of GUI appearance if YDISP, ZDISP is selected in the menu
*                6 moveable splitwindows with label
*                window areas cannot disappear here
*                there is a maximise button, where a window area can be made to ful screen
* used classes: Cpanelscrolllabel
* special java classes: javax.swing.JSplitPane
* explanation: window area refers to six subwindows in the mainframe (code, input, arguments, returns, output, error)
*/


::class Csplitcontentp public
::attribute p1
::attribute p2
::attribute p3
::attribute p4
::attribute p5
::attribute p6
::attribute splitpane
::attribute splitpane1
::attribute splitpane2
::attribute splitpane3
::attribute splitpane4

::method init
   expose p1 p2 p3 p4 p5 p6 splitpane splitpane1 splitpane2 splitpane3 splitpane4
   use arg dimframe, colors


   if .mm.dir~isdebug == true then say "Csplitcontentp" dimframe~getwidth dimframe~getheight

   p1 = .Cpanelscrolllabel~new(1)
   p2 = .Cpanelscrolllabel~new(2)
   p3 = .Cpanelscrolllabel~new(3)
   p4 = .Cpanelscrolllabel~new(4)
   p5 = .Cpanelscrolllabel~new(5)
   p6 = .Cpanelscrolllabel~new(6)

   p1~label~settext("Code")
   p2~label~settext("Input")
   p3~label~settext("Arguments")
   p4~label~settext("Returns")
   p5~label~settext("Output / Says")
   p6~label~settext("Errors / Informations")
   -- alt-key 1...6
   p1~maxbutton~setMnemonic(.KeyEvent~VK_1)
   p2~maxbutton~setMnemonic(.KeyEvent~VK_2)
   p3~maxbutton~setMnemonic(.KeyEvent~VK_3)
   p4~maxbutton~setMnemonic(.KeyEvent~VK_4)
   p5~maxbutton~setMnemonic(.KeyEvent~VK_5)
   p6~maxbutton~setMnemonic(.KeyEvent~VK_6)

   p1~label~setBackground(colors~b1)
   p2~label~setBackground(colors~b2)
   p3~label~setBackground(colors~b3)
   p4~label~setBackground(colors~b4)
   p5~label~setBackground(colors~b5)
   p6~label~setBackground(colors~b6)
   p1~label~setForeground(colors~t1)
   p2~label~setForeground(colors~t2)
   p3~label~setForeground(colors~t3)
   p4~label~setForeground(colors~t4)
   p5~label~setForeground(colors~t5)
   p6~label~setForeground(colors~t6)

   dimsp = .Dimension~new()
   -- dimsp~setsize(dimframe~getwidth-12,dimframe~getheight-64)
   dimsp~setsize(dimframe~getwidth-12,dimframe~getheight-94)

   splitpane  = .bsf~new("javax.swing.JSplitPane")
   Call BSF 'invoke', splitpane, 'setOrientation',       .JSplitPane~VERTICAL_SPLIT

   Call BSF 'invoke', splitpane, 'setpreferredsize',     dimsp
   w1 = trunc(dimsp~getwidth)
   h1 = trunc(dimsp~getheight)
   Call BSF 'invoke', splitpane, 'setsize', w1, h1

   Call BSF 'invoke', splitpane, 'setdividersize',       "2"
   splitpane~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   splitpane~bsf.invokestrict("setResizeWeight", "double", "0.3")

   splitpane4 = .bsf~new("javax.swing.JSplitPane")
   Call BSF 'invoke', splitpane4, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', splitpane4, 'settopcomponent',     p3~panel
   Call BSF 'invoke', splitpane4, 'setbottomcomponent',  p4~panel

   splitpane3 = .bsf~new("javax.swing.JSplitPane")
   Call BSF 'invoke', splitpane3, 'setOrientation',      .JSplitPane~HORIZONTAL_SPLIT
   Call BSF 'invoke', splitpane3, 'settopcomponent',     p2~panel
   Call BSF 'invoke', splitpane3, 'setbottomcomponent',  splitpane4

   splitpane1 = .bsf~new("javax.swing.JSplitPane")
   Call BSF 'invoke', splitpane1, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', splitpane1, 'settopcomponent',     p1~panel
   Call BSF 'invoke', splitpane1, 'setbottomcomponent',  splitpane3
   -- Call BSF 'invoke', splitpane1, 'setbottomcomponent',  p2~panel

   splitpane2 = .bsf~new("javax.swing.JSplitPane")
   Call BSF 'invoke', splitpane2, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', splitpane2, 'settopcomponent',     p5~panel
   Call BSF 'invoke', splitpane2, 'setbottomcomponent',  p6~panel

   splitpane1~bsf.invokestrict("setResizeWeight", "double", "0.6")
   splitpane2~bsf.invokestrict("setResizeWeight", "double", "0.4")
   splitpane3~bsf.invokestrict("setResizeWeight", "double", "0.5")
   splitpane4~bsf.invokestrict("setResizeWeight", "double", "0.5")

   Call BSF 'invoke', splitpane1, 'setdividersize',       "2"
   Call BSF 'invoke', splitpane2, 'setdividersize',       "2"
   Call BSF 'invoke', splitpane3, 'setdividersize',       "2"
   Call BSF 'invoke', splitpane4, 'setdividersize',       "2"

   Call BSF 'invoke', splitpane, 'settopcomponent',      splitpane1
   Call BSF 'invoke', splitpane, 'setbottomcomponent',   splitpane2

/**
* name: Cinternalframepane
* attributes: f1... the window area, a scrollable subwindow
* functionality: the type of GUI appearance if WDISP is selected in the menu
*                6 moveable internal frames with label
*                desktopp contains the specific window areas
* used classes: desktopp of type javax.swing.JDesktopPane
* special java classes: javax.swing.JInternalFrame
* commentapr2014: this representation has much potential that is not developped in current code
*                 at least the signalling colors for the window areas should be used
*                 then the position of the window areas should be saved in a setting file
*                 a good idea would be to have several standard settings
* explanation: window area refers to six internal frames (code, input, arguments, returns, output, error)
*/

::class Cinternalframepane public
::attribute f1
::attribute f2
::attribute f3
::attribute f4
::attribute f5
::attribute f6
::attribute desktopp

::method init
expose f1 f2 f3 f4 f5 f6 desktopp
use arg bounds
-- here also buttonpanel should be passed
   if .mm.dir~isdebug == true then say "Cinternalframe " bounds~width bounds~height bounds~x bounds~y

   desktopp = .bsf~new("javax.swing.JDesktopPane")

   dimsp = .Dimension~new(bounds~width, bounds~height)
   Call BSF 'invoke', desktopp, 'setpreferredsize',     dimsp

   f1 = .bsf~new("javax.swing.JInternalFrame", "code",              .true,.true,.true,.true)
   f2 = .bsf~new("javax.swing.JInternalFrame", "input",             .true,.true,.true,.true)
   f3 = .bsf~new("javax.swing.JInternalFrame", "arguments",         .true,.true,.true,.true)
   f4 = .bsf~new("javax.swing.JInternalFrame", "returns",           .true,.true,.true,.true)
   f5 = .bsf~new("javax.swing.JInternalFrame", "output/says",       .true,.true,.true,.true)
   f6 = .bsf~new("javax.swing.JInternalFrame", "error/information", .true,.true,.true,.true)
   swidth  = trunc(bounds~width*2 / 3)
   sheight = trunc(bounds~height*2 / 3)
   sheight2 = trunc(sheight/2)

   Call BSF 'invoke', f1, 'setSize', swidth, sheight
   Call BSF 'invoke', f2, 'setSize', swidth, sheight
   Call BSF 'invoke', f3, 'setSize', swidth, sheight2
   Call BSF 'invoke', f4, 'setSize', swidth, sheight2
   Call BSF 'invoke', f5, 'setSize', swidth, sheight2
   Call BSF 'invoke', f6, 'setSize', swidth, sheight2

   lx = 1
   ly = 1
   Call BSF 'invoke', f1, 'setLocation', lx,ly

   divskal = 16
   lx = trunc(lx + swidth / divskal)
   ly = trunc(ly + sheight / divskal)
   Call BSF 'invoke', f2, 'setLocation', lx,ly

   lx = trunc(lx + swidth / divskal)
   ly = trunc(ly + sheight / divskal)
   Call BSF 'invoke', f3, 'setLocation', lx,ly

   lx = trunc(lx + swidth / divskal)
   ly = trunc(ly + sheight / divskal)
   Call BSF 'invoke', f4, 'setLocation', lx,ly

   lx = trunc(lx + swidth / divskal)
   ly = trunc(ly + sheight / divskal)
   Call BSF 'invoke', f5, 'setLocation', lx,ly

   lx = trunc(lx + swidth / divskal)
   ly = trunc(ly + sheight / divskal)
   Call BSF 'invoke', f6, 'setLocation', lx,ly

   Call BSF 'invoke', f1, 'setVisible', .true
   Call BSF 'invoke', f2, 'setVisible', .true
   Call BSF 'invoke', f3, 'setVisible', .true
   Call BSF 'invoke', f4, 'setVisible', .true
   Call BSF 'invoke', f5, 'setVisible', .true
   Call BSF 'invoke', f6, 'setVisible', .true

   Call BSF 'invoke', desktopp, 'add', f1
   Call BSF 'invoke', desktopp, 'add', f2
   Call BSF 'invoke', desktopp, 'add', f3
   Call BSF 'invoke', desktopp, 'add', f4
   Call BSF 'invoke', desktopp, 'add', f5
   Call BSF 'invoke', desktopp, 'add', f6

   Call BSF 'invoke', f1, 'setSelected', .true
   Call BSF 'invoke', f2, 'setSelected', .false
   Call BSF 'invoke', f3, 'setSelected', .false
   Call BSF 'invoke', f4, 'setSelected', .false
   Call BSF 'invoke', f5, 'setSelected', .false
   Call BSF 'invoke', f6, 'setSelected', .false


   Call BSF 'invoke', desktopp, 'setDragMode', .JDesktopPane~OUTLINE_DRAG_MODE

   /*
   Call BSF 'invoke', desktopp, 'add', buttonpanel
   lx = trunc(10)
   ly = trunc((14 * sheight) / divskal)
   Call BSF 'invoke', buttonpanel, 'setLocation', lx,ly
   Call BSF 'invoke', buttonpanel, 'setVisible', .true
   */


/**
* name: Cpanelscrolllabel
* parameter: wnumber 1..6 identifies if this window area is code, input .. errors
* attributes: panel
*             scrollpane scroller around the textarea
*             textarea
*             label the header label of the window area
*             gridbag layout manager
*             maxbutton button for ismax
*             cscroll c... help to position the element correct
*             clabel
*             cbutton
*             ismax is this window area maximized or part of the 6 window area main frame
* functionality: class for one scrollable window area
*                the pane consists of label maxbutton and the scrollable textarea
*                the three elements are put into the pane with the gridbag layoutmanager
* methods: init
*          disppanelscrolllabel
*          getmax
*          setmax
* special features: set rows is an initial setting, so that scroller appears
*                   the text area is as expandable to infinity
* special java classes: javax.swing.JTextArea
* commentapr2014: somehow the core class of the swing version
*                 the wnumber parameter is okay, but the code is ugly
*/


::class Cpanelscrolllabel public

::attribute panel
::attribute scrollpane
::attribute textarea
::attribute label
::attribute gridbag
::attribute maxbutton
::attribute cscroll
::attribute clabel
::attribute cbutton
::attribute ismax

::method init
   expose panel scrollpane textarea label gridbag maxbutton cscroll clabel cbutton ismax
   use arg wnumber

   if .mm.dir~isdebug == true then say "initialize panel: " wnumber
   if wnumber == 1 then do
      codeArea = .bsf~new("javax.swing.JTextArea")
      .mm.dir~codeArea = codeArea
      textarea = codeArea
      textarea~setEditable(.true)
      textarea~setLineWrap(.true)
   end
   if wnumber == 2 then do
      inputArea = .bsf~new("javax.swing.JTextArea")
      .mm.dir~inputArea = inputArea
      textarea = inputArea
      textarea~setEditable(.false)
      textarea~setLineWrap(.true)
   end
   if wnumber == 3 then do
      argsArea = .bsf~new("javax.swing.JTextArea")
      .mm.dir~argsArea = argsArea
      textarea = argsArea
      textarea~setEditable(.true)
      textarea~setLineWrap(.true)
   end
   if wnumber == 4 then do
      returnsArea = .bsf~new("javax.swing.JTextArea")
      .mm.dir~returnsArea = returnsArea
      textarea = returnsArea
      textarea~setEditable(.false)
      textarea~setLineWrap(.true)
   end
   if wnumber == 5 then do
      saysArea = .bsf~new("javax.swing.JTextArea")
      .mm.dir~saysArea = saysArea
      textarea = saysArea
      textarea~setEditable(.false)
      textarea~setLineWrap(.true)
   end
   if wnumber == 6 then do
      errorsArea = .bsf~new("javax.swing.JTextArea")
      .mm.dir~errorsArea = errorsArea
      textarea = errorsArea
      textarea~setEditable(.false)
      textarea~setLineWrap(.true)
   end

   -- textarea = .bsf~new("javax.swing.JTextArea")
   Call BSF 'invoke', textarea, "setColumns", 1
   Call BSF 'invoke', textarea, "setRows", 40

   cscroll = .GridBagConstraints~new
   cscroll~fill = .GridBagConstraints~BOTH
   cscroll~gridwidth = .GridBagConstraints~REMAINDER
   cscroll~insets = .Insets~new(1,1,1,1)
   cscroll~anchor = .GridBagConstraints~LINE_START

   clabel = cscroll~clone
   cbutton= cscroll~clone

   scrollpane = .bsf~new("javax.swing.JScrollPane", textarea)
   -- panel = .bsf~new("javax.swing.JPanel")
   label = .bsf~new("javax.swing.JLabel", 'text', .JLabel~CENTER)
   maxbutton = .bsf~new("javax.swing.JButton")
   -- gridbag = .bsf~new("java.awt.GridBagLayout")

   self~disppanelscrolllabel()

::method disppanelscrolllabel public
   expose panel scrollpane textarea label gridbag maxbutton cscroll clabel cbutton ismax

   panel = .bsf~new("javax.swing.JPanel")
   gridbag = .bsf~new("java.awt.GridBagLayout")

   Call BSF 'invoke', textarea, "setColumns", 1
   Call BSF 'invoke', textarea, "setRows", 40

   cscroll~fill = .GridBagConstraints~BOTH
   cscroll~gridwidth = .GridBagConstraints~REMAINDER
   cscroll~insets = .Insets~new(1,1,1,1)
   cscroll~anchor = .GridBagConstraints~LINE_START

   clabel~fill = .GridBagConstraints~BOTH
   clabel~insets = .Insets~new(1,1,1,1)
   clabel~anchor = .GridBagConstraints~LINE_START

   cbutton~fill = .GridBagConstraints~BOTH
   cbutton~gridwidth = .GridBagConstraints~REMAINDER
   cbutton~insets = .Insets~new(1,1,1,1)
   cbutton~anchor = .GridBagConstraints~LINE_START

   ismax = .false

   clabel~weightx = 2
   clabel~gridwidth = .GridBagConstraints~RELATIVE
   cbutton~gridwidth = .GridBagConstraints~REMAINDER
   cbutton~anchor = .GridBagConstraints~LINE_END
   cbutton~weightx = 0

   cscroll~weightx = 2
   cscroll~weighty = 2

   label~bsf.invokestrict("setOpaque", "boolean", "true")

   dimmax = .Dimension~new()
   dimmax~setsize(60,12)
   Call BSF 'invoke', maxbutton, setmaximumsize, dimmax
   color1 = .Color~cyan
   label~setBackground(color1)
   color2 = .Color~red
   label~setForeground(color2)

   Call BSF 'invoke', gridbag, setConstraints, label, clabel
   Call BSF 'invoke', gridbag, setConstraints, maxbutton, cbutton
   Call BSF 'invoke', gridbag, setConstraints, scrollpane, cscroll

   Call BSF 'invoke', panel, setlayout, gridbag
   Call BSF 'invoke', panel, add, label
   CALL BSF 'invoke', panel, add, maxbutton
   Call BSF 'invoke', panel, add, scrollpane


::method getmax
   return self~ismax
   if .mm.dir~isdebug == true then say self~ismax
::method setmax
   use arg val
   self~ismax = val


/**
* name: CYDispMenu
* functionality: clean the whole frame (contentpanel)
*                get the size of the whole frame
*                generate the 6 scrollable panels
*                organize the 6 panels in 4 splitpanes
*                disable LDISP option (setonetouchexpandable)
*                the assignment of the real text (code...error) to the areas is in Cpanelscrolllabel
* variables: methArgs~userData~dtype = "splitpane"
*            userData is the main structure that contains all window settings
*            methArgs is a pointer to userData and parameter in this class
*            dtype in userData contains the appearance type
*            if YDISP is selected in the menu we are here and the type is splitpane
*            other possible types are tabbedpane or intframes ...
*            the splitpane type has 3 subtypes, YDISP, ZDISP, LDISP
*            YDISP is the default type,
*            ZDISP has a better screen usage by omitting labels and
*            LDISP has the additional option to eliminate window areas
* commentapr2014: to make this organisation useful it should be possible to store several window setting
*                 in different files and restore them.
*/


::class CYDispMenu public
::method actionPerformed
   use arg methName, methArgs

   -- if (methArgs~userData~dtype == "splitpane" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~splitpane)
   -- if (methArgs~userData~dtype == "tabbedpane") THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~tabbedpane)
   -- if (methArgs~userData~dtype == "intframes" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~d1)
   methArgs~userData~contentpanel~bsf.invoke("removeall")

   methArgs~userData~dtype = "splitpane"
   wf = methArgs~userdata~frame~getsize~width
   hf = methArgs~userdata~frame~getsize~height
   w1 = methArgs~userdata~frame~getsize~width -12
   -- h1 = methArgs~userdata~frame~getsize~height - 64
   h1 = methArgs~userdata~frame~getsize~height - 94
   dimsp = .Dimension~new(w1,h1)
   w1 = trunc(dimsp~getwidth)
   h1 = trunc(dimsp~getheight)

   methArgs~userData~p1~setmax(.false)
   methArgs~userData~p2~setmax(.false)
   methArgs~userData~p3~setmax(.false)
   methArgs~userData~p4~setmax(.false)
   methArgs~userData~p5~setmax(.false)
   methArgs~userData~p6~setmax(.false)
   methArgs~userData~maxedpane = NIL

   methArgs~userData~p1~disppanelscrolllabel
   methArgs~userData~p2~disppanelscrolllabel
   methArgs~userData~p3~disppanelscrolllabel
   methArgs~userData~p4~disppanelscrolllabel
   methArgs~userData~p5~disppanelscrolllabel
   methArgs~userData~p6~disppanelscrolllabel

   methArgs~userData~p1~label~setBackground(methArgs~userData~colors~b1)
   methArgs~userData~p2~label~setBackground(methArgs~userData~colors~b2)
   methArgs~userData~p3~label~setBackground(methArgs~userData~colors~b3)
   methArgs~userData~p4~label~setBackground(methArgs~userData~colors~b4)
   methArgs~userData~p5~label~setBackground(methArgs~userData~colors~b5)
   methArgs~userData~p6~label~setBackground(methArgs~userData~colors~b6)
   methArgs~userData~p1~label~setForeground(methArgs~userData~colors~t1)
   methArgs~userData~p2~label~setForeground(methArgs~userData~colors~t2)
   methArgs~userData~p3~label~setForeground(methArgs~userData~colors~t3)
   methArgs~userData~p4~label~setForeground(methArgs~userData~colors~t4)
   methArgs~userData~p5~label~setForeground(methArgs~userData~colors~t5)
   methArgs~userData~p6~label~setForeground(methArgs~userData~colors~t6)

   flowlayout = .FlowLayout~new
   methArgs~userData~contentpanel~bsf.invoke("setLayout",flowlayout)
   methArgs~userData~contentpanel~bsf.invoke("add", methArgs~userData~splitpane)
   methArgs~userData~contentpanel~bsf.invoke("add", methArgs~userData~buttonpanel)
   if .mm.dir~isdebug == true then say "CYDISP buttonpanel"

   Call BSF 'invoke', methArgs~userData~splitpane, 'setOrientation',       .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane, 'settopcomponent',      methArgs~userData~splitpane1
   Call BSF 'invoke', methArgs~userData~splitpane, 'setbottomcomponent',   methArgs~userData~splitpane2

   Call BSF 'invoke', methArgs~userData~splitpane4, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane4, 'settopcomponent',     methArgs~userData~p3~panel
   Call BSF 'invoke', methArgs~userData~splitpane4, 'setbottomcomponent',  methArgs~userData~p4~panel

   Call BSF 'invoke', methArgs~userData~splitpane3, 'setOrientation',      .JSplitPane~HORIZONTAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane3, 'settopcomponent',     methArgs~userData~p2~panel
   Call BSF 'invoke', methArgs~userData~splitpane3, 'setbottomcomponent',  methArgs~userData~splitpane4

   Call BSF 'invoke', methArgs~userData~splitpane1, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane1, 'settopcomponent',     methArgs~userData~p1~panel
   Call BSF 'invoke', methArgs~userData~splitpane1, 'setbottomcomponent',  methArgs~userData~splitpane3

   Call BSF 'invoke', methArgs~userData~splitpane2, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane2, 'settopcomponent',     methArgs~userData~p5~panel
   Call BSF 'invoke', methArgs~userData~splitpane2, 'setbottomcomponent',  methArgs~userData~p6~panel

   -- methArgs~userData~splitpane~bsf.invokeStrict("setDividerLocation", "double", "0.6")
   methArgs~userData~splitpane~bsf.invokestrict("setResizeWeight", "double", "0.5")

   --methArgs~userData~splitpane1~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane1~bsf.invokestrict("setResizeWeight", "double", "0.6")

   --methArgs~userData~splitpane2~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane2~bsf.invokestrict("setResizeWeight", "double", "0.5")

   --methArgs~userData~splitpane3~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane3~bsf.invokestrict("setResizeWeight", "double", "0.5")

   --methArgs~userData~splitpane4~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane4~bsf.invokestrict("setResizeWeight", "double", "0.5")

   Call BSF 'invoke', methArgs~userData~splitpane , 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane1, 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane2, 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane3, 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane4, 'setdividersize',       "2"

   Call BSF 'invoke', methArgs~userdata~splitpane, 'setpreferredsize',     dimsp
   Call BSF 'invoke', methArgs~userdata~splitpane, 'reshape', 0, 0, w1, h1
   Call BSF 'invoke', methArgs~userdata~splitpane, 'revalidate'

   methArgs~userData~splitpane~bsf.invokestrict("setVisible", "boolean", "true")

   -- neutralize alt-x-y-z return from maxbutton
   methArgs~userData~p1~maxbutton~setMnemonic(.KeyEvent~VK_1)
   methArgs~userData~p2~maxbutton~setMnemonic(.KeyEvent~VK_2)
   methArgs~userData~p3~maxbutton~setMnemonic(.KeyEvent~VK_3)
   methArgs~userData~p4~maxbutton~setMnemonic(.KeyEvent~VK_4)
   methArgs~userData~p5~maxbutton~setMnemonic(.KeyEvent~VK_5)
   methArgs~userData~p6~maxbutton~setMnemonic(.KeyEvent~VK_6)

   Call BSF 'invoke', methArgs~userData~splitpane,  setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane1, setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane2, setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane3, setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane4, setOneTouchExpandable, .false

   -- Call BSF 'invoke', methArgs~userData~frame, "pack"
   methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")

/**
* name: CZDispMenu
* functionality: same as CYDISPMenu
*                only label and maxbutton is omitted
* variables: methArgs~userData~dtype = "splitpane"
*            same as CYDISPMenu
* commentapr2014: this is pretty much a copy of CYDISPmenu
*                 but there are slight differences, after all there is some streamlinig possible
*/


::class CZDispMenu public
::method actionPerformed
   use arg methName, methArgs

   methArgs~userData~dtype        = "splitpane"
   wf = methArgs~userdata~frame~getsize~width
   hf = methArgs~userdata~frame~getsize~height
   w1 = methArgs~userdata~frame~getsize~width -12
   -- h1 = methArgs~userdata~frame~getsize~height - 64
   h1 = methArgs~userdata~frame~getsize~height - 94
   dimsp = .Dimension~new(w1,h1)
   w1 = trunc(dimsp~getwidth)
   h1 = trunc(dimsp~getheight)

   methArgs~userData~p1~setmax(.false)
   methArgs~userData~p2~setmax(.false)
   methArgs~userData~p3~setmax(.false)
   methArgs~userData~p4~setmax(.false)
   methArgs~userData~p5~setmax(.false)
   methArgs~userData~p6~setmax(.false)
   methArgs~userData~maxedpane = NIL

   -- if (methArgs~userData~dtype == "splitpane" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~splitpane)
   -- if (methArgs~userData~dtype == "tabbedpane") THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~tabbedpane)
   -- if (methArgs~userData~dtype == "intframes" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~d1)
   methArgs~userData~contentpanel~bsf.invoke("removeall")


   flowlayout = .FlowLayout~new
   methArgs~userData~contentpanel~bsf.invoke("setLayout",flowlayout)
   methArgs~userData~contentpanel~bsf.invoke("add", methArgs~userData~splitpane)
   methArgs~userData~contentpanel~bsf.invoke("add", methArgs~userData~buttonpanel)
   if .mm.dir~isdebug == true then say "zeile 3355 buttonpanel z" w1 h1 methArgs~userdata~frame~getsize~width

   Call BSF 'invoke', methArgs~userData~splitpane, 'setOrientation',       .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane, 'settopcomponent',      methArgs~userData~splitpane1
   Call BSF 'invoke', methArgs~userData~splitpane, 'setbottomcomponent',   methArgs~userData~splitpane2

   Call BSF 'invoke', methArgs~userData~splitpane4, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane4, 'settopcomponent',     methArgs~userData~p3~scrollpane
   Call BSF 'invoke', methArgs~userData~splitpane4, 'setbottomcomponent',  methArgs~userData~p4~scrollpane

   Call BSF 'invoke', methArgs~userData~splitpane3, 'setOrientation',      .JSplitPane~HORIZONTAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane3, 'settopcomponent',     methArgs~userData~p2~scrollpane
   Call BSF 'invoke', methArgs~userData~splitpane3, 'setbottomcomponent',  methArgs~userData~splitpane4

   Call BSF 'invoke', methArgs~userData~splitpane1, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane1, 'settopcomponent',     methArgs~userData~p1~scrollpane
   Call BSF 'invoke', methArgs~userData~splitpane1, 'setbottomcomponent',  methArgs~userData~splitpane3

   Call BSF 'invoke', methArgs~userData~splitpane2, 'setOrientation',      .JSplitPane~VERTICAL_SPLIT
   Call BSF 'invoke', methArgs~userData~splitpane2, 'settopcomponent',     methArgs~userData~p5~scrollpane
   Call BSF 'invoke', methArgs~userData~splitpane2, 'setbottomcomponent',  methArgs~userData~p6~scrollpane

   -- methArgs~userData~splitpane~bsf.invokeStrict("setDividerLocation", "double", "0.6")
   methArgs~userData~splitpane~bsf.invokestrict("setResizeWeight", "double", "0.5")

   --methArgs~userData~splitpane1~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane1~bsf.invokestrict("setResizeWeight", "double", "0.6")

   --methArgs~userData~splitpane2~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane2~bsf.invokestrict("setResizeWeight", "double", "0.5")

   --methArgs~userData~splitpane3~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane3~bsf.invokestrict("setResizeWeight", "double", "0.5")

   --methArgs~userData~splitpane4~bsf.invokeStrict("setDividerLocation", "double", "0.5")
   methArgs~userData~splitpane4~bsf.invokestrict("setResizeWeight", "double", "0.5")

   Call BSF 'invoke', methArgs~userData~splitpane , 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane1, 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane2, 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane3, 'setdividersize',       "2"
   Call BSF 'invoke', methArgs~userData~splitpane4, 'setdividersize',       "2"

   Call BSF 'invoke', methArgs~userdata~splitpane, 'setpreferredsize',     dimsp
   Call BSF 'invoke', methArgs~userdata~splitpane, 'reshape', 0, 0, w1, h1
   Call BSF 'invoke', methArgs~userdata~splitpane, 'revalidate'

   methArgs~userData~splitpane~bsf.invokestrict("setVisible", "boolean", "true")

   -- neutralize alt-x-y-z return from maxbutton
   methArgs~userData~p1~maxbutton~setMnemonic(.KeyEvent~VK_1)
   methArgs~userData~p2~maxbutton~setMnemonic(.KeyEvent~VK_2)
   methArgs~userData~p3~maxbutton~setMnemonic(.KeyEvent~VK_3)
   methArgs~userData~p4~maxbutton~setMnemonic(.KeyEvent~VK_4)
   methArgs~userData~p5~maxbutton~setMnemonic(.KeyEvent~VK_5)
   methArgs~userData~p6~maxbutton~setMnemonic(.KeyEvent~VK_6)

   Call BSF 'invoke', methArgs~userData~splitpane,  setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane1, setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane2, setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane3, setOneTouchExpandable, .false
   Call BSF 'invoke', methArgs~userData~splitpane4, setOneTouchExpandable, .false

   -- Call BSF 'invoke', methArgs~userData~frame, "pack"

   methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
   if .mm.dir~isdebug == true then say "z end" methArgs~userdata~frame~getsize~width


/**
* name: CTDispMenu
* functionality: make the tabbed pane TDISP appaearance
* special java classes: javax.swing.JTabbedPane
* commentapr2014: a part of the code containing icon01..6 is commented
*                 the problem is, that the benefit of using an icon in the tabbed pane is small
*                 and afterwards there is not only one file but also ressources to handle
*                 in case the program is expanded more a resource subdirectory is recommended
*                 there we could store the setting file, additional setting files and also gifs ...
*/

::class CTDispMenu public
::method actionPerformed
   use arg methName, methArgs

   -- if (methArgs~userData~dtype == "splitpane" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~splitpane)
   -- if (methArgs~userData~dtype == "tabbedpane") THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~tabbedpane)
   -- if (methArgs~userData~dtype == "intframes" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~d1)
   methArgs~userData~contentpanel~bsf.invoke("removeall")

   methArgs~userData~dtype = "tabbedpane"
   if .mm.dir~isdebug == true then say "Tabbed disp called"

   tabbedpane = .bsf~new("javax.swing.JTabbedPane")

/*
   icon01 = .bsf~new("javax.swing.ImageIcon", 'images/pk1c.gif')
   icon02 = .bsf~new("javax.swing.ImageIcon", 'images/pk2c.gif')
   icon03 = .bsf~new("javax.swing.ImageIcon", 'images/pk3c.gif')
   icon04 = .bsf~new("javax.swing.ImageIcon", 'images/pk4c.gif')
   icon05 = .bsf~new("javax.swing.ImageIcon", 'images/pk5c.gif')
   icon06 = .bsf~new("javax.swing.ImageIcon", 'images/pk6c.gif')

   Call BSF 'invoke', tabbedpane, 'addTab', "code", icon01, methArgs~userdata~p1~scrollpane, "panel1"
   Call BSF 'invoke', tabbedpane, 'addTab', "inpt", icon02, methArgs~userdata~p2~scrollpane, "panel2"
   Call BSF 'invoke', tabbedpane, 'addTab', "args", icon03, methArgs~userdata~p3~scrollpane, "panel3"
   Call BSF 'invoke', tabbedpane, 'addTab', "rets", icon04, methArgs~userdata~p4~scrollpane, "panel4"
   Call BSF 'invoke', tabbedpane, 'addTab', "says", icon05, methArgs~userdata~p5~scrollpane, "panel5"
   Call BSF 'invoke', tabbedpane, 'addTab', "errs", icon06, methArgs~userdata~p6~scrollpane, "panel6"
*/
   Call BSF 'invoke', tabbedpane, 'addTab', "code", .NIL, methArgs~userdata~p1~scrollpane, "panel1"
   Call BSF 'invoke', tabbedpane, 'addTab', "inpt", .NIL, methArgs~userdata~p2~scrollpane, "panel2"
   Call BSF 'invoke', tabbedpane, 'addTab', "args", .NIL, methArgs~userdata~p3~scrollpane, "panel3"
   Call BSF 'invoke', tabbedpane, 'addTab', "rets", .NIL, methArgs~userdata~p4~scrollpane, "panel4"
   Call BSF 'invoke', tabbedpane, 'addTab', "says", .NIL, methArgs~userdata~p5~scrollpane, "panel5"
   Call BSF 'invoke', tabbedpane, 'addTab', "errs", .NIL, methArgs~userdata~p6~scrollpane, "panel6"

   tabbedpane~setMnemonicAt(0, .KeyEvent~VK_1)
   tabbedpane~setMnemonicAt(1, .KeyEvent~VK_2)
   tabbedpane~setMnemonicAt(2, .KeyEvent~VK_3)
   tabbedpane~setMnemonicAt(3, .KeyEvent~VK_4)
   tabbedpane~setMnemonicAt(4, .KeyEvent~VK_5)
   tabbedpane~setMnemonicAt(5, .KeyEvent~VK_6)

   tabbedpane~setTabPlacement(.JTabbedPane~RIGHT)


   gridlayout = .bsf~new("java.awt.GridLayout")


   flowlayout = .FlowLayout~new
   methArgs~userData~contentpanel~bsf.invoke("setLayout",flowlayout)
   methArgs~userData~contentpanel~bsf.invoke("add", tabbedpane)
   methArgs~userData~contentpanel~bsf.invoke("add", methArgs~userData~buttonpanel)

   methArgs~userdata~tabbedpane = tabbedpane
   bounds = .Rectangle~new
   bounds = methArgs~userData~frame~getbounds()

   dimscroll = .Dimension~new
   dimscroll~setSize( bounds~width - 132, bounds~height - 104)

   methArgs~userdata~p1~scrollpane~setpreferredSize(dimscroll)
   methArgs~userdata~p2~scrollpane~setpreferredSize(dimscroll)
   methArgs~userdata~p3~scrollpane~setpreferredSize(dimscroll)
   methArgs~userdata~p4~scrollpane~setpreferredSize(dimscroll)
   methArgs~userdata~p5~scrollpane~setpreferredSize(dimscroll)
   methArgs~userdata~p6~scrollpane~setpreferredSize(dimscroll)

   Call BSF 'invoke', methArgs~userdata~p1~textarea, "setRows", 20
   Call BSF 'invoke', methArgs~userdata~p2~textarea, "setRows", 20
   Call BSF 'invoke', methArgs~userdata~p3~textarea, "setRows", 20
   Call BSF 'invoke', methArgs~userdata~p4~textarea, "setRows", 20
   Call BSF 'invoke', methArgs~userdata~p5~textarea, "setRows", 20
   Call BSF 'invoke', methArgs~userdata~p6~textarea, "setRows", 20

   Call BSF 'invoke', methArgs~userData~frame, "pack"
   Call BSF 'invoke', methArgs~userData~frame, 'setBounds', bounds~x, bounds~y, bounds~width, bounds~height

   methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")

/**
* name: CWDispMenu
* functionality: clean the whole frame (contentpanel)
*                and put the 6 internal frames on certain places in the free area
*                make the WDISP (internal frames representation)
* commentapr2014: there is an error when switching from WDISP to LDISP
*/


::class CWDispMenu public
::method actionPerformed
   use arg methName, methArgs

   -- if (methArgs~userData~dtype == "splitpane" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~splitpane)
   -- if (methArgs~userData~dtype == "tabbedpane") THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~tabbedpane)
   -- if (methArgs~userData~dtype == "intframes" ) THEN methArgs~userData~contentpanel~bsf.invoke("remove", methArgs~userData~d1)
   methArgs~userData~contentpanel~bsf.invoke("removeall")

   methArgs~userData~dtype        = "intframes"
   if .mm.dir~isdebug == true then say "wdisp called"

   bounds = .Rectangle~new
   bounds = methArgs~userData~frame~getbounds()
   bounds~height = bounds~height
   d1 = .Cinternalframepane~new(bounds)

   flowlayout = .FlowLayout~new
   methArgs~userData~contentpanel~bsf.invoke("setLayout",flowlayout)
   methArgs~userData~contentpanel~bsf.invoke("add", d1~desktopp)
   methArgs~userData~contentpanel~bsf.invoke("add", methArgs~userData~buttonpanel)

   dimspx = .Dimension~new(0,0)

   d1~f1~getsize(dimspx)
   dimspx~width = dimspx~width - 12
   dimspx~height = dimspx~height - 48
   Call BSF 'invoke', d1~f1, add, methArgs~userData~p1~scrollpane
   methArgs~userData~p1~panel~bsf.invoke("setpreferredSize", dimspx)
   Call BSF 'invoke', methArgs~userData~p1~panel, 'reshape', 0, 0, dimspx~width, dimspx~height
   Call BSF 'invoke', methArgs~userData~p1~panel, 'revalidate'

   d1~f2~getsize(dimspx)
   dimspx~width = dimspx~width - 12
   dimspx~height = dimspx~height - 48
   Call BSF 'invoke', d1~f2, add, methArgs~userData~p2~scrollpane
   methArgs~userData~p2~panel~bsf.invoke("setpreferredSize", dimspx)
   Call BSF 'invoke', methArgs~userData~p2~panel, 'reshape', 0, 0, dimspx~width, dimspx~height
   Call BSF 'invoke', methArgs~userData~p2~panel, 'revalidate'

   d1~f3~getsize(dimspx)
   dimspx~width = dimspx~width - 12
   dimspx~height = dimspx~height - 48
   Call BSF 'invoke', d1~f3, add, methArgs~userData~p3~scrollpane
   methArgs~userData~p3~panel~bsf.invoke("setpreferredSize", dimspx)
   Call BSF 'invoke', methArgs~userData~p3~panel, 'reshape', 0, 0, dimspx~width, dimspx~height
   Call BSF 'invoke', methArgs~userData~p3~panel, 'revalidate'

   d1~f4~getsize(dimspx)
   dimspx~width = dimspx~width - 12
   dimspx~height = dimspx~height - 48
   Call BSF 'invoke', d1~f4, add, methArgs~userData~p4~scrollpane
   methArgs~userData~p4~panel~bsf.invoke("setpreferredSize", dimspx)
   Call BSF 'invoke', methArgs~userData~p4~panel, 'reshape', 0, 0, dimspx~width, dimspx~height
   Call BSF 'invoke', methArgs~userData~p4~panel, 'revalidate'

   d1~f5~getsize(dimspx)
   dimspx~width = dimspx~width - 12
   dimspx~height = dimspx~height - 48
   Call BSF 'invoke', d1~f5, add, methArgs~userData~p5~scrollpane
   methArgs~userData~p2~panel~bsf.invoke("setpreferredSize", dimspx)
   Call BSF 'invoke', methArgs~userData~p5~panel, 'reshape', 0, 0, dimspx~width, dimspx~height
   Call BSF 'invoke', methArgs~userData~p5~panel, 'revalidate'

   d1~f6~getsize(dimspx)
   dimspx~width = dimspx~width - 12
   dimspx~height = dimspx~height - 48
   Call BSF 'invoke', d1~f6, add, methArgs~userData~p6~scrollpane
   methArgs~userData~p6~panel~bsf.invoke("setpreferredSize", dimspx)
   Call BSF 'invoke', methArgs~userData~p6~panel, 'reshape', 0, 0, dimspx~width, dimspx~height
   Call BSF 'invoke', methArgs~userData~p6~panel, 'revalidate'


   -- Call BSF 'invoke', methArgs~userData~frame, "pack"
   Call BSF 'invoke', methArgs~userData~frame, 'setBounds', bounds~x, bounds~y, bounds~width, bounds~height
   methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")

   methArgs~userData~d1 = d1

/**
* name: CLDispMenu
* functionality: basically as CYDispMenu
*                but set onetouchexpandable.
*                if not splitpane then without consequence.
*                if ismaximized then exit.
*                reset occurs everytime YDISP or ZDISP explicitly called.
* commentapr2014: there is a problem when switching from WDISP to LDISP
*                 which is clear after all: when we come from WDSIP there is no splitpane ...
*/

::class CLDispMenu public
::method actionPerformed
   use arg methName, methArgs

   if .mm.dir~isdebug == true then say "setonetouch expandable called"

   if methArgs~userdata~maxedpane == NIL then do
      if .mm.dir~isdebug == true then say "setonetouch expandable to true"
      Call BSF 'invoke', methArgs~userData~splitpane,  setOneTouchExpandable, .true
      Call BSF 'invoke', methArgs~userData~splitpane1, setOneTouchExpandable, .true
      Call BSF 'invoke', methArgs~userData~splitpane2, setOneTouchExpandable, .true
      Call BSF 'invoke', methArgs~userData~splitpane3, setOneTouchExpandable, .true
      Call BSF 'invoke', methArgs~userData~splitpane4, setOneTouchExpandable, .true
      Call BSF 'invoke', methArgs~userData~splitpane,  'setdividersize',       "10"
      Call BSF 'invoke', methArgs~userData~splitpane1, 'setdividersize',       "10"
      Call BSF 'invoke', methArgs~userData~splitpane2, 'setdividersize',       "10"
      Call BSF 'invoke', methArgs~userData~splitpane3, 'setdividersize',       "10"
      Call BSF 'invoke', methArgs~userData~splitpane4, 'setdividersize',       "10"
   end

/**
* name: CFrameCL
* functionality: this class handles actions performed on the main frame of the GUI
*                problems only appear in case of resizing
*                this has to be forwarded to all subcomponents
* methods: componentresized
* commentapr2014: somehow a trial and error approach
*                 it works as it is programmed here but i am sure it is possible to make it a lot better
*/


::class CFrameCL public
::method componentresized
   use arg methName, methArgs
   -- say methArgs~userdata~allindexes~toString

   w1 = methArgs~userdata~frame~getsize~width -12
   -- h1 = methArgs~userdata~frame~getsize~height - 64
   h1 = methArgs~userdata~frame~getsize~height - 94
   dimsp = .Dimension~new(w1,h1)
   if .mm.dir~isdebug == true then say "frame component listener resized" methArgs~userdata~dtype w1 h1

   if methArgs~userdata~dtype == "tabbedpane" then do
      x = (methArgs~userdata~tabbedpane~getpreferredsize~width - w1 )
      y = (methArgs~userdata~tabbedpane~getpreferredsize~height - h1 )
      z = x * x + y * y
      if z < 99 then exit
      if .mm.dir~isdebug == true then say "tabbedpane handling"
      if .mm.dir~isdebug == true then say methArgs~userdata~tabbedpane~getpreferredsize~width methArgs~userdata~tabbedpane~getpreferredsize~height
      Call BSF 'invoke', methArgs~userdata~tabbedpane, 'setpreferredsize',     dimsp
      Call BSF 'invoke', methArgs~userdata~tabbedpane, 'revalidate'
      exit
   end

   if methArgs~userdata~dtype == "splitpane" then do

      x = (methArgs~userdata~splitpane~getpreferredsize~width - w1 )
      y = (methArgs~userdata~splitpane~getpreferredsize~height - h1 )
      z = x * x + y * y
      if z < 99 then exit

      if .mm.dir~isdebug == true then say "splitpane handling"
      Call BSF 'invoke', methArgs~userdata~splitpane, 'setpreferredsize',     dimsp
      if .mm.dir~isdebug == true then say methArgs~userdata~splitpane~getpreferredsize~width methArgs~userdata~splitpane~getpreferredsize~height
      Call BSF 'invoke', methArgs~userdata~splitpane, 'reshape', 0, 0, w1, h1
      Call BSF 'invoke', methArgs~userdata~splitpane, 'revalidate'

      select
         when methArgs~userdata~p1~getmax == .true then do
            methArgs~userdata~p1~panel~bsf.invoke("setpreferredSize", dimsp)
            Call BSF 'invoke', methArgs~userdata~p1~panel, 'revalidate'
            Call BSF 'invoke', methArgs~userdata~p1~scrollpane, 'revalidate'
            if .mm.dir~isdebug == true then say "panelheight 1    " methArgs~userdata~p1~panel~getsize~height
            if .mm.dir~isdebug == true then say "scrollpane height" methArgs~userdata~p1~scrollpane~getsize~height
         end
         when methArgs~userdata~p2~getmax == .true then do
            methArgs~userdata~p2~panel~bsf.invoke("setpreferredSize", dimsp)
            Call BSF 'invoke', methArgs~userdata~p2~panel, 'revalidate'
            Call BSF 'invoke', methArgs~userdata~p2~scrollpane, 'revalidate'
            if .mm.dir~isdebug == true then say "panelheight 2    " methArgs~userdata~p2~panel~getsize~height
            if .mm.dir~isdebug == true then say "scrollpane height" methArgs~userdata~p2~scrollpane~getsize~height
         end
         when methArgs~userdata~p3~getmax == .true then do
            methArgs~userdata~p3~panel~bsf.invoke("setpreferredSize", dimsp)
            Call BSF 'invoke', methArgs~userdata~p3~panel, 'revalidate'
            Call BSF 'invoke', methArgs~userdata~p3~scrollpane, 'revalidate'
            if .mm.dir~isdebug == true then say "panelheight 3    " methArgs~userdata~p3~panel~getsize~height
            if .mm.dir~isdebug == true then say "scrollpane height" methArgs~userdata~p3~scrollpane~getsize~height
         end
         when methArgs~userdata~p4~getmax == .true then do
            methArgs~userdata~p4~panel~bsf.invoke("setpreferredSize", dimsp)
            Call BSF 'invoke', methArgs~userdata~p4~panel, 'revalidate'
            Call BSF 'invoke', methArgs~userdata~p4~scrollpane, 'revalidate'
            if .mm.dir~isdebug == true then say "panelheight 4    " methArgs~userdata~p4~panel~getsize~height
            if .mm.dir~isdebug == true then say "scrollpane height" methArgs~userdata~p4~scrollpane~getsize~height
         end
         when methArgs~userdata~p5~getmax == .true then do
            methArgs~userdata~p5~panel~bsf.invoke("setpreferredSize", dimsp)
            Call BSF 'invoke', methArgs~userdata~p5~panel, 'revalidate'
            Call BSF 'invoke', methArgs~userdata~p5~scrollpane, 'revalidate'
            if .mm.dir~isdebug == true then say "panelheight 5    " methArgs~userdata~p5~panel~getsize~height
            if .mm.dir~isdebug == true then say "scrollpane height" methArgs~userdata~p5~scrollpane~getsize~height
         end
         when methArgs~userdata~p6~getmax == .true then do
            methArgs~userdata~p6~panel~bsf.invoke("setpreferredSize", dimsp)
            Call BSF 'invoke', methArgs~userdata~p6~panel, 'revalidate'
            Call BSF 'invoke', methArgs~userdata~p6~scrollpane, 'revalidate'
            if .mm.dir~isdebug == true then say "panelheight 6    " methArgs~userdata~p6~panel~getsize~height
            if .mm.dir~isdebug == true then say "scrollpane height" methArgs~userdata~p6~scrollpane~getsize~height
         end
         otherwise do
            if .mm.dir~isdebug == true then say "else"
            Call BSF 'invoke', methArgs~userdata~splitpane, 'setpreferredsize',     dimsp
            if .mm.dir~isdebug == true then say "splitprefer " methArgs~userdata~splitpane~getpreferredsize~width methArgs~userdata~splitpane~getpreferredsize~height
            Call BSF 'invoke', methArgs~userdata~splitpane, 'reshape', 0, 0, w1, h1
            Call BSF 'invoke', methArgs~userdata~splitpane, 'revalidate'
         end
      end
   end
exit

::method unknown
/* all other methods of this class perform here ... and do nothing */
   use arg methName, methArgs
   if .mm.dir~isdebug == true then say "frame component listener:" methName

/*
::method componentmoved
   use arg methName, methArgs
   if .mm.dir~isdebug == true then say "frame component listener moved"
::method componenthidden
   use arg methName, methArgs
   if .mm.dir~isdebug == true then say "frame component listener hidden"
::method componentshown
   use arg methName, methArgs
   if .mm.dir~isdebug == true then say "frame component listener shown"
*/

/**
* name: CButton1EH
* functionality: event handler: maximise the code window area
*/

::class CButton1EH
::method actionPerformed
   use arg methName, methArgs
   if .mm.dir~isdebug == true then say "button 1"
   if methArgs~userdata~maxedpane == NIL then do
      methArgs~userdata~maxedpane = methArgs~userdata~p1
      call pressmaxpane methArgs~userdata
   end
   else do
      call pressshowsplitpane methArgs~userdata
   end

