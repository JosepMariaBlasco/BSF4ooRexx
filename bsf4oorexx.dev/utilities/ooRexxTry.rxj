/**
* name: ColorEH
* functionality: only for debug output
*                there is no need to do something specific
* commentapr2014: an idea might be to provide an OK and CANCEL button and depending on this
*                 either do the changes or not.
*                 simply to close the window is equivalent to the cancel button
*/

::class ColorEH public
::method init
::method unknown
::method windowClosing
   if .mm.dir~isdebug == true then say "windowClosing colorchooser"
::method waitForExit

/**
* name: CloseEH
* functionality: close handler for the application
*/

::class CloseEH
::attribute closeApp
::method init
   expose closeApp
   closeApp = .false
::method unknown
::method actionPerformed
  expose closeApp
  closeApp=.true
::method windowClosing
   expose closeApp
   closeApp=.true
::method waitForExit
   expose closeApp
   guard on when closeApp=.true

/**
* name: CColorChooserEH
* menue item: settings->set COLOR
* main variables: bccb1..7 color chooser buttons for background color (button color chooser background 1 ...)
*                 bcct1..7 color chooser buttons for foreground color
* event handler: rpbccEH handles event button pressed and opens a color panel
* functionality: set colors for banner background and foreground
* special java classes: java.awt.GridLayout
* commentapr2014: this is not the best place for transparency setting (which is commented out here)
*                 transparency should be set in an own menu item
*/


::class CColorChooserEH public
::method actionPerformed
   use arg methName, methArgs

   if .mm.dir~isdebug == true then say methArgs~userData~colors~b1
   if .mm.dir~isdebug == true then say methArgs~userData~colors~t1

   colorframe = .bsf~new("javax.swing.JFrame", 'Colors for Panels and Text')
   Call BSF 'invoke', colorframe, 'setBounds',    100, 200, 200, 250
   Call BSF 'invoke', colorframe, 'setSize',     200, 250

   dimframe = colorframe~getsize
   colorpanel = .bsf~new("javax.swing.JPanel", )
   Call BSF 'invoke', colorframe, setContentPane, colorpanel

   myGridLayout = .bsf~new("java.awt.GridLayout")
   Call BSF 'invoke', myGridLayout, "setColumns", 2
   Call BSF 'invoke', myGridLayout, "setRows", 7

   rexxColorEH = .ColorEH~new
   rpColorEH = BsfCreateRexxProxy(rexxColorEH, , "java.awt.event.WindowListener")
   Call BSF 'invoke', colorframe, 'addWindowListener',     rpColorEH

   colorpanel~setLayout(myGridLayout)

   bccb1 = .bsf~new("javax.swing.JButton", "Code banner color")
   bcct1 = .bsf~new("javax.swing.JButton", "Code Text color")
   bccb2 = .bsf~new("javax.swing.JButton", "Input banner color")
   bcct2 = .bsf~new("javax.swing.JButton", "Input Text color")
   bccb3 = .bsf~new("javax.swing.JButton", "Arg banner color")
   bcct3 = .bsf~new("javax.swing.JButton", "Arg Text color")
   bccb4 = .bsf~new("javax.swing.JButton", "Ret banner color")
   bcct4 = .bsf~new("javax.swing.JButton", "Ret Text color")
   bccb5 = .bsf~new("javax.swing.JButton", "Out banner color")
   bcct5 = .bsf~new("javax.swing.JButton", "Out Text color")
   bccb6 = .bsf~new("javax.swing.JButton", "Errors banner color")
   bcct6 = .bsf~new("javax.swing.JButton", "Errors Text color")
   bccb7 = .bsf~new("javax.swing.JButton", "History banner color")
   bcct7 = .bsf~new("javax.swing.JButton", "History Text color")

   -- transparency settings would fit pretty well into the color setting dialog
   -- code 2014 march does not support transparency due to some problems

   -- jtrans = .bsf~new("javax.swing.JSlider", .JSlider~HORIZONTAL,0,100,100);
   -- jcheck = .bsf~new("javax.swing.JCheckBox","Transparency Setting");
   -- jlab1  = .bsf~new("javax.swing.JLabel", "Transparency Setting",.javax.swing.JLabel~center);


   if .mm.dir~isdebug == true then say methArgs~userData~bccb1 methArgs~userData~colors~b1
   Call BSF 'invoke', bccb1,  'setBackground', methArgs~userData~colors~b1
   Call BSF 'invoke', bccb2,  'setBackground', methArgs~userData~colors~b2
   Call BSF 'invoke', bccb3,  'setBackground', methArgs~userData~colors~b3
   Call BSF 'invoke', bccb4,  'setBackground', methArgs~userData~colors~b4
   Call BSF 'invoke', bccb5,  'setBackground', methArgs~userData~colors~b5
   Call BSF 'invoke', bccb6,  'setBackground', methArgs~userData~colors~b6
   Call BSF 'invoke', bccb7,  'setBackground', methArgs~userData~colors~b7

   Call BSF 'invoke', bcct1,  'setForeground', methArgs~userData~colors~t1
   Call BSF 'invoke', bcct2,  'setForeground', methArgs~userData~colors~t2
   Call BSF 'invoke', bcct3,  'setForeground', methArgs~userData~colors~t3
   Call BSF 'invoke', bcct4,  'setForeground', methArgs~userData~colors~t4
   Call BSF 'invoke', bcct5,  'setForeground', methArgs~userData~colors~t5
   Call BSF 'invoke', bcct6,  'setForeground', methArgs~userData~colors~t6
   Call BSF 'invoke', bcct7,  'setForeground', methArgs~userData~colors~t7

   -- Call BSF 'invoke', jcheck,  'setActionCommand', 'transset'

   rexxbccEH = .CbccEH~new
   rpbccEH = BsfCreateRexxProxy(rexxbccEH, methArgs~userData, "java.awt.event.ActionListener")
   -- rexxxccEH = .CxccEH~new
   -- rpxccEH = BsfCreateRexxProxy(rexxxccEH, methArgs~userData, "java.awt.event.ActionListener")
   -- rexxtccEH = .CtccEH~new
   -- rptccEH = BsfCreateRexxProxy(rexxtccEH, methArgs~userData, "java.awt.event.ChangeListener")


   bccb1~~addActionListener(rpbccEH)
   bccb2~~addActionListener(rpbccEH)
   bccb3~~addActionListener(rpbccEH)
   bccb4~~addActionListener(rpbccEH)
   bccb5~~addActionListener(rpbccEH)
   bccb6~~addActionListener(rpbccEH)
   bccb7~~addActionListener(rpbccEH)
   bcct1~~addActionListener(rpbccEH)
   bcct2~~addActionListener(rpbccEH)
   bcct3~~addActionListener(rpbccEH)
   bcct4~~addActionListener(rpbccEH)
   bcct5~~addActionListener(rpbccEH)
   bcct6~~addActionListener(rpbccEH)
   bcct7~~addActionListener(rpbccEH)

   -- jcheck~~addActionListener(rpxccEH)
   -- jtrans~~addChangeListener(rptccEH)

   colorpanel~bsf.invoke("add", bccb1);
   colorpanel~bsf.invoke("add", bcct1);
   colorpanel~bsf.invoke("add", bccb2);
   colorpanel~bsf.invoke("add", bcct2);
   colorpanel~bsf.invoke("add", bccb3);
   colorpanel~bsf.invoke("add", bcct3);
   colorpanel~bsf.invoke("add", bccb4);
   colorpanel~bsf.invoke("add", bcct4);
   colorpanel~bsf.invoke("add", bccb5);
   colorpanel~bsf.invoke("add", bcct5);
   colorpanel~bsf.invoke("add", bccb6);
   colorpanel~bsf.invoke("add", bcct6);
   -- colorpanel~bsf.invoke("add", jtrans);
   -- colorpanel~bsf.invoke("add", jcheck);
   -- colorpanel~bsf.invoke("add", jlab1);
   colorpanel~bsf.invoke("add", bccb7);
   colorpanel~bsf.invoke("add", bcct7);

   methArgs~userData~colorframe = colorframe
   methArgs~userData~colorpanel = colorpanel
   methArgs~userData~bccb1 = bccb1
   methArgs~userData~bccb2 = bccb2
   methArgs~userData~bccb3 = bccb3
