   methArgs~userData~bcct1 = bcct1
   methArgs~userData~bcct2 = bcct2
   methArgs~userData~bcct3 = bcct3
   methArgs~userData~bcct4 = bcct4
   methArgs~userData~bcct5 = bcct5
   methArgs~userData~bcct6 = bcct6
   methArgs~userData~bcct7 = bcct7

   -- methArgs~userData~jcheck = jcheck

   Call BSF 'invoke', colorframe, "pack"
   colorframe~bsf.invokestrict("setVisible", "boolean", "true")

   rexxcolorEH~waitForExit
   call SysSleep .2

/**
* name: CbccEH
* parameter: methname contains the caller label of the class
*            methargs as everywhere the userData
* functionality: depending on the caller set a new color for a certain window element
*                here: the banner for the six main windows
*                      the history window
* special java classes: javax.swing.JColorChooser
* commentapr2014: maybe the if construction can be done a little bit less error prone and shorter
*                 there are other windows like history capacity
*                                              set monitors ...
*                 or even this one, where a color banner might be usefull
*/

::class CbccEH public
::attribute newColor
::method actionPerformed
   use arg methName, methArgs
   sourcelabel = bsf('invoke', methName~getSource, 'getLabel')

   if .mm.dir~isdebug == true then say methArgs~userData~colors~b1

   sbutton = "none"
   if sourcelabel = "<S>Code banner color"     then sbutton = "b1"
   if sourcelabel = "<S>Code Text color"       then sbutton = "t1"
   if sourcelabel = "<S>Input banner color"    then sbutton = "b2"
   if sourcelabel = "<S>Input Text color"      then sbutton = "t2"
   if sourcelabel = "<S>Arg banner color"      then sbutton = "b3"
   if sourcelabel = "<S>Arg Text color"        then sbutton = "t3"
   if sourcelabel = "<S>Ret banner color"      then sbutton = "b4"
   if sourcelabel = "<S>Ret Text color"        then sbutton = "t4"
   if sourcelabel = "<S>Out banner color"      then sbutton = "b5"
   if sourcelabel = "<S>Out Text color"        then sbutton = "t5"
   if sourcelabel = "<S>Errors banner color"   then sbutton = "b6"
   if sourcelabel = "<S>Errors Text color"     then sbutton = "t6"
   if sourcelabel = "<S>History banner color"  then sbutton = "b7"
   if sourcelabel = "<S>History Text color"    then sbutton = "t7"

   if .mm.dir~isdebug == true then say "wert von tab  stringed " sourcelabel sbutton

   emptypanel = .bsf~new("javax.swing.JPanel")

   if sbutton == "b1" then oldColor = methArgs~userData~colors~b1
   if sbutton == "t1" then oldColor = methArgs~userData~colors~t1
   if sbutton == "b2" then oldColor = methArgs~userData~colors~b2
   if sbutton == "t2" then oldColor = methArgs~userData~colors~t2
   if sbutton == "b3" then oldColor = methArgs~userData~colors~b3
   if sbutton == "t3" then oldColor = methArgs~userData~colors~t3
   if sbutton == "b4" then oldColor = methArgs~userData~colors~b4
   if sbutton == "t4" then oldColor = methArgs~userData~colors~t4
   if sbutton == "b5" then oldColor = methArgs~userData~colors~b5
   if sbutton == "t5" then oldColor = methArgs~userData~colors~t5
   if sbutton == "b6" then oldColor = methArgs~userData~colors~b6
   if sbutton == "t6" then oldColor = methArgs~userData~colors~t6
   if sbutton == "b7" then oldColor = methArgs~userData~colors~b7
   if sbutton == "t7" then oldColor = methArgs~userData~colors~t7

   rexxcolorchooser = .bsf~new("javax.swing.JColorChooser")

   rexxcolorchooser~setPreviewPanel(emptypanel)

   if oldColor == .nil then do
      i255 = box("int",255) /* java version compatibility problem: int and float */
      oldColor = .Color~new(i255,   6,   1, 200)
   end
   newColor = rexxcolorchooser~showDialog(.nil, 'ColorChooser', oldColor)

   if newColor == .nil then return
   if sbutton == "b1" then do
      methArgs~userData~colors~b1 = newColor
      Call BSF 'invoke', methArgs~userData~bccb1,  'setBackground', newColor
      methArgs~userData~p1~label~setBackground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "t1" then do
      methArgs~userData~colors~t1 = newColor
      Call BSF 'invoke', methArgs~userData~bcct1,  'setForeground', newColor
      methArgs~userData~p1~label~setForeground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "b2" then do
      methArgs~userData~colors~b2 = newColor
      Call BSF 'invoke', methArgs~userData~bccb2,  'setBackground', newColor
      methArgs~userData~p2~label~setBackground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "t2" then do
      methArgs~userData~colors~t2 = newColor
      Call BSF 'invoke', methArgs~userData~bcct2,  'setForeground', newColor
      methArgs~userData~p2~label~setForeground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "b3" then do
      methArgs~userData~colors~b3 = newColor
      Call BSF 'invoke', methArgs~userData~bccb3,  'setBackground', newColor
      methArgs~userData~p3~label~setBackground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "t3" then do
      methArgs~userData~colors~t3 = newColor
      Call BSF 'invoke', methArgs~userData~bcct3,  'setForeground', newColor
      methArgs~userData~p3~label~setForeground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "b4" then do
      methArgs~userData~colors~b4 = newColor
      Call BSF 'invoke', methArgs~userData~bccb4,  'setBackground', newColor
      methArgs~userData~p4~label~setBackground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "t4" then do
      methArgs~userData~colors~t4 = newColor
      Call BSF 'invoke', methArgs~userData~bcct4,  'setForeground', newColor
      methArgs~userData~p4~label~setForeground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")

   end
   if sbutton == "b5" then do
      methArgs~userData~colors~b5 = newColor
      Call BSF 'invoke', methArgs~userData~bccb5,  'setBackground', newColor
      methArgs~userData~p5~label~setBackground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "t5" then do
      methArgs~userData~colors~t5 = newColor
      Call BSF 'invoke', methArgs~userData~bcct5,  'setForeground', newColor
      methArgs~userData~p5~label~setForeground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "b6" then do
      methArgs~userData~colors~b6 = newColor
      Call BSF 'invoke', methArgs~userData~bccb6,  'setBackground', newColor
      methArgs~userData~p6~label~setBackground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end
   if sbutton == "t6" then do
      methArgs~userData~colors~t6 = newColor
      Call BSF 'invoke', methArgs~userData~bcct6,  'setForeground', newColor
      methArgs~userData~p6~label~setForeground(newColor)
      methArgs~userData~frame~bsf.invokestrict("setVisible", "boolean", "true")
      methArgs~userData~colorframe~bsf.invokestrict("setVisible", "boolean", "true")
   end

   if sbutton == "b7" then do
      methArgs~userData~colors~b7 = newColor
      Call BSF 'invoke', methArgs~userData~bccb7,  'setBackground', newColor
   end
   if sbutton == "t7" then do
      methArgs~userData~colors~t7 = newColor
      Call BSF 'invoke', methArgs~userData~bcct7,  'setForeground', newColor
   end

   return
::method unknown
   use arg methName, methArgs
   if .mm.dir~isdebug == true then say "CbccEH called: " methName

/**
* name: CExitHandler
* functionality: When test-code is executed it is called by rexxEngine~apply
*                The rexxEngine has this exitHandler associated.
*                actually here strings are associated to certain streams
*                furthermore entries for the history array are made
*/
::class CExitHandler
::method handleExit
use arg slot, exitNumber, subFunction, parmBlock

if .mm.dir~isdebug == true then say "CEXITHANDLER" exitNumber subFunction parmBlock[1]

-- generate history array
if subFunction == 1 then mark = "S"
if subFunction == 2 then mark = "E"
if subFunction == 3 then mark = "I"
if subFunction == 4 then mark = "I"

if subFunction == 1 then .output~lineout(parmBlock[1])
if subFunction == 2 then .error~lineout(parmBlock[1])
if subFunction == 3 then .input~linein(parmBlock[1])
if subFunction == 4 then .input~linein(parmBlock[1])

if exitNumber == 5 then do
   .mm.dir~hcque~setelem(TIME("L"),mark,parmBlock[1])
   return .mm.dir~RXEXIT_HANDLED
end
else do
   return .mm.dir~RXEXIT_NOT_HANDLED
end
/* GLEITNER Classes end */



/**
* name: importClasses (routine)
* functionality: Imports all necessary java classes so that they can be referred to
                 by a dot an the specific class name without the package.
*/

::routine importClasses

    list=.list~new
    list ~ append( 'java.awt.BorderLayout'              )
    list ~ append( 'java.awt.Color'                     )
    list ~ append( 'java.awt.Cursor'                    )
    list ~ append( 'java.awt.Dimension'                 )
    list ~ append( 'java.awt.FlowLayout'                )
    list ~ append( 'java.awt.Font'                      )
    list ~ append( 'java.awt.Frame'                     )
    list ~ append( 'java.awt.GridBagConstraints'        )
    list ~ append( 'java.awt.GridBagLayout'             )
    list ~ append( 'java.awt.Insets'                    )
    list ~ append( 'java.awt.Toolkit'                   )
    list ~ append( 'java.awt.datatransfer.StringSelection' )
    list ~ append( 'java.awt.event.ActionListener'      )
    list ~ append( 'java.awt.event.KeyEvent'            )
    list ~ append( 'java.awt.event.KeyListener'         )
    list ~ append( 'java.awt.event.MouseListener'       )
    list ~ append( 'java.io.BufferedReader'             )
--    list ~ append( 'java.io.File'                       )-- rgf, 2012-04-04, not used
    list ~ append( 'java.io.InputStreamReader'          )
    list ~ append( 'java.io.PrintWriter'                )
    list ~ append( 'java.lang.Runnable'                 )
    list ~ append( 'java.lang.Thread'                   )
    list ~ append( 'javax.swing.ButtonGroup'            )
    list ~ append( 'javax.swing.DefaultListModel'       )
    list ~ append( 'javax.swing.JButton'                )
    list ~ append( 'javax.swing.JCheckBoxMenuItem'      )
    list ~ append( 'javax.swing.JComponent'             )
    list ~ append( 'javax.swing.JDialog'                )
    list ~ append( 'javax.swing.JFileChooser'           )
    list ~ append( 'javax.swing.JFrame'                 )
    list ~ append( 'javax.swing.JLabel'                 )
    list ~ append( 'javax.swing.JList'                  )
    list ~ append( 'javax.swing.JMenu'                  )
    list ~ append( 'javax.swing.JMenuBar'               )
    list ~ append( 'javax.swing.JMenuItem'              )
    list ~ append( 'javax.swing.JPanel'                 )
    list ~ append( 'javax.swing.JRadioButton'           )
    list ~ append( 'javax.swing.JScrollPane'            )
    list ~ append( 'javax.swing.JTabbedPane'            )
    list ~ append( 'javax.swing.JTextArea'              )
    list ~ append( 'javax.swing.JTextField'             )
    list ~ append( 'javax.swing.KeyStroke'              )
    list ~ append( 'javax.swing.ListSelectionModel'     )
    list ~ append( 'javax.swing.UIManager'              )
    list ~ append( 'javax.swing.border.EmptyBorder'     )
    list ~ append( 'javax.swing.filechooser.FileFilter' )

    do clz over list
       call bsf.importClass clz
    end

  .bsf~bsf.import('java.awt.BorderLayout',            'BorderLayout'       )
  .bsf~bsf.import('java.awt.Color',                   'Color'              )
  .bsf~bsf.import('java.awt.Container',               'Container'          )
  .bsf~bsf.import('java.awt.Component',               'Component'          )
  .bsf~bsf.import('java.awt.Dimension',               'Dimension'          )
  .bsf~bsf.import('java.awt.FlowLayout',              'FlowLayout'         )
  .bsf~bsf.import('java.awt.Graphics',                'Graphics'           )
  .bsf~bsf.import('java.awt.Rectangle',               'Rectangle'          )
  .bsf~bsf.import('java.awt.event.KeyEvent',          'KeyEvent'           )
  .bsf~bsf.import('java.awt.event.ComponentListener', 'ComponentListener'  )
  .bsf~bsf.import('java.awt.GridBagConstraints',      'GridBagConstraints' )
  .bsf~bsf.import('java.awt.GridBagLayout',           'GridBagLayout'      )
  .bsf~bsf.import('java.awt.GridLayout',              'GridLayout'         )
  .bsf~bsf.import('java.awt.Insets',                  'Insets'             )
  .bsf~bsf.import('javax.swing.AbstractButton',       'AbstractButton'     )
  .bsf~bsf.import('javax.swing.BoxLayout',            'BoxLayout'          )
  .bsf~bsf.import('javax.swing.ImageIcon',            'ImageIcon'          )
  .bsf~bsf.import('javax.swing.JColorChooser',        'JColorChooser'      )
  .bsf~bsf.import('javax.swing.colorchooser.ColorSelectionModel',           'ColorSelectionModel')
  .bsf~bsf.import('javax.swing.JInternalFrame',       'JInternalFrame'     )
  .bsf~bsf.import('javax.swing.JDesktopPane',         'JDesktopPane'       )
  .bsf~bsf.import('javax.swing.JFrame',               'JFrame'             )
  .bsf~bsf.import('javax.swing.JLabel',               'JLabel'             )
