  use arg methName, argArray, arg3=.nil

  say "UNKNOWN, methodName:" pp(methName)
  do i=1 to argArray~items
     o=argArray[i]
     say "   arg #" i":" pp(o)
     if o~isA(.directory) then
     do
        do idx over o
           say "      entry:" pp(idx)
        end
     end

  end
  say "---"

  return .array~of(methName, argArray, arg3)



/* ==================================================================================== */
-- this class defines one method per Java method; note: "double_Method" and "Double_Method"
-- are two different Java methods, but in ooRexx only one method is defined for it (ooRexx
-- does not distinguish the case in method names); with the help from the information supplied
-- from the Java side, it becomes possible to fetch the exact casing of the method name and
-- also the method description, if necessary; this information may be supplied in the slotDir
-- argument which is appended as the last argument on explicit RexxProxy callbacks
::Class "Rexx_Using_forwardToSuper_01"

-- just return the method name and the arguments accompanying it
::method init
  expose testRunner verbose
  use arg testRunner
  verbose=.false

  if verbose then say self~class~id"::init ..." "arg()="arg()

::attribute verbose get
::attribute verbose set
  expose verbose
  use strict arg newVale

  if newValue=.true then verbose=.true
  else verbose=.false


::method getTestRunner
  expose testRunner  verbose
  return testrunner


::method "instance_String_Method"
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::instance_String_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)

  newValue=slotDir~javaObject~instance_String_Method_forwardToSuper(value)
  return newValue


::method "static_String_Method"
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::static_String_Method ..." "arg()="arg()  "value="pp(value) "slotDir="pp(slotDir)

  newValue=slotDir~javaObject~static_String_Method_forwardToSuper(value)
  return newValue


::method dummy_Method
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::dummy_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)

  newValue=slotDir~javaObject~dummy_Method_forwardToSuper(value)
  return newValue


::method Boolean_Method
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::Boolean_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)

  newValue=slotDir~javaObject~Boolean_Method_forwardToSuper(value)
  testRunner~assertNotEquals(value, newValue, "Boolean_Method_forwardToSuper")
  return newValue

-- this method may be sendMessaged either via "double_method" or "Double_method" (note capital "D")
::method double_Method
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::double_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)
  if verbose then say self~class~id": processing" pp(slotDir~methodName) "..."

   -- uses "bsf.invokeStrict()" to allow method name to be exactly defined
  if slotDir~methodName="double_Method" then
  do
     newValue=slotDir~javaObject~bsf.invokeStrict(slotDir~methodName"_forwardToSuper", "double", value)
     testRunner~assertEquals(value/2, newValue, "double_Method_forwardToSuper")
  end
  else
  do
     newValue=slotDir~javaObject~bsf.invokeStrict(slotDir~methodName"_forwardToSuper", "Object", box("double",value))
     testRunner~assertEquals(value/2, newValue, "DDDouble_Method_forwardToSuper")
  end
  return newValue


::method String_Method
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::String_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)
  newValue=slotDir~javaObject~string_method_forwardToSuper(value)
  return newValue


::method Object_Method
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::Object_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)
  newValue=slotDir~javaObject~Object_Method_forwardToSuper(value)

  testRunner~assertEquals(value, BsfRexxProxy(newValue), "Object_Method_forwardToSuper")
  return newValue



-- no or more than one argument for the Java method:

::method void_Method
  expose testRunner  verbose
  use arg slotDir

  if verbose then say self~class~id"::void_Method ..." "arg()="arg() "slotDir="pp(slotDir) "arg(1)="pp(arg(1))

  newValue=slotDir~javaObject~void_Method_forwardToSuper -- will only return .nil to indicate no value
  return newValue


::method all_args_Method
  expose testRunner  verbose

  use arg bo1, bo2, by1, by2, ch1, ch2, sh1, sh2, in1, in2, lo1, lo2, fl1, fl2, do1, do2, slotdir

  if verbose then say self~class~id"::all_args_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)

  newValue=slotDir~javaObject~all_args_Method_forwardToSuper(bo1, bo2, by1, by2, ch1, ch2, sh1, sh2, in1, in2, lo1, lo2, fl1, fl2, do1, do2)
  return newValue


::method unknown
  expose verbose
  use arg methName, argArray, arg3=.nil

  if verbose then
  do
     say "UNKNOWN, methodName:" pp(methName) "argArray="pp(argArray) "arg3="pp(arg3)
     do i=1 to argArray~items
        o=argArray[i]
        say "   arg #" i":" pp(o)
        if o~isA(.directory) then
        do
           do idx over o
              say "      entry:" pp(idx)
           end
        end

     end
     say "---"
  end

  return .array~of(methName, argArray, arg3)



/* ==================================================================================== */
-- this class generically uses UNKNOWN to forward the message to the superclass and returns
-- that return value to the sendMessager
::Class "Rexx_Using_forwardToSuper_02"

-- just return the method name and the arguments accompanying it
::method init
  expose testRunner verbose
  use arg testRunner
  verbose=.false

  if verbose then say self~class~id"::init ..." "arg()="arg()

::attribute verbose get
::attribute verbose set
  expose verbose
  use strict arg newVale

  if newValue=.true then verbose=.true
  else verbose=.false


::method getTestRunner
  expose testRunner  verbose
  return testrunner


-- this method may be sendMessaged either via "double_method" or "Double_method" (note capital "D")
-- let us deal with it specifically, using bsf.invokeStrict() to force picking the specific method
-- in Java (remove freedom to pick any of the matching methods)
::method double_Method
  expose testRunner  verbose
  use arg value, slotDir

  if verbose then say self~class~id"::double_Method ..." "arg()="arg() "value="pp(value) "slotDir="pp(slotDir)
  if verbose then say self~class~id": processing" pp(slotDir~methodName) "..."

   -- uses "bsf.invokeStrict()" to allow method name to be exactly defined
  if slotDir~methodName="double_Method" then
  do
     newValue=slotDir~javaObject~bsf.invokeStrict(slotDir~methodName"_forwardToSuper", "double", value)
     testRunner~assertEquals(value/2, newValue, "double_Method_forwardToSuper")
  end
  else
  do
     newValue=slotDir~javaObject~bsf.invokeStrict(slotDir~methodName"_forwardToSuper", "Object", box("double",value))
     testRunner~assertEquals(value/2, newValue, "DDDouble_Method_forwardToSuper")
  end
  return newValue


-- intercept Java's constructor invocation
::method "<init>"
  expose verbose
  if verbose then
  do
     say self~class~id": <INIT>"
     if arg()>0 then
     do
        argArray=arg(1, "Array")
        do i=1 to argArray~items
           o=argArray[i]
           say "   arg #" i":" pp(o)
           if o~isA(.directory) then
           do
              do idx over o
                 say "      entry:" pp(idx)
              end
           end
        end
     end
     say "---"
  end


::method unknown
  expose verbose
  use arg methName, argArray

  items=argArray~items     -- get number of items
  slotDir=argArray[items]  -- last argument is the supplied and added "slotDir"
  targetMethodName=slotDir~methodName||"_forwardToSuper" -- build new method name
  newArgs=argArray~section(1, items-1)    -- create argument array, don't include the slotDir arg

  -- define methodName to forward to
  if verbose then
  do
     tab="  "
     say self~class~id": UNKNOWN, methodName:" pp(methName) "argArray="pp(argArray)
     say tab "targetMethodName="pp(targetMethodName)
     do i=1 to argArray~items
        o=argArray[i]
        say tab "   arg #" i":" pp(o)
        if o~isA(.directory) then
        do
           do idx over o
              say tab tab"      entry:" pp(idx) "value:" pp(o~entry(idx))
           end
        end
     end
     say "---"
  end

  forward message (targetMEthodName)   -
          to (slotDir~javaObject)      -
          arguments (newArgs)



/* ==================================================================================== */
::routine checkReturnedValues
  use arg expected, rp_arg1, rp_arg2, items, rp_arg3, listOfEntries=.nil, noArgs, oneArg

  bDebug=.false -- .true

  if bDebug then say "1:" expected~methodName~upper "<>" rp_arg1
  if expected~methodName~upper<>rp_arg1 then return .false

  if bDebug then say "2:" expected~argArrayItems "<>" items
  if expected~argArrayItems<>items then return .false

  if bDebug then say "3:" expected~slotArgument "," listOfEntries
  if expected~slotArgument, listOfEntries=.nil then return .false

  if listOfEntries<>.nil then    -- slot argument given, check it
  do
     if bDebug then dbgDir=.directory~new

     oneArg[1]=items
     slotDir=rp_arg2~sendMessage("at", oneArg)    -- get slotDir object from argArray

      -- get all entries in slotDir and save them in a set
     allIndexes=slotDir~sendMessage("allIndexes", noArgs)  -- get allIndexes
     tmpSet=.set~new
     do i=1 to allIndexes~sendMessage("items", noArgs)     -- iterate over all entries
        oneArg[1]=i              -- set index
        idx=allIndexes~sendMessage("at", oneArg)
        tmpSet~put(idx)          -- retrieve string value

        if bDebug then
        do
           oneArg[1]=idx
           dbgDir[idx]=slotDir~sendMessage("at",oneArg)
        end
     end

     if bDebug then
     do
        tmpStr=""
        do i over tmpSet
           if tmpStr="" then tmpStr=i
                        else tmpStr=tmpStr i
        end
        say "--"
        call dumpDir dbgDir
        say "---"
     end

     if bDebug then say "4:" tmpSet~items "<>" listOfEntries~items"; tmpSet="pp(tmpStr)
     if tmpSet~items <> listOfEntries~items then return .false -- mismatch, cannot be o.k.!

      -- remove the expected entries from the set
     do entry over listOfEntries       -- check whether slotDir contains all expected entries
        if bDebug then say "...entry:" pp(entry)
        tmpSet~remove(entry)           -- remove entry from the set
     end
     return (tmpSet~items=0)           -- returns .true, if all entries got removed
  end

  return .true

dumpDir: procedure
  use arg dir

  tab="09"x
  do idx over dir
     o=dir[idx]
     say "idx="pp(idx) "o="pp(o) "o~class="pp(o~class)
  end
  return



  -- display declared and expected methods in sorted order, showing missing methods on either side
::routine compareAndDump
    use arg title, declSet, expSet
    say "dumping:" pp(title)
    tab="09"x
    declArr=declSet~allIndexes~stableSortWith(.caselesscomparator~new)
    expArr =expSet~allIndexes~stableSortWith(.caselesscomparator~new)
    len=30
    i=1; dItems=declArr~items
    k=1; eItems=expArr~items

    do forever
       dL=declArr[i]                -- declared
       if dL=.nil then dL=""
       eL=expArr[k]                 -- expected
       if eL=.nil then eL=""

       if dL="", eL="" then leave

       dLUpper=dL~upper
       eLUpper=eL~upper

       if dLUpper=eLUpper then
       do
           say tab dL~left(len) el  -- both equal
           i+=1
           k+=1
       end
       else if dLUpper<eLUpper then -- show declared, no expected
       do
           say tab dL
           i+=1
       end
       else
       do
           say tab " "~left(len) el -- no declared, show expected
           k+=1
       end

       if i>dItems then             -- declared exhausted, dump expected
       do
          do k=k to eItems
             say tab " "~left(len) expArr[k]
          end
          leave
       end
       else if k>eItems then        -- dump declared, expected exhausted
       do
          do i=i to dItems
             say tab declArr[i]
          end
          leave
       end
    end
    return


--  expects a Java array of java.lang.reflect members and queries the names and returns them
::routine getSetOfNames
  use arg arr
  tmpSet=.set~new
  do el over arr
     tmpSet~put(el~getName)      -- save name in set (removes duplicates)
  end
  return tmpSet

--  expects a Java array of java.lang.reflect members and queries the names and returns them
::routine getBagOfNames
  use arg arr
  tmpBag=.Bag~new
  do el over arr
     tmpBag~put(el~getName)      -- save name in Bag (removes duplicates)
  end
  return tmpBag