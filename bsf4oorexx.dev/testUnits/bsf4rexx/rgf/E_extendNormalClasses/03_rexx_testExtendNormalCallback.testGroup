/* ==================================================================================== */
-- just return the method name and the arguments accompanying it
::class "RexxWithForwardToSuperMethods"
::method init
  expose testRunner
  use arg testRunner             -- fetch this testRunner

::method getTestRunner
  expose testRunner
  return testrunner


::method "instance_String_Method"
  use arg value, slotDir
  -- say self~class~id": instance_String_Method ..." "value="pp(value) "slotDir="pp(slotDir) pp(slotDir~allIndexes~makeString) pp(slotDir~javaObject)
  return value "instance_String_Method from ooRexx"   -- return inverted value


::method "static_String_Method"
  use arg value, slotDir
  -- say self~class~id": static_String_Method ..."   "value="pp(value) "slotDir="pp(slotDir)
  return value "static_String_Method from ooRexx"     -- return inverted value


