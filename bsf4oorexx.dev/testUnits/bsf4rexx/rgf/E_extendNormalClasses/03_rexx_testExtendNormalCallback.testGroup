::method "test_07_test_correct_methods_generated"
    ro=.SomeRexxClass~new(self)
    -- rp=BsfCreateRexxProxy(ro, , "rgf.E_extendNormalClasses.NormalTest_03")  -- create a RexxProxy representing the Java "NormalTest" interface
    -----------------------------------------------------------------------------------------
    rp=BsfCreateRexxProxy(ro)       -- create a RexxProxy (Java) object of it

    extendingClassLoader=.bsf~new("org.rexxla.bsf.engines.rexx.RexxExtendingClassLoader")
    classVersion=0                  -- use the compiled class' class version
    argArr=bsf.createArrayOf("java.lang.String", "dummy_Method", "Boolean_Method", "double_Method", -
                             "Double_Method", "String_Method", "Object_Method", "void_Method",      -
                             "all_args_Method", "getTestRunner")
    clz=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03", newName, classVersion, argArr)
    -----------------------------------------------------------------------------------------

    declaredMethods=.set~new              -- get all declared methods
    do method over clz~getDeclaredMethods()   -- iterate over all declared method objects
       declaredMethods~put(method~getName)-- put method name into set
    end

    -- define expected methods
    expectedMethods=.set~of("dummy_Method",      "dummy_Method_forwardToSuper",     -
                            "Boolean_Method",    "Boolean_Method_forwardToSuper",   -
                            "double_Method",     "double_Method_forwardToSuper",    -
                            "Double_Method",     "Double_Method_forwardToSuper",    -
                            "String_Method",     "String_Method_forwardToSuper",    -
                            "Object_Method",     "Object_Method_forwardToSuper",    -
                            "void_Method",       "void_Method_forwardToSuper",      -
                            "all_args_Method",   "all_args_Method_forwardToSuper",  -
                            "getTestRunner",     "getTestRunner_forwardToSuper",    -
                            "getDefaultHandler", "getTargetRexxProxy",              -
                            "setDefaultHandler", "setTargetRexxProxy")


    javaRuntimeVersion=.java.lang.system~getProperty("java.version")
    if javaRuntimeVersion<1.5 then     -- if running on Java 1.4, then take the synthetic method into account
       expectedMethods~put("class$")
--    call compareAndDump "declared<-->expected", declaredMethods, expectedMethods

    self~assertTrue(declaredMethods~subset(expectedMethods), "declaredMethods~subset(expectedMethods)")
    self~assertTrue(expectedMethods~subset(declaredMethods), "expectedMethods~subset(declaredMethods)")

      -- three constructors to cover
    self~assertEquals(3, clz~getDeclaredConstructors~items, "exactly three constructors")

    return



/* This test case fetches the dynamically created, extended class; it excercises the three
   constructors that expect a RexxProxy (injected) as the first argument, and then no more,
   one more or sixteen more arguments.
   The supplied values will be stored in appropriate fields and are then checked for correct
   values.
*/
::method "test_08_test_constructors_and_fields"
    ro=.SomeRexxClass~new(self)
    rpSolo=BsfCreateRexxProxy(ro)         -- needed as argument

    -----------------------------------------------------------------------------------------
    extendingClassLoader=.bsf~new("org.rexxla.bsf.engines.rexx.RexxExtendingClassLoader")
    classVersion=0                  -- use the compiled class' class version
    argArr=bsf.createArrayOf("java.lang.String", "dummy_Method", "Boolean_Method", "double_Method", -
                             "Double_Method", "String_Method", "Object_Method", "void_Method",      -
                             "all_args_Method", "getTestRunner")
    clz=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03", newName, classVersion, argArr)
    rpClz=clz
    -----------------------------------------------------------------------------------------

    constrs=rpClz~getDeclaredConstructors
    do c over constrs
       paramTypes=c~getParameterTypes
       if paramTypes~items=1 then
          constr0=c
       else if paramTypes~items=2 then
          constr1=c
       else if paramTypes~items>2 then
          constrMany=c

--       say "paramTypes~items="pp(paramTypes~items)": c~toString="pp(c~toString)
    end

      -- constructor expects a RexxProxy as very first argument
    argArray=bsf.createArrayOf("java.lang.Object", rpSolo)
    o1=constr0~newInstance(argArray)
-- say .line "o1="pp(o1) "o~fld_o1:" pp(o1~fld_o1) ".nil="pp(.nil)
    self~assertEquals(.nil, o1~fld_o1)

    val="oha, Dackel!"
    argArray=bsf.createArrayOf("java.lang.Object", rpSolo, val)
    o2=constr1~newInstance(argArray)   -- use constructor with original one argument
    self~assertEquals(val, o2~fld_o1)

      -- check whether initial field values are correct
    self~assertEquals(.true,   o2~fld_b1, "o2~fld_b1" )
    self~assertEquals(.true,   o2~fld_b2, "o2~fld_b2" )
    self~assertEquals( -1  ,   o2~fld_b3, "o2~fld_b3" )
    self~assertEquals( -1  ,   o2~fld_b4, "o2~fld_b4" )
    self~assertEquals( "a" ,   o2~fld_c1, "o2~fld_c1" )
    self~assertEquals( "a" ,   o2~fld_c2, "o2~fld_c2" )
    self~assertEquals( -1  ,   o2~fld_s1, "o2~fld_s1" )
    self~assertEquals( -1  ,   o2~fld_s2, "o2~fld_s2" )
    self~assertEquals( -1  ,   o2~fld_i1, "o2~fld_i1" )
    self~assertEquals( -1  ,   o2~fld_i2, "o2~fld_i2" )
    self~assertEquals( -1  ,   o2~fld_l1, "o2~fld_l1" )
    self~assertEquals( -1  ,   o2~fld_l2, "o2~fld_l2" )
    self~assertEquals( -1  ,   o2~fld_f1, "o2~fld_f1" )
    self~assertEquals( -1  ,   o2~fld_f2, "o2~fld_f2" )
    self~assertEquals( -1  ,   o2~fld_d1, "o2~fld_d1" )
    self~assertEquals( -1  ,   o2~fld_d2, "o2~fld_d2" )


      -- constructor expects a RexxProxy as very first argument, all primitive types need to be boxed (wrapped)
    boxFalse =box("bool", .false)
    boxByte  =box("byte", 3)
    boxChar  =box("char", "b")
    boxShort =box("short", 4)
    boxInt   =box("int", 5)
    boxLong  =box("long", 6)
    boxFloat =box("float", 7.07)
    boxDouble=box("double", 8.08)

    argArray=bsf.createArrayOf("java.lang.Object", rpSolo, -
                               boxFalse, boxFalse, -
                               boxByte,  boxByte , -
                               boxChar,  boxChar , -
                               boxShort, boxShort, -
                               boxInt,   boxInt,   -
                               boxLong,  boxLong,  -
                               boxFloat, boxFloat, -
                               boxDouble,boxDouble )
--    say "argArray~items:" pp(argArray~items)
    o3=constrMany~newInstance(argArray)   -- use constructor with original one argument

      -- check whether field values were changed correctly
    self~assertEquals(.false,  o3~fld_b1, "o2~fld_b1" )
    self~assertEquals(.false,  o3~fld_b2, "o2~fld_b2" )
    self~assertEquals( 3    ,  o3~fld_b3, "o2~fld_b3" )
    self~assertEquals( 3    ,  o3~fld_b4, "o2~fld_b4" )
    self~assertEquals( "b"  ,  o3~fld_c1, "o2~fld_c1" )
    self~assertEquals( "b"  ,  o3~fld_c2, "o2~fld_c2" )
    self~assertEquals( 4    ,  o3~fld_s1, "o2~fld_s1" )
    self~assertEquals( 4    ,  o3~fld_s2, "o2~fld_s2" )
    self~assertEquals( 5    ,  o3~fld_i1, "o2~fld_i1" )
    self~assertEquals( 5    ,  o3~fld_i2, "o2~fld_i2" )
    self~assertEquals( 6    ,  o3~fld_l1, "o2~fld_l1" )
    self~assertEquals( 6    ,  o3~fld_l2, "o2~fld_l2" )
    self~assertEquals( 7.07 ,  o3~fld_f1, "o2~fld_f1" )
    self~assertEquals( 7.07 ,  o3~fld_f2, "o2~fld_f2" )
    self~assertEquals( 8.08 ,  o3~fld_d1, "o2~fld_d1" )
    self~assertEquals( 8.08 ,  o3~fld_d2, "o2~fld_d2" )

    return


/* This test case will create dynamically created extended classes that inject a RexxProxy
   as first argument in the created methods.
*/
::method "test_09_test_maskConcreteMethods"
    -- say;say "self:" self

      -- get current's Java class version
    javaClzVersion=.java.lang.System~getProperty("java.class.version")

    extendingClassLoader=.bsf~new("org.rexxla.bsf.engines.rexx.RexxExtendingClassLoader")

    -- abstract methods for which by default methods get created

    -- define expected methods
    abstractPublicMethods=.set~of("dummy_Method",      "dummy_Method_forwardToSuper",     -
                                  "Boolean_Method",    "Boolean_Method_forwardToSuper",   -
                                  "double_Method",     "double_Method_forwardToSuper",    -
                                  "Double_Method",     "Double_Method_forwardToSuper",    -
                                  "String_Method",     "String_Method_forwardToSuper",    -
                                  "Object_Method",     "Object_Method_forwardToSuper",    -
                                  "void_Method",       "void_Method_forwardToSuper",      -
                                  "all_args_Method",   "all_args_Method_forwardToSuper",  -
                                  "getTestRunner",     "getTestRunner_forwardToSuper")

      -- method 'class$' only for Java 1.4 or earlier (class.version<49)

    defaultSyntheticMethods=.set~of(                     -
            "getDefaultHandler", "getTargetRexxProxy",   -  -- class methods
            "setDefaultHandler", "setTargetRexxProxy")      -- instance methods

      -- if masking methods, then the synthetic methods get generated depending on instance or static methods
--     forwardToSuperMethods=.set~of("convertFromStringTo$", "instance_String_Method", "forwardToSuper", "forwardToSuperStrict")   -- for instance methods
--     forwardToSuperStaticMethods=.set~of("convertFromStringTo$", "static_String_Method", "forwardToSuperStatic", "forwardToSuperStaticStrict")   -- for static methods
    forwardToSuperMethods=.set~of("instance_String_Method", "instance_String_Method_forwardToSuper")   -- for instance methods
    forwardToSuperStaticMethods=.set~of("static_String_Method", "static_String_Method_forwardToSuper")   -- for static methods

    -------------------------------------------------------------------------------------------------
    --> just create methods for public abstract methods
    testFamily="_family_01"
    do classVersion=48 to 50
       if javaClzVersion<classVersion then leave   -- oops current Java class version cannnot handle target class version anymore, skip
       newName="NormalTest_03_"classVersion"_Java_1_4" || testFamily
       argArr=bsf.createArrayOf("java.lang.String",    -
