/* This test case will create dynamically created extended classes that inject a RexxProxy
   as first argument in the created methods.
   A Rexx class is used within which the "_forwardToSuper" methods (i.e. the Java methods
   themselves get sendMessaged).
*/
::method "test_14_test_forwardToSuper"
    -- say;say "self:" self

      -- get current's Java class version
    javaClzVersion=.java.lang.System~getProperty("java.class.version")
    extendingClassLoader=.bsf~new("org.rexxla.bsf.engines.rexx.RexxExtendingClassLoader")

    ro=.Rexx_Using_forwardToSuper_01~new(self)  -- create Rexx object to forward to, supply this testRunner to it
    rp=BsfCreateRexxProxy(ro)             -- create a RexxProxy (Java) object of it

    javaClzVersion=.java.lang.System~getProperty("java.class.version")

    --> just create explicitly methods for *all* methods; empty list of methods or .nil for this argument causes this
    testFamily="_family_01"
    do classVersion=48 to 50
       if javaClzVersion<classVersion then leave   -- oops current Java class version cannnot handle target class version anymore, skip

       -- methods that get created plus their "_forwardToSuper" counterparts:
       --    "dummy_Method", "Boolean_Method", "double_Method", "Double_Method", "String_Method",
       --    "Object_Method", "void_Method", "instance_String_Method", "static_String_Method",
       --    "all_args_Method"
       newName="test_14_NormalTest_03_A_"classVersion || testFamily
       -- clz=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03", newName, classVersion, .nil)

       jArr=bsf.createJavaArray("java.lang.String",0) -- 2015-06-27, rgf
       clz=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03", newName, classVersion, jarr)

       clz~setDefaultHandler(rp) -- *MUST* be set for static methods to work, also for constructors
                                 -- that are supposed to callback to a RexxProxy




       self~assertTrue(abbrev(clz~getName, newName), "clz: test new class name for java.class.version="classVersion)
       self~assertEquals(3, clz~getDeclaredConstructors~items, "exactly three constructors for java.class.version="classVersion)

       -- create an instance of the extended class, supplying the RexxProxy object
            -- get constructor
       argArray=bsf.createArrayOf("java.lang.Class", bsf.loadClass("org.rexxla.bsf.engines.rexx.RexxProxy"))
       constructor=clz~getDeclaredConstructor(argArray)
       self~assertNotNull(constructor, "constructor<>.nil")

            -- create instance of extended Java class, supplying RexxProxy to forward to
       argArr=bsf.createArrayOf("java.lang.Object", rp)
       jo=constructor~newInstance(argArr)    -- create instance

       self~assertFalse(jo~Boolean_Method(.true))
       self~assertEquals(35/2, jo~bsf.invokeStrict('double_Method', 'double', 35))
       self~assertEquals(35/2, jo~bsf.invokeStrict('Double_Method', 'Object', box('double',35)))
       self~assertEquals("hen",                jo~String_Method("Häenschen und Gretchen"))
       self~assertEquals("1 1 -1 -1 a a -2 -2 -3 -3 -4 -4 -5.0 -5.0 -6.0 -6.0",  -
                              jo~all_args_Method(.true, box("bo",.true), -
                                                    -1, box("by", -1),   -
                                                   'a', box("ch", 'a'),  -
                                                    -2, box("sh", -2),   -
                                                    -3, box("in", -3),   -
                                                    -4, box("lo", -4),   -
                                                    -5, box("fl", -5),   -
                                                    -6, box("do", -6)    -
                                                 )                       -
                         )

-- say "jo~instance_String_method("aha")="pp(jo~instance_String_method("aha"))
       self~assertTrue(pos("_String_Method from Java", jo~instance_String_method("aha"))>0, "instance_String_method")
       self~assertTrue(pos("_String_Method from Java", jo~  static_String_method("aha"))>0, "static_String_method")


       self~assertNull(jo~void_Method)       -- 2009-09-06: no slotDir created: fixed, rgf

       o=.object~new    -- 2009-09-06, create a unique object to be used as argument
         -- the following invocations will return Java RexxProxy objects, as the Rexx methods will
         -- sendMessage Java methods that return Rexx objects wrapped up as Java RexxProxy objects;
         -- hence the need for a new routine "BsfRexxProxy()" to get at the proxied Rexx objects
       self~assertEquals(o, BsfRexxProxy(jo~Object_Method(o)))  -- 2009-09-06: exception in VM: fxied cause in BSF4Rexx, rgf
       self~assertEquals(o, BsfRexxProxy(jo~dummy_Method(o)))   -- 2009-09-06: exception in VM: fxied cause in BSF4Rexx, rgf
    end




