   -- default name starts with "XYZ_$RexxExtendClass$_", where "XYZ" is the name of the class to extend
::method "test_10_test_name_of_simple_extension"
    -- on extending regular classes the simple (single argument) version of "generateAndLoadExtendedClass"
    -- cannot be used, therefore just returning from this method
    return

    -- say;say "self:" self
    extendingClassLoader=.bsf~new("org.rexxla.bsf.engines.rexx.RexxExtendingClassLoader")
    clz2=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03")

-- call dump2 getBagOfNames(clz2~getDeclaredMethods)~allIndexes~sortWith(.CaselessComparator~new)

    self~assertTrue(abbrev(clz2~getName, "rgf.E_extendNormalClasses.NormalTest_03_$RexxExtendClass$_"), "clz2: test automatic generated new class name")


::method "test_11_creating_specific_class_version_48_Java_1_4" -- Java 1.4 (which is the minum version for BSF4Rexx 4.0)
    -- say;say "self:" self
    extendingClassLoader=.bsf~new("org.rexxla.bsf.engines.rexx.RexxExtendingClassLoader")

    -- this allows to define the name of the new class and the class version to use (50=Java6,
    -- 49=Java1.5, 48=Java1.4, 47=Java1.3, 46=Java1.2, 45.3=Java1.1.8
    clzVersion=.java.lang.System~getProperty("java.class.version")
    newName="NixiNoxi_48"
    argArr=bsf.createArrayOf("java.lang.String", "instance_String_Method")
    clz2=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03", newName, 48, argArr)
    -- say "clz2="pp(clz2) pp(clz2~toString)

    self~assertTrue(abbrev(clz2~getName, newName), "clz2: test new class name")

-- call dump2 getBagOfNames(clz2~getDeclaredMethods)~allIndexes~sortWith(.CaselessComparator~new)
    -- on Java 1.4 the synthetic method "class$" must be created
    self~assertTrue(getSetOfNames(clz2~getDeclaredMethods)~hasIndex('class$'), "'class$' must be available on Java 1.4")


::method "test_12_creating_specific_class_version_49_Java_1_5" -- Java 1.5
    -- say;say "self:" self
    extendingClassLoader=.bsf~new("org.rexxla.bsf.engines.rexx.RexxExtendingClassLoader")

    -- this allows to define the name of the new class and the class version to use (50=Java6,
    -- 49=Java1.5, 48=Java1.4, 47=Java1.3, 46=Java1.2, 45.3=Java1.1.8
    clzVersion=.java.lang.System~getProperty("java.class.version")
-- say "clzVersion="pp(clzVersion)"<49 ?" (clzVersion<49)
    if clzVersion<49 then  -- will cause a "java.lang.UnsupportedClassVersionError"
       self~expectSyntax(40.900)

    newName="NixiNoxi_49"
    -- create all methods
    -- clz2=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03", newName, 49, .nil)
    jArr=bsf.createJavaArray("java.lang.String",0) -- 2015-06-27, rgf
    clz2=extendingClassLoader~generateAndLoadExtendedClass("rgf.E_extendNormalClasses.NormalTest_03", newName, 49, jArr)

-- call dump2 getBagOfNames(clz2~getDeclaredMethods)~allIndexes~sortWith(.CaselessComparator~new)


    self~assertEquals(newName, clz2~getName)

    -- on Java 1.5 the synthetic method "class$" must NOT be created
    self~assertFalse(getSetOfNames(clz2~getDeclaredMethods)~hasIndex('class$'), "'class$' must not be available on Java 1.5")


