       expectedMethods=abstractPublicMethods~union(defaultSyntheticMethods)
       expectedMethods~putAll(forwardToSuperStaticMethods)
       if classVersion=48 then  -- if Java 1.4 or earlier, then we have the static synthetic method "class$" as well
          expectedMethods~put("class$")

-- call compareAndDump "declared<-->expected for version:" classVersion"/"testFamily, declaredMethods, expectedMethods

       self~assertTrue(declaredMethods~subset(expectedMethods), "declaredMethods~subset(expectedMethods) for java.class.version="classVersion)
