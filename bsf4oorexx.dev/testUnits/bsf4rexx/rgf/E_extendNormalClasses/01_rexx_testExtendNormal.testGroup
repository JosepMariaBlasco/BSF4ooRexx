#!/usr/bin/env rexx
/*
   name:             rexx_testAbstract1.testGroup
   author:           Rony G. Flatscher
   version:          1.0.0
   date:             2009-09-04
   changed:          2015-06-27, rgf: - changed to adapt to new semantics when creating an extended class (array
                                        of method names must not be null now, but have a capacity of 0 instead)
                     2019-08-21, rgf: - ASM got replaced, adjust tests; ProxiedJavaTool got renamed to ClassAdapter

   license:          ASF 2.0 (Apache Software License)
   purpose:          test BSF4Rexx 4.0 new proxying of Java interfaces
   needs:            compiled Java classes in this directory
   hint:             you may want to run this test under Java 1.4, 1.5 and 1.6 separately
*/


  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.testExtendNormal1)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::routine dumpPathProperty
  use arg propertyName
  tab="09"x
  say "---> Java propertyName:" pp(propertyName)
  val=.java.lang.System~getProperty(propertyName)
  if val=.nil then
  do
      say tab pp(.nil)
      return
  end
  valArr=val~makeArray(";")
  do i over valArr
      say tab pp(i)
  end

::class "testExtendNormal1" subclass ooTestCase public


::method "test_01_unknown"
   /* due to the naming in this testgroup, this method will be the first that gets
      run; as previous tests may have changed the "bsfPrefixReturnValue", make sure
      that it is set as BSF.CLS routines and methods depend on that */
    if bsf("bsfPrefixReturnValue")=0 then
       call bsf "bsfPrefixReturnValue", 1  -- make sure that it is set

    -- get an instance of the RexxExtendingClassLoader
    adapterClass=bsf.importClass("org.rexxla.bsf.engines.rexx.ClassAdapter")
    class2proxy=bsf.loadClass("rgf.E_extendNormalClasses.NormalTest")
    newName="test_01_ExtendedNormal"

      -- create dynamically an extended Java-class that implements all methods and forwards their invocation to a Rexx proxy
    jarray=bsf.createJavaArray("java.lang.String",0)  -- capacity of 0
    extClz=adapterClass~createProxiedJavaClass(class2proxy, newName, jarray, .nil)

    -- find constructor with single RexxProxy argument
    constructor=.nil
    constructors=extClz~getDeclaredConstructors
    do con over constructors
       if con~getParameterTypes~items=1 then    -- found
       do
          constructor=con
          leave
       end
    end

    ---
    ro=.RexxProxy_UsingUnknown_no_boxing~new(self) -- create Rexx object to send messages to
    rp=BsfCreateRexxProxy(ro)                     -- create RexxProxy Java object

    -- create an instance of our dynamically created extended Java class
    argArray=bsf.createArrayOf("java.lang.Object", rp)
    jForwarderObject=constructor~newInstance(argArray) -- create an instance of it

    ---
    jo=.bsf~new("rgf.E_extendNormalClasses.Test_NormalTest") -- create an instance of the Java class that uses an NormalTest object as an argument
    jo~test_NormalTest(jForwarderObject)  -- now let the Java object excercise all defined methods

    self~assertNotNull(constructor, "constructor<>.nil")


::method "test_02_unknown_box_result"
    -- get an instance of the RexxExtendingClassLoader
    adapterClass=bsf.importClass("org.rexxla.bsf.engines.rexx.ClassAdapter")
    class2proxy=bsf.loadClass("rgf.E_extendNormalClasses.NormalTest")
    newName="test_02_ExtendedNormal"

      -- create dynamically an extended Java-class that implements all methods and forwards their invocation to a Rexx proxy
    jarray=bsf.createJavaArray("java.lang.String",0)  -- capacity of 0
    extClz=adapterClass~createProxiedJavaClass(class2proxy, newName, jarray, .nil)

    -- find constructor with single RexxProxy argument
    argArray=bsf.createArrayOf("java.lang.Class", bsf.loadClass("org.rexxla.bsf.engines.rexx.RexxProxy"))
    constructor=extClz~getDeclaredConstructor(argArray)
    self~assertNotNull(constructor, "constructor<>.nil")

