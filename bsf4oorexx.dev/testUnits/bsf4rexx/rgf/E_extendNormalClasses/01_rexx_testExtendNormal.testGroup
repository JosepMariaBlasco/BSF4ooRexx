::method "test_05_test_correct_methods_generated"
    -- get an instance of the RexxExtendingClassLoader
    adapterClass=bsf.importClass("org.rexxla.bsf.engines.rexx.ClassAdapter")
    class2proxy=bsf.loadClass("rgf.E_extendNormalClasses.NormalTest")
    newName="test_04_ExtendedNormal"
      -- create dynamically an extended Java-class that implements all methods and forwards their invocation to a Rexx proxy
    jarray=bsf.createJavaArray("java.lang.String",0)  -- capacity of 0
    extClz=adapterClass~createProxiedJavaClass(class2proxy, newName, jarray, .nil)

/*
    ro=.RexxProxy_UsingUnknown~new(self)
    rp=BsfCreateRexxProxy(ro, , "NormalTest")  -- create a RexxProxy representing the Java "NormalTest" interface
    rpClz=rp~getClass                     -- get dynamically created class object
*/
    rpClz=extClz

    declaredMethods=.set~new              -- get all declared methods
    do method over rpClz~getDeclaredMethods()   -- iterate over all declared method objects
       declaredMethods~put(method~getName)-- put method name into set
    end

    -- define expected methods
    expectedMethods=.set~of("all_args_Method",    "all_args_Method_forwardToSuper",   -
                            "Boolean_Method",     "Boolean_Method_forwardToSuper",    -
                            "boolean_Method",     "boolean_Method_forwardToSuper",    -
                            "Byte_Method",        "Byte_Method_forwardToSuper",       -
                            "byte_Method",        "byte_Method_forwardToSuper",       -
                            "char_Method",        "char_Method_forwardToSuper",       -
                            "Character_Method",   "Character_Method_forwardToSuper",  -
                            "Double_Method",      "Double_Method_forwardToSuper",     -
                            "double_Method",      "double_Method_forwardToSuper",     -
                            "dummy_Method",       "dummy_Method_forwardToSuper",      -
                            "Float_Method",       "Float_Method_forwardToSuper",      -
                            "float_Method",       "float_Method_forwardToSuper",      -
                            "int_Method",         "int_Method_forwardToSuper",        -
                            "Integer_Method",     "Integer_Method_forwardToSuper",    -
                            "Long_Method",        "Long_Method_forwardToSuper",       -
                            "long_Method",        "long_Method_forwardToSuper",       -
                            "Object_Method",      "Object_Method_forwardToSuper",     -
                            "Short_Method",       "Short_Method_forwardToSuper",      -
                            "short_Method",       "short_Method_forwardToSuper",      -
                            "String_Method",      "String_Method_forwardToSuper",     -
                            "void_Method",        "void_Method_forwardToSuper",       -
                            "getDefaultHandler",  "setDefaultHandler",                -
                            "getTargetRexxProxy", "setTargetRexxProxy",               -
                            "getTestRunner",      "getTestRunner_forwardToSuper")

    javaRuntimeVersion=.java.lang.system~getProperty("java.version")
    if javaRuntimeVersion<1.5 then     -- if running on Java 1.4, then take the synthetic method into account
       expectedMethods~put("class$")
--    call compareAndDump "declared<-->expected", declaredMethods, expectedMethods

    self~assertTrue(declaredMethods~subset(expectedMethods), "declaredMethods~subset(expectedMethods)")
    self~assertTrue(expectedMethods~subset(declaredMethods), "expectedMethods~subset(declaredMethods)")

    self~assertTrue(rpClz~getDeclaredConstructors~items=2, "expecting two (default and RexxProxy-argument) constructors")
    return


  -- display declared and expected methods in sorted order, showing missing methods on either side
::routine compareAndDump
    use arg title, declSet, expSet
    say "dumping:" pp(title)
    tab="09"x
    declArr=declSet~allIndexes~stableSortWith(.caselesscomparator~new)
    expArr =expSet~allIndexes~stableSortWith(.caselesscomparator~new)
    len=30
    i=1; dItems=declArr~items
    k=1; eItems=expArr~items

    do forever
       dL=declArr[i]                -- declared
       if dL=.nil then dL=""
       eL=expArr[k]                 -- expected
       if eL=.nil then eL=""

       if dL="", eL="" then leave

       dLUpper=dL~upper
       eLUpper=eL~upper

       if dLUpper=eLUpper then
       do
           say tab dL~left(len) el  -- both equal
           i+=1
           k+=1
       end
       else if dLUpper<eLUpper then -- show declared, no expected
       do
           say tab dL
           i+=1
       end
       else
       do
           say tab " "~left(len) el -- no declared, show expected
           k+=1
       end

       if i>dItems then             -- declared exhausted, dump expected
       do
          do k=k to eItems
             say tab " "~left(len) expArr[k]
          end
          leave
       end
       else if k>eItems then        -- dump declared, expected exhausted
       do
          do i=i to dItems
             say tab declArr[i]
          end
          leave
       end
    end
    return




/* ==================================================================================== */
/* this class will serve a RexxProxy */
::class RexxProxy_UsingUnknown
::method init
  expose testRunner
  use arg testRunner

::method getTestRunner
  expose testRunner
--  call dumpArgs arg(1, 'A')
  return testRunner

::method unknown
  use arg methName, argArray

  select
     when methName="BOOLEAN_METHOD" then return box("bool",\argArray[1])   -- return inverse value

     when methName="BYTE_METHOD"    then return box("byte", argArray[1]%2)  -- return halved value

     when methName="CHAR_METHOD" | methName="CHARACTER_METHOD" then
                                    return box("char", argArray[1])       -- just return received argument

     when methName="SHORT_METHOD"   then return box("short", argArray[1]%2)  -- return halved value

     when methName="INT_METHOD" | methName="INTEGER_METHOD" then
                                    do
                                       numeric digits 10     -- account for 2**31
                                       return box('int',argArray[1]%2)  -- return halved value
                                    end

     when methName="LONG_METHOD" then
                                    do
                                       numeric digits 19     -- account for 2**31
                                       return box('long',argArray[1]%2)  -- return halved value
                                    end


     when methName="FLOAT_METHOD" | methName="DOUBLE_METHOD" | methName="OBJECT_METHOD" then
                                    return box(methName~left(2),argArray[1])       -- just return received argument


     when methName="VOID_METHOD"    then return                -- return nothing

     when methName="STRING_METHOD"  then return argArray[1]~right(3) -- return last three chars

     when methName="ALL_ARGS_METHOD" then    -- iterate over all args, create an array off it
                                      do
                                          tmpStr=""
                                          do i=1 to argArray~items-1
                                             if tmpStr="" then tmpStr=argArray[i]
                                                          else tmpStr=tmpStr argArray[i]
                                          end
                                          return tmpStr
                                      end

     when methName="<INIT>"         then return -- constructor, return nothing

     otherwise    -- error, must not arrive here !
              raise syntax 93.900 array (self~string": UNKNOWN method" pp(methName)", arrived unexpectedly in OTHERWISE !")
  end



