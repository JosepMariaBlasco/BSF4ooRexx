#!/usr/bin/env rexx
/*
   name:             rexx_testAbstract1.testGroup
   author:           Rony G. Flatscher
   version:          1.0.0
   date:             2009-08-31, 2009-09-05, 2009-09-07
   changed:          2015-06-27, rgf - adapted the test to what is deocumented for supplying an array of
                                       method names to be proxied
   changed:          2017-08-16, rgf: "test_07_test_correct_methods_generated" corrected expected number of declared
                              constructors from three to four
   license:          ASF 2.0 (Apache Software License)
   purpose:          test BSF4Rexx 4.0 new callback from Java to ooRexx
   hint:             RexxProxy objects are Java objects and allow Java to interface with Rexx objects;
                     hence this test unit needs to address RexxProxy objects in a Java fashion, using
                     the RexxProxy method "sendMessage(String methodName, Object[] args)"; any Rexx object
                     that gets returned will be wrapped up as a RexxProxy as well
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.testAbstractCallback1)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS


::class "testAbstractCallback1" subclass ooTestCase public


::method "test_01_plain_sendMessage_no_args"
   /* due to the naming in this testgroup, this method will be the first that gets
      run; as previous tests may have changed the "bsfPrefixReturnValue", make sure
      that it is set as BSF.CLS routines and methods depend on that */
    if bsf("bsfPrefixReturnValue")=0 then
       call bsf "bsfPrefixReturnValue", 1  -- make sure that it is set

    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro, ,"rgf.D_abstractClasses.AbstractTest")  -- create Java RexxProxy object, being used as an AbstractTest object
    listOfEntries=.list~of("METHODNAME", "METHODDESCRIPTOR", "JAVAOBJECT")

    expected=.directory~new
    expected~methodName="dummy_Method"
    expected~argArrayItems=1+1         -- one for argument, one for slotArgument
    expected~slotArgument=.true

    rp_arr=rpo~dummy_Method("oha1")     -- sendMessage interface method, fetch result from Rexx object's unknown

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
      -- get UNKNOWN's arguments
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, listOfEntries, noArgs, oneArg))


