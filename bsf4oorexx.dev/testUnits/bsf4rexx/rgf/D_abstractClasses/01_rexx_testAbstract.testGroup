::method Character_Method        -- roundtrip, return received value
  use arg value
  return value

::method Short_Method            -- return half the value
  use arg value
  return value%2

::method int_Method              -- return half the value
  use arg value
  numeric digits 10              -- account for 2**31
  return value%2

::method Integer_Method          -- return half the value
  use arg value
  numeric digits 10              -- account for 2**31
  return value%2

::method long_Method             -- return half the value
  use arg value
  numeric digits 19              -- account for 2**63
  return value%2

::method float_Method
  use arg value
  return value                   -- just return received argument

::method double_Method
  use arg value
  return value                   -- just return received argument

::method object_Method
  use arg value
  return value                   -- just return received argument

::method void_Method             -- return nothing
  use arg value
  return

::method string_Method           -- return the last three characters
  use arg value
  return value~right(3)

::method all_args_Method         -- iterate over all args, create an array off it

  tmpStr=""
  do i=1 to arg()-1              -- do not process appended slot argument
     if tmpStr="" then tmpStr=arg(i)
                  else tmpStr=tmpStr arg(i)
  end
  return tmpStr


::method unknown
  use arg methName, argArray
  raise syntax 93.900 array (self~string": UNKNOWN method" pp(methName)", arrived unexpectedly in OTHERWISE !")

::routine dumpAbstractImplmentation
  use arg rp

  say "rp:" pp(rp)
  rpClz=rp~getClass
  say "rp~getClass:" pp(rpClz)

  say "dumping methods:"
  meths=rpClz~getMethods
  do i=1 to meths~items
     say "    " "#" i":" pp(meths[i]~toString)
  end
  say "----"

  say "dumping declared methods:"
  meths=rpClz~getDeclaredMethods
  do i=1 to meths~items
     say "    " "#" i":" pp(meths[i]~toString)
  end
  say "----"


