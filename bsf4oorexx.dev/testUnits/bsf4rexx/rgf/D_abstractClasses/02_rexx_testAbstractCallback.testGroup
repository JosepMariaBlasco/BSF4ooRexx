::method "test_04_sendMessage_with_userData_no_args"
    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro, "max","rgf.D_abstractClasses.AbstractTest")  -- create Java RexxProxy object, being used as an AbstractTest object
    listOfEntries=.list~of("USERDATA", "METHODNAME", "METHODDESCRIPTOR", "JAVAOBJECT")

    expected=.directory~new
    expected~methodName="dummy_Method"
    expected~argArrayItems=1+1            -- plus appended slotDir argument!
    expected~slotArgument=.true

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
    rp_arr=rpo~dummy_Method("oha4")     -- sendMessage interface method, fetch result from Rexx object's unknown

      -- get UNKNOWN's arguments
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, listOfEntries, noArgs, oneArg))


