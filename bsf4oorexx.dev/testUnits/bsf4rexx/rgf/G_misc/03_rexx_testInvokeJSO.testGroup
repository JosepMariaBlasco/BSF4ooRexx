    self~assertTrue(valJSO_01~toString=valJSO_02~toString)
    self~assertTrue(valJSO_01~toString=valJSO_03~toString)
    self~assertTrue(valJSO_01~toString==valJSO_02~toString)
    self~assertTrue(valJSO_01~toString==valJSO_03~toString)


::method "test_03_utf8_string"
      -- the following string contains chars > "7F"x for which Unicode chars will be needed
    str="-aäoOuÜ-szß-AÄOÖUÜ-"
    bDebug= .false -- .true

      -- will use the current codepage setting
    str_01a=.java.lang.String~new(str)
    str_02a=.bsf~new("java.lang.String",str)

if bDebug=.true then
do
   say "str_01a:" pp(str_01a) pp(str_01a~toString)
   say "str_02a:" pp(str_02a) pp(str_02a~toString)
end

    self~assertTrue(str_01a~bsf.isA("java.lang.String"))
    self~assertTrue(str_02a~bsf.isA("java.lang.String"))
    self~assertEquals(str_01a~toString, str_02a~toString)


      -- returns a UTF-8 string using the local codepage for encoding
   str_01b=bsf.stringToUtf8(str_01a)
   str_02b=bsf.stringToUtf8(str_02a)

if bDebug=.true then
do
   say "str_01b:" pp(str_01b)
   say "str_02b:" pp(str_02b)
end

    self~assertEquals(str_01b, str_02b)


      -- returns a string encoded to the local codepage
   str_01c=bsf.utf8ToString(str_01b)
   str_02c=bsf.utf8ToString(str_02b)

if bDebug=.true then
do
   say "str_01c:" pp(str_01c)
   say "str_02c:" pp(str_02c)
end

      -- return the Java (UTF-8) string as a JSO (a reference to java.lang.String)
   str_01d=bsf.utf8stringAsJSO(str_01b)
   str_02d=bsf.utf8stringAsJSO(str_02b)

if bDebug=.true then
do
   say "str_01d:" pp(str_01d) pp(str_01d~toString)
   say "str_02d:" pp(str_02d) pp(str_02d~toString)
end

    self~assertTrue(str_01d~bsf.isA("java.lang.String"))
    self~assertTrue(str_02d~bsf.isA("java.lang.String"))

    self~assertEquals(str_01a~toString, str_01d~toString)
    self~assertEquals(str_02a~toString, str_02d~toString)
    self~assertEquals(str_01a~toString, str_02d~toString)

      -- turn JSO into a UTF-8 string
   str_01e=bsf.JSOasUTF8string(str_01d)
   str_02e=bsf.JSOasUTF8string(str_02d)

if bDebug=.true then
do
   say "str_01e:" pp(str_01e)
   say "str_02e:" pp(str_02e)
end

    self~assertEquals(str_01e, str_02e)
    self~assertEquals(str_01b, str_01e)
    self~assertEquals(str_02b, str_02e)



::method "test_04_static_utf8-umlauts_field"
    jclz=bsf.import("rgf.G_misc.o3_Test_JSO")
    jo  =jclz~new             -- create a Java instance

    fieldname="staticStringWithUTF8umlauts"

    val_01   =jclz~bsf.getStaticValue(jclz,fieldName)    -- Rexx string
    val_02   =jclz~send(fieldName)                       -- Rexx string
    val_03   =jo~send(fieldName)                         -- Rexx string
    valJSO_01=jclz~bsf.getStaticValueJSO(jclz,fieldName) -- a reference to a Java String object
    valJSO_02=bsf.getStaticValueJSO(jclz,fieldName)      -- a reference to a Java String object
    valJSO_03=bsf.getConstantJSO(jclz,fieldName)         -- a reference to a Java String object

    self~assertTrue(jo~bsf.isA("java.lang.Object"))
    self~assertTrue(jo~bsf.isA("rgf.G_misc.o3_Test_JSO"))
    self~assertFalse(jo~bsf.isA("java.lang.String"))

    self~assertTrue(valJSO_01~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_02~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_03~bsf.isA("java.lang.String"))

    self~assertTrue(valJSO_01~equals(valJSO_02))
    self~assertTrue(valJSO_01~equals(valJSO_03))
    self~assertTrue(valJSO_02~equals(valJSO_03))

    self~assertSame(val_01, valJSO_01~toString)
    self~assertSame(val_02, valJSO_02~toString)
    self~assertSame(val_03, valJSO_03~toString)


    --- now test encodings (explicit/implicit)
      -- define test string value in Windows (Austrian/German Windows XP): "Cp1252"
    encoding="Cp1252"      -- Windows encoding, Western Europe
    strVal="auml-ä-ouml-ö-uuml-ü-szlig-ß-Auml-Ä-Ouml-Ö-Uuml-Ü-"   -- glyphs only show correctly, if "Cp1252" is used

    strValJSO=BsfRawBytes(valJSO_01~getBytes(encoding))  -- turn "UTF-8" into "Cp1252"
    self~assertSame(strVal, strValJSO)                   -- now compare "Cp1252" chars

    strValAsUtf8=.java.lang.String~new(BSFRawBytes(strVal),encoding) -- turn "Cp1252" into "UTF-8"
    self~assertTrue(strValAsUtf8~equals(valJSO_01))      -- now compare "UTF-8" chars



::method "test_05_static_utf8-icons_field"
    jclz=bsf.import("rgf.G_misc.o3_Test_JSO")
    jo  =jclz~new             -- create a Java instance

    fieldname="staticStringWithUTF8icons"

    val_01   =jclz~bsf.getStaticValue(jclz,fieldName)    -- Rexx string
    val_02   =jclz~send(fieldName)                       -- Rexx string
    val_03   =jo~send(fieldName)                         -- Rexx string
    valJSO_01=jclz~bsf.getStaticValueJSO(jclz,fieldName) -- a reference to a Java String object
    valJSO_02=bsf.getStaticValueJSO(jclz,fieldName)      -- a reference to a Java String object
    valJSO_03=bsf.getConstantJSO(jclz,fieldName)         -- a reference to a Java String object

    self~assertTrue(jo~bsf.isA("java.lang.Object"))
    self~assertTrue(jo~bsf.isA("rgf.G_misc.o3_Test_JSO"))
    self~assertFalse(jo~bsf.isA("java.lang.String"))

    self~assertTrue(valJSO_01~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_02~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_03~bsf.isA("java.lang.String"))

    self~assertTrue(valJSO_01~equals(valJSO_02))
    self~assertTrue(valJSO_01~equals(valJSO_03))
    self~assertTrue(valJSO_02~equals(valJSO_03))

    self~assertSame(val_01, valJSO_01~toString)
    self~assertSame(val_02, valJSO_02~toString)
    self~assertSame(val_03, valJSO_03~toString)