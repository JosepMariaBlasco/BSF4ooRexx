#!/usr/bin/env rexx
/*
   name:             03_rexx_testInvokeJSO.testGroup
   author:           Rony G. Flatscher
   version:          1.0.0
   date:             2015-06-29
   license:          ASF 2.0 (Apache Software License)
   purpose:          test BSF4ooRexx functions and methods that return a reference to a Java String object ("JSO")
                     instead of transparently turning them into a Rexx string 
*/

  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.testInvokeJSO)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS


::class "testInvokeJSO" subclass ooTestCase public

::method setup
   /* Unit tests for the older interface may have turned off the prefixing of the return values, if so, restore it. */
  if bsf("bsfPrefixReturnValue")=0 then
     call bsf "bsfPrefixReturnValue", 1  -- make sure that it is set

::method "test_01_get_static_string_field"
    jclz=bsf.import("rgf.G_misc.o3_Test_JSO")
    jo  =jclz~new             -- create a Java instance

    fieldname="staticString"

    val_01   =jclz~bsf.getStaticValue(jclz,fieldName)    -- Rexx string
    val_02   =jclz~send(fieldName)                       -- Rexx string
    val_03   =jo~send(fieldName)                         -- Rexx string
    valJSO_01=jclz~bsf.getStaticValueJSO(jclz,fieldName) -- a reference to a Java String object
    valJSO_02=bsf.getStaticValueJSO(jclz,fieldName)      -- a reference to a Java String object
    valJSO_03=bsf.getConstantJSO(jclz,fieldName)         -- a reference to a Java String object

    self~assertTrue(jo~bsf.isA("java.lang.Object"))
    self~assertTrue(jo~bsf.isA("rgf.G_misc.o3_Test_JSO"))
    self~assertFalse(jo~bsf.isA("java.lang.String"))

    self~assertEquals(val_01, "This is a static Java string.")
    self~assertEquals(val_02, "This is a static Java string.")
    self~assertEquals(val_03, "This is a static Java string.")

    self~assertTrue(val_01=val_02)
    self~assertTrue(val_01==val_02)
    self~assertTrue(val_01==val_03)

    self~assertTrue(valJSO_01~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_02~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_03~bsf.isA("java.lang.String"))

    self~assertTrue(valJSO_01~objectName~pos("java.lang.String@")>0)
    self~assertTrue(valJSO_02~objectName~pos("java.lang.String@")>0)
    self~assertTrue(valJSO_03~objectName~pos("java.lang.String@")>0)

    self~assertTrue(valJSO_01~toString=val_01)
    self~assertTrue(valJSO_01~toString=val_02)

    self~assertTrue(valJSO_01~toString=valJSO_02~toString)
    self~assertTrue(valJSO_01~toString=valJSO_03~toString)
    self~assertTrue(valJSO_01~toString==valJSO_02~toString)
    self~assertTrue(valJSO_01~toString==valJSO_03~toString)


::method "test_01_get_static_string_field_via_messages"
    jclz=bsf.import("rgf.G_misc.o3_Test_JSO")
    jo  =jclz~new             -- create a Java instance

    fieldname="staticString"

    val_01   =jclz~getStaticString                       -- Rexx string
    val_02   =jclz~send(fieldName)                       -- Rexx string
    val_03   =jo~getStaticString                         -- Rexx string
    valJSO_01=jclz~bsf.getStaticValueJSO(jclz,fieldName) -- a reference to a Java String object
    valJSO_02=jclz~bsf.invokeJSO(fieldName)              -- a reference to a Java String object
    valJSO_03=jo  ~bsf.invokeJSO(fieldName)              -- a reference to a Java String object

    self~assertTrue(jo~bsf.isA("java.lang.Object"))
    self~assertTrue(jo~bsf.isA("rgf.G_misc.o3_Test_JSO"))
    self~assertFalse(jo~bsf.isA("java.lang.String"))

    self~assertEquals(val_01, "This is a static Java string.")
    self~assertEquals(val_02, "This is a static Java string.")
    self~assertEquals(val_03, "This is a static Java string.")

    self~assertTrue(val_01=val_02)
    self~assertTrue(val_01==val_02)
    self~assertTrue(val_01==val_03)

    self~assertTrue(valJSO_01~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_02~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_03~bsf.isA("java.lang.String"))

    self~assertTrue(valJSO_01~objectName~pos("java.lang.String@")>0)
    self~assertTrue(valJSO_02~objectName~pos("java.lang.String@")>0)
    self~assertTrue(valJSO_03~objectName~pos("java.lang.String@")>0)

    self~assertTrue(valJSO_01~toString=val_01)
    self~assertTrue(valJSO_01~toString=val_02)

    self~assertTrue(valJSO_01~toString=valJSO_02~toString)
    self~assertTrue(valJSO_01~toString=valJSO_03~toString)
    self~assertTrue(valJSO_01~toString==valJSO_02~toString)
    self~assertTrue(valJSO_01~toString==valJSO_03~toString)


::method "test_03_get_instance_string_field"

    jclz=bsf.import("rgf.G_misc.o3_Test_JSO")
    jo  =jclz~new             -- create a Java instance

    fieldname="instanceString"

    val_01   =jo~bsf.getFieldValue(fieldName)
    val_02   =jo~bsf.getFieldValueStrict(fieldName)
    val_03   =jo~send(fieldName)                         -- Rexx string

    valJSO_01=jo~bsf.getFieldValueJSO(fieldName)         -- a reference to a Java String object
    valJSO_02=jo~bsf.getPropertyValueJSO(fieldName)                -- a reference to a Java String object
    valJSO_03=jo~bsf.getFieldValueStrictJSO(fieldName)   -- a reference to a Java String object

    self~assertTrue(jo~bsf.isA("java.lang.Object"))
    self~assertTrue(jo~bsf.isA("rgf.G_misc.o3_Test_JSO"))
    self~assertFalse(jo~bsf.isA("java.lang.String"))

    self~assertEquals(val_01, "This is an instance Java string.")
    self~assertEquals(val_02, "This is an instance Java string.")
    self~assertEquals(val_03, "This is an instance Java string.")

    self~assertTrue(val_01=val_02)
    self~assertTrue(val_01==val_02)
    self~assertTrue(val_01==val_03)

    self~assertTrue(valJSO_01~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_02~bsf.isA("java.lang.String"))
    self~assertTrue(valJSO_03~bsf.isA("java.lang.String"))

    self~assertTrue(valJSO_01~objectName~pos("java.lang.String@")>0)
    self~assertTrue(valJSO_02~objectName~pos("java.lang.String@")>0)
    self~assertTrue(valJSO_03~objectName~pos("java.lang.String@")>0)

    self~assertTrue(valJSO_01~toString=val_01)
    self~assertTrue(valJSO_01~toString=val_02)

    self~assertTrue(valJSO_01~toString=valJSO_02~toString)
    self~assertTrue(valJSO_01~toString=valJSO_03~toString)
    self~assertTrue(valJSO_01~toString==valJSO_02~toString)
    self~assertTrue(valJSO_01~toString==valJSO_03~toString)

