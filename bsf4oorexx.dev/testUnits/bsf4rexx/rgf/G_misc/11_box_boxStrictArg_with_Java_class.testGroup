::method "test_17a_fail_static_double"
  clzTest=bsf.import("rgf.G_misc.o11_TestStrictArgs",.nil)

  boxedValue=box.strictArg("double",987123.456, .true)   -- primitive variant (should work in this case)
  clzTest~bsf.setFieldValueStrict('static_double', boxedValue)
  self~assertTrue(.true)         -- increase assertion count as assignment took place

  self~expectSyntax(40.900)
  boxedValue=box.strictArg("double",-987123.456, .false)   -- wrapper variant (should create syntax exception in this case)
  clzTest~bsf.setFieldValueStrict('static_double', boxedValue)


::method "test_17b_fail_static_Double"
