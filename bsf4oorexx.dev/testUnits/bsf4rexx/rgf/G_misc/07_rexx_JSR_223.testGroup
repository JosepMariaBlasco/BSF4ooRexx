#!/usr/bin/env rexx
/*
   name:             07_rexx_JSR_223.testGroup
   author:           Rony G. Flatscher
   version:          1.0.1
   date:             2015-07-05, 2015-07-07, 2021-01-11
   changed:          2017-08-16, rgf:
                        - adjust for new formatting of Rexx code when produced by the RexxEngine factory
                        - adjust scope names which are turned into a stem by BsfContextVariables()
                        - adjust count of context variables (scope entries starting with 'JAVAX.' will be one stem context variable)
                        - remove usage of bsf.ScriptContext2rexx() use .JSR223 class method "ScriptContext2RexxDir" instead
                     2020-01-20, rgf:
                        - adjust for the change in getOutputStatement() which now uses .output~charout() instead of SAY
                        - adjust for the change in returning "rexx" instead of "Rexx" in the extension list
                     2021-01-11, rgf: - adjust for change in getOutputStatement() which now uses "SAY" again
                                      - adjust for change in using unqualified ".RexxScriptEngine@"


   license:          ASF 2.0 (Apache Software License)
   purpose:          test JSR-223 (javax.script introduced with Java 6) support

*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.testJSR223)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS


::class "testJSR223" subclass ooTestCase public

::method setup
   /* Unit tests for the older interface may have turned off the prefixing of the return values, if so, restore it. */
  if bsf("bsfPrefixReturnValue")=0 then
     call bsf "bsfPrefixReturnValue", 1  -- make sure that it is set


::method tearDown
  call bsf.redirectTo "Rexx"     -- make sure that redirection is to the plain ooRexx objects again


::method "test_01_Rexx_Script_Engine_Factory"
  sem=.bsf~new("javax.script.ScriptEngineManager")
  re =sem~getEngineByName("ooRexx")
  self~assertNotNull(re)

  ref=re~getFactory
  self~assertNotNull(ref)


  self~assertSame("Open Object Rexx (ooRexx)", ref~getEngineName)
  self~assertTrue(ref~getEngineVersion>100)

   -- initially (201507) the following extensions got defined
  soen=.set~of("rex", "rexx", "orx", "cls", "rxj", "rexxj", "jrexx", "rxo" )
  jsoen=ref~getExtensions~iterator
  do while jsoen~hasNext
     soen~remove(jsoen~next)
  end
  self~assertTrue(soen~items=0)

  self~assertSame("ooRexx", ref~getLanguageName )

  self~assertTrue(ref~getLanguageVersion>"4.1")

  self~assertSame("rexx", ref~getName)

  jArrStr=bsf.createJavaArray(.java.lang.String,0)
  self~assertEquals("m~hi", ref~getMethodCallSyntax("m","hi", jArrStr))

  jArrStr=bsf.createJavaArrayOf(.java.lang.String,".nil")
  self~assertEquals("m~hi(.nil)", ref~getMethodCallSyntax("m","hi", jArrStr))

  jArrStr=bsf.createJavaArray(.java.lang.String,1)
  self~assertEquals("m~hi(.nil)", ref~getMethodCallSyntax("m","hi", jArrStr))

  jArrStr=bsf.createJavaArrayOf(.java.lang.String,"arg1")
  self~assertEquals("m~hi(arg1)", ref~getMethodCallSyntax("m","hi", jArrStr))

  jArrStr=bsf.createJavaArrayOf(.java.lang.String,"arg1","arg2")
  self~assertEquals("m~hi(arg1,arg2)", ref~getMethodCallSyntax("m","hi", jArrStr))


  jArrStr=bsf.createJavaArray(.java.lang.String,2)
  jArrStr[1]="arg1"
  self~assertEquals("m~hi(arg1,.nil)", ref~getMethodCallSyntax("m","hi", jArrStr))

  jArrStr=bsf.createJavaArray(.java.lang.String,2)
  jArrStr[2]="arg2"
  self~assertEquals("m~hi(.nil,arg2)", ref~getMethodCallSyntax("m","hi", jArrStr))

  jArrStr[2]=.nil
  self~assertEquals("m~hi(.nil,.nil)", ref~getMethodCallSyntax("m","hi", jArrStr))


   -- initially (201507) the following mimetypes got defined
  soen=.set~of("text/x-rexx", "text/x-rexx-java", "text/x-rexx-java-ooo")
  jsoen=ref~getMimeTypes~iterator
  do while jsoen~hasNext
     soen~remove(jsoen~next)
  end
  self~assertTrue(soen~items=0)


   -- initially (201507) the following engine names got defined
  soen=.set~of("rexx", "Rexx", "oorexx", "ooRexx", "orexx", "oRexx")
  jsoen=ref~getNames~iterator
  do while jsoen~hasNext
     soen~remove(jsoen~next)
  end
  self~assertTrue(soen~items=0)

/*
  self~assertEquals(".output~charOut(""hi"")", ref~getOutputStatement('hi'))
  self~assertEquals('.output~charOut("""hi""")', ref~getOutputStatement('"hi"'))
  self~assertEquals(".output~charOut(""'hi'"")", ref~getOutputStatement("'hi'"))
*/
  self~assertEquals("SAY ""hi""", ref~getOutputStatement('hi'))
  self~assertEquals('SAY """hi"""', ref~getOutputStatement('"hi"'))
  self~assertEquals("SAY ""'hi'""", ref~getOutputStatement("'hi'"))

  self~assertEquals("MULTITHREADED", ref~getParameter("THREADING"))

  call check self, ref, .nil
  call check self, ref, .array~new
  call check self, ref, .array~of(.nil)
  call check self, ref, .array~of("say 'hi'")
  call check self, ref, .array~of('say "hi"')
  call check self, ref, .array~of('say "hi"', .nil, "say 'holla'")
  call check self, ref, .array~of('say "hi"', .nil, "", "say 'holla'")
  call check self, ref, .array~of('say "hi"', .nil, "", " ", "say 'holla'")


  reName="org.rexxla.bsf.engines.rexx.RexxScriptEngine@"
  self~assertTrue(ref~getScriptEngine~objectName~abbrev(reName))    -- get a new RexxScriptEngine
  return



check: procedure      -- routine to carry out program creation and checking correctness
  use arg self, ref, strArr=.nil

--  refName="org.rexxla.bsf.engines.rexx.jsr223.RexxScriptEngineFactory@"
  refName=".RexxScriptEngineFactory@"  -- adjusted
  leadin ="/* --> begin of" refName
  leadout="/* <-- end   of" refName

  bThreeLiner=(strArr=.nil)
  if strArr<>.nil, strArr~items=0 then
  do
     bThreeLiner=.true
     jStrArr=bsf.createJavaArray(.java.lang.String,0) -- create Java array of capacity 0
  end

  if bThreeLiner=.true then -- strArr=.nil || strArr~items=0 then      -- .nil, no code at all!
  do
      if strArr=.nil then
         strPgmArr=ref~getProgram(strArr)~makeArray
      else
         strPgmArr=ref~getProgram(jStrArr)~makeArray

      self~assertTrue(strPgmArr~items=3)

      self~assertTrue(strPgmArr[1]~abbrev(leadIn))

      if strArr=.nil then
         self~assertEquals("09"x || '/* -- no statements supplied (received "null") */;', strPgmArr[2])
      else
      do
         self~assertEquals("09"x || '/* -- no statements supplied (received an empty array) */;', strPgmArr[2])
      end

      self~assertTrue(strPgmArr[3]~abbrev(leadOut))
      return
  end

  items=strArr~items
  jStrArr=bsf.createJavaArray(.java.lang.String,items) -- create Java array
  do i=1 to items
     jStrArr[i]=strArr[i]
  end


  strPgmArr=ref~getProgram(jStrArr)~makeArray
  self~assertTrue(strPgmArr[1]~abbrev(leadIn))
  do i=2 to items+1
     if strArr[i-1]=.nil then
        self~assertEquals("09"x || "-- 'null' received!;", strPgmArr[i])
     else
        self~assertEquals("09"x || strArr[i-1]";", strPgmArr[i])
  end
  self~assertTrue(strPgmArr[i]~abbrev(leadOut))
  return



::method "test_02_Rexx_Script_Engine"
  sem=.bsf~new("javax.script.ScriptEngineManager")
  re =sem~getEngineByName("ooRexx")
  self~assertNotNull(re)

  rexxCode="return 1+1"
  self~assertEquals(2, re~eval(rexxCode))
  cs=re~getCurrentScript
  self~assertEquals(rexxCode, cs~getScriptSource)
  self~assertEquals(2, re~eval(rexxCode))
  cs2=re~getCurrentScript
  self~assertEquals(cs~objectname,cs2~objectname)

  self~assertEquals("!ih", re~eval("return reverse('hi!')"))
  cs2=re~getCurrentScript
  self~assertNotEquals(cs~objectname,cs3~objectname)

  -- test Invocable
  nl=.endofline
  rexxCode="return .test~new     -- return Rexx-object           ;" nl -
           "                                                     ;" nl -
           "::requires BSF.CLS   -- get Java camouflaging support;" nl -
           "                                                     ;" nl -
           "::class test                                         ;" nl -
           "::method oneString                                   ;" nl -
           "  return 'ONESTRING'                                 ;" nl -
           "::method two                                         ;" nl -
           "  return 2                                           ;" nl -
           "::method adder                                       ;" nl -
           "  parse arg a1, a2                                   ;" nl -
           "  return a1+a2                                       ;" nl -
           "::method run                                         ;" nl -
           "  say 'run...'                                       ;" nl -
           "                                                     ;" nl -
           "::method getString                                   ;" nl -
           "  return 'getString'                                 ;" nl -
           "::method multiply                                    ;" nl -
           "  parse arg a1, a2                                   ;" nl -
           "  return a1*a2                                       ;" nl -
           "                                                     ;" nl -
           "::routine getString public                           ;" nl -
           "  return 'routine: getString'                        ;" nl -
           "::routine multiply  public                           ;" nl -
           "  return arg(1)*arg(2)/3 -- to distinguish from meth ;"

  obj=re~eval(rexxCode)    -- fetch Rexx object as a RexxProxy
  self~assertEquals("ONESTRING", obj~sendMessage0("oneString"))
  self~assertEquals("2", obj~sendMessage0("two"))
  self~assertEquals("3", obj~sendMessage2("adder", 1, 2))

  jarr=bsf.createJavaArray("java.lang.Object",0)
  self~assertEquals("ONESTRING", re~invokeMethod(obj, "onestring", jarr))
  self~assertEquals("2", re~invokeMethod(obj, "two", jarr))

  jarr=bsf.createJavaArrayOf("java.lang.Object",1,2)
  self~assertEquals("3", re~invokeMethod(obj, "adder", jarr))

  iclz=bsf.loadClass("rgf.G_misc.o7_Test_JSR223")

      -- use 'obj' methods to carry out the method invocations
  jobj=re~getInterface(obj, iclz)
  self~assertEquals("getString", jobj~getString)
  self~assertEquals(12, jobj~multiply(3,4))

      -- execute public routines
  jarr=bsf.createJavaArrayOf("java.lang.Object", 9, 5)
  self~assertEquals(15, re~invokeFunction("multiply", jarr))   -- public routine intentionally returns 1/3 of the value
  self~assertEquals("routine: getString", re~invokeFunction("getString", .nil))  -- no args

      -- use public routines to carry out the method invocations
  jobj2=re~getInterface(iclz)    -- this uses the public routines
  self~assertEquals("routine: getString", jobj2~getString)
  self~assertEquals(10, jobj2~multiply(6,5))    -- public routine intentionally returns 1/3 of the value


::method "test_03_Rexx__Script_Context"
  sem=.bsf~new("javax.script.ScriptEngineManager")
  re =sem~getEngineByName("ooRexx")
  self~assertNotNull(re)

  sc=re~getContext
--  say "sc:" pp(sc)

  self~assertTrue(sc~objectname~abbrev("javax.script.SimpleScriptContext@"))
  engineScope=sc~engine_scope       -- "100"
  globalScope=sc~global_scope       -- "200"

  self~assertEquals(2, sc~getScopes~size) -- only two scopes available

  gb=sc~getBindings(globalScope)
  self~assertTrue(gb~objectname~abbrev("javax.script.SimpleBindings@"))
  self~assertEquals(0,gb~size)

  eb=sc~getBindings(engineScope)
  self~assertTrue(eb~objectname~abbrev("javax.script.SimpleBindings@"))
  self~assertEquals(5,eb~size)


   -- initially (201507) the following mimetypes got defined
  soen=.set~of("javax.script.engine_version", "javax.script.language", "javax.script.name", -
               "javax.script.language_version", "javax.script.engine")
  ks=eb~keySet    -- get all keys

  jsoen=ks~iterator
  do while jsoen~hasNext
     soen~remove(jsoen~next)
  end
  self~assertTrue(soen~items=0)

  nl=.endOfLine
  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self)) -- supply this object for assertions in the Rexx program
  eb~put(re~argv,jargs)    -- add to engine scope's bindings

bDummyStuff=.true
bDummyStuff=.false
if bDummyStuff=.true then
do
   say "1) eb="pp(eb) "eb~class="pp(eb~class) "eb~getClass="pp(eb~getClass) "eb~getClass~toString="pp(eb~getClass~toString)
   say "1) gb="pp(gb) "gb~class="pp(gb~class) "gb~getClass="pp(gb~getClass) "gb~getClass~toString="pp(gb~getClass~toString)
end

  rexxCode="call BsfContextVariables 'set', .jsr223~scriptContext2RexxDir(arg(arg())~scriptContext)                ;" nl -
           "cdir=BsfContextVariables()  -- get context variables should be all from scriptContext!                 ;" nl -
           "sdir=.jsr223~scriptContext2RexxDir(arg(arg())~scriptContext) -- a Rexx directory of the scriptContext entries ;" nl -
           "                                                                                                       ;" nl -
           "/* ---                                                                                                 ;" nl -
           "call 'rgf_util2.rex'                                                                                   ;" nl -
           "call dump2 cdir, 'context-vars'                                                                        ;" nl -
           "call dump2 sdir, 'scriptContext'                                                                       ;" nl -
           "say 'JAVAX.SCRIPT.LANGUAGE_VERSION:' pp(JAVAX.SCRIPT.LANGUAGE_VERSION)                                 ;" nl -
           "--- */                                                                                                 ;" nl -
           "                                                                                                       ;" nl -
           "use arg jobj                                                                                           ;" nl -
           "                                                                                                       ;" nl -
           "jobj~assertEquals(2,arg())                                                                             ;" nl -
           "jobj~assertEquals(6,sdir~items)                                                                        ;" nl -
           "jobj~assertEquals(2,cdir~items,'context variables')  /* 'RESULT', 'JAVAX.' */                          ;" nl -
           "                                                                                                       ;" nl -
           "::requires BSF.CLS                                                                                     ;" nl -
           "                                                                                                       ;" nl -
           "                                                                                                       ;"
  re~eval(rexxCode)

-- the following must be executed, otherwise ooRexx 4.2.0 will later use objectname as value :( ! (rgf, 20150707)
if bDummyStuff=.true then
do
   say "2) eb="pp(eb) "eb~class="pp(eb~class) "eb~getClass="pp(eb~getClass) "eb~getClass~toString="pp(eb~getClass~toString)
   say "2) gb="pp(gb) "gb~class="pp(gb~class) "gb~getClass="pp(gb~getClass) "gb~getClass~toString="pp(gb~getClass~toString)
end


  --------------------------------------------------------
  --- now test global and engine scope together, separately, list of numbered scopes intermixed with symbolic named scopes ('g', 'e')

   -- 3 entries in global:
  gb~put("RGF_GLOBAL_TIME", .datetime~new~string)
  gb~put("RGF_GLOBAL"     , "global")
  gb~put("RGF"            , "global")     -- entry in global as well as in engine scope

   -- 6+2=8 entries in engine:
  eb~put("RGF_ENGINE",      "engine")
  eb~put("RGF"            , "engine")     -- entry in global as well as in engine scope


  rexxCode="call BsfContextVariables 'set', .jsr223~scriptContext2RexxDir(arg(arg())~scriptContext)                        ;" nl -
           "cdir=BsfContextVariables()  -- get context variables should be all from scriptContext!                         ;" nl -
           "sdir=.jsr223~scriptContext2RexxDir(arg(arg())~scriptContext) -- a Rexx directory of the scriptContext entries  ;" nl -
           "                                                                                                               ;" nl -
           "use arg jobj, nrEntries                                                                                        ;" nl -
           "                                                                                                               ;" nl -
           "/*                                                                                                             ;" nl -
           "say 'jobj='pp(jobj~objectName) 'nrEntries='pp(nrEntries)                                                       ;" nl -
           "say 'cdir='pp(cdir) 'sdir='pp(sdir)                                                                            ;" nl -
           "say 'cdir~items='pp(cdir~items) 'sdir~items='pp(sdir~items)                                                    ;" nl -
           "*/                                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           " /* 'JAVAX.' entries will count as one stem variable, hence adjusting expected value */                        ;" nl -
           "jobj~assertEquals(nrEntries, cdir~items+4, 'context variables')                                                ;" nl -
           "                                                                                                               ;" nl -
           "jobj~assertEquals(nrEntries, sdir~items)                                                                       ;" nl -
           "                                                                                                               ;" nl -
           "/*                                                                                                             ;" nl -
           "---                                                                                                            ;" nl -
           "call 'rgf_util2.rex'                                                                                           ;" nl -
           "call dump2 cdir, 'context-vars'                                                                                ;" nl -
           "call dump2 sdir, 'scriptContext'                                                                               ;" nl -
           "---                                                                                                            ;" nl -
           "*/                                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           "::requires BSF.CLS                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           "                                                                                                               ;"

  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self), 10     ) -- "RGF" in context vars will be present only once



-- the following must be executed, otherwise ooRexx 4.2.0 will later use objectname as value :( ! (rgf, 20150707)
if bDummyStuff=.true then
do
   say "3) eb="pp(eb) "eb~class="pp(eb~class) "eb~getClass="pp(eb~getClass) "eb~getClass~toString="pp(eb~getClass~toString)
   say "3) gb="pp(gb) "gb~class="pp(gb~class) "gb~getClass="pp(gb~getClass) "gb~getClass~toString="pp(gb~getClass~toString)
end


  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)

  rexxCode="call BsfContextVariables 'set', .jsr223~scriptContext2RexxDir(arg(arg())~scriptContext, , arg(4))              ;" nl -
           "cdir=BsfContextVariables()  -- get context variables should be all from scriptContext!                         ;" nl -
           "sdir=.jsr223~scriptContext2RexxDir(arg(arg())~scriptContext, , arg(4)) -- a Rexx directory of the scriptContext entries ;" nl -
           "                                                                                                               ;" nl -
           "use arg jobj, nrEntriesCdir, nrEntriesSdir                                                                     ;" nl -
           "                                                                                                               ;" nl -
           "/*                                                                                                             ;" nl -
           "say 'jobj='pp(jobj~objectName) 'nrEntries='pp(nrEntries)                                                       ;" nl -
           "say 'cdir='pp(cdir) 'sdir='pp(sdir)                                                                            ;" nl -
           "say 'cdir~items='pp(cdir~items) 'sdir~items='pp(sdir~items)                                                    ;" nl -
           "*/                                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           "/*                                                                                                             ;" nl -
           "---                                                                                                            ;" nl -
           "call 'rgf_util2.rex'                                                                                           ;" nl -
           "call dump2 cdir, 'context-vars'                                                                                ;" nl -
           "call dump2 sdir, 'scriptContext'                                                                               ;" nl -
           "---                                                                                                            ;" nl -
           "*/                                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           "jobj~assertEquals(nrEntriesCdir, cdir~items, 'context variables')                                              ;" nl -
           "jobj~assertEquals(nrEntriesSdir, sdir~items)                                                                   ;" nl -
           "                                                                                                               ;" nl -
           "::requires BSF.CLS                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           "                                                                                                               ;"

  -- "A" from all scopes: "JAVAX." will count as one variable in context variables instead of six
  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self),  6, 10, "A") -- "RGF" in context vars will be present only once
  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)

  -- "G" from global scope
  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self), 4, 3, "g")
  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)

  -- "E" from ewngine scope: "JAVAX." will count as one variable in context variables instead of six
  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self), 4, 8, "e")
  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)


--- own code (with four args):

  rexxCode="call BsfContextVariables 'set', .jsr223~scriptContext2RexxDir(arg(arg())~scriptContext, , arg(4), arg(5))      ;" nl -
           "cdir=BsfContextVariables()  -- get context variables should be all from scriptContext!                         ;" nl -
           "sdir=.jsr223~scriptContext2RexxDir(arg(arg())~scriptContext, , arg(4), arg(5))                                 ;" nl -
           "                                                                                                               ;" nl -
           "use arg jobj, nrEntriesCdir, nrEntriesSdir                                                                     ;" nl -
           "                                                                                                               ;" nl -
           "/*                                                                                                             ;" nl -
           "say 'l# 451: jobj='pp(jobj~objectName) 'nrEntriesCdir='pp(nrEntriesCdir) 'nrEntriesSdir='pp(nrEntriesSdir)     ;" nl -
           "say 'cdir='pp(cdir) 'sdir='pp(sdir)                                                                            ;" nl -
           "say 'cdir~items='pp(cdir~items) 'sdir~items='pp(sdir~items)                                                    ;" nl -
           "*/                                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           "/*                                                                                                             ;" nl -
           "---                                                                                                            ;" nl -
           "call 'rgf_util2.rex'                                                                                           ;" nl -
           "call dump2 cdir, 'context-vars'                                                                                ;" nl -
           "call dump2 sdir, 'scriptContext'                                                                               ;" nl -
           "---                                                                                                            ;" nl -
           "*/                                                                                                             ;" nl -
           "                                                                                                               ;" nl -
           "jobj~assertEquals(nrEntriesCdir, cdir~items, 'context variables')                                              ;" nl -
           "jobj~assertEquals(nrEntriesSdir, sdir~items)                                                                   ;" nl -
           "                                                                                                               ;" nl -
           "::requires BSF.CLS                                                                                             ;" nl -
           "                                                                                                               ;"

  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self), 6, 10, "g", "e") -- sequence: global, engine (last prevails)
  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)

  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self), 6, 10, "e", "g") -- sequence: engine, global (last prevails)
  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)

  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self), 6, 10, 100, 200) -- sequence: global, engine (last prevails)
  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)

  jargs=bsf.createJavaArrayOf("java.lang.Object", BsfCreateRexxProxy(self), 6, 10, 200, 100) -- sequence: engine, global (last prevails)
  eb~put(re~argv,jargs)    -- add to engine scope's bindings
  re~eval(rexxCode)


--- maybe own code (e.g. with eight args):
  rexxCode="call BsfContextVariables 'set', .jsr223~scriptContext2RexxDir(arg(arg())~scriptContext, , arg(4), arg(5), arg(6), arg(7), arg(8), arg(9)) ;" nl -
           "cdir=BsfContextVariables()  -- get context variables should be all from scriptContext!                         ;" nl -
