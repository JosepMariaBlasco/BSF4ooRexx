#!/usr/bin/env rexx
/*
   name:             rexx_testAbstract1.testGroup
   author:           Rony G. Flatscher
   version:          1.0.0
   date:             2009-08-29
   license:          ASF 2.0 (Apache Software License)
   purpose:          test BSF4Rexx 4.0 new callback from Java to ooRexx
   hint:             RexxProxy objects are Java objects and allow Java to interface with Rexx objects;
                     hence this test unit needs to address RexxProxy objects in a Java fashion, using
                     the RexxProxy method "invoke(String methodName, Object[] args)"; any Rexx object
                     that gets returned will be wrapped up as a RexxProxy as well
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.testCallback1)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::class "testCallback1" subclass ooTestCase public


::method "test_01_plain_invoke_no_args"
   /* due to the naming in this testgroup, this method will be the first that gets
      run; as previous tests may have changed the "bsfPrefixReturnValue", make sure
      that it is set as BSF.CLS routines and methods depend on that */
    if bsf("bsfPrefixReturnValue")=0 then
       call bsf "bsfPrefixReturnValue", 1  -- make sure that it is set

    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro)      -- create Java RexxProxy object, do not supply anything

    expected=.directory~new
    expected~methodName="HI"
    expected~argArrayItems=0
    expected~slotArgument=.false

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
    rp_arr=rpo~sendMessage("hi", noArgs) -- send a message without arguments

      -- get UNKNOWN's arguments
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, .nil, noArgs, oneArg))


::method "test_02_plain_invoke_one_arg"
    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro)      -- create Java RexxProxy object, do not supply anything

    expected=.directory~new
    expected~methodName="HI"
    expected~argArrayItems=1
    expected~slotArgument=.false

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arr=rpo~sendMessage("hi", oneArg) -- send a message with one argument

      -- get UNKNOWN's arguments
    oneArg[1]=1
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, .nil, noArgs, oneArg))


::method "test_03_plain_invoke_two_args"
    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro)      -- create Java RexxProxy object, do not supply anything

    expected=.directory~new
    expected~methodName="HOLLADRIJOH"
    expected~argArrayItems=2
    expected~slotArgument=.false

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
    twoArgs=bsf.createArrayOf("java.lang.String", "anton", "berta")
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arr=rpo~sendMessage("hoLlAdRiJoH", twoArgs)      -- send a message with two arguments

      -- get UNKNOWN's arguments
    oneArg[1]=1
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, .nil, noArgs, oneArg))


::method "test_04_invoke_with_userData_no_args"
    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro, "max")     -- create Java RexxProxy object, do not supply anything
    listOfEntries=.list~of("USERDATA", "METHODNAME")

    expected=.directory~new
    expected~methodName="HI"
    expected~argArrayItems=0+1            -- plus appended slotDir argument!
    expected~slotArgument=.true

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
    rp_arr=rpo~sendMessage("hi", noArgs) -- send a message without arguments

      -- get UNKNOWN's arguments
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, listOfEntries, noArgs, oneArg))


::method "test_05_invoke_with_userData_one_arg"
    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro, "moritz")      -- create Java RexxProxy object, do not supply anything
    listOfEntries=.list~of("USERDATA", "METHODNAME")

    expected=.directory~new
    expected~methodName="HI"
    expected~argArrayItems=1+1            -- plus appended slotDir argument!
    expected~slotArgument=.true

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arr=rpo~sendMessage("hi", oneArg) -- send a message with one argument

      -- get UNKNOWN's arguments
    oneArg[1]=1
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, listOfEntries, noArgs, oneArg))


::method "test_06_invoke_with_userData_two_args"
    ro=.SomeRexxClass~new           -- create an instance of an ooRexx class

    rpo=BsfCreateRexxProxy(ro, "maria")    -- create Java RexxProxy object, do not supply anything
    listOfEntries=.list~of("USERDATA", "METHODNAME")

    expected=.directory~new
    expected~methodName="HOLLADRIJOH"
    expected~argArrayItems=2+1            -- plus appended slotDir argument!
    expected~slotArgument=.true

    noArgs=bsf.createArrayOf("java.lang.Object")   -- no arguments (= empty array of arguments)
    twoArgs=bsf.createArrayOf("java.lang.String", "anton", "berta")
    oneArg=bsf.createArrayOf("java.lang.String", 1)
    rp_arr=rpo~sendMessage("hoLlAdRiJoH", twoArgs)      -- send a message with two arguments

      -- get UNKNOWN's arguments
    oneArg[1]=1
    rp_arg1=rp_arr~sendMessage("AT", oneArg)

    oneArg[1]=2
    rp_arg2=rp_arr~sendMessage("[]", oneArg)
    items=rp_arg2~sendMessage("items", noArgs)

    oneArg[1]=3
    rp_arg3=rp_arr~sendMessage("AT", oneArg)

    self~assertTrue(checkReturnedValues(expected, rp_arg1, rp_arg2, items, rp_arg3, listOfEntries, noArgs, oneArg))



/* ==================================================================================== */
-- just return the method name and the arguments accompanying it
::class SomeRexxClass
::method unknown
  use arg methName, argArray, arg3=.nil

/*
  say "UNKNOWN, methodName:" pp(methName)
  do i=1 to argArray~items
     o=argArray[i]
     say "   arg #" i":" pp(o)
     if o~isA(.directory) then
     do
        do idx over o
           say "      entry:" pp(idx)
        end
     end

  end
  say "---"
*/

  return .array~of(methName, argArray, arg3)


/* ==================================================================================== */
::routine checkReturnedValues
  use arg expected, rp_arg1, rp_arg2, items, rp_arg3, listOfEntries=.nil, noArgs, oneArg

  if expected~methodName<>rp_arg1 then return .false
  if expected~argArrayItems<>items then return .false
  if expected~slotArgument, listOfEntries=.nil then return .false

  if listOfEntries<>.nil then    -- slot argument given, check it
  do
     oneArg[1]=items
     slotDir=rp_arg2~sendMessage("at", oneArg)    -- get slotDir object from argArray

      -- get all entries in slotDir and save them in a set
     allIndexes=slotDir~sendMessage("allIndexes", noArgs)  -- get allIndexes
     tmpSet=.set~new
     do i=1 to allIndexes~sendMessage("items", noArgs)     -- iterate over all entries
        oneArg[1]=i              -- set index
        tmpSet~put(allIndexes~sendMessage("at", oneArg))   -- retrieve string value
     end

     if tmpSet~items <> listOfEntries~items then return .false -- mismatch, cannot be o.k.!

      -- remove the expected entries from the set
     do entry over listOfEntries       -- check whether slotDir contains all expected entries
        tmpSet~remove(entry)           -- remove entry from the set
     end
     return (tmpSet~items=0)           -- returns .true, if all entries got removed
  end

  return .true
