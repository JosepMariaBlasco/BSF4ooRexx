#!/usr/bin/rexx
/*
   name:             EventListener testGroup
   author:           Michael Lex
   version:          1.0.1
   changed:          2017-12-23: make sure we do not have RexxAndJava return prefixes for the values (procedural interface only, no BSF.CLS)
*/
/*

  Due to the circumstance that the error codes were change from
  BSF4Rexx version 2.8 to version 4.0 the following local variable
  indicates the current used version.

  For version 4.0:
	.local~ver = 4

  For version 2.8:
	.local~ver = 2 -- or any other value since the check is only if 4 is present
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.EventListener.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::class "EventListener.testGroup" subclass ooTestCase public

::method setup       -- make sure we run in non-prefix mode -- rgf, 20171223
 -- say "---> EventListener.testGruop, setup(): bsf('bsfPrefixValue') ->" bsf("bsfPrefixReturnValue")
 call bsf "bsfPrefixReturnValue", .false  -- procedural version, make sure no prefix
 .local~ver = 4

::method "test_1"

	e=BSF("postEventText", "eventtest")
	self~assertEquals(e, "eventtest")

::method "test_2"
	e=BSF("postEventText", "eventtest", 0)
	self~assertEquals(e, "eventtest")

::method "test_11"
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	e=BSF("postEventText", "eventtest", 1, 1)


return

