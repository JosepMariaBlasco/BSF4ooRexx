	r=BSF("arrayPut", arr, 1, 0)

::method "test_40"
	arr=bsf.createArray("boolean.class", 5)
	r=BSF("arrayPut", arr, .false, 2)
	-- self~assertEquals(arr[3], .false)
	self~assertEquals(BSF("arrayAt", arr, 2), .false)

::method "test_41"
	arr=bsf.createArray("boolean.class", 5)
	r=BSF("arrayPut", arr, .true, 2)       -- rgf, 2018-01-04: also Rexx TRUE value (.true, "1") will yield Boolean.TRUE
	-- self~assertEquals(arr[3], .false)
	self~assertEquals(BSF("arrayAt", arr, 2), .true)

	r=BSF("arrayPut", arr, "true", 3)      -- rgf, 2018-01-01: only "true" will yield a true value on the Java side
	self~assertEquals(BSF("arrayAt", arr, 3), .true)

	r=BSF("arrayPut", arr, .false, 3)
	self~assertEquals(BSF("arrayAt", arr, 3), .false)

	r=BSF("arrayPut", arr, ""    , 3)
	self~assertEquals(BSF("arrayAt", arr, 3), .false)

