-- rgf, 2018-01-01: note, only the string "true" will yield a Java boolean truth value!
-- rgf, 2018-01-04: changed RexxAndJava to consistently behave w.r.t. Booleans: now "1" and "true" will be regarded as Boolean.TRUE
::method "test_36"
	arr=bsf.createArray("boolean.class", 128623)
	r=BSF("arrayPut", arr, .true, 54321)
	-- self~assertEquals(arr[54322], .false)
	self~assertEquals(BSF("arrayAt", arr, 54321), .true)

::method "test_36b"
	arr=bsf.createArray("boolean.class", 128623)
	r=BSF("arrayPut", arr, "true", 54321)
	-- self~assertEquals(arr[54322], .false)
	self~assertEquals(BSF("arrayAt", arr, 54321), .true)

::method "test_36c"
	arr=bsf.createArray("boolean.class", 128623)
	r=BSF("arrayPut", arr, .false, 54321)
	-- self~assertEquals(arr[54322], .false)
	self~assertEquals(BSF("arrayAt", arr, 54321), .false)

::method "test_36d"
	arr=bsf.createArray("boolean.class", 128623)
	r=BSF("arrayPut", arr, "", 54321)
	-- self~assertEquals(arr[54322], .false)
	self~assertEquals(BSF("arrayAt", arr, 54321), .false)

::method "test_37"
	show_msg = BsfShowErrorMessage(0)
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	arr=bsf.createArray("boolean.class", foo)

