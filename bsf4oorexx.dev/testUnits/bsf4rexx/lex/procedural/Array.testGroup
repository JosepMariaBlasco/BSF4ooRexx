#!/usr/bin/env rexx
/*
   name:             Array testGroup
   author:           Michael Lex
   version:          1.0.1
   changed:          rgf, 2018-01-01:
                     - make sure we use procedural APIs only; while running this test return values
                       are not expected to be prefixed
                     - arrayPut() and arrayAt() use the C/Java array index rules, where the first element is at
                       position 0
*/
/*

  Due to the circumstance that the error codes were change from
  BSF4Rexx version 2.8 to version 4.0 the following local variable
  indicates the current used version.

  For version 4.0:
	.local~ver = 4

  For version 2.8:
	.local~ver = 2 -- or any other value since the check is only if 4 is present
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.Array.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::class "Array.testGroup" subclass ooTestCase public

::method setup
  expose initialPrefixValue
  .local~ver = 4              -- indicate BSF4ooRexx major version >= 4
  if \VAR(initialPrefixValue) then
  do
	initialPrefixValue=BSF("bsfPrefixReturnValue")  -- fetch current setting
   if initialPrefixValue~left(3)="<S>" then initialPrefixValue=substr(initialprefixValue,4)
  end
  call BSF "bsfPrefixReturnValue", 0      -- no "<O>" or "<S>" prefixes

::method tearDown
  expose initialPrefixValue
  call bsf 'bsfPrefixReturnValue', initialPrefixValue -- reset setting


::method "test_1"
	arr=bsf.createArray("int.class", 5)
	r=BSF("arrayPut", arr, 12345, 2)
	-- self~assertEquals(arr[3], 12345)
	self~assertEquals(BSF("arrayAt", arr, 2), 12345)

::method "test_2"
	show_msg = BsfShowErrorMessage(0)
	arr=bsf.createArray("int.class", 5)
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	r=BSF("arrayPut", arr, 12345, 7)

::method "test_3"
	arr=bsf.createArray("int.class", 5, 5)
	r=BSF("arrayPut", arr, 12345, 2, 2)
	-- self~assertEquals(arr[3,3], 12345)
	self~assertEquals(BSF("arrayAt", arr, 2, 2), 12345)

::method "test_4"
	arr=bsf.createArray("int.class", 5, 5, 5)
	r=BSF("arrayPut", arr, 12345, 2, 2, 2)
	-- self~assertEquals(arr[3,3,3], 12345)
	self~assertEquals(BSF("arrayAt", arr, 2, 2, 2), 12345)

