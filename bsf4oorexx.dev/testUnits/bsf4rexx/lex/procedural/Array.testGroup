	r=BSF("arrayPut", arr, "foo", 2)
	-- self~assertNotEquals(arr[3], "bar")
	self~assertEquals(BSF("arrayAt", arr, 2), "foo")
	self~assertNotEquals(BSF("arrayAt", arr, 2), "bar")

