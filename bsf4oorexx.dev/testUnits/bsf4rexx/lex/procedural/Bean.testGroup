#!/usr/bin/env rexx
/*
   name:             Bean testGroup
   author:           Michael Lex
   changed:
                     rgf, 2011-02-12: allow this test to run in "java.awt.headless=true"-mode
                     rgf, 2018-01-01: "setup" method added
                     rgf, 2018-02-23: adjusted unregisterBean tests to cater for the new return value, which is an int of reference counts
                     rgf, 2018-02-28: remove version test (3/4)
                     rgf, 2018-11-04: - rewrite all tests to use the procedural functions (i.e. no support from BSF.CLS!) only
                                      - added test_30

   version:          1.0.2
*/
/*

  Due to the circumstance that the error codes were change from
  BSF4Rexx version 2.8 to version 4.0 the following local variable
  indicates the current used version.

  For version 4.0:
	.local~ver = 4

  For version 2.8:
	.local~ver = 2 -- or any other value since the check is only if 4 is present
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.Bean.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes

::class "Bean.testGroup" subclass ooTestCase public

::method setup
  expose initialPrefixValue

         /* load the BSF4Rexx functions and start a JVM, if necessary */
   if rxFuncQuery("BSF") = 1 then   /* BSF() support not loaded yet ? */
   do
      call rxFuncAdd "BsfLoadFuncs", "BSF4ooRexx", "BsfLoadFuncs"
      call BsfLoadFuncs          /* load all BSF*() functions  */
      call BsfLoadJava           /* load Java                  */
   end

  if \VAR(initialPrefixValue) then
  do
     initialPrefixValue=BSF("bsfPrefixReturnValue")  -- fetch current setting
     if initialPrefixValue~left(3)="<S>" then initialPrefixValue=substr(initialprefixValue,4)
  end
  call bsf "bsfPrefixReturnValue", 0   -- make sure no prefixes get prepended
  call BSF "setRexxNullString", ".NIL" -- make sure we reset to default
  call BsfShowErrorMessage 0           -- do not display error messages on stdout

::method tearDown
  expose initialPrefixValue
  call bsf 'bsfPrefixReturnValue', initialPrefixValue -- make sure we have the original setting before leaving
  call BSF "setRexxNullString", ".NIL"    -- make sure we reset to default


::method "test_01"
	self~expectSyntax(40.900)
   s=bsf('newStrict', , 'java.lang.String', 'int', 5)


::method "test_02.1"
   fd=bsf('newStrict', , 'java.awt.Dimension', 'int', 1, 'int', 2)
   w1=bsf('invokeStrict', fd, 'getWidth')
   self~assertEquals(1, w1)
   h1=bsf('invokeStrict', fd, 'getHeight')
   self~assertEquals(2, h1)


::method "todo test_02.2"
   fd=bsf('new', , 'java.awt.Dimension', 1, 2)
   w1=bsf('invoke', fd, 'getWidth')
   self~assertEquals(1, w1)
   h1=bsf('invoke', fd, 'getHeight')
   self~assertEquals(2, h1)


::method "test_03"
	self~expectSyntax(40.900)
   ftf=bsf('newStrict', , "java.awt.TextField", "int", 1, 2)

::method "test_04"
	self~expectSyntax(40.900)
   ftf=bsf('newStrict', , "java.awt.TextField", "double", 5)

::method "test_05"
--   .bsf~bsf.import("java.awt.Dimension", "JaD")
--   fd=.JaD~newStrict("int", 1, "int", 2)

   fd=bsf('new', ,'java.awt.Dimension', 1, 2)
	refCount=bsf("unregisterBean",fd)
	refCount=bsf("unregisterBean",fd)
	self~assertEquals(-1, refCount)

::method "test_06"
	refCount=bsf("unregisterBean",non_existent_bean)
	self~assertEquals(-1, refCount, "unregistering non-existent bean")


::method "test_07"
	self~expectSyntax(40.900)
   call bsf 'newStrict', , 'non_existing_Java_class', 5


::method "test_08"
	r=BSF("setRexxNullString", "newnullstring")
	b=BSF("lookupBean", "not_there")
	self~assertEquals("newnullstring", b)



::method "test_11"
	self~expectSyntax(40.900)
   call bsf 'new', , 'java.awt.TextField', "foo", 1, 2


::method "test_12"
   fd=bsf('registerBean', , 'java.awt.Dimension', 1, 2)   -- original name for subfunction "new", which is an alias
	refCount=bsf("unregisterBean",fd)
	refCount=bsf("unregisterBean",fd)
	self~assertEquals(-1, refCount)


::method "test_13"
	refCount=bsf("unregisterBean", a_not_existing_bean)
	self~assertEquals(-1, refCount)


::method "test_14"
	self~expectSyntax(40.900)
   call bsf 'registerBeanStrict', , 'int', 5    -- synonym for 'newStrict'


::method "test_27"
   clz=bsf('loadClass', 'java.awt.TextField')
   ftf=bsf('rawRegisterBean', "oha", clz)
   self~assertNotNull(ftf)
   self~assertTrue(bsf('getBeanRefCount',clz)>0)
   self~assertTrue(bsf('getBeanRefCount',ftf)>0)


::method "test_30"   --- new, 20181104: really test the bean interface

   beanName="maxUndMoritz"
   fd=bsf('new', beanName , 'java.lang.Object') -- create an Object, store it under beanName in Java registry
   self~assertEquals(beanName, fd)

   self~assertEquals(1,bsf("getBeanRefCount",beanName))

   do i=1 to 20                  -- will increase the ref count
      a=bsf('lookupBean', beanName)
      self~assertEquals(i,bsf("getBeanRefCount",a))
   end

   do i=20 to 1 by -1            -- will decrease the ref count
      self~assertEquals(i-1,bsf("unregisterBean",a))
   end
   self~assertEquals(-1,bsf("unregisterBean", a))  -- not registered anymore
   self~assertEquals(-1,bsf("getBeanRefCount",a))
   self~assertEquals(-1,bsf("unregisterBean", a))  -- not registered anymore
   self~assertEquals(-1,bsf("getBeanRefCount",a))

   self~assertEquals( 0, bsf("unregisterBean",  beanName))
   self~assertEquals(-1, bsf("getBeanRefCount", beanName))
   self~assertEquals(-1, bsf("unregisterBean",  beanName))
   self~assertEquals(-1, bsf("getBeanRefCount", beanName))

