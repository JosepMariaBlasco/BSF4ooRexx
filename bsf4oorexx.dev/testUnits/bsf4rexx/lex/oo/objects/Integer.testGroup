	errorCode=40.1
	self~expectSyntax(errorCode)
	i=.JInteger~new(2147483648)

::method "test_5"
	.bsf~bsf.import("java.lang.Integer","JInteger")
	errorCode=40.1
	self~expectSyntax(errorCode)
	i=.JInteger~new(foo)
*/

::method "test_6"
	.bsf~bsf.import("java.lang.Integer","JInteger")
	i=.JInteger~newStrict("Integer","-2147483648")
	self~assertEquals(i~intValue,"-2147483648")

::method "test_7"
--	.bsf~bsf.import("java.lang.Integer","JInteger")
--	errorCode=40.1
--	self~expectSyntax(errorCode)
--	i=.JInteger~newStrict("Integer","-2147483649")

::method "test_8"
	.bsf~bsf.import("java.lang.Integer","JInteger")
	i=.JInteger~newStrict("Integer.class","-2147483648")
	self~assertEquals(i~intValue,"-2147483648")

::method "test_9"
	.bsf~bsf.import("java.lang.Integer","JInteger")
	i=.JInteger~newStrict("INTEGER.CLASS","-2147483648")
	self~assertEquals(i~intValue,"-2147483648")

::method "test_10"
--	.bsf~bsf.import("java.lang.Integer","JInteger")
--	errorCode=40.1
--	self~expectSyntax(errorCode)
--	i=.JInteger~new("Inte","-2147483648")


::method "test_11"
	.bsf~bsf.import("java.lang.Integer","JInteger")
	i=.JInteger~newStrict("In","-2147483648")
	self~assertEquals(i~intValue,"-2147483648")

::method "test_12"
	.bsf~bsf.import("java.lang.Integer","JInteger")
	i=.JInteger~newStrict("I","-2147483648")
	self~assertEquals(i~intValue,"-2147483648")


return