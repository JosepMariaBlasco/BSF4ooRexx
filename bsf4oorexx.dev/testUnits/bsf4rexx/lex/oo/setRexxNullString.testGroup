#!/usr/bin/env rexx
/*
   name:             setRexxNullString testGroup
   author:           Michael Lex
   version:          1.0.1
   changed:          - 2018-02-28, rgf: - make sure we reset the rexxNullString to ".NIL",
                                        - remove ooRexx version (3 vs. 4) dependent code, not needed anymore

*/
/*

  Due to the circumstance that the error codes were change from
  BSF4Rexx version 2.8 to version 4.0 the following local variable
  indicates the current used version.

  For version 4.0:
	.local~ver = 4

  For version 2.8:
	.local~ver = 2 -- or any other value since the check is only if 4 is present
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.setRexxNullString.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::class "setRexxNullString.testGroup" subclass ooTestCase public

::method setup
  call BSF "setRexxNullString", ".NIL"    -- make sure we reset to default

::method tearDown
  call BSF "setRexxNullString", ".NIL"    -- make sure we reset to default

::method "test_1"
	nns=.bsf~bsf.setRexxNullString("newnullstring")
	self~assertEquals(nns,"newnullstring")

::method "test_2"
	self~expectSyntax(40.900)
	nns=.bsf~bsf.setRexxNullString("newnullstring", "foo")

::method "test_3"
	self~expectSyntax(40.900)
	nns=.bsf~bsf.setRexxNullString()