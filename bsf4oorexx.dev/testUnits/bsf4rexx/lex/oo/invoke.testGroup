#!/usr/bin/env rexx
/*
   name:             invoke testGroup
   author:           Michael Lex
   version:          1.0.0
*/
/*

  Due to the circumstance that the error codes were change from
  BSF4Rexx version 2.8 to version 4.0 the following local variable
  indicates the current used version.

  For version 4.0:
	.local~ver = 4

  For version 2.8:
	.local~ver = 2 -- or any other value since the check is only if 4 is present
*/

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.invoke.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::class "invoke.testGroup" subclass ooTestCase public

::method "test_1"
	.local~ver = 4

	show_msg=BsfShowErrorMessage(0)
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	.bsf~bsf.import("foo")

::method "test_2"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invoke("length")
	self~assertEquals(r, 10)

::method "test_3"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invoke("compareTo","teststring")
	self~assertEquals(r, 0)

::method "test_4"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invoke("length")
	self~assertEquals(r, 10)

::method "test_5"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	r=ns~bsf.invoke("length", "foo")

::method "test_6"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	r=ns~bsf.invoke("length", "")

::method "test_7"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invokeStrict("compareTo", "String","teststring")
	self~assertEquals(r, 0)

::method "test_8"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invokeStrict("compareTo", "String", "foo")
	self~assertNotEquals(r, 0)

::method "test_9"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invoke("compareTo", "foo")
	self~assertNotEquals(r, 0)

::method "test_10"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	r=ns~bsf.invokeStrict("compareTo", "int", "teststring")

::method "test_11"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invoke("valueOf", 2)
	self~assertEquals(r, 2)

::method "test_12"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.invokeStrict("valueOf", "double", 2)
	self~assertEquals(r, 2)

::method "test_13"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.dispatch("length")
	self~assertEquals(r, 10)

::method "test_14"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.dispatch("compareTo","teststring")
	self~assertEquals(r, 0)

::method "test_15"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.dispatch("length")
	self~assertEquals(r, 10)

::method "test_16"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	r=ns~bsf.dispatch("length", "foo")

::method "test_17"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	IF .ver = 4 THEN errorCode=40.900; ELSE errorCode=40.1
	self~expectSyntax(errorCode)
	r=ns~bsf.dispatch("length", "")

::method "test_20"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.dispatch("compareTo", "foo")
	self~assertNotEquals(r, 0)

::method "test_22"
	.bsf~bsf.import("java.lang.String", "jls")
        ns=.jls~new("teststring")
	r=ns~bsf.dispatch("valueOf", 2)
	self~assertEquals(r, 2)

return