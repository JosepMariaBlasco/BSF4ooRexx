#!/usr/bin/env rexx
/*
   name:             04_draw_fill.testGroup
   author:           Josep Maria Blasco
   version:          0.1.0
   date:             2026-10-14
   license:          ASF 2.0 (Apache Software License)
   purpose:          JDOR drawing and filling: drawLine, drawRect/fillRect,
                     drawOval/fillOval, drawArc/fillArc,
                     drawRoundRect/fillRoundRect, draw3DRect/fill3DRect,
                     drawPolygon/fillPolygon/drawPolyline
   hint:             checked through pixels with antialiasing off ("render
                     aliasOff"): probes lie on the outline or well inside a
                     figure, and probes for "outside" keep a margin of two
                     pixels, so that antialiasing or rounding differences
                     between implementations do not matter
*/

  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.jdor.drawFill.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"
::requires "jdorTestSupport.cls"

::class "jdor.drawFill.testGroup" subclass ooTestCase public

::method setUp                    -- a 50x50 image, no antialiasing, red
  call jdorTest.fresh
  address jdor
  newImage 50 50
  render aliasOff
  color red

::method assertInk                -- assertInk(x, y [, message]): pixel is red
  use strict arg x, y, msg = ("pixel" x y "should be red")
  self~assertEquals(jdorTest.argb(255, 0, 0), jdorTest.pixel(x, y), msg)

::method assertEmpty              -- assertEmpty(x, y [, message]): pixel untouched
  use strict arg x, y, msg = ("pixel" x y "should be empty")
  self~assertEquals(0, jdorTest.pixel(x, y), msg)

-- lines and rectangles ---------------------------------------------------------

::method test_drawLine
  address jdor
  moveTo 10 10
  drawLine 40 10
  self~assertEquals(0, rc)
  self~assertInk(10, 10, "start")
  self~assertInk(25, 10, "middle")
  self~assertInk(40, 10, "end")
  self~assertEmpty(25, 12)
  self~assertEmpty(43, 10)

::method test_drawLine_does_not_move_position
  address jdor
  moveTo 10 10
  drawLine 40 30
  position
  self~assertEquals("10 10", rc)

::method test_drawRect
  address jdor
  moveTo 10 10
  drawRect 20 10
  self~assertInk(10, 10, "top left")
  self~assertInk(30, 10, "top right: x + width")
  self~assertInk(30, 20, "bottom right: y + height")
  self~assertInk(20, 20, "bottom edge")
  self~assertEmpty(20, 15, "interior")
  self~assertEmpty(33, 15)

::method test_fillRect
  address jdor
  moveTo 10 10
  fillRect 20 10
  self~assertInk(10, 10)
  self~assertInk(29, 19, "last pixel: x + width - 1, y + height - 1")
  self~assertInk(20, 15)
  self~assertEmpty(32, 15)
  self~assertEmpty(20, 22)

::method test_fillRect_wrong_arguments_is_error
  trace off
  address jdor
  'fillRect 5'
  self~assertEquals(-102, rc)
  self~assertEquals(1, .rs)

-- ovals and arcs ---------------------------------------------------------------

::method test_fillOval
  address jdor
  moveTo 10 10
  fillOval 30 30
  self~assertInk(25, 25, "centre")
  self~assertInk(12, 25, "near the left edge")
  self~assertEmpty(11, 11, "corner of the bounding box")

::method test_drawOval
  address jdor
  moveTo 10 10
  drawOval 30 30
  self~assertInk(10, 25, "leftmost point")
  self~assertInk(25, 10, "topmost point")
  self~assertEmpty(25, 25, "centre")
  self~assertEmpty(12, 12, "inside the box, outside the oval")

::method test_fillArc_quadrant
  address jdor
  moveTo 10 10
  fillArc 30 30 0 90            -- from 3 o'clock, 90 degrees counterclockwise
  self~assertInk(32, 18, "upper right quadrant")
  self~assertEmpty(18, 18, "upper left quadrant")
  self~assertEmpty(32, 32, "lower right quadrant")

::method test_drawArc_quadrant
  address jdor
  moveTo 10 10
  drawArc 30 30 90 90           -- from 12 to 9 o'clock
  self~assertInk(25, 10, "12 o'clock")
  self~assertInk(10, 25, "9 o'clock")
  self~assertEmpty(40, 25, "3 o'clock is not part of the arc")

::method test_fillRoundRect
  address jdor
  moveTo 10 10
  fillRoundRect 30 30 20 20
  self~assertInk(25, 25, "centre")
  self~assertInk(25, 11, "middle of the top edge")
  self~assertEmpty(10, 10, "the corner is rounded off")

::method test_drawRoundRect
  address jdor
  moveTo 10 10
  drawRoundRect 30 30 10 10
  self~assertInk(25, 10, "middle of the top edge")
  self~assertEmpty(10, 10, "the corner is rounded off")
  self~assertEmpty(25, 25, "centre")

-- 3D rectangles -------------------------------------------------------------------

::method test_draw3DRect
  address jdor
  moveTo 10 10
  draw3DRect 30 20 .true
  self~assertTrue(jdorTest.pixel(10, 10) \= 0, "border")
  self~assertTrue(jdorTest.pixel(40, 30) \= 0, "opposite corner of the border")
  self~assertEmpty(25, 20, "interior (finding 1)")

::method test_fill3DRect
  address jdor
  moveTo 10 10
  fill3DRect 30 20 .false
  self~assertTrue(jdorTest.pixel(25, 20) \= 0, "interior")

::method test_3DRect_bad_boolean_is_error
  trace off
  address jdor
  moveTo 10 10
  draw3DRect 30 20 maybe
  self~assertEquals(1, .rs)

-- polygons --------------------------------------------------------------------

::method test_fillPolygon_array_strings
  address jdor
  'fillPolygon "(10,40,10)" "(10,10,40)" 3'
  self~assertEquals(0, rc)
  self~assertInk(15, 15, "inside the triangle")
  self~assertEmpty(35, 35, "beyond the hypotenuse")

::method test_fillPolygon_array_variables
  address jdor
  xs = bsf.createJavaArrayOf("int.class", 10, 40, 10)
  ys = bsf.createJavaArrayOf("int.class", 10, 10, 40)
  'fillPolygon xs ys 3'          -- quoted: the handler must see the names
  self~assertEquals(0, rc)
  self~assertInk(15, 15)
  self~assertEmpty(35, 35)

::method test_drawPolygon_is_closed
  address jdor
  'drawPolygon "(10,40,10)" "(10,10,40)" 3'
  self~assertInk(20, 10, "first side")
  self~assertInk(25, 25, "second side (hypotenuse)")
  self~assertInk(10, 25, "closing side")
  self~assertEmpty(15, 15, "interior")

::method test_drawPolyline_is_open
  address jdor
  'drawPolyline "(10,40,10)" "(10,10,40)" 3'
  self~assertInk(20, 10, "first segment")
  self~assertInk(25, 25, "second segment")
  self~assertEmpty(10, 25, "no closing segment")

::method test_polygon_short_array_is_error
  trace off
  address jdor
  'fillPolygon "(10,40)" "(10,10,40)" 3'
  self~assertEquals(-102, rc)
  self~assertEquals(1, .rs)
