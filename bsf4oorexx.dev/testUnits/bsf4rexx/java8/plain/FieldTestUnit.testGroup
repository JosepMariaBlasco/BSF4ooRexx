#!/usr/bin/env rexx
/*
   name:             FieldValue testGroup
   author:           Rony G. Flatscher
   version:          1.0.0

   changed:          rgf, 2018-01-01:
                     - make sure we use procedural APIs only; while running this test return values
                       are not expected to be prefixed
*/

  if .bsf4rexx~java.major.version<8 then return   -- we need at least Java 1.8/8 due to static and dynamic interface methods
                              -- the Java class files got compiled to Java 1.8/8 and cannot run on earlier JRE

  parse source . . fileSpec;

  group = .TestGroup~new(fileSpec)
  group~add(.FieldValue.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires "ooTest.frm"     -- load the ooRexxUnit classes
::requires BSF.CLS

::class "FieldValue.testGroup" subclass ooTestCase public

::method setup
  expose initialPrefixValue bEcho
  -- bEcho=.true        -- execute SAY-statements
  bEcho=.false       -- execute SAY-statements

  if \VAR(initialPrefixValue) then
  do
	initialPrefixValue=BSF("bsfPrefixReturnValue")  -- fetch current setting
   if initialPrefixValue~left(3)="<S>" then initialPrefixValue=substr(initialprefixValue,4)
  end
  call BSF "bsfPrefixReturnValue", 0      -- no "<O>" or "<S>" prefixes

::method tearDown
  expose initialPrefixValue
  call bsf 'bsfPrefixReturnValue', initialPrefixValue -- reset setting



/* --- o.k. already

o.k. already --- */

::method "test_01_getFieldValue"
   expose bEcho
	n=BSF("new", "myt2", "java8.plain.Test2")
   if bEcho=.true then call time 'reset'
   do i=1 to 10
   	f=BSF("getFieldValue", "myt2", "INT_T2_obj") -- instance field
   	self~assertEquals(203, f)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end

   do i=1 to 10
   	f=BSF("getFieldValue", "myt2", "int_t2_obj") -- instance field
   	self~assertEquals(203, f)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end


::method "test_02_getFieldValueStrict"
   expose bEcho
	beanName=BSF("new", , "java8.plain.Test2")
   if bEcho=.true then call time 'reset'
   do i=1 to 10
   	f=BSF("getFieldValueStrict", beanName, "INT_T2_obj") -- instance field
   	self~assertEquals(203, f)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end

	self~expectSyntax(40.900)
   self~assertEquals(202, BSF("getFieldValueStrict", beanName, "int_t2_obj"))  -- private static field



::method "test_03_getFieldValue"
   expose bEcho
	beanName=BSF("new", "myTest2", "java8.plain.Test2")
   if bEcho=.true then call time 'reset'
   do i=1 to 10
   	self~assertEquals(101, BSF("getFieldValue", beanName, "INT_T1"))  -- static field
   	self~assertEquals(111, BSF("getFieldValue", beanName, "INT_i1"))  -- static field (interface)
   	self~assertEquals( 22, BSF("getFieldValue", beanName, "INT_i2"))  -- static field (interface)
   	self~assertEquals(201, BSF("getFieldValue", beanName, "INT_T2"))  -- static field

      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end

   /*
   F:\work\svn\bsf4oorexx\trunk\bsf4oorexx.dev\testUnits\bsf4rexx\java8\plain>java -cp ..\..;.             UseTest2
   class UseTest2 in main() method...
   obj1.STRING_i1=ISTRING_11 (static)
   obj1.STRING_i2=ISTRING_22 (static)
   obj1.STRING_i3=ISTRING_33 (static)
   obj1.INT_T1   =101
   obj1.INT_i1   =111
   obj1.INT_i2   =22
   obj1.INT_T2   =201
   class java8.plain.Test1: getField("INT_i2")=public static final int java8.plain.Interface2.INT_i2, declared in: interface java8.plain.Interface2
   class java8.plain.Test1: getDeclaredField("INT_i3")=private static int java8.plain.Test2.INT_i3
   */



::method "test_04_getFieldValue_exception"
   expose bEcho
	beanName=BSF("new", "myTest2", "java8.plain.Test2")
   -- rgf, 2018-02-15: will now find the field in Interface3 via inheritance resolution (ignoring non-public fields on the way)
   self~assertEquals(33, BSF("getFieldValue", beanName, "INT_i3"))  -- field from Interface3, not the static private field in Test2 !


