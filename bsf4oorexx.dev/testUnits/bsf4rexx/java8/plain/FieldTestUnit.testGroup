-- 2018-01-10: rgf, add get and set on private fields, which should cause the search for
--                  public respective getter and setter methods

::method "test_12_getSet_private_fields_via_their_setter_and_getter_methods"
   expose bEcho
   className="java8.plain.Test2"
	beanName=BSF("new", , className)
   clzTest2=bsf("loadClass", className)

   if bEcho=.true then call time 'reset'
   do i=1 to 10
      newVal=.true
      call BSF "setFieldValue",    beanName, "zwei", newVal
   	currVal=BSF("getFieldValue", beanName, "zwei")
      self~assertEquals(newVal,currVal)

      currVal=\currVal;
      call BSF "setFieldValue",    beanName, "staticZwei", newVal
   	currVal=BSF("getFieldValue", beanName, "staticZwei")

      currVal=\currVal;
      call BSF "setFieldValue",     beanName, "staticZwei", newVal
   	currVal=BSF("getStaticValue", clzTest2, "staticZwei")
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end


   if bEcho=.true then call time 'reset'
   do i=1 to 10
      newVal=.true
      call BSF "setFieldValue",    beanName, "drei", newVal
   	currVal=BSF("getFieldValue", beanName, "drei")
      self~assertEquals(newVal,currVal)

      currVal=\currVal;
      call BSF "setFieldValue",    beanName, "staticDrei", newVal
   	currVal=BSF("getFieldValue", beanName, "staticDrei")

      currVal=\currVal;
      call BSF "setFieldValue",     beanName, "staticDrei", newVal
   	currVal=BSF("getStaticValue", clzTest2, "staticDrei")
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end




   if bEcho=.true then call time 'reset'
   do i=1 to 10
      newVal=.true
      call BSF "setFieldValue",    beanName, "vier", newVal
   	currVal=BSF("getFieldValue", beanName, "vier")
      self~assertEquals(newVal,currVal)

      currVal=\currVal;
      call BSF "setFieldValue",    beanName, "staticVier", newVal
   	currVal=BSF("getFieldValue", beanName, "staticVier")

      currVal=\currVal;
      call BSF "setFieldValue",     beanName, "staticVier", newVal
   	currVal=BSF("getStaticValue", clzTest2, "staticVier")
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end