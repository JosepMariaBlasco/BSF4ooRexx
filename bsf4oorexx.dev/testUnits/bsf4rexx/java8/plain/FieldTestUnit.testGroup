::method "test_08a_JSO"
   expose bEcho

	jobj=BSF("new", "myt2", "java8.plain.Test2")
   if bEcho=.true then call time 'reset'
   do i=1 to 10
   	f=BSF("getFieldValueJSO", jobj, "STRING_T1") -- instance field
   	self~assertTrue(abbrev(f,"java.lang.String@"))
      str=bsf("invoke", f, "toString")
      self~assertEquals("TSTRING_101 (instance)", str)

   	f=BSF("getFieldValueJSO", jobj, "string_t1") -- instance field
   	self~assertTrue(abbrev(f,"java.lang.String@"))
      str=bsf("invoke", f, "toString")
      self~assertEquals("TSTRING_101 (instance)", str)


   	f=BSF("getFieldValueStrictJSO", jobj, "STRING_T1") -- instance field
   	self~assertTrue(abbrev(f,"java.lang.String@"))
      str=bsf("invoke", f, "toString")
      self~assertEquals("TSTRING_101 (instance)", str)

         -- class object access:
   	f=BSF("getStaticValueJSO", "java8.plain.Interface1", "STRING_i1") -- instance field
   	self~assertTrue(abbrev(f,"java.lang.String@"))
      str=bsf("invoke", f, "toString")
      self~assertEquals("ISTRING_11 (static)", str)

   	f=BSF("getStaticValueJSO", "java8.plain.Interface1", "string_i1") -- instance field
   	self~assertTrue(abbrev(f,"java.lang.String@"))
      str=bsf("invoke", f, "toString")
      self~assertEquals("ISTRING_11 (static)", str)

   	f=BSF("getStaticValueStrictJSO", "java8.plain.Interface3", "STRING_i1") -- instance field
   	self~assertTrue(abbrev(f,"java.lang.String@"))
      str=bsf("invoke", f, "toString")
      self~assertEquals("ISTRING_11 (static)", str)

      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end

   -- non-existing field:
	self~expectSyntax(40.900)
   f=BSF("getStaticValueJSO", "java8.plain.Interface1", "nixinoxi, nixinoxii") -- instance field




::method "test_09_setFieldValue"
   expose bEcho

	beanName=BSF("new", "myTest2", "java8.plain.Test2")
   if bEcho=.true then call time 'reset'

/*
   F:\work\svn\bsf4oorexx\trunk\bsf4oorexx.dev\testUnits\bsf4rexx\java8\plain>java -cp ..\..;.             UseTest2
class UseTest2 in main() method...
obj1.STRING_i1 =ISTRING_11 (static)
obj1.STRING_i2 =ISTRING_22 (static)
obj1.STRING_i3 =ISTRING_33 (static)
obj1.INT_T1    =101
obj1.INT_i1    =111
obj1.INT_i2    =22

obj1.INT_T2    =201 (static)
obj1.INT_T2    =291 (static)

obj1.INT_T2_obj=203
obj1.INT_T2_obj=294

obj1.INT_T1    =101 (static)
obj1.INT_T1    =191 (static)

obj1.INT_i1    =111
obj1.INT_i1    =191
*/

   do i=1 to 10
      -- static fields
         -- Test2
      newVal=-123
      call BSF "setFieldValue", beanName, "INT_T2", newVal      -- static field
   	currVal=BSF("getFieldValue", beanName, "INT_T2")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValueStrict", beanName, "INT_T2", newVal      -- static field
   	currVal=BSF("getFieldValueStrict", beanName, "INT_T2")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValue", beanName, "int_t2", newVal      -- static field
   	currVal=BSF("getFieldValue", beanName, "int_t2")
      self~assertEquals(newVal,currVal)

      -- mix with getStaticValue()
      call BSF "setFieldValue", beanName, "INT_T2", newVal      -- static field
   	currVal=BSF("getStaticValue", beanName, "INT_T2")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValueStrict", beanName, "INT_T2", newVal      -- static field
   	currVal=BSF("getStaticValueStrict", beanName, "INT_T2")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValue", beanName, "int_t2", newVal      -- static field
   	currVal=BSF("getStaticValue", beanName, "int_t2")
      self~assertEquals(newVal,currVal)

         -- Test1
      newVal=-123
      call BSF "setFieldValue", beanName, "INT_T1", newVal      -- static field
   	currVal=BSF("getFieldValue", beanName, "INT_T1")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValueStrict", beanName, "INT_T1", newVal      -- static field
   	currVal=BSF("getFieldValueStrict", beanName, "INT_T1")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValue", beanName, "int_t1", newVal      -- static field
   	currVal=BSF("getFieldValue", beanName, "int_t1")
      self~assertEquals(newVal,currVal)

      -- mix with getStaticValue()
      call BSF "setFieldValue", beanName, "INT_T1", newVal      -- static field
   	currVal=BSF("getStaticValue", beanName, "INT_T1")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValueStrict", beanName, "INT_T1", newVal      -- static field
   	currVal=BSF("getStaticValueStrict", beanName, "INT_T1")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValue", beanName, "int_t1", newVal      -- static field
   	currVal=BSF("getStaticValue", beanName, "int_t1")
      self~assertEquals(newVal,currVal)

      -- instance fields only
         -- Test2
      newVal=-123
      call BSF "setFieldValue", beanName, "INT_T2_obj", newVal
   	currVal=BSF("getFieldValue", beanName, "INT_T2_obj")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValueStrict", beanName, "INT_T2_obj", newVal
   	currVal=BSF("getFieldValueStrict", beanName, "INT_T2_obj")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValue", beanName, "int_t2_OBJ", newVal
   	currVal=BSF("getFieldValue", beanName, "int_t2_OBJ")
      self~assertEquals(newVal,currVal)


         -- Test1
      newVal=-123
      call BSF "setFieldValue", beanName, "INT_i1", newVal
   	currVal=BSF("getFieldValue", beanName, "INT_i1")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValueStrict", beanName, "INT_i1", newVal
   	currVal=BSF("getFieldValueStrict", beanName, "INT_i1")
      self~assertEquals(newVal,currVal)

      newVal*=2
      call BSF "setFieldValue", beanName, "int_i1", newVal
   	currVal=BSF("getFieldValue", beanName, "int_i1")
      self~assertEquals(newVal,currVal)


      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end




::method "test_10_getSetBooleanFieldValue"
   expose bEcho
	beanName=BSF("new", , "java8.plain.Test2")
   if bEcho=.true then call time 'reset'

   do i=1 to 10      -- instance fields
      newVal=.true
      call BSF "setFieldValue",    beanName, "bool_1", newVal
   	currVal=BSF("getFieldValue", beanName, "bool_1")
      self~assertEquals(newVal,currVal)

      newVal="true"
      call BSF "setFieldValue",    beanName, "bool_1", newVal
   	currVal=BSF("getFieldValue", beanName, "bool_1")
      self~assertEquals(1,currVal)

      newVal="true"        -- change boolean value to opposite
      call BSF "setFieldValue",    beanName, "Boolean_1", newVal
   	currVal=BSF("getFieldValue", beanName, "Boolean_1")
      self~assertEquals(1,currVal)

      newVal=\currVal      -- change boolean value to opposite
      call BSF "setFieldValue",    beanName, "Boolean_1", newVal
   	currVal=BSF("getFieldValue", beanName, "Boolean_1")
      self~assertEquals(newVal,currVal)
   end


   do i=1 to 10      -- static fields
      newVal=.true
      call BSF "setFieldValue",     beanName, "bool_static_1", newVal
   	currVal=BSF("getStaticValue", beanName, "bool_static_1")
      self~assertEquals(newVal,currVal)

      newVal=\currVal      -- change boolean value to opposite
      call BSF "setFieldValue",     beanName, "Boolean_static_1", newVal
   	currVal=BSF("getStaticValue", beanName, "Boolean_static_1")
      self~assertEquals(newVal,currVal)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end


