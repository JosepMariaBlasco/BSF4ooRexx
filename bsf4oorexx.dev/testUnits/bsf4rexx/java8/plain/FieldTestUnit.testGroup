   	f=BSF("getStaticValue", javaClassName, "INT_T2") -- instance field
   	self~assertEquals(201, f)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end

   javaClassName="java8.plain.Interface1"
   if bEcho=.true then call time 'reset'
   do i=1 to 10
   	f=BSF("getStaticValue", javaClassName, "INT_i1") -- instance field
   	self~assertEquals(11, f)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end

   javaClassName="java8.plain.Interface2"
   if bEcho=.true then call time 'reset'
   do i=1 to 10
   	f=BSF("getStaticValue", javaClassName, "INT_i2") -- instance field
   	self~assertEquals(22, f)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end

   javaClassName="java8.plain.Interface3"
   if bEcho=.true then call time 'reset'
   do i=1 to 10
   	f=BSF("getStaticValue", javaClassName, "INT_i3") -- instance field
   	self~assertEquals(33, f)
      if bEcho=.true then say "--- enf of loop #" i "elapsed time:" time("R")
   end



