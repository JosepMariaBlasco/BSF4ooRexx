      call bsf 'invoke', clzTest2, "staticVier", "true"
      self~assertEquals(bsf('invoke', clzTest2, "staticVier"                  ), .true              )

      if bEcho=.true then say "---//\\--- enf of loop #" i "elapsed time:" time("R") "---//\\---"
