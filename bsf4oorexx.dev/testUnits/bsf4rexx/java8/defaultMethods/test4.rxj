signal on syntax
clzT4=bsf.importClass("Test4")
t4=.bsf~new("Test4")
say "test4.rxj: t4~instanceMeth ..................>" t4~instanceMeth
clzI=bsf.loadClass("Interface")
say "test4.rxj: clzI~staticMeth('from_test4.rxj')>" clzI~staticMeth('from_test4.rxj')
exit 0

syntax:
  co=condition("object")
  say ppCondition2(co)
  exit -1

::requires "rgf_util2.rex"

::requires "BSF.CLS"
