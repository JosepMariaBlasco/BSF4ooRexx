signal on syntax
clzT1=bsf.importClass("Test1")
t1=.bsf~new("Test1")
say "test1.rxj: t1~instanceMeth ..................>" t1~instanceMeth
say "test1.rxj: Test1~staticMeth('from_test1.rxj')>" clzT1~staticMeth('from_test1.rxj')
exit 0

syntax:
  co=condition("object")
  say ppCondition1(co)
  exit -1

::requires "rgf_util2.rex"

::requires "BSF.CLS"

