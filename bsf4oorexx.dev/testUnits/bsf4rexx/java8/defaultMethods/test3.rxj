signal on syntax
clzT3=bsf.importClass("Test3")
t3=.bsf~new("Test3")
say "test3.rxj: t3~instanceMeth ..................>" t3~instanceMeth
clzI=bsf.loadClass("Interface")
say "test3.rxj: clzI~staticMeth('from_test3.rxj')>" clzI~staticMeth('from_test3.rxj')
exit 0

syntax:
  co=condition("object")
  say ppCondition2(co)
  exit -1

::requires "rgf_util2.rex"

::requires "BSF.CLS"

