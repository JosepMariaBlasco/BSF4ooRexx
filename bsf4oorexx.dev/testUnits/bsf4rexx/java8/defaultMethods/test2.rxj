signal on syntax
clzT2=bsf.importClass("Test2")
t2=.bsf~new("Test2")
say "test2.rxj: t2~instanceMeth ..................>" t2~instanceMeth
say "test2.rxj: Test2~staticMeth('from_test2.rxj')>" clzT2~staticMeth('from_test2.rxj')
exit 0

syntax:
  co=condition("object")
  say ppCondition2(co)
  exit -1

::requires "rgf_util2.rex"

::requires "BSF.CLS"

