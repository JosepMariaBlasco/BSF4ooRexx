[Desktop Entry]
Version=1.0
Type=Application
Name=Rexx Script
NoDisplay=true
Name[de]=Rexx Skript
GenericName=RexxScript
Comment=Rexx or ooRexx script executed by ooRexx.
# Icon=oorexx_logo
Icon=oorexx
# MimeType=application/x-rexx;application/x-rexx-java;application/x-rexx-java-ooo;
MimeType=application/x-rexx;
TryExec=rexx
Exec=rexx %f
Terminal=true
Categories=Utility;

