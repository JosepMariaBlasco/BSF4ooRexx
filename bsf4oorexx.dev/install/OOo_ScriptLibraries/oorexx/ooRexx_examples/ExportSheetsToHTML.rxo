#!/usr/bin/env rexx
/* Modelled after the JavaScript example supplied by OOo.
   Rony G. Flatscher, 2010-06-10, WU, Wien/Vienna, Austria
*/

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)     -- get the xScriptContext object
oDoc  =scriptContext~getDocument -- get the document object
xSDoc =oDoc~XSpreadsheetDocument -- get the XSpreadsheetDocument interface
xModel=oDoc~XModel               -- get the XModel interface
xStorable=xSDoc~XStorable        -- get the XStorable interface used to save the document
   -- get the XModifiable interface used to indicate if the document has been changed
xModifiable=xSDoc~XModifiable
   -- get the XIndexAccess interface used to access each sheet
xSheetsIndexAccess=xSDoc~getSheets~XIndexAccess

-- set up an array of PropertyValue objects used to save each sheet in the document
storeProps=uno.createArray("com.sun.star.beans.PropertyValue",1)
storeProps[1]=uno.createProperty("FilterName", "HTML (StarCalc)")

storeUrl=xModel~getURL
storeUrl=left(storeUrl, lastPos('.',storeUrl)-1)   -- remove file type

-- set only one sheet visible, and store to HTML doc
do i=0 to i<xSheetsIndexAccess~getCount
	call setAllButOneHidden xSheetsIndexAccess, i
	xModifiable~setModified(.false)
	xStorable~storeToURL(storeUrl || "_sheet" || (i+1) || ".html", storeProps)
end

-- now set all visible again
do i=0 to i<xSheetsIndexAccess~getCount
   xPropSet=xSheetsIndexAccess~getByIndex(i)~XPropertySet
	xPropSet~setPropertyValue("IsVisible", box("bool",.true))
end

::requires UNO.CLS   -- get UNO support (using the UNO-Java-bridge)

::routine setAllButOneHidden
  use arg xSheetsIndexAccess, vis

   -- get an XPropertySet interface for the vis-th sheet
   xPropSet=xSheetsIndexAccess~getByIndex(vis)~XPropertySet
    -- set the vis-th sheet to be visible
	xPropSet~setPropertyValue("IsVisible", box("bool",.true))

    -- set all other sheets to be invisible
   do i=0 to i<xSheetsIndexAccess~getCount
      if i=vis then iterate
      xPropSet=xSheetsIndexAccess~getByIndex(i)~XPropertySet
      xPropSet~setPropertyValue("IsVisible", box("bool",.false))
   end

