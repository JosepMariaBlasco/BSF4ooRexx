#!/usr/bin/env rexx
/* Modelled after the BeanShell example supplied by OOo.
   Rony G. Flatscher, 2010-06-10, WU, Wien/Vienna, Austria
*/

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  -- get the xScriptContext object
oDoc=scriptContext~getDocument               -- get the document object

runtime = bsf.loadClass("java.lang.Runtime")~getRuntime
generator = .bsf~new("java.util.Random")
date = .bsf~new("java.util.Date")

-- allocate a random number of bytes so that the data changes
len = trunc( generator~nextFloat * runtime~freeMemory / 5)
bytes = bsf.createJavaArray("byte.class", len)

sheet = createSpreadsheet(scriptContext)
call addData sheet, date~toString, runtime~totalMemory, runtime~freeMemory
call addChart sheet

return 0

::requires UNO.CLS   -- get UNO support (using the UNO-Java-bridge)

::routine createSpreadsheet
  use arg scriptContext

  loader=scriptContext~getDesktop~XComponentLoader
  comp  = loader~loadComponentFromURL("private:factory/scalc", "_blank", 4, .uno~noProps)
  doc   = comp~XSpreadSheetDocument
  index = doc~getSheets~XIndexAccess
  sheet = index~getByIndex(0)~XSpreadSheet
  return sheet


::routine addData
  use arg sheet, date, total, free

  -- set the labels
  sheet~getCellByPosition(0, 0)~setFormula("Used")
  sheet~getCellByPosition(0, 1)~setFormula("Free")
  sheet~getCellByPosition(0, 2)~setFormula("Total")

  -- set the values in the cellt
  sheet~getCellByPosition(1, 0)~setValue(total - free)
  sheet~getCellByPosition(1, 1)~setValue(free)
  sheet~getCellByPosition(1, 2)~setValue(total)


::routine addChart
  use arg sheet

    rect = .bsf~new("com.sun.star.awt.Rectangle")
    rect~X = 500
    rect~Y = 3000
    rect~Width = 10000
    rect~Height = 8000

    range = sheet~XCellRange
    myRange = range~getCellRangeByName("A1:B2")

    rangeAddr = myRange~XCellRangeAddressable
    myAddr = rangeAddr~getRangeAddress

    addr=bsf.createJavaArrayOf("com.sun.star.table.CellRangeAddress", myAddr)

    supp = sheet~XTableChartsSupplier
    charts = supp~getCharts
    charts~addNewByName("Example", rect, addr, .false, .true)

    call sysSleep 3

    -- get the diagram and Change some of the properties
    chartsAccess = charts~XNameAccess
    tchart = chartsAccess~getByName("Example")~XTableChart
    eos    = tchart~XEmbeddedObjectSupplier
    xifc   = eos~getEmbeddedObject

    xChart = xifc~XChartDocument
    xDocMSF = xChart~XMultiServiceFactory

    diagObject = xDocMSF~createInstance("com.sun.star.chart.PieDiagram")
    xDiagram = diagObject~XDiagram
    xChart~setDiagram(xDiagram)

    propset = xChart~getTitle~XPropertySet
    propset~setPropertyValue("String", "JVM Memory Usage");

