If arg(1)='?' Then Do
  Parse Source source
  Say source
  Say 'Get the Java System Properties from java.lang.System'
  Say 'and show them on the console'
  Say '  (1) using store'
  Say '  (2) using storeToXML'
  Say 'This is the only one showing user.timezone correctly'
  Exit
  End

system=.bsf~bsf.loadClass("java.lang.System")   -- get the class object
outStream=system~out    -- get the standard output stream

      -- store all properties in the property file format to standard out (the console)
system~getProperties~store(outStream, "this is from ooRexx on:" date("S") time())

say copies("=",70)
      -- store all properties in the XML property file format to standard out (the console)
      -- needs Java >= 1.5
system~getProperties~storeToXML(outStream, "this is from ooRexx on:" date("S") time())

::requires BSF.CLS      -- get the BSF4Rexx support for ooRexx