/*
   name:    demoJSO.rxj
   purpose: demonstrate how to retrieve a reference to the Java string object ("JSO") that method
            invocations and read access to fields and properties might return, rather than
            having the default and transparent translation to a Rexx string
   author:  Rony G. Flatscher
   date:    2014-10-05

   last change: $Revision: 491 $ $Author: rony $ $Date: 2009-10-17 19:50:02 +0200 (Sat, 17 Oct 2009) $
   changes: ---

   license:

    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2001-2009 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

d=.bsf~new("java.awt.Dimension", 12, 34)  -- create a Dimension object

say "d~tostring           :" d~tostring
say
say "d~bsf.invoke(...)    :" d~bsf.invoke("toString")    -- returns a Rexx string
say "d~bsf.invokeJSO(...) :" d~bsf.invokeJSO("toString") -- returns a reference to the JSO
say
say "d~bsf.invokeStrict   :" d~bsf.invokeStrict("toString")    -- returns a Rexx string
say "d~bsf.invokeStrictJSO:" d~bsf.invokeStrictJSO("toString") -- returns a reference to the JSO
say
say "-"~copies(50)

say
clzName="java.awt.BorderLayout"
clz=bsf.importClass(clzName)
field="NORTH"

say "Working with class" pp(clzName)", retrieving the static String field" pp(field)":"
say
say "clz~bsf.getFieldValue(..)         :" clz~bsf.getFieldValue(field)
say "clz~bsf.getFieldValueJSO(..)      :" clz~bsf.getFieldValueJSO(field)
say
say "clz~bsf.getFieldValueStrict(..)   :" clz~bsf.getFieldValueStrict(field)
say "clz~bsf.getFieldValueStrictJSO(..):" clz~bsf.getFieldValueStrictJSO(field)
say

say "-- routines:"
say
say "bsf.getStaticValue(..)            :" bsf.getStaticValue(clzName,field)
say "bsf.getStaticValueJSO(..)         :" bsf.getStaticValueJSO(clzName,field)
say
say "bsf.getStaticValueStrict(..)      :" bsf.getStaticValueStrict(clzName,field)
say "bsf.getStaticValueStrictJSO(..)   :" bsf.getStaticValueStrictJSO(clzName,field)
say
say "bsf.getConstant(..)               :" bsf.getConstant(clzName,field)
say "bsf.getConstantJSO(..)            :" bsf.getConstantJSO(clzName,field)


::requires bsf.cls
