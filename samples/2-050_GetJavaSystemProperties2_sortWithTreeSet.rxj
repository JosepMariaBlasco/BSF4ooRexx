#!/usr/bin/env rexx
/*
   name:    2-050_GetJavaSystemProperties2_sortWithTreeSet.rxj
   changed: 05 July 2009 Walter Pachl add help and display line separator in hex
            2022-01-20, rename program to indicate what it demonstrates
   last change: $Revision: 564 $ $Author: rony $ $Date: 2010-02-10 18:03:08 +0100 (Wed, 10 Feb 2010) $
   license:
    ------------------------ Apache Version 2.0 license -------------------------
