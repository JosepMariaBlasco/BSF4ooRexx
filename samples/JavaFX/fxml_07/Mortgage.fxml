<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<!-- processing instruction (PI) that defines the Java script engine named 'rexx'
     to be used to execute programs (fx:script or in event attributes) -->
<?language rexx?>

<AnchorPane id="AnchorPane" fx:id="idRoot" prefHeight="104.0" prefWidth="244.0" xmlns="http://javafx.com/javafx/8.0.65" xmlns:fx="http://javafx.com/fxml/1">

    <children>
      <GridPane fx:id="idGridPane" layoutY="11.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" prefWidth="85" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="200" />
          <ColumnConstraints />
        </columnConstraints>

        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <padding>
                <Insets bottom="20" left="20" right="20" top="10" />
        </padding>


         <children>
                <!-- Column # 0 -->
                <Label text="Credit Amount" fx:id="idCreditLabel"   prefWidth="75" alignment="BASELINE_RIGHT" />
                <Label text="Interest Rate" fx:id="idInterestLabel" prefWidth="75" alignment="BASELINE_RIGHT"
                                                                 GridPane.rowIndex="2" />
                <Label text="# Months"      fx:id="idMonthsLabel"   prefWidth="75" alignment="BASELINE_RIGHT"
                                                                 GridPane.rowIndex="3" />

                <Label text="Monthly Payment Rate" minWidth="100" prefWidth="195" alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Total Accumulated Payments" minWidth="100" prefWidth="195" alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <!-- Column # 1 -->
                <Slider fx:id="idCreditSlider" blockIncrement="10000" majorTickUnit="10000" max="999999999.99" value="350000"
                                                                GridPane.columnIndex="1" />
                <Slider fx:id="idInterestSlider" blockIncrement="0.1" max="20.0" value="15.0"
                                                                GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Slider fx:id="idMonthsSlider" blockIncrement="1" min="1" max="360" value="180"
                                                                GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <!-- Column # 2 -->
                <TextField fx:id="idCreditTextField" text="350000.00" alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="2" />

                <TextField fx:id="idFormattedCreditTF"  disable="true" alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="2" GridPane.rowIndex="1" />

                <TextField fx:id="idInterestTextField" text="15.0"  alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="2" GridPane.rowIndex="2" />

                <TextField fx:id="idMonthsTextField" text="180"   alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="2" GridPane.rowIndex="3" />

                <TextField fx:id="idRateTextField" disable="true"   alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="2" GridPane.rowIndex="4" />

                <TextField fx:id="idTotalAccumulatedPaymentsTextField" disable="true" alignment="BASELINE_RIGHT"
                                        GridPane.columnIndex="2" GridPane.rowIndex="5" />

                <Button maxWidth="135.0" text="Calculate" defaultButton="true"
                                        onAction="call rexxCalculateButtonPressed arg(arg()) /* pass on slotDir argument*/"
                                        prefHeight="22.0" prefWidth="135.0"
                                        GridPane.columnIndex="2" GridPane.rowIndex="6" />
         </children>

         <!-- defines entries for ScriptContext bindings, public routine 'klickButton' -->
         <fx:script source="MortgageController.rex" />

      </GridPane>
    </children>

    <!-- save all fx:id objects defined so far in ".environment~my.app~Mortgage.fxml" -->
    <fx:script source="put_FXID_objects_into.my.app.rex" />

</AnchorPane>
