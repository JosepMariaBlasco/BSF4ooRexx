#!/usr/bin/env rexx
/*
   author:  Rony G. Flatscher

   name:    javafx_update_GUI-from-non-GUI-thread.rxj

   date:    2018-07-19

   purpose: this JavaFX GUI application demonstrates how to update a GUI object (a Label)
            from a non-GUI thread using the methods of the public class .FxGuiThread defined
            in BSF.CLS


            Note: GUIs are usually implemented single threaded and managed on a separate
                  thread, usually named "GUI thread" or "awt thread" in the case of awt/swing
                  or "FX Application Thread" in the case of JavaFX.

                  After building the GUI proper interactions with the GUI objects is only
                  allowed on the GUI thread, otherweise unpredictable results may occur, from
                  hangs to exceptions!

                  Usually the GUI objects get callbacks assigned to them, e.g. for Button
                  objects, which will be called on the GUI thread and as such it is safe
                  for such Rexx code to directly interact with the GUI objects.

                  However, sometimes it may become necessary to interact with GUI objects
                  from code that does never run on the GUI thread (e.g. a long lasting
                  process that updates the GUI to give the user feedback about its state).
                  For such use cases GUI systems usually have a means on board which allows
                  for registering code that will be dispatched the next time the GUI manager
                  works on the GUI thread after having serviced all GUI events.

                  The ooRexx class *.FxGuiThread* defined in BSF.CLS is the Rexx means for
                  allowing such deferred, later execution of Rexx messages on the GUI thread
                  for *JavaFX GUI objects*, allowing the invoked Rexx code to directly interact
                  with GUI objects.

                  The method runLater(...) and runLaterLatest(...) expect the same arguments
                  as the ooRexx fundamental class .Message expects and returns a GUIMessage
                  object that possesses the same methods as the ooRexx .Message class.

                  The time between invoking runLater() or runLaterLatest() and having them
                  dispatched on the GUI thread is usually a very small fraction of a second,
                  which the user usually does not notice (it appears to them to execute
                  immediately). runLaterLatest() differs from runLater(), in that it removes
                  duplicate messages to the same target.

   changes: 2018-09-29, rgf: - commented "call SysSleep 0.001" which should not be needed for ooRexx 5.0
                             - if stopping, do not clear label anymore
            2018-10-07, rgf: - if running on pre ooRexx 5.0 use SysSleep() in loop to help avoid hangs
            2019-08-08, rgf: - if ooRexx smaller version 5.0, ask user whether to proceed
            2020-08-12, rgf: - changing ppCondition2() to the new BSF.CLS routine ppJavaExceptionChain()
                             - removing dependency on "rgf_util2.rex"
            2025-08-28, rgf: - remove warning to run on 5.0 or later, as this is now a given
                             - added infoPrefix to say statements

   license: Apache License 2.0 (see at bottom)

   invoke:

         rexx javafx_update_GUI-from-non-GUI-thread.rxj
         rexxj.{cmd|sh} javafx_update_GUI-from-non-GUI-thread.rxj

   needs: ooRexx 5.0 or higher, and BSF4ooRexx850 or higher

*/

signal on syntax
rxApp=.RexxApplication~new  -- create Rexx object that will control the FXML set up
   -- rxApp will be used for "javafx.application.Application"
jrxApp=BSFCreateRexxProxy(rxApp, ,"javafx.application.Application")
jrxApp~launch(jrxApp~getClass, .nil)   -- launch the application, invokes "start"

.SOME_REXX_CLASS~stopRexxThread=.true  -- make sure we leave non-GUI thread, otherwise this app hangs here
call syssleep .0001              -- give ooRexx some closing time
exit

syntax:
  co=condition("object")
  say ppJavaExceptionChain(co)   -- display Java exception chain
  exit -1

::requires "BSF.CLS"    -- get Java support

-- Rexx class defines "javafx.application.Application" abstract method "start"
::class RexxApplication -- implements the abstract class "javafx.application.Application"
::method start          -- Rexx method "start" implements the abstract method
  use arg primaryStage  -- fetch the primary stage (window)
  primaryStage~setTitle("Demo Howto Update JavaFX GUI from A Non-GUI Thread")

  -- get Java class objects to ease access to their constants (static fields)
  colorClz=bsf.loadClass("javafx.scene.paint.Color") -- JavaFX colors
  cdClz=bsf.loadClass("javafx.scene.control.ContentDisplay") -- ContentDisplay constants
  alClz=bsf.loadClass("javafx.geometry.Pos")      -- alignment constants (an Enum class)

  root=.bsf~new("javafx.scene.layout.AnchorPane") -- create the root node
  root~prefHeight=200           -- or: root~setPrefHeight(200)
  root~prefWidth=800            -- or: root~setPrefWidth(400)

      -- define the Label
  font=.bsf~new("javafx.scene.text.Font", "Courier", 12)

  lbl=.bsf~new("javafx.scene.control.Label")
  lbl~setFont(font)
  lbl~textFill=colorClz~OLIVEDRAB      -- or: lbl~setTextFill(colorClz~OLIVEDRAB)
  lbl~setLayoutX(20)            -- or: lbl~layoutX=76
  lbl~setLayoutY(138)           -- or: lbl~layoutY=138
  lbl~prefHeight="16.0"         -- or: lbl~setPrefHeight("16.0")
  lbl~prefWidth="780.0"         -- or: lbl~setPrefWidth("680.0")
  lbl~contentDisplay=cdClz~CENTER       -- or: lbl~setContentDisplay (cdClz~CENTER)
  lbl~alignment=alClz~valueOf("CENTER") -- or: lbl~setAlignment(alClz~valueOf("CENTER"))

      -- define and add the Button, assign values as if we deal with Rexx attributes
  .local~btn.StartText="Start a Rexx Thread!"
  .local~btn.StopText ="Stop the Rexx Thread!"
  btn=.bsf~new("javafx.scene.control.Button")
  btn~textFill=colorClz~NAVY    -- or: btn~setTextFill(colorClz~NAVY)
  btn~layoutX=330               -- or: btn~setLayoutX(135)
  btn~layoutY=89                -- or: btn~setLayoutY(89)
  btn~text=.btn.StartText       -- or: btn~setText(.btn.StartText)

      -- create a Rexx ButtonHandler, wrap it up as a Java RexxProxy
  rh=.RexxButtonHandler~new(lbl)-- create Rexx object, supply it the label "lbl"
  jrh=BSFCreateRexxProxy(rh, ,"javafx.event.EventHandler")
  btn~setOnAction(jrh)          -- forwards "handle" message to Rexx object
      -- add the button and label to the AnchorPane object
  root~getChildren~~add(btn)~~add(lbl)
      -- put the scene on the stage
  primaryStage~setScene(.bsf~new("javafx.scene.Scene", root))
  primaryStage~show -- show the stage (window) with the scene

/* ------------------------------------------------------------------------ */
   -- Rexx class which handles the button presses
::class RexxButtonHandler   -- implements "javafx.event.EventHandler" interface
::method init       -- Rexx constructor method
  expose label      -- allow direct access to ooRexx attribute
  use arg label     -- save reference to javafx.scene.control.Label

::method handle     -- will be invoked by the Java side
  expose label      -- allow direct access to ooRexx attribute, not used in this example
  use arg event, slotDir    -- expected arguments

  infoPrefix=pp("R".context~interpreter) pp("T".context~thread) pp("I".context~invocation)

  btn=event~source
  if btn~text=.btn.StartText then
  do
     say infoPrefix self"::handle - starting Rexx thread"
     btn~text=.btn.StopText
     .some_rexx_class~update_gui_from_rexx_thread(label)
  end
  else
  do
     say infoPrefix self"::handle - stopping Rexx thread"
     .some_rexx_class~stopRexxThread=.true   -- have Rexx thread stop updating the label!
     call sysSleep .01
     btn~text=.btn.StartText
  end


/* ------------------------------------------------------------------------ */
::class SOME_REXX_CLASS
::attribute stopRexxThread CLASS UNGUARDED   -- allow concurrent interactions with attribute

::method update_gui_from_rexx_thread class
  expose stopRexxThread
  use arg label         -- GUI object to interact with
  infoPrefix=pp("R".context~interpreter) pp("T".context~thread) pp("I".context~invocation)
  say infoPrefix self"::updateGuiFromRexxThread - just arrived, GUI thread:" bsfGetTid()
  reply
      -- this runs on a new thread
  infoPrefix=pp("R".context~interpreter) pp("T".context~thread) pp("I".context~invocation)
  tid=bsfGetTid()
  say infoPrefix self"::updateGuiFromRexxThread - now running on thread:" tid
  rexxVersion=.bsf4rexx~rexx.version
  stopRexxThread=.false
  startDateTime=.dateTime~new    -- take start date and time
  loop i=1 while stopRexxThread<>.true
     now=.dateTime~new           -- take current date and time
     duration=now-startDateTime  -- calculation duration

     if duration~totalMicroseconds=0 then -- in the beginning ooRexx could be too fast :)
        loopSec=""
     else      -- show loops per seconds
        loopsSec=", loops/sec="pp(myFormat(format((i/duration~totalMicroseconds)*1000000,,0)))

     str=now || loopsSec", loop #" myFormat(i)": value from non-GUI Rexx thread" pp(tid)
     .FxGuiThread~runLaterLatest(label, "setText", "i", str)
     if rexxVersion<5 then    -- pre ooRexx versions prior to 5.0 exhibit multithreaded problems causing sometimes hangs
        call SysSleep 0.0001  -- sleep a bit, relinquishes the Rexx thread
  end
  endDateTime=.dateTime~new
  totalDuration=(endDateTime-startDateTime)
  totalLoops=i-1
  loopsSec="| total" "loops:" pp(myFormat(totalLoops)) "duration:" pp(totalDuration) -
           "loops/sec="pp(myFormat(format((totalLoops/totalDuration~totalMicroseconds)*1000000,,0)))
  say infoPrefix self"::updateGuiFromRexxThread - now stopping executing on thread:" tid loopsSec
  say

::routine myFormat   -- format a number American style, i.e. inject comma to indicate a thousand group
  parse arg num
  if num~length<4 then return num

  res=""
  revNum=num~reverse
  do while revNum<>""
     parse var revNum group +3 revNum
     if res="" then res=group
               else res=res","group
  end
  return res~strip~reverse


