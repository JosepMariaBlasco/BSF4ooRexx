#!/usr/bin/env rexx
/*
   Name:       javafx_dialog_demo.rxj
   author:     Rony G. Flatscher
   date:       2018-07-18
   purpose:    demonstrate using the JavaFX dialog classes that got introduced with JavaFX 8u40,
               cf. <http://code.makery.ch/blog/javafx-dialogs-official/>
               these ooRexx examples are the ooRexx equivalents of the above code examples

   note:       this is a standalone demonstration program that uses JavaFX which must be
               initialized prior to using JavaFX dialogs, otherwise a "java.lang.IllegalStateException:
               Toolkit not initialized" error will occur; there are two possible options:
               - one is to create a "javafx.application.Application" and run the demo from
                 its 'start' method
               - the other one is to initialize the Java class "javafx.embed.swing.JFXPanel" and
                 dispatch the JavaFX dialog code on the FX Application Thread by using BSF's class
                 .FxGuiThread and its method 'runLater'; in this mode it is possible that focusing
                 via .FxGuiThread is overriden by awt/swing (and therefore not working correctly)

   changes: 2018-07-22, rgf: prepended file name in creating Image with "file:" to allow it to find
               the bitmap in the current directory

            2020-08-12, rgf: - changing ppCondition2() to the new BSF.CLS routine ppJavaExceptionChain()                     

   last change: $Revision: 564 $ $Author: rony $ $Date: 2010-02-10 18:03:08 +0100 (Wed, 10 Feb 2010) $

   changed:
               ---

   license:

    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2018-2020 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

signal on syntax     -- if something goes wrong on the Java side, this will give us the Java exception chain

 -- change to the directory where the program resides (we have relative paths to png-files in this program)
parse source  . . pgm               -- get full path to our program
call directory filespec('L', pgm)   -- change locally to the directory this program resides

   -- import some JavaFX classes that we need to use, supply environment name to use for easier retrieval
call bsf.import "javafx.application.Platform"         , "fxPlatform"

call bsf.import "javafx.scene.control.Alert"          , "fxAlert"
call bsf.import "javafx.scene.control.Alert$AlertType", "fxAlertType"         -- nested enumeration class, hence "$" instead of "."
call bsf.import "javafx.scene.control.ButtonType"     , "fxButtonType"
call bsf.import "javafx.scene.control.ButtonBar$ButtonData", "fxButtonData"   -- nested enumeration class, hence "$" instead of "."
call bsf.import "javafx.scene.control.ChoiceDialog"   , "fxChoiceDialog"
call bsf.import "javafx.scene.control.Dialog"         , "fxDialog"
call bsf.import "javafx.scene.control.Label"          , "fxLabel"
call bsf.import "javafx.scene.control.TextArea"       , "fxTextArea"
call bsf.import "javafx.scene.control.TextField"      , "fxTextField"
call bsf.import "javafx.scene.control.TextInputDialog", "fxTextInputDialog"

call bsf.import "javafx.scene.image.ImageView"        , "fxImageView"

call bsf.import "javafx.scene.layout.Priority"        , "fxPriority"
call bsf.import "javafx.scene.layout.GridPane"        , "fxGridPane"

call bsf.import "javafx.stage.StageStyle"             , "fxStageStyle"

   -- start interaction with user
say 'This demo uses JavaFX dialogs, so the JavaFX Toolkit needs to be initialized!'
say
say 'Use from within (1) JavaFX Application (default) or from (2) awt/swing (JFXPanel)?'
parse pull input .
.local~bUseJFXPanel=.false    -- by default use javafx.application.Application
if input=1 | input="" then    -- run from within a JavaFX Application
do
   say "(1) -> using the JavaFX toolkit initialized via 'javafx.application.Application'..."
   say
   rxApp=.dummyFXApplication~new          -- create Rexx object that will control the FXML set up
   jrxApp=BSFCreateRexxProxy(rxApp, ,"javafx.application.Application")
   jrxApp~launch(jrxApp~getClass, .nil)   -- launch the application, invokes "start"
end

else if input=2 then -- run from awt/swing, hence need to use class .FxGuiThread
do
   say "(2) -> using the JavaFX toolkit initialized via 'javafx.embed.swing.JFXPanel'..."
   say
   say 'Creating an instance of the Java class "javafx.embed.swing.JFXPanel":'
   fxPanel = .bsf~new("javafx.embed.swing.JFXPanel")
   .local~bUseJFXPanel=.true     -- indicate that this run uses JFXPanel
   say 'now JavaFX is initialized and we may take advantage of the JavaFX dialogs from the'
   say 'FX Application Thread (using method ''runLater'' in the BSF class ''FxGuiThread'').'
   say
   msg=.FxGUIthread~runLater(.demoJavaFXDialogs, "showOff") -- dispatch on the FX Application thread
   res=msg~result      -- wait until msg was processed
end

else
do
   say "you entered:" pp(input)", valid values are '1' or '2'"
   exit -1
end
say "done."
exit

syntax:
   co=condition("object")     -- get all condition information
   say ppJavaExceptionChain(co)   -- display Java exception chain
   exit -1

::requires BSF.CLS
::requires "rgf_util2.rex"    -- to get access to ppCondition2()

/* =========================================================================== */
/* =========================================================================== */
   -- this Rexx class implements the abstract method "start" of "javafx.application.Application"
   -- that does nothing; using this dummy application still causes JavaFX to initialize, which
   -- is needed if using standalone JavaFX dialogs

/** This Rexx class implements the abstract method 'start' of "javafx.application.Application"
 *  which will get invoked on the FX Applicataion Thread. It merely invokes the 'showOff'
 *  method of the Rexx class .demoJavaFXDialogs and then causes the application to be closed
 *  via the Java "javafx.application.Platform" class.
*/
::class dummyFXApplication
/* =========================================================================== */
::method start             -- will run on the FX Application Thread so directly interacting with JavaFX controls is o.k.
  use arg stage, slotDir   -- just to document the arguments; we do not need them for this purpose

  say "--> START method of 'dummyFXApplication' running on the FX Application Thread"
  say
  .demoJavaFxDialogs~showOff  -- demo some of the JavaFX Dialogs
  .fxPlatform~exit          -- close this JavaFX Application
  say
  say "<-- START method of 'dummyFXApplication': about to return from the START method."


/* =========================================================================== */
/* =========================================================================== */
/** The methods of this Rexx class need to be invoked on the FX Application Thread
*   as they demonstrate some of the JavaFX Dialog classes.
*/
::class demoJavaFXDialogs

/* =========================================================================== */
::method showOff class        -- this method must be invoked on the FX Application Thread

   say "-"~copies(100)
  say "Demonstrating some of the standard JavaFX Dialogs (since JavaFX 8u40) ..."
  say
/* temporarily commented out:
*/
  self~demoInformationDialog
  self~demoInformationDialogWithTextArea
  self~demoDialogBoxes
  self~demoTextInputDialog
  self~demoChoiceDialog
  self~demoCustomizedDialog

/* =========================================================================== */
::method demoInformationDialog class      -- demonstrate the information Alert dialog
   say
   say "Information Dialog with title, header and content"
   say
   say "type: INFORMATION (cf. icon)"
   alert=.fxAlert~new(.fxAlertType~INFORMATION)    -- create Alert dialog
   alert~title      ="Information Dialog (see icon) from ooRexx"
   alert~headerText ="This is a header text available in FX dialogs"
   alert~contentText="This is the information message, created at" pp(.dateTime~new)
   res=alert~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'alert~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)

   say "type: ERROR (cf. icon)"
   alert=.fxAlert~new(.fxAlertType~ERROR)          -- create Alert dialog
   alert~title      ="Error Dialog (see icon) from ooRexx"
   alert~headerText ="This is a header text available in FX dialogs"
   alert~contentText="This is the error message, created at" pp(.dateTime~new)
   res=alert~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'alert~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)

   say "type: CONFIRMATION (cf. icon, two buttons)"
   alert=.fxAlert~new(.fxAlertType~CONFIRMATION)   -- create Alert dialog: has OK and CANCEL button
   alert~title      ="Confirmation Dialog (see icon, two buttons) from ooRexx"
   alert~headerText ="This is a header text available in FX dialogs"
   alert~contentText="This is the confirmation message, created at" pp(.dateTime~new)
   res=alert~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'alert~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)
   val=res~get             -- gets the ButtonType object from the result
   ok=.fxButtonType~ok     -- gets the ButtonType object from the ButtonType class
   -- val and ok may be different ooRexx objects, although referring to the same Java object;
   -- if val and ok represent the same ButtonType then their ButtonType text is the same:
   if val~getText=ok~getText then
      say "   --> you pressed the OK button!"
   else
      say "   --> you pressed the CANCEL button!"

   say "type: WARNING (cf. icon)"
   alert=.fxAlert~new(.fxAlertType~WARNING)        -- create Alert dialog
   alert~title      ="Warning Dialog (see icon) from ooRexx"
   alert~headerText ="This is a header text available in FX dialogs"
   alert~contentText="This is the warning message, created at" pp(.dateTime~new)
   res=alert~showAndWait    -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'alert~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)

   say "-"~copies(79)


/* =========================================================================== */
::method demoInformationDialogWithTextArea class      -- demonstrate the information Alert dialog
   say
   say "Error Dialog with title, header and content"
   say
   say "type: ERROR (cf. icon)"
   say
   say "** causing a Rexx error condition, which can be looked at"
   say
   signal on syntax
   rexxCode="say '   >>> from an interpreted Rexx program: hello, world'",                 -
            "say '   >>> this running Rexx program causes a syntax exception on purpose'", -
            "a=1/0    -- a divide by 0 runtime error"
   interpret rexxCode~toString(, ';')
   exit

syntax:
   co=condition("object")        -- get the condition object (a Rexx directory)
   coText=ppCondition2(co)       -- format condition object as a string

   alert=.fxAlert~new(.fxAlertType~ERROR)          -- create Alert dialog
   alert~title      ="Rexx Condition Raised (from ooRexx)"
   alert~headerText ="This is how a Rexx condition could be displayed."
   alert~contentText="A divide by 0 condition formatted with ppCondition2() ..." pp(.dateTime~new)

   label=.fxLabel~new("The Rexx condition was:")

   textArea=.fxTextArea~new(coText) -- assign Rexx condition text
   textArea~editable =.false     -- instead of textArea~setEditable(.false)
   textArea~wrapText =.true      -- instead of textArea~wrapText(.true)

   max_value=bsf.importClass("java.lang.Double")~MAX_VALUE
   textArea~maxWidth =max_value  -- instead of textArea~setMaxWidth(max_value)
   textArea~maxHeight=max_value  -- instead of textArea~setMaxHeight(max_value)
   .fxGridPane~setVgrow(textArea, .fxPriority~always)
   .fxGridPane~setHgrow(textArea, .fxPriority~always)

   expContent=.fxGridPane~new
   expContent~setMaxWidth(max_value)
   expContent~add(label,   0,0)
   expContent~add(textArea,0,1)

   -- instead of: alert~getDialogPane~setExpandableContent(expContent)
   dialogPane=alert~dialogPane
   dialogPane~expandableContent=expContent
   dialogPane~setPrefWidth(600)  -- make it wider to not clip the lines if opening drop-down

   say
   say "** to see the Rexx condition text click the <down> button or the text 'Show Details'!"

   res=alert~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'alert~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)
   say "-"~copies(79)
   return


/* =========================================================================== */
::method demoDialogBoxes class      -- demonstrate the information Alert dialog
   say
   say "Dialogs with title, header and content"
   say
   say "type: CONFIRMATION (cf. icon)"
   alert=.fxAlert~new(.fxAlertType~CONFIRMATION)   -- create Alert dialog: has OK and CANCEL button
   alert~title      ="Confirmation Dialog (see icon) from ooRexx"
   alert~headerText ="An important question!"
   alert~contentText="Shall we delete?, created at" pp(.dateTime~new)
   res=alert~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'alert~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)

   say
   say "type: CONFIRMATION (cf. icon) with many buttons"
   alert=.fxAlert~new(.fxAlertType~CONFIRMATION)   -- create Alert dialog: has OK and CANCEL button
   alert~title      ="Tickling Confirmation Dialog (see icon) from ooRexx"
   alert~headerText ="Please pick a button"
   alert~contentText="Choose person to tickle, created at" pp(.dateTime~new)

      -- define and assign buttons
   jarrBT=bsf.createJavaArray(.fxButtonType, 4)
   jarrBT[1]=.fxButtonType~new("Tickle Alice")     -- ButtonData: OTHER
   jarrBT[2]=.fxButtonType~new("Tickle Berta")     -- ButtonData: OTHER
   jarrBT[3]=.fxButtonType~new("Tickle Cindy")     -- ButtonData: OTHER
   jarrBT[4]=.fxButtonType~new("Cancel", .fxButtonData~CANCEL_CLOSE) -- create a CANCEL_CLOSE ButtonData type
   alert~buttonTypes~setAll(jarrBT)    -- alert.getButtonTypes().setAll(...)
   res=alert~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'alert~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)
   say "   button's text="pp(res~get~text)   -- get value from Optional, a ButtonType, query its text

   say "-"~copies(79)


/* =========================================================================== */
::method demoTextInputDialog class     -- demonstrate the information Alert dialog
   say
   say "TextInputDialog with title, header and content, an ImageView; supplying default text"
   say
   say "type: javafx.scene.control.TextInputDialog"
   defText="Isn't BSF4ooRexx (ooRexx+Java) great? ;)"
   dialog=.fxTextInputDialog~new(defText) -- create TextInputDialog: has OK and CANCEL button
   dialog~graphic=.fxImageView~new("file:bsf4oorexx_256.png")
   dialog~title      ="TextInputDialog from ooRexx"
   dialog~headerText ="This dialog returns the text you enter; created at" pp(.dateTime~new)
   dialog~contentText="Please enter something:"
   res=dialog~showAndWait     -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'dialog~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)
   if res~isPresent then say "   res~get="pp(res~get)
                    else say "   no result present! (ESCAPE pressed?)"
   say "-"~copies(79)


/* =========================================================================== */
::method demoChoiceDialog class     -- demonstrate the information Alert dialog
   say
   say "ChoiceDialog with title, header and content, an ImageView"
   say
   say "type: javafx.scene.control.ChoiceDialog"
      -- create a Java array of type String with the choices to supply
   jarrChoices=bsf.createJavaArrayOf(.java.lang.String, "Tickle Alice", "Tickle Berta", "Tickle Cindy")
   defChoice  ="Tickle Berta"
   dialog=.fxChoiceDialog~new(defChoice, jarrChoices)  -- create ChoiceDialog: has OK and CANCEL button
      -- this time we resize it to 128 pixel
   dialog~graphic=.fxImageView~new("file:oorexx4ooo_256.png")~~setFitWidth(128)~~setPreserveRatio(.true)~~setSmooth(.true)
   dialog~title      ="ChoiceDialog from ooRexx"

   lf="0a"x    -- insert line breaks in headerText
   dialog~headerText ="This dialog returns the text of" lf"the selected choice;" lf"created at" pp(.dateTime~new)
   dialog~contentText="Please pick a choice:"
   res=dialog~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'dialog~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)
   if res~isPresent then say "   res~get="pp(res~get)
                    else say "   no result present! (ESCAPE pressed?)"
   say "-"~copies(79)


/* =========================================================================== */
::method demoCustomizedDialog class     -- demonstrate the information Alert dialog
   say
   say "Customized Dialog with title, header and content, an ImageView, a TextField, a PasswordField"
   say
   say "type: javafx.scene.control.ChoiceDialog"

   dialog=.fxDialog~new   -- create a Dialog and customize it: has OK and CANCEL button
   dialogPane=dialog~dialogPane

   image=.bsf~new("javafx.scene.image.Image", "file:oorexx_256.png")
   dialogPane~scene~window~icons~add(image)  -- make it a system menu icon (upper left-hand corner)
   say
   say "note: custom icon in the upper left hand corner of the dialog"

      -- this time we resize the ImageView to 64 pixel
   imageView=.fxImageView~new(image)~~setFitWidth(64)~~setPreserveRatio(.true)~~setSmooth(.true)

   dialog~graphic=imageView
   dialog~title      ="Customized Dialog from ooRexx"
   dialog~headerText ="This dialog is meant for logins"

      -- define and assign buttons
   loginButtonType=.fxButtonType~new("Login", .fxButtonData~OK_DONE) -- use as the default push button
   jarrBT=bsf.createJavaArrayOf(.fxButtonType, loginButtonType, .fxButtonType~new("Cancel",.fxButtonData~CANCEL_CLOSE) )
   dialogPane~buttonTypes~setAll(jarrBT)    -- dialog.getButtonTypes().setAll(...)

      -- get loginButtonType node, disable it (should only be enabled, if username TextField has a value)
   loginButtonNode=dialogPane~lookupButton(loginButtonType) ~~setDisable(.true)

      -- define grid and the fields and labels it should contain
   grid=.fxGridPane~new ~~setHGap(10) ~~setVGap(10) ~~setPadding(.bsf~new("javafx.geometry.Insets", 20,150,10,10))

   userName=.fxTextField~new
   userName~promptText="Username"      -- will be displayed in light grey when field is empty
   grid~add(.fxLabel~new("Username:"), 0, 0)
   grid~add(userName,                  1, 0)

   password=.bsf~new("javafx.scene.control.PasswordField")
   password~promptText="Password"      -- will be displayed in light grey when field is empty
   grid~add(.fxLabel~new("Password:"), 0, 1)
   grid~add(password,                  1, 1)

      -- create a Rexx directory add the JavaFX objects to it, which we need to access on callbacks
   rexxDir=.directory~new
   rexxDir~loginButtonNode=loginButtonNode
   rexxDir~loginButtonType=loginButtonType
   rexxDir~username       =username
   rexxDir~password       =password
      -- wrap Rexx object into a Java proxy, denoting the Java interfaces the Rexx object supports
      -- the second argument is a Rexx value (a Rexx directory) which will be contained in the slotDir
      -- directory under the name "rexxDir"
   jobj=bsfCreateRexxProxy(.demoCustomizedDialogListener~new,rexxDir,"javafx.beans.value.ChangeListener","javafx.util.Callback")
   userName~textProperty~addListener(jobj)   -- add it as listener, gets invoked if field gets edited
   dialog~setResultConverter(jobj)           -- add it as result converter which defines the return value of the Dialog

   dialogPane~content=grid

      -- use the BSF Rexx class .fxGuiThread to have the Rexx message dispatched on the FX Application Thread later
   .fxGuiThread~runLater(userName, "requestFocus") -- place focus into the userName TextField
   if .bUseJFXPanel=.true then
   do
      say "HINT: focusing on the 'userName' TextField might not work correctly in JFXPanel-mode!"
--      .fxGuiThread~runLater(userName, "selectAll") -- select all
   end

   res=dialog~showAndWait      -- show the dialog, wait until user closes it, returns a java.util.Optional (isPresent(), get(), ...)
   say "   'dialog~showAndWait' returned res="pp(res)"; res~toString="pp(res~toString)
   if res~isPresent then
   do
       usernamePassword=res~get
       say "   Username="pp(usernamePassword~key)", Password="pp(usernamePassword~value)
   end
   else
       say "   no result present! (ESCAPE pressed?)"
   say "-"~copies(79)


/* This class is needed for changing the state of the Login-button in the "demoCustomizedDialog" method above.
   It implements two different functional methods:

   - 'changed(observable,oldValue,newValue)' from the functional interface 'javafx.beans.value.ChangeListener' and
   - 'call(param)' from the functional interface 'javafx.util.Callback'.

   Boxing a Rexx instance of this class using 'BsfCreateRexxProxy()' into a Java object, one can supply
   the two functional interface classes.

   The trailing argument named 'slotDir' (a subclass of the Rexx directory class named 'Slot.Argument')
   gets supplied by BSF4ooRexx and contains information about the Java method invocation and may
   contain an entry 'USERDATA' storing the second argument to 'BsfCreateRexxProxy()', if that was given.
*/
::class demoCustomizedDialogListener

-- javafx.beans.value.ChangeListener<T>: void changed(ObservableValue<? extends T> observable, T oldValue, T newValue)
::method changed              -- whenever the userName TextField gets edited
  use arg observable, oldValue, newValue, slotDir
  say "/1/" self"::changed: observable="pp(observable) "oldValue="pp(oldValue) "newValue="pp(newValue) "slotDir="pp(slotDir)

     -- fetch the loginButtonNode and set its disabled state accordingly
  slotDir~userData~loginButtonNode ~setDisable(newValue="")

-- javafx.util.Callback<P,R>: R call(P param): used by the Dialog's "ResultConverter"
::method call
  use arg param, slotDir
  say "\2\" self"::call:    param="pp(param) "slotDir="pp(slotDir)
  rexxDir=slotDir~userData    -- fetch the Rexx directory we supplied from the slotDir directory (supplied by BSF4ooRexx)

  if param~text==rexxDir~loginButtonType~text then
     return .bsf~new("javafx.util.Pair", rexxDir~username~getText, rexxDir~password~getText)

  return .nil

