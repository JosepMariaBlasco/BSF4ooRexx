#!/usr/bin/env rexx
/*
   author:  Rony G. Flatscher

   name:    3-090_update_awtSwing_GUI-from-non-GUI-thread.rxj

   date:    2018-07-19

   purpose: this awt/swt GUI application demonstrates how to update a GUI object (a Label)
            from a non-GUI thread using the methods of the public class .AwtGuiThread defined
            in BSF.CLS

            Note: GUIs are usually implemented single threaded and managed on a separate
                  thread, usually named "GUI thread" or "awt thread" in the case of awt/swing
                  or "FX Application Thread" in the case of JavaFX.

                  After building the GUI proper interactions with the GUI objects is only
                  allowed on the GUI thread, otherweise unpredictable results may occur, from
                  hangs to exceptions!

                  Usually the GUI objects get callbacks assigned to them, e.g. for Button
                  objects, which will be called on the GUI thread and as such it is safe
                  for such Rexx code to directly interact with the GUI objects.

                  However, sometimes it may become necessary to interact with GUI objects
                  from code that does never run on the GUI thread (e.g. a long lasting
                  process that updates the GUI to give the user feedback about its state).
                  For such use cases GUI systems usually have a means on board which allows
                  for registering code that will be dispatched the next time the GUI manager
                  works on the GUI thread after having serviced all GUI events.

                  The ooRexx class *.AwtGuiThread* defined in BSF.CLS is the Rexx means for
                  allowing such deferred, later execution of Rexx messages on the GUI thread
                  for *awt/swing GUI objects*, allowing the invoked Rexx code to directly interact
                  with GUI objects.

                  The method runLater(...) and runLaterLatest(...) expect the same arguments
                  as the ooRexx fundamental class .Message expects and returns a GUIMessage
                  object that possesses the same methods as the ooRexx .Message class.

                  The time between invoking runLater() or runLaterLatest() and having them
                  dispatched on the GUI thread is usually a very small fraction of a second,
                  which the user usually does not notice (it appears to them to execute
                  immediately). runLaterLatest() differs from runLater(), in that it removes
                  duplicate messages to the same target.

   license: Apache License 2.0 (see at bottom)

   invoke:

         rexx 3-090_update_awtSwing_GUI-from-non-GUI-thread.rxj
         rexxj.{cmd|sh} 3-090_update_awtSwing_GUI-from-non-GUI-thread.rxj

   needs: ooRexx 4.1 or higher, and BSF4ooRexx 6.00 or highter

    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2018 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

If arg(1)='?' Then Do
  Parse Source source
  Say source
  Say 'This program demonstrates how to update a GUI Label from a non-GUI Rexx thread'
  Exit
End

   --  create a framed Java window, set a title text
win=.bsf~new("java.awt.Frame", "Demo Howto Update An awt/swing GUI from A Non-GUI Thread")
win~setPreferredSize(.bsf~new("java.awt.Dimension", 640, 200))

   -- create a Java label, set it to show the text centered
lab=.bsf~new("java.awt.Label", " "~copies(160))
lab~setAlignment(lab~center)  -- set alignment to center

   -- create a Java push button and label it
.local~btn.StartText="Start a Rexx Thread!"
.local~btn.StopText ="Stop the Rexx Thread!"
but=.bsf~new("java.awt.Button", .btn.StartText)

   -- Create a Java RexxProxy for controlling the closing of the application
rEH =.RexxEventHandler~new(lab)  -- Rexx event handler

   -- Create Java RexxProxy for the Rexx event handler
jEH=BsfCreateRexxProxy(rEH, , "java.awt.event.WindowListener", "java.awt.event.ActionListener"  )
win~addWindowListener(jEH)    -- add boxed (RexxProxy) event handler

   -- Create a RexxProxy for the button Rexx event handler
but~addActionListener(jEH)     -- add boxed (RexxProxy) event handler
win ~~add("Center", lab) ~~add("South", but) -- add the label and the button to the frame
win ~~pack                    -- now calculate all widget dimensions

   -- position in center of screen
screenSize=win~toolkit~screenSize
winSize   =win~size
say "screenSize:" pp(screenSize~toString)
say "winSize   :" pp(winSize   ~toString)
xPos=trunc((screenSize~width  - winSize~width)/2)
yPos=trunc((screenSize~height - winSize~height)/2)
say "xPos="pp(xPos) "yPos="pp(yPos)
win~setLocation(xPos,yPos)

win ~~setVisible(.true) ~~toFront   -- make frame visible and move it to the front

rEH~waitForExit               -- wait for the GUI to get closed by the user
.some_rexx_class~stopRexxThread=.true  -- have Rexx thread stop updating the label!


::requires BSF.CLS      -- get Java support


/* ------------------------------------------------------------------------ */
   -- Rexx class which handles the button press and Window closing events and
   -- allows to block the main thread
::class RexxEventHandler
::method init        -- Rexx constructor method
  expose closeApp label
  use arg label      -- save reference to javafx.scene.control.Label
  closeApp  = .false -- if set to .true, then it is safe to close the app

::attribute closeApp          -- indicates whether app should be closed

::method waitForExit    -- method blocks until attribute is set to .true
  expose closeApp
  guard on when closeApp=.true

---------------------------------------------------------
::method actionPerformed   -- "java.awt.event.ActionListener" method, will be invoked by the Java side
  expose label closeApp    -- allow direct access to ooRexx attribute, not used in this example
  if closeApp=.true then return  -- do nothing, if we are supposed to close the app

  use arg event, slotDir   -- expected arguments
  btn=event~source         -- get Button object
  if btn~label=.btn.StartText then
  do
     say self"::actionPerformed - starting Rexx thread"
     btn~label=.btn.StopText  -- relabel the button
     .some_rexx_class~update_gui_from_rexx_thread(label) -- start non-GUI Rexx thread
  end
  else
  do
     say self"::actionPerformed - stopping Rexx thread"
     .some_rexx_class~stopRexxThread=.true   -- have Rexx thread stop updating the label!
     call sysSleep .01        -- give it some time to stop (not really necessary)
     btn~label=.btn.StartText -- relabel the button
  end
  return

---------------------------------------------------------
  -- the following methods implement the "java.awt.event.WindowListener" methods,
  -- the ooRexx "unknown" method intercepts all WindowListener method invocations
  -- that we are not interested in handling (otherwise Rexx will raise a runtime
  -- error 'object does not understand message'
::method unknown        -- intercept unhandled events, do nothing

::method windowClosing  -- event method (from WindowListener)
  expose closeApp
     say self"::windowClosing - unset lock 'closeApp=.true'"
  closeApp=.true        -- indicate that the app should close


/* ------------------------------------------------------------------------ */
::class SOME_REXX_CLASS
::attribute stopRexxThread CLASS UNGUARDED   -- allow concurrent interactions with attribute

::method update_gui_from_rexx_thread class
  expose stopRexxThread
  use arg label         -- GUI object to interact with
  say self"::updateGuiFromRexxThread - just arrived, GUI thread:" bsfGetTid()
  reply
  tid=bsfGetTid()
  say self"::updateGuiFromRexxThread - now running on thread:" tid
  stopRexxThread=.false
  loop while stopRexxThread<>.true
     .AwtGuiThread~runLaterLatest(label, "setText", "i", .dateTime~new": value from non-GUI Rexx thread" pp(tid))
     call SysSleep .0001   -- sleep a bit
  end
  say self"::updateGuiFromRexxThread - now stopping executing on thread:" tid
  .AwtGuiThread~runLater(label, "setText", "i", "") -- set Label's text to empty string
  say

