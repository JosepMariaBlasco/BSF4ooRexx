If arg(1)='?' Then Do
  Parse Source source
  Say source
  Say 'This program demonstrates how to update a GUI Label from a non-GUI Rexx thread'
  Exit
End


   -- Create a userData directory
-- userData=.directory~new    -- a directory which will be passed to Rexx with the event

   --  create a framed Java window, set a title text
win=.bsf~new("java.awt.Frame", "Demo Howto Update An awt/swing GUI from A Non-GUI Thread")

   -- create a Java label, set it to show the text centered
lab=.bsf~new("java.awt.Label", " "~copies(160))
lab~setAlignment(lab~center)  -- set alignment to center

   -- create a Java push button
.local~btn.StartText="Start a Rexx Thread!"
.local~btn.StopText ="Stop the Rexx Thread!"
but=.bsf~new("java.awt.Button", .btn.StartText)


   -- Create a Java RexxProxy for controlling the closing of the application
rEH =.RexxEventHandler~new(lab)  -- Rexx event handler

   -- Create Java RexxProxy for the Rexx event handler
jEH=BsfCreateRexxProxy(rEH, , "java.awt.event.WindowListener", "java.awt.event.ActionListener"  )
win~addWindowListener(jEH)    -- add boxed (RexxProxy) event handler

   -- Create a RexxProxy for the button Rexx event handler
but~addActionListener(jEH)     -- add boxed (RexxProxy) event handler
win ~~add("Center", lab) ~~add("South", but) -- add the label and the button to the frame
win ~~pack                    -- now calculate all widget dimensions

win ~~setVisible(.true) ~~toFront   -- make frame visible and move it to the front

rEH~waitForExit                  -- wait until we are allowed to end the program
.some_rexx_class~stopRexxThread=.true  -- have Rexx thread stop updating the label!

-- if Java was loaded by Rexx, then terminate Java's RexxEngine to inhibit callbacks from Java
call BSF.terminateRexxEngine


::requires BSF.CLS      -- get Java support


/* ------------------------------------------------------------------------ */
   -- Rexx class which handles the button presses
::class RexxEventHandler
::method init        -- Rexx constructor method
  expose closeApp label
  use arg label      -- save reference to javafx.scene.control.Label
  closeApp  = .false -- if set to .true, then it is safe to close the app

::attribute closeApp          -- indicates whether app should be closed

::method unknown              -- intercept unhandled events, do nothing

::method windowClosing        -- event method (from WindowListener)
  expose closeApp

  closeApp=.true              -- indicate that the app should close

::method waitForExit          -- method blocks until attribute is set to .true
  expose closeApp

  guard on when closeApp=.true


::method actionPerformed   -- will be invoked by the Java side
  expose label closeApp    -- allow direct access to ooRexx attribute, not used in this example

  if closeApp=.true then return  -- do nothing, if we are supposed to end everything

  use arg event, slotDir   -- expected arguments
  btn=event~source         -- get Button object
  if btn~label=.btn.StartText then
  do
     btn~label=.btn.StopText
     .some_rexx_class~update_gui_from_rexx_thread(label)
  end
  else
  do
     .some_rexx_class~stopRexxThread=.true   -- have Rexx thread stop updating the label!
     call sysSleep .01
     btn~label=.btn.StartText
  end
  return


::requires "BSF.CLS"    -- get Java support

::requires "rgf_util2.rex"    -- to get access to ppCondition2()



::class SOME_REXX_CLASS
::attribute stopRexxThread CLASS UNGUARDED   -- allow concurrent interactions with attribute

::method update_gui_from_rexx_thread class
  expose stopRexxThread
  use arg label         -- GUI object to interact with
  say self"::updateGuiFromRexxThread - just arrived, GUI thread:" bsfGetTid()
  reply
  tid=bsfGetTid()
  say self"::updateGuiFromRexxThread - now running on thread id:" tid
  stopRexxThread=.false
  loop while stopRexxThread<>.true
     .AwtGuiThread~runLaterLatest(label, "setText", "i", .dateTime~new": value from non-GUI Rexx thread" pp(tid))
     call SysSleep .0001   -- sleep a bit
  end
  .AwtGuiThread~runLater(label, "setText", "i", "") -- set Label's text to empty string



/* ------------------------------------------------------------------------ */
/* Rexx event handler to set "close app" indicator */
::class RexxCloseAppEventHandler
::method init        -- constructor
  expose closeApp
  closeApp  = .false   -- if set to .true, then it is safe to close the app

::attribute closeApp          -- indicates whether app should be closed

::method unknown              -- intercept unhandled events, do nothing

::method windowClosing        -- event method (from WindowListener)
  expose closeApp
  closeApp=.true              -- indicate that the app should close

::method waitForExit          -- method blocks until attribute is set to .true
  expose closeApp
  guard on when closeApp=.true




