#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited and extended by Rony G. Flatscher, 2010-07-19/20 */
/* Example 19: load the calc document from example 18, experiment a little bit with the embedded chart */

   /* create the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* open the file that got created in example 18 */
userHome = .java.lang.System~getProperty("user.home")    /* get user home directory from Java */
fileName = "myAhammerExample14_with_ChartFromExample18.ods"
url = uno.convertToUrl(userHome"/"fileName)

signal on syntax  /* let us intercept the Rexx condition, if loading document fails */
calcComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)
signal off syntax /* do not intercept Rexx syntax conditions anymore */

   /* get first sheet in spreadsheet */
xSheet = calcComponent~XSpreadSheetDocument~getSheets~XIndexAccess~getByIndex(0) ~XSpreadSheet

   /* get the Sheet's ChartsSupplier */
xTableCharts = xSheet~XTableChartsSupplier~getCharts

   /* xTableCharts is a SUBCLASS of XNameAccess */
xChart = xTableCharts~getByName("FirstChart")~XTableChart

   /* get the embedded Object */
xComponent = xChart~XEmbeddedObjectSupplier~getEmbeddedObject

   /* get the Diagram from the ChartDocument */
xDiagram = xComponent~XChartDocument~getDiagram

   /* set the properties */
xPropsChart = xDiagram~XPropertySet

.bsf.dialog~messageBox("Change the 'Dim3D' and 'Deep' properties to '.true' ...",,"info")
xPropsChart~setPropertyValue("Dim3D", box("bool", .true))
xPropsChart~setPropertyValue("Deep", box("bool", .true))

   /* define the 'SolidType' types */
types       = .array~of("CYLINDER", "CONE", "PYRAMID", "RECTANGULAR_SOLID")
   /* define the colors in RGB (one byte intensity per "red", "green", and "blue"), encoded as an integer number */
floorColors = .array~of("FF 00 8F"x ~c2d, "00 FF 8F"x ~c2d, "FF 8F 00"x ~c2d, "FF 00 8F"x ~c2d)

.bsf.dialog~messageBox("About to change 'SolidType' property (and 'FillColor') to one of four values  ...",,"info")

   /* get access to the Floor properties */
xPropsFloor = xDiagram~X3DDisplay~getFloor~XPropertySet

do i=1 to types~items
   /* Property named "SolidType" caused erros in 2.3.0, where one needed to use the name "SymbolType"! */
   --   xPropsChart~setPropertyValue("SymbolType", box("INT", bsf.getConstant("com.sun.star.chart.ChartSolidType", type)))
   xPropsChart~setPropertyValue("SolidType", box("INT", bsf.getConstant("com.sun.star.chart.ChartSolidType", types[i])))

   xPropsFloor~setPropertyValue("FillColor", box("int", floorColors[i]))
   xPropsFloor~setPropertyValue("FillBackground", box("boolean", .true))
   .bsf.dialog~messageBox("Changed 'SolidType' to '"types[i]"', 'FillColor' to the RGB value '"floorColors[i]~d2c~c2x"'x ...",,"info")
end

.bsf.dialog~messageBox("Done, about to dispose (close) the calc component ...", "Closing Dialog", "info")
calcComponent~dispose
exit

syntax:  /* Rexx condition handler */
   title = "File Not Found/Problem Loading File"
   msg = "Please run 'example18_scalc_chart1.rxo' before running this example. We need the file that gets produced in example 18!" "0a"x || -
         "File in question:" pp(uno.convertFromUrl(url))
   .bsf.dialog~messageBox(msg, title, "error")
   say title":" msg     /* also display in command-line window */


::requires UNO.CLS    -- get UNO support

