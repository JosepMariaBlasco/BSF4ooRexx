#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited and extended by Rony G. Flatscher, 2010-07-17/19/20 */
/* Example 14: create calc document, fill in values and formulas, use autofill function to extend */

   /* create the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* create a new calc document */
url = "private:factory/scalc"
calcComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

   /* get first sheet in spreadsheet */
xSheet = calcComponent~XSpreadSheetDocument~getSheets~XIndexAccess~getByIndex(0) ~XSpreadSheet

   /* insert column titles */
call UNO.setCell xSheet, 0, 0, "Col-A"             /* cell "A1" */
call UNO.setCell xSheet, 1, 0, "Col-B"             /* cell "B1" */
call UNO.setCell xSheet, 2, 0, "Col-C"             /* cell "C1" */
call UNO.setCell xSheet, 3, 0, "Col-D"             /* cell "D1" */


   /* insert some values and formulas */
call UNO.setCell xSheet, 0, 1, "1"                 /* cell "A2" */
call UNO.setCell xSheet, 1, 1, "=(A2*3)"           /* cell "B2" */
call UNO.setCell xSheet, 2, 1, "=($A$2*10*RAND())" /* cell "C2" */
call UNO.setCell xSheet, 3, 1, "1"                 /* cell "D2" */


   /* use AutoFill to create additional new entries */
to_bottom = bsf.getConstant("com.sun.star.sheet.FillDirection", "TO_BOTTOM")
range1 = "A2:C11"
msg = "About to use 'XCellSeries.fillAuto(...)': cell range" pp(range1)", filling *every* cell 'TO_BOTTOM' ..."
.bsf.dialog~messageBox(msg, "Filling Every Cell","info")
getCellSeries(xSheet,range1)~fillAuto(to_bottom, 1)   /* fill every cell */

   /* give a hint to the user for behavriour in C2:C11 */
info = "Values in C2:C11 will change upon each recalculation/update due to using the function 'RAND()' !"
call UNO.setCell xSheet, "C12", info

range2="D2:D11"
msg = "About to use 'XCellSeries.fillAuto(...)': cell range" pp(range2)", filling *every* *SECOND* cell 'TO_BOTTOM' ..."
.bsf.dialog~messageBox(msg, "Filling Every SECOND (!) Cell Only","info")
getCellSeries(xSheet,range2)~fillAuto(to_bottom, 2)   /* fill every second cell */

   /* save the result - we need it for the next example */
userHome = .java.lang.System~getProperty("user.home")    /* get user home directory from Java */
fileName = "myAhammerExample14.ods"
storeURL = uno.convertToUrl(userHome"/"fileName)
calcComponent~XStorable~storeAsURL(storeURL, .UNO~noProps)

say "New document saved to" pp(uno.convertFromUrl(storeUrl))

.bsf.dialog~messageBox("Done, about to dispose (close) the calc component ...", "Closing Dialog", "info")
calcComponent~dispose


::requires UNO.CLS    -- get UNO support

::routine getCellSeries /* return a XCellSeries matching supplied cell range */
  use arg xSheet, aRange
  return xSheet~XCellRange~getCellRangeByName(aRange)~XCellSeries