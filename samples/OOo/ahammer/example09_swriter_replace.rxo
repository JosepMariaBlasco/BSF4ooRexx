#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited by Rony G. Flatscher, 2010-07-17/20 */
/* Example 09: load an existing writer document ("inquiry.odt"),
              change its content (the title "Inquiry" to "Order"),
              insert text from another existing document ("orderText.odt"),
              save the resulting new document under a new name ("order.odt").
*/

   /* Retrieve the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* load an existing writer document */
url = makeUrl("myInquiry.odt")  -- get the document from the current folder
writerComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

/* get the XText object, create a TextCursor for it */
-- xWriterDocument = writerComponent~XTextDocument
xText = writerComponent~XTextDocument~getText
xTextCursor = xText~createTextCursor


.bsf.dialog~messageBox("About to replace 'Inquiry' with the bold text 'Order' ...", , "info")
   /* get the XReplaceable interface, create the ReplaceDescriptor */
xReplaceable = writerComponent~XReplaceable
xReplaceDescriptor = xReplaceable~createReplaceDescriptor

   /* configure the ReplaceDescriptor: search for "Inquiry" (caselessly) and
      replace it with "Order" in BOLD weight */
xReplaceDescriptor~~setSearchString("inquiry")~~setReplaceString("Order")

   /* the replacement text gets formatted in BOLD font weight */
props = bsf.createJavaArray(.UNO~propertyValue, 1)
bold = bsf.getConstant("com.sun.star.awt.FontWeight", "BOLD")
props[1]=uno.createProperty("CharWeight", box("float", bold))
xReplaceDescriptor~XPropertyReplace~setReplaceAttributes(props)

   /* now carry out all replacements */
xReplaceable~replaceAll(xReplaceDescriptor)


includeFileName = "myOrderTextToInclude.odt"
msg = "About to insert a writer document's content ("""includeFileName""") at the end of this document ..."
.bsf.dialog~messageBox(msg, "Include Document Content Dialog", "info")
   /* insert a text from another textdocument */
xTextCursor~gotoEnd(.false)
-- insertURL = makeUrl("ordertext.odt")   /* get the document from the current folder */
insertURL = makeUrl(includeFileName)   /* get the document from the current folder */

xTextCursor~XDocumentInsertable~insertDocumentFromURL(insertURL, .UNO~noProps)

   /* save the edited document under a new name using the user's home directory */
url = uno.ConvertToUrl(.java.lang.System~getProperty("user.home") || "\myOrder.odt")
.bsf.dialog~messageBox("About to save the new document to" pp(uno.convertFromUrl(url)) "...", "Closing Dialog", "info")
writerComponent~XStorable~storeAsURL(url, .UNO~noProps)
say "New document saved to" pp(uno.convertFromUrl(url))

::requires UNO.CLS    -- get UNO support


::routine makeUrl /* a function for creating the URL for the file existing in the current folder */
  return  uno.convertToURL(stream(arg(1), "c", "query exists"))