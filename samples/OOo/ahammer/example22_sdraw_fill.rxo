#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited and extended by Rony G. Flatscher, 2010-07-19/20 */
/* Example 22: create a draw document, define a RectangleShape, set XText settings, including a Gradient fill */

   /* create the Desktop object, we need its XComponentLoader interface to load a new document */
xContext = UNO.connect()   /* connect to server and retrieve the XContext object */
XMcf = xContext~getServiceManager   /* retrieve XMultiComponentFactory */
xDesktop         = UNO.createDesktop(xContext)  /* get the UNO Desktop service object */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* create a new draw document */
url = "private:factory/sdraw"
drawComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

   /* get the component's factory */
xDocumentFactory = drawComponent~XMultiServiceFactory

   /* get the (first) draw page by (0-based) index */
xDrawPage = drawComponent~XDrawPagesSupplier~getDrawPages~getByIndex(0)~XDrawPage

   /* create a Rectangle and add it to the shape */
xShapeRectangle = xDocumentFactory~createInstance("com.sun.star.drawing.RectangleShape") ~XShape
xShapeRectangle~setPosition(.bsf~new("com.sun.star.awt.Point", 0, 0))   /* x=0, y=0 */
xShapeRectangle~setSize(.bsf~new("com.sun.star.awt.Size", 21000, 8000)) /* width=21000, height=8000 */
xDrawPage~add(xShapeRectangle)      /* add the RectangleShape to the draw page */

xShapeProps = xShapeRectangle~XPropertySet   /* set the properties of the rectangle shape */

   /* set colors */
.bsf.dialog~messageBox("About to change the default fill and line colors ...",,"info")
xShapeProps~setPropertyValue("FillColor", box("int", "ff 00 ff"x ~c2d))
xShapeProps~setPropertyValue("LineColor", box("int", "00 00 ff"x ~c2d))

   /* create a Gradient and set its members */
.bsf.dialog~messageBox("About to define a 'Gradient' to fill the rectangle ...",,"info")
oGradient = .bsf~new("com.sun.star.awt.Gradient")
oGradient~Style = bsf.getConstant("com.sun.star.awt.GradientStyle", "LINEAR")
oGradient~StartColor     = 11961315 /* "B6 83 E3"x ~c2d -- original: 95847395 = "05 B6 83 E3"x */
oGradient~EndColor       =  6345907 /* "60 D4 B3"x ~c2d -- original: 23123123 = "01 60 D4 B3"x */
oGradient~Angle          = 450
oGradient~Border         = 0
oGradient~XOffset        = 0
oGradient~YOffset        = 0
oGradient~StartIntensity = 100
oGradient~EndIntensity   = 100
oGradient~StepCount      = 10

fillStyle = bsf.getConstant("com.sun.star.drawing.FillStyle", "GRADIENT")
xShapeProps~setPropertyValue("FillStyle", fillStyle)
xShapeProps~setPropertyValue("FillGradient", oGradient)

   /* set the XText related properties */
xText = xShapeRectangle~XText
xText~insertString(xText~getEnd, "Some text", .false)

.bsf.dialog~messageBox("About to set 'TextFitToSizeType' to 'PROPORTIONAL', adding some more text to the end ...",,"info")
proportional = bsf.getConstant("com.sun.star.drawing.TextFitToSizeType", "PROPORTIONAL")
xShapeProps~setPropertyValue("TextFitToSize", proportional)

xText~insertString(xText~getEnd, " using 'TextFitToSize'.", .false)

   /* define insets for each side */
.bsf.dialog~messageBox("About to set the insets to 2500 (25mm=2.5cm) ...",,"info")
javaInteger = box("int", 2500)   /* box primitive value as a java.lang.Integer representing "2500" */
xShapeProps~setPropertyValue("TextLeftDistance",  javaInteger)
xShapeProps~setPropertyValue("TextRightDistance", javaInteger)
xShapeProps~setPropertyValue("TextUpperDistance", javaInteger)
xShapeProps~setPropertyValue("TextLowerDistance", javaInteger)


.bsf.dialog~messageBox("After setting the insets to 2500, about to set the property 'ParaAdjust' to 'CENTER' and 'CharColor' to red and inserting some more text ...",,"info")

xTextProps = xText~getEnd~XPropertySet    /* get and set the properties */
xTextProps~setPropertyValue("ParaAdjust", bsf.getConstant("com.sun.star.style.ParagraphAdjust", "CENTER"))
xTextProps~setPropertyValue("CharColor",  box("int", "ff 00 00"x ~c2d)) /* RGB-value */

paragraph_break = bsf.getConstant("com.sun.star.text.ControlCharacter", "PARAGRAPH_BREAK")
xText~insertControlCharacter(xText~getEnd, paragraph_break, .false)

xText~insertString(xText~getEnd, "The inset (inner distance to border) is: 2,5 cm (25 mm).", .false)

   /* set "modified" false -> UNO will not ask if you want to save the current document on close */
drawComponent~XModifiable~setModified(.false)

::requires UNO.CLS    -- get UNO support