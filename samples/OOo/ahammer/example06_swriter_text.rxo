#!/usr/bin/rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited and extended by Rony G. Flatscher, 2010-07-15/16/17/20 */
/* Example 06: demonstrate how to use cursors and properties to add and edit text as well as formatting paragraphs */

   /* Retrieve the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* create a new writer document */
url = "private:factory/swriter"
writerComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

   /* get the text object */
xText = writerComponent~XTextDocument~getText

   /* create a text-cursor, fetch a word cursor of it as well */
xTextCursor = xText~createTextCursor
xWordCursor = xTextCursor~XWordCursor

   /* create the CursorProperty */
xTextCursorProps = xTextCursor~XPropertySet

   /* write a sentence */
xText~setString("This is the text!")

   /* insert the word "old" after the third word */
.bsf.dialog~messageBox("About to insert the word 'old ' after the third word ...", , "info")

xTextCursor~gotoStart(.false) /* position the cursor to the beginning */
   /* use the word cursor to move position three words to the right */
xWordCursor~~gotoNextWord(.false)~~gotoNextWord(.false)~~gotoNextWord(.false)
xText~insertString(xWordCursor, "old ", .false)

   /* replace the word "old" */
.bsf.dialog~messageBox("About to replace the word 'old ' with the word 'new ' ...", , "info")

xTextCursor~gotoStart(.false)
   /* position four words to the right, select the fourth word */
xWordCursor~~gotoNextWord(.false)~~gotoNextWord(.false)~~gotoNextWord(.false) ~~gotoNextWord(.true)
xText~insertString(xWordCursor, "new ", .true)  /* .true: replace selection */

   /* insert the page number */
.bsf.dialog~messageBox("About to insert the page number at the end of the text ...", , "info")
xTextCursor~gotoEnd(.false)

   /* get access to the PageCursor */
xPageCursor = writerComponent~XModel~getCurrentController -
                             ~XTextViewCursorSupplier~getViewCursor~XPageCursor

   /* insert the current PageNumber */
xText~insertString(xWordCursor, (" [on page " || xPageCursor~getPage || "] ") , .false)

   /* change color of characters, insert a smiley */
.bsf.dialog~messageBox("About to insert a colored smiley at the end of the text, slightly animated ...", , "info")
xTextCursor~gotoEnd(.false)

   /* change the color of the characters */
xTextProps = xTextCursor~XPropertySet                 /* get access to the properties */
oldCharColor = xTextProps~getPropertyValue("CharColor")  /* fetch current (old) value */
xTextProps~setPropertyValue("CharColor", box("int", "ff 00 00"x ~c2d))  /* set to red */

   /* insert a colored smilie in a new line of the same paragraph */
xText~insertString(xTextCursor, "0a09"x, .false)        /* enter LF and TAB characters */
sleepTime=0.1
call sysSleep sleepTime; xText~insertString(xTextCursor, " ;", .false)
call sysSleep sleepTime; xText~insertString(xTextCursor, "-", .false)
call sysSleep sleepTime; xText~insertString(xTextCursor, ") ", .false)
call sysSleep sleepTime

   /* reset color and write "done." in a new paragraph */
xTextProps~setPropertyValue("CharColor", oldCharColor)
xText~insertString(xTextCursor, "0d"x || "Done.", .false)


.bsf.dialog~messageBox("About to insert a couple of paragraphs, formatting them to the right, center, block, and left ...", , "info")
   /* demonstrate inserting control characters via the appropriate API, and also
      how to set the paragraph adjustments as this poses an incredible challenge
      for students; rgf, 2010-07-15 */

   /* make all of the UNO_CONSTANTS value easily available to Rexx: */
ctlConstants=.uno_constants~new("com.sun.star.text.ControlCharacter")
   /* for debugging: show all values */
say "UNO_CONSTANTS 'ControlCharacter':" pp(ctlConstants~makeString)

   /* make all of the UNO_ENUM values easily available to Rexx: */
paraEnum=.uno_enum~new("com.sun.star.style.ParagraphAdjust")
   /* for debugging: show all values */
say "UNO_ENUM 'ParagraphAdjust':" pp(paraEnum~makeString)

   /* get properties of XParagraphCursor */
xParagraphCursorProps=xTextCursor~XParagraphCursor~XPropertySet
   /* for debugging: show the definition, including all available properties */
say "'xParagraphCursorProps':" ppd(xParagraphCursorProps~uno.getDefinition)

   /* right adjust paragraph */
xTextCursor~gotoEnd(.false)
xText~insertControlCharacter(xTextCursor, ctlConstants~paragraph_Break, .false)
xText~insertString(xTextCursor, "This paragraph will be right-adjusted. "~copies(8), .true)
xParagraphCursorProps~setPropertyValue("ParaAdjust", paraEnum~right)

   /* center adjust paragraph */
xTextCursor~gotoEnd(.false)
xText~insertControlCharacter(xTextCursor, ctlConstants~paragraph_Break, .false)
xText~insertString(xTextCursor, "This paragraph will be center-adjusted. "~copies(8), .true)
xParagraphCursorProps~setPropertyValue("ParaAdjust", paraEnum~center)

   /* block adjust paragraph */
xTextCursor~gotoEnd(.false)
xText~insertControlCharacter(xTextCursor, ctlConstants~append_paragraph, .false)
xText~insertString(xTextCursor, "This paragraph will be block-adjusted. "~copies(8), .true)
xParagraphCursorProps~setPropertyValue("ParaAdjust", paraEnum~block)

   /* left adjust paragraph */
xTextCursor~gotoEnd(.false)
xText~insertControlCharacter(xTextCursor, ctlConstants~paragraph_Break, .false)
xText~insertString(xTextCursor, "This paragraph will be left-adjusted. "~copies(8), .true)
xParagraphCursorProps~setPropertyValue("ParaAdjust", paraEnum~left)

   /* set "modified" false -> UNO will not ask if you want to save the current document on close */
writerComponent~XModifiable~setModified(.false)

::requires UNO.CLS    -- get UNO support

