#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited by Rony G. Flatscher, 2010-07-18/20 */
/* Example 17: create calc document, fill in values; create, insert and apply custom style */

   /* create the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* create a new calc document */
url = "private:factory/scalc"
calcComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

   /* get first sheet in spreadsheet */
xSheet = calcComponent~XSpreadSheetDocument~getSheets~XIndexAccess~getByIndex(0) ~XSpreadSheet

   /* insert some text */
call UNO.setCell xSheet, 0, 0, "Look at the cell style..."

title = "Creating, Inserting and Applying a Custom Style"
.bsf.dialog~messageBox("About to create and insert a custom cell style into the document ...", title, "info")

   /* we need the XSpreadSheetDocument to define and insert a custom style */
xDocument    = calcComponent~XSpreadSheetDocument

   /* get the cell style container */
-- xFamiliesSupplier = xDocument~XStyleFamiliesSupplier
xCellStyle = xDocument~XStyleFamiliesSupplier~getStyleFamilies~getByName("CellStyles")~XNameContainer

   /* create a new cell style */
xServiceManager = calcComponent~XMultiServiceFactory  /* get the document's factory */
oCellStyle = xServiceManager~createInstance("com.sun.star.style.CellStyle")
cellStyleName = "MyNewCellStyle"
xCellStyle~insertByName(cellStyleName, oCellStyle)

   /* modify properties of the new style */
xPropertySet = oCellStyle~XPropertySet
xPropertySet~setPropertyValue("CharWeight", box("float", bsf.getConstant("com.sun.star.awt.FontWeight", "BOLD")))
xPropertySet~setPropertyValue("CharColor",  box("int",   "ff 00 00"x ~c2d))   /* red color */

   /* create a CellRange and set the PropertyStyle */
.bsf.dialog~messageBox("About to apply the custom cell style named" pp(cellStyleName) "...", title, "info")
xCellRange = xSheet~getCellRangeByPosition(0, 0, 3, 3)
xCellRange~XPropertySet~setPropertyValue("CellStyle",cellStyleName)

   /* set "modified" false -> UNO will not ask if you want to save the current document on close */
calcComponent~XModifiable~setModified(.false)

::requires UNO.CLS    -- get UNO support