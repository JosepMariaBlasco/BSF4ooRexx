#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-07/20 */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* open a new blank writer document */
url = "private:factory/swriter"
writerComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0,.UNO~noProps)

   /* create the TextObject and the TextCursor */
xTextDocument = writerComponent~XTextDocument
xText = XTextDocument~getText
xTextCursor = xText~createTextCursor

   /* get the MulitServiceFactory from the current document */
xDMsf = xTextDocument~XMultiServiceFactory

   /* create the TextTable */
xTextTable = xDMsf~createInstance("com.sun.star.text.TextTable")~XTextTable
xTextTable~initialize(3,3 )

   /* insert TextTable in the Text */
xText~insertTextContent(xTextCursor, xTextTable, .false)

/*
-- does not fully solve the screen update problems, if running via Tools->Macro;
if scriptContext<>.nil then   /* if run via Tools->Macro, make sure that screen gets updated */
do
   call SysSleep 0.5          /* sleep for 1/2 second */
   writerComponent~XModel~getCurrentController~getFrame~getContainerWindow~XTopWindow~toFront
end
*/
.bsf.dialog~messageBox("Created a new text processor document, inserted a TextTable with 3 columns and 3 rows.", "Please Press Button to Continue...", "information")

   /* insert Text in the first row of the table */
xTextTable~getCellByName("A1")~XText~setString("First Column")
xTextTable~getCellByName("B1")~XText~setString("Second Column")
xTextTable~getCellByName("C1")~XText~setString("Third Column")

   /* insert values into the table */
xTextTable~getCellByName("A2")~setValue(random(0,500))
xTextTable~getCellByName("B2")~setValue(random(0,500))
xTextTable~getCellByName("C2")~setValue(random(0,500))
xTextTable~getCellByName("A3")~setValue(random(0,500))
xTextTable~getCellByName("B3")~setValue(random(0,500))
xTextTable~getCellByName("C3")~setValue(random(0,500))

.bsf.dialog~messageBox("Filled-in titles and random numbers. About to create two additional rows.", "Please Press Button to Continue...", "information")

   /* get row collection, insert two additional rows */
xTextRows = xTextTable~getRows ~~insertByIndex(3,2)

   /* set values into the new row */
xTextTable~getCellByName("A4")~setValue(random(0,500))
xTextTable~getCellByName("B4")~setValue(random(0,500))
xTextTable~getCellByName("C4")~setValue(random(0,500))

.bsf.dialog~messageBox("Created two additional rows, filled-in random numbers into one of the new rows.", "Please Press Button to Continue...", "information")

   /* set last row to mean the column values */
xTextTable~getCellByName("A5")~setFormula("mean <A2:A4>")
xTextTable~getCellByName("B5")~setFormula("mean <B2:B4>")
xTextTable~getCellByName("C5")~setFormula("mean <C2:C4>")

   /* set style properties of the table */
xTextRows~getbyIndex(0)~xPropertySet~setPropertyValue("BackColor", box("int", "e6e6fa"x ~c2d))
xTextRows~getbyIndex(4)~xPropertySet~setPropertyValue("BackColor", box("int", "66cdaa"x ~c2d))

.bsf.dialog~messageBox("Filled-in mean formulas into the last row and colorized first and last row of the TextTable.", "Please Press Button to Finish...", "information")

xTextDocument~XModifiable~setModified(.false)   /* allow to close (abort) document without saving-dialog */

::requires UNO.cls    -- get UNO support