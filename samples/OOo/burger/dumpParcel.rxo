#!/usr/bin/env rexx
-- rgf, 2010-08-23: script to create the entries for index.html exploiting the wrok
--                  done already for "parcel-descriptor.xml"

srcParcel=.Parcel~fromXMLFile("parcel-descriptor.xml")

scripts=srcParcel~ParcelScriptDefinitions
do idx over sort2(scripts~allIndexes)
   script=scripts[idx]

    say '    <dt><a href="'script~functionName'">'script~functionName'</a>'
    say '    <dd>' script~description
    say

   -- say pp(script~functionname) pp(script~description)
end

::requires uno.cls