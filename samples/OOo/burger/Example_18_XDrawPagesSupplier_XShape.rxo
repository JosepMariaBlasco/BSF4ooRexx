#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-07/14/20 */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* open a blank draw document */
url = "private:factory/sdraw"
drawComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0,.UNO~noProps)
xDMsf = drawComponent~XMultiServiceFactory   /* get factory of the document                     */

   /* get draw page by index */
xDrawPage=drawComponent~XDrawPagesSupplier~getDrawPages~getByIndex(0) ~XDrawPage

/* ------------------------------------------------------------ */
size  = .bsf~new("com.sun.star.awt.Size")
point = .bsf~new("com.sun.star.awt.Point")

/* ------------------------------------------------------------ */
xShape1 = xDMsf~createInstance("com.sun.star.drawing.RectangleShape")~XShape
size~Height = 6000
size~Width  = 8000
point~x = 6000
point~y = 3000
xShape1~~setSize(size)~~setPosition(point)
xDrawPage~add(xShape1)

xShapeProps1=xShape1~xPropertySet
xShapeProps1~setPropertyValue("FillColor", box("int", "E0E0E0"x ~c2d))
xShapeProps1~setPropertyValue("LineColor", box("int", "FFFF99"x ~c2d))

/* ------------------------------------------------------------ */
xShape2 = xDMsf~createInstance("com.sun.star.drawing.EllipseShape")~XShape
size~Height = 2500
size~Width  = 2500
point~x = 9000
point~y = 5000
xShape2~~setSize(size)~~setPosition(point)
xDrawPage~add(xShape2)

xShape2Props=xShape2~xPropertySet
section = bsf.getConstant("com.sun.star.drawing.CircleKind", "SECTION")
xShape2Props~setPropertyValue("CircleKind", section)
xShape2Props~setPropertyValue("CircleStartAngle", box("int", 9000))
xShape2Props~setPropertyValue("CircleEndAngle", box("int", 18000))
xShape2Props~setPropertyValue("FillColor", box("int", "FFFFFF"x ~c2d))

/* ------------------------------------------------------------ */
xShape3 = xDMsf~createInstance("com.sun.star.drawing.TextShape")~XShape
xShape3~~setSize(size)~~setPosition(point)   /* same size and position as the 'EllipsesShape' above   */
xDrawPage~add(xShape3)

proportional= bsf.getConstant("com.sun.star.drawing.TextFitToSizeType", "PROPORTIONAL")
xShape3~xPropertySet~setPropertyValue("TextFitToSize", proportional)

xShape3xText = xShape3~xText
xShape3xText~setString("1")

/* ------------------------------------------------------------ */
.bsf.dialog~messageBox("About to enlarge circle (before step 2).", "Please press button to continue...", "information")
xShape2Props~setPropertyValue("CircleEndAngle", box("int", 27000))
xShape3xText~setString("2")

/* ------------------------------------------------------------ */
.bsf.dialog~messageBox("About to enlarge circle (before step 3).", "Please Press Button to Continue...", "information")
xShape2Props~setPropertyValue("CircleEndAngle", box("int", 36000))
xShape3xText~setString("3")

/* ------------------------------------------------------------ */
.bsf.dialog~messageBox("About to enlarge to a full circle (before step 4).", "Please Press Button to Continue...", "information")
full = bsf.getConstant("com.sun.star.drawing.CircleKind", "FULL")
xShape2Props~~setPropertyValue("CircleKind", full)
xShape3xText~setString("4")

/* ------------------------------------------------------------ */
.bsf.dialog~messageBox("About to remove all but the first shape object.", "Please Press Button to Continue...", "information")
xDrawPage~remove(xShape2)
xDrawPage~remove(xShape3)

/* ------------------------------------------------------------ */
.bsf.dialog~messageBox("Removed all shapes from the draw page, except of the 'RectangleShape' shape, which now gets animated (scrolling) text assigned to.", "Please Press Button to Finish...", "information")
scroll = bsf.getConstant("com.sun.star.drawing.TextAnimationKind", "SCROLL")
xShapeProps1~setPropertyValue("TextAnimationKind", scroll)
xShape1~xText~setString("This text scrolls through the 'RectangleShape'...")

drawComponent~XModifiable~setModified(.false)   /* allow to close (abort) document without saving-dialog */

::requires UNO.CLS   -- load UNO support for OpenOffice.org

