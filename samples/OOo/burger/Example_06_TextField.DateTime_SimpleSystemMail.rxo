#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-07/14/20 */

/* If your computer has an e-mail system set up that is known to OpenOffice.org, then you
   can use OOo to send simple messages as demonstrated by this program.
*/

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
   thisPath=uno.getScriptPath(.nil, slotArg)    /* will return the physical path to this script */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
   thisPath = directory()                    /* determine path to this script                   */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* ---> create an attachment writer document on the fly --->   */
url = "private:factory/swriter"

bDisplayCreatedDocument = .false             /* .true: show created attachment                  */

if bDisplayCreatedDocument = .true then
   props = .uno~noProps                /* empty PropertyValue array, use defaults, ie. "visible"*/
else  /* create a hidden property to make sure that document is not displayed */
do
   prop = uno.createProperty("Hidden", box("bool", .true))
   props = bsf.createJavaArrayOf(.uno~PropertyValue, prop)
end

writerComponent=xComponentLoader~loadComponentFromURL(url, "_blank", 0, props)

   /* create the TextObject and the TextCursor */
xTextDocument = writerComponent~XTextDocument
xText = XTextDocument~getText
xTextCursor = xText~createTextCursor

   /* create TextFields to insert date and time */
xDmsf = xTextDocument~xMultiServiceFactory
   /* display Date portion */
xTextFieldTime1 = xDMsf~createInstance("com.sun.star.text.TextField.DateTime") ~xTextField
xTextFieldTime1~XPropertySet~setPropertyValue("IsDate", box("boolean", .true))
   /* display Time portion (default) */
xTextFieldTime2 = xDMsf~createInstance("com.sun.star.text.TextField.DateTime") ~xTextField

xText~insertString(xTextCursor,"This is an attachement created and sent via OpenOffice.org (OOo) on" .DateTime~new, .false)
xText~insertString(xTextCursor, "; you have loaded this document on ", .false)
xText~insertTextContent(xTextCursor, xTextFieldTime1, .false)
xText~insertString(xTextCursor, " at ", .false)
xText~insertTextContent(xTextCursor, xTextFieldTime2, .false)
xText~insertString(xTextCursor, ". Have fun, ooRexx.", .false)

   /* save the document */
   /* get directory to save temporary file to using Java */
-- tmpPath=.java.lang.System~getProperty("user.home")       /* get user's home directory         */
tmpPath=.java.lang.System~getProperty("java.io.tmpdir")  /* get directory for temporary files */
attachFileUrl=uno.convertToUrl(tmpPath"/myAttachment-created-on-the-fly.odt")
writerComponent~xStorable~storeAsURL(attachFileUrl, .UNO~noProps)
writerComponent~XModifiable~setModified(.false) /* allow to close (abort) document without saving-dialog */

if bDisplayCreatedDocument = .false then
   writerComponent~dispose                      /* dispose of document window */
   /* <--- attachment writer document got created & saved <--- */


   /* create xSimpleMailClient(for sending) and
      SimpleMailMessage(for adding Subject, Recipient and Attachement) */
xMcf = xContext~getServiceManager~XMultiServiceFactory
simpleMailSystem=xMcf~createInstance("com.sun.star.system.SimpleSystemMail")

xSimpleMailClient = simpleMailSystem~XSimpleMailClientSupplier~querySimpleMailClient
mail = xSimpleMailClient~createSimpleMailMessage

   /* set Recipient and Subject */
recipient=.bsf.dialog~inputBox("Enter e-mail address of recipient", "SimpleSystemMail Example", "question")
mail~setRecipient(recipient)
mail~setSubject("Sending mail via OpenOffice.org (OOo)")

   /* create Java array with attachment URL names */
myDoc = uno.convertToUrl(thisPath"/myTestDocument.odt")
attach = bsf.createJavaArrayOf("java.lang.String", attachFileUrl, myDoc)
mail~setAttachement(attach)

   /* there are other flags available like "NO_USER_INTERFACE" */
flag=bsf.getConstant("com.sun.star.system.SimpleMailClientFlags", "DEFAULTS")
xSimpleMailClient~sendSimpleMailMessage(mail, flag)   /* send the mail     */

   /* to get quickly at some interesting definitions you might want to employ uno.getDefintion(): */
say ppd(uno.getDefinition("com.sun.star.system.SimpleMailClientFlags"))
name=mail~uno.getInterfaceName           /* get the UNO interface name */
say ppd(uno.getDefinition(name))         /* get and display definition */

::requires UNO.CLS   -- load UNO support for OpenOffice.org