#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-11/14/20 */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
   thisPath=uno.getScriptPath(.nil, slotArg)    /* will return the physical path to this script */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
   thisPath = directory()                    /* determine path to this script                   */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* ------------------------------------------------------------ */
   /* create a new draw document */
url = "private:factory/sdraw"
drawComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0,.UNO~noProps)
xDMsf = drawComponent~XMultiServiceFactory  /* get document's service factory   */

   /* get draw page by index */
xDrawPage=drawComponent~XDrawPagesSupplier~getDrawPages~getByIndex(0) ~XDrawPage

   /* create a Size and a Point object, will be used as parameters */
size  = .bsf~new("com.sun.star.awt.Size")
point = .bsf~new("com.sun.star.awt.Point")

   /* ------------------------------------------------------------ */
xShape1 = xDMsf~createInstance("com.sun.star.drawing.GraphicObjectShape")~XShape
size~Height = 5500   /* incorporate the pixel-height of the graphic to keep proportions      */
size~Width  = 8030   /* incorporate use the pixel-width of the graphic to keep proportions   */
point~x = 5000
point~y = 3000
xShape1~~setSize(size)~~setPosition(point)

xShape1Props = xShape1~xPropertySet
xShape1Props~setPropertyValue("GraphicURL", uno.convertToUrl(thisPath"/OOo3.png"))

   /* ------------------------------------------------------------ */
xShape2 = xDMsf~createInstance("com.sun.star.drawing.RectangleShape")~xShape
size~Height = 1000
point~y = 10000
xShape2~~setSize(size)~~setPosition(point)

xDrawPage~add(xShape1)
xDrawPage~add(xShape2)
xShape2~xText~setString("An editable shape.")

/*
-- does not fully solve the screen update problems, if running via Tools->Macro;
if scriptContext<>.nil then   /* if run via Tools->Macro, make sure that screen gets updated */
do
   call SysSleep 0.5          /* sleep for 1/2 second */
   drawComponent~XModel~getCurrentController~getFrame~getContainerWindow~XTopWindow~~toFront~~toFront
end
*/
.bsf.dialog~messageBox("Defined a 'GraphicObjectShape' and a 'RectangleShape', both shapes being visible and editable.", "Please Press Button to Continue...", "information")

   /* ------------------------------------------------------------ */
xLayerManager = drawComponent~XLayerSupplier~getLayerManager~XLayerManager
   /* Layer 1 */
xLayer1 = xLayerManager~insertNewByIndex(xLayerManager~getCount)
xLayer1Props = xLayer1~XPropertySet
xLayer1Props~setPropertyValue("Name", "NotVisibleAndEditable")
xLayer1Props~setPropertyValue("IsVisible", box(boolean, .false))
xLayer1Props~setPropertyValue("IsLocked",  box(boolean, .true))
   /* Layer 2 */
xLayer2 = xLayerManager~insertNewByIndex(xLayerManager~getCount)
xLayer2Props = xLayer2~XPropertySet
xLayer2Props~setPropertyValue("Name", "NotEditable")
xLayer2Props~setPropertyValue("IsVisible", box(boolean, .true))
xLayer2Props~setPropertyValue("IsLocked",  box(boolean, .true))

xLayerManager~attachShapeToLayer(xShape1, xLayer1)
xLayerManager~attachShapeToLayer(xShape2, xLayer2)
xShape2~xText~setString("Not editable anymore.")
hint="Created two layers ('NotVisibleAndEditable' and 'NotEditable'),"   "0a"x -
     "attached the graphical shape to the 'NotVisibleAndEditable' layer" "0a"x -
     "and attached the rectangular shape to the 'NotEditable' layer."

.bsf.dialog~messageBox(hint, "Please Press Button to Continue...", "information")

   /* ------------------------------------------------------------ */
xLayerManager~attachShapeToLayer(xShape1, xLayer2);
xShape1Props~setPropertyValue("Transparency", box("short", 50))
hint="Attached the graphical shape to the 'NotEditable' layer, setting its transparency to '50'"
xShape1~xText~setString("Not editable anymore.")

.bsf.dialog~messageBox(hint, "Please Press Button to Finish...", "information")

drawComponent~XModifiable~setModified(.false) /* allow to close (abort) document without saving-dialog */


::requires UNO.CLS   -- load UNO support for OpenOffice.org

