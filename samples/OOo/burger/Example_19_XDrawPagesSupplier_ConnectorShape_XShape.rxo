#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-11/20 */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
   thisPath=uno.getScriptPath(.nil, slotArg)    /* will return the physical path to this script */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
   thisPath = directory()                    /* determine path to this script                   */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* ------------------------------------------------------------ */
   /* create a new draw document */
url = "private:factory/sdraw"
drawComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0,.UNO~noProps)
xDMsf = drawComponent~XMultiServiceFactory   /* get document's service factory   */

   /* get draw page by index */
xDrawPage=drawComponent~XDrawPagesSupplier~getDrawPages~getByIndex(0) ~XDrawPage

   /* create a Size and a Point object, will be used as parameters */
size  = .bsf~new("com.sun.star.awt.Size")
point = .bsf~new("com.sun.star.awt.Point")

   /* ------------------------------------------------------------ */
xShape1 = xDMsf~createInstance("com.sun.star.drawing.GraphicObjectShape")~xShape
size~Height = 5500   /* incorporate the pixel-height of the graphic to keep proportions      */
size~Width  = 8030   /* incorporate use the pixel-width of the graphic to keep proportions   */
point~x = 5000
point~y = 3000
xShape1~~setSize(size)~~setPosition(point)

xShape1Props=xShape1~xPropertySet
fileUrl = uno.convertToUrl(thisPath"/OOo3.png")
xShape1Props~setPropertyValue("GraphicURL", fileUrl)
xDrawPage~add(xShape1)

.bsf.dialog~messageBox("Used 'GraphicURL' with a value of """fileUrl""" to denote the graphic to be shown.", "Please press button to continue...", "information")

xShape1Props~setPropertyValue("Transparency", box("short", 50))   /* set transparency */
xShape1~xText~setString("OpenOffice.org - Automation/Remote-controlling")  /* set text */

   /* ------------------------------------------------------------ */
xShape2 = xDMsf~createInstance("com.sun.star.drawing.GraphicObjectShape")~xShape
size~Height = 4000
size~Width  = 4000
point~x = 3000
point~y = 12000
xShape2~~setSize(size)~~setPosition(point)

xShape2~XPropertySet~setPropertyValue("GraphicURL", uno.convertToUrl(thisPath"/BSF4ooRexx.png"))
xDrawPage~add(xShape2)

   /* ------------------------------------------------------------ */
xShape3 = xDMsf~createInstance("com.sun.star.drawing.GraphicObjectShape")~xShape
point~x = 11000
point~y = 12000
   /* using previous set size */
xShape3~~setSize(size)~~setPosition(point)

xShape3~xPropertySet~setPropertyValue("GraphicURL", uno.convertToUrl(thisPath"/ooRexx4OOo.png"))
xDrawPage~add(xShape3)

   /* ------------------------------------------------------------ */
   /* connector 1 */
xShapeconn1 = xDMsf~createInstance("com.sun.star.drawing.ConnectorShape")~XShape
xDrawPage~add(xShapeconn1)
xConnProps1 = xShapeconn1~xPropertySet
xConnProps1~setPropertyValue("StartShape", xShape1)
xConnProps1~setPropertyValue("StartGluePointIndex", 2)
xConnProps1~setPropertyValue("EndShape",   xShape2)
xConnProps1~setPropertyValue("EndGluePointIndex",   4)

   /* connector 2 */
xShapeconn2 = xDMsf~createInstance("com.sun.star.drawing.ConnectorShape")~XShape
xDrawPage~add(xShapeconn2)
xConnProps2 = xShapeconn2~xPropertySet
xConnProps2~setPropertyValue("StartShape", xShape1)
xConnProps2~setPropertyValue("StartGluePointIndex", 2)
xConnProps2~setPropertyValue("EndShape",   xShape3)
xConnProps2~setPropertyValue("EndGluePointIndex",   4)

drawComponent~XModifiable~setModified(.false) /* allow to close (abort) document without saving-dialog */

::requires UNO.CLS   -- load UNO support for OpenOffice.org
