#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited and extended by Rony G. Flatscher, 2010-07-12/14 */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* ------------------------------------------------------------ */
   /* create a new presentation document */
url = "private:factory/simpress"
impressComponent = xComponentLoader~loadComponentFromURL(url, "_blank",0,.UNO~noProps)
xImpressFactory = impressComponent~XMultiServiceFactory  /* get document's factory  */

xDrawPagesSupplier = impressComponent~XDrawPagesSupplier
xDrawPages = xDrawPagesSupplier~getDrawPages

loop 3      /* insert additional three draw pages before the existing one */
   xDrawPages~insertNewByIndex(0)
end

   /* ------------------------------------------------------------ */
xDrawPage = xDrawPages~getByIndex(0)~xDrawPage
xShape = xImpressFactory~createInstance("com.sun.star.drawing.RectangleShape")~XShape
call setShape xShape,  3000,  1000, 5000, 5000
xDrawPage~add(xShape)

xShapeProps =  xShape~XPropertySet
wfb = bsF.getConstant("com.sun.star.presentation.AnimationEffect", "WAVYLINE_FROM_BOTTOM")
xShapeProps~setPropertyValue("Effect", wfb)
xShapeProps~setPropertyValue("DimHide", box(boolean, .false))
xShapeProps~setPropertyValue("DimPrevious", box(boolean, .true))
xShapeProps~setPropertyValue("DimColor", box("int", "C0 C0 C0"x ~c2d))

fsize=box("float",12)      /* java.lang.Float with this value defines the height of the text */
xShape~XText ~~setString("WAVYLINE_FROM_BOTTOM, click: DimHide")~XPropertySet~setPropertyValue("CharHeight", fsize)

call setPageInfo xImpressFactory, xDrawPage, 1  /* add slide number to page   */

   /* ------------------------------------------------------------ */
xDrawPage = xDrawPages~getByIndex(1)~XDrawPage
xShape = xImpressFactory~createInstance("com.sun.star.drawing.EllipseShape")~XShape
call setShape xShape, 19000, 15000, 5000, 5000
xDrawPage~add(xShape)

xShapeProps =  xShape~XPropertySet
hide = bSf.getConstant("com.sun.star.presentation.AnimationEffect", "HIDE")
xShapeProps~setPropertyValue("Effect", hide)
xShape~XText ~~setString("AnimationEffect: HIDE")~XPropertySet~setPropertyValue("CharHeight", fsize)

call setPageInfo xImpressFactory, xDrawPage, 2 "(BOOKMARK: ""page - two"")" /* add slide number to page   */

   /* ------------------------------------------------------------ */
xDrawPage = xDrawPages~getByIndex(2)~XDrawPage
xShape = xImpressFactory~createInstance("com.sun.star.drawing.EllipseShape")~XShape
call setShape xShape,  3000,  8000, 5000, 5000
xDrawPage~add(xShape)

xShapeProps =  xShape~xPropertySet
ffc = bsF.getConstant("com.sun.star.presentation.AnimationEffect", "FADE_FROM_CENTER")
xShapeProps~setPropertyValue("Effect", ffc)
firstPagE = bsf.getConstant("com.sun.star.presentation.ClickAction", "FIRSTPAGE")
xShapeProps~setPropertyValue("OnClick", firstPage)
xShape~XText ~~setString("FADE_FROM_CENTER, click: FIRSTPAGE")~XPropertySet~setPropertyValue("CharHeight", fsize)

xShape = xImpressFactory~createInstance("com.sun.star.drawing.RectangleShape")~XShape
call setShape xShape, 20000,  8000, 5000, 5000
xDrawPage~add(xShape)

xShapeProps =  xShape~XPropertySet
ffr = bsF.getConstant("com.sun.star.presentation.AnimationEffect", "FADE_FROM_RIGHT")
xShapeProps~setPropertyValue("Effect", ffr)
bookMark = bsf.getConstant("com.sun.star.presentation.ClickAction", "BOOKMARK")
xShapeProps~setPropertyValue("OnClick", bookMark)

xNamed = xDrawPages~getbyIndex(1)~XNamed
xNamed~setName("page - two")
xShapeProps~setPropertyValue("Bookmark", xNamed~getName)
xShape~XText ~~setString("FADE_FROM_RIGHT, click: BOOKMARK")~XPropertySet~setPropertyValue("CharHeight", fsize)

call setPageInfo xImpressFactory, xDrawPage, 3  /* add slide number to page   */

   /* ------------------------------------------------------------ */
xDrawPage = xDrawPages~getByIndex(3)~XDrawPage
call setPageInfo xImpressFactory, xDrawPage, 4  /* add slide number to page   */

impressComponent~XModifiable~setModified(.false) /* allow to close (abort) document without saving-dialog */

::requires UNO.CLS   -- load UNO support for OpenOffice.org

::routine setShape   /* utility routine to set the size and position of an xShape object */
   use arg xShape, x, y, w, h

   xShape~setPosition(.bsf~new("com.sun.star.awt.Point", x, y))
   xShape~setSize(.bsf~new("com.sun.star.awt.Size", w, h))
   return


::routine setPageInfo   /* utility routine to place page information on each slide  */
   use arg xImpressFactory, xDrawPage, slideNr
   xTextShape = xImpressFactory~createInstance("com.sun.star.drawing.TextShape")~XShape
   call setShape xTextShape,  3000,  19000, 15000, 500
   xDrawPagE~add(xTextShape)
   xTextShape~XText~setString("Slide #" slideNr)
   return