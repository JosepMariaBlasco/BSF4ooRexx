#!/usr/bin/env rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-07/20 */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* create a new spreadsheet file */
url = "private:factory/scalc"
calcComponent  = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)
xCalcComponent = calcComponent~XSpreadSheetDocument

   /* get first sheet (OOo collections are 0-based) */
xSheet1 = xCalcComponent~getSheets~XIndexAccess~getByIndex(0) ~XSpreadSheet

   /* insert values into tables*/
call UNO.setCell xSheet1, 0, 0, "original data on first sheet"
blue=box("int", "0000C0"x ~c2d)
xSheet1~getCellByPosition(0,0)~xPropertySet~setPropertyValue("CellBackColor", blue)

call UNO.setCell xSheet1, 0, 1, "1"
call UNO.setCell xSheet1, 0, 2, "5"
call UNO.setCell xSheet1, 0, 3, "11"
call UNO.setCell xSheet1, 0, 4, "55"

if scriptContext<>.nil then   /* if run via Tools->Macro, make sure that screen gets updated */
do
   call SysSleep 0.5          /* sleep for 1/2 second */
   calcComponent~XModel~getCurrentController~getFrame~getContainerWindow~XTopWindow~toFront
end
.bsf.dialog~messageBox("About to copy 'A2:A6' from 'Sheet1' to 'Sheet2'.", -
                       "Please Press Button to Continue...", "information")

   /* get second sheet (OOo collections are 0-based) */
xSheet2 = xCalcComponent~getSheets~XIndexAccess~getByIndex(1) ~XSpreadSheet

   /* activate second sheet */
xCalcComponent~XModel~getCurrentController ~xSpreadsheetView ~setActiveSheet(xSheet2)

   /* copying cell ranges */
call UNO.setCell xSheet2, 0, 0, "copied data from first sheet"
green=box("int", "00C000"x ~c2d)
xSheet2~getCellByPosition(0,0)~xPropertySet~setPropertyValue("CellBackColor", green)

   /* define cell range to copy from   */
rangeAddress = xSheet1~xCellRange~getCellRangeByName("A2:A6")~XCellRangeAddressable~getRangeAddress

   /* define target cell to copy to    */
targetCell = xSheet2~getCellByPosition(0,1)~xCellAddressable~getCellAddress

   /* copy the range to the target     */
xSheet2~xCellRangeMovement~copyRange(targetCell, rangeAddress)

if scriptContext<>.nil then   /* if run via Tools->Macro, make sure that screen gets updated */
do
   call SysSleep 0.5          /* sleep for 1/2 second */
   calcComponent~XModel~getCurrentController~getFrame~getContainerWindow~XTopWindow~toFront
end
.bsf.dialog~messageBox("Scrolled to second sheet.", "Please Press Button to Finish...", "information")
calcComponent~XModifiable~setModified(.false)   /* allow to close (abort) document without saving-dialog */

::requires UNO.CLS   -- load UNO support for OpenOffice.org