#!/usr/bin/env rexx
/*
   name:    scalc_chart.rxo
   author:  Rony G. Flatscher
   purpose: Use UNO.CLS to have a fully portable AOO/LO application
            which runs unchanged on Windows, Linux and MacOS; this
            is the equivalent OLE-only version distributed with
            ooRexx 5.0
   needs:   BSF4ooRexx (ooRexx-Java bridge)
   date:    2022-06-28
   changed: ---
   usage:   rexx scalc_chart.rxo
   needs:   ooRexx 5.0 or higher
