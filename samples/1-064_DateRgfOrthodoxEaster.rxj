#!/usr/bin/env rexx
/*
   name:       1-064_DateRgfOrthodoxEaster.rxj
   author:     Rony G. Flatscher
   date:       2022-08-07
   purpose:    demonstrate the usage of the DateRgf class (part of samples distribution) for
               calculating the Orthodox Easter Sunday and some dependent holidays
   needs:      ooRexx, BSF4ooRexx
   changes:    ---
   usage:      1-064_DateRgfOrthodoxEaster.rxj [startYear [years]]
               ... years number of years to calculate Orthodox Easter related holidays, default: 5
               ... startYear startYear for calculating Orthodox Easter related holidays, default: current year

   last change: $Revision$ $Author$ $Date$

   license:

    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2022 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

-- import the Java class (part of BSF4ooRexx samples), make it available as ".DATERGF"
.bsf~bsf.import("org.oorexx.datergf.DateRGF", "dateRgf")
.bsf~bsf.loadClass("org.oorexx.datergf.DTC", "dtc")   -- interface class with constants

parse arg startYear years           -- parse command line arguments, if any
if years=""     then years=5        -- default to 5 years
if startYear="" then startYear=date('s')~left(4)   -- default to current year

do i=startYear for years            -- iterate over years
   say left("Year/Jahr:" pp(i) " (Dates are given in Gregorian Calendar)", 79, "-")
   say
   greg=.dtc~Gregorian
   say "Lazarus Saturday/Georgstag        " pp(orthodoxEastern(i,-8)~toString) "(Easter Sunday -  8 days)"
   say "Palm Sunday/Palmsonntag           " pp(orthodoxEastern(i,-7)~toString) "(Easter Sunday -  7 days)"
   say "Holy Friday/Karfreitag:           " pp(orthodoxEastern(i,-2)~toString) "(Easter Sunday -  2 days)"
   say "Easter Sunday/Ostersonntag:       " pp(orthodoxEastern(i)   ~toString)
   say "Ascension Day/Christi Himmelfahrt:" pp(orthodoxEastern(i,39)~toString) "(Easter Sunday + 39 days)"
   say "Pentecost/Pfingstsonntag:         " pp(orthodoxEastern(i,49)~toString) "(Easter Sunday + 49 days)"
   say "Whit Monday/Pfingstmontag:        " pp(orthodoxEastern(i,50)~toString) "(Easter Sunday + 50 days)"
   say
end

::requires "BSF.CLS"    -- get ooRexx-Java bridge

::routine orthodoxEastern
  use arg year, diffDays=0

  d = .dateRgf~easter(year, .dtc~julian)~add(diffDays)   -- date in Julian calendar
  g = d~jdn2date(d~get(.dtc~JDN), d, .dtc~GREGORIAN)     -- get JDN and return corresponding Gregorian date
  return g
