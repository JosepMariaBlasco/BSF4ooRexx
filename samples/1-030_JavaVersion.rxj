#!/usr/bin/env rexx
/*

   name:    1-030_JavaVersion.rxj
   Invoke:  rexx JavaVersion

             "rexx JavaVersion.rxj"
              ... Rexx script will load Java and use its classes

              or

             "rexxj2 JavaVersion.rxj"      (Windows)
             "rexxj2.sh JavaVersion.rxj"   (Unix)
              ... Java will load Rexx and execute the Rexx script, which uses Java classes

   Purpose: This program displays the java version as stored in system.class

   last change: $Revision$ $Author$ $Date$

   changed:
              2016-07-26, Eva Gerger, Julian Reindorf - added Exit to Help

   license(s): see end of this file
*/
If arg(1)='?' Then
Do
  Parse Source source
  Say source
  Say 'This program displays the java version as stored in system.class'
  Exit
End

-- say "java.version:" bsf('invoke', 'System.class', 'getProperty', 'java.version')~substr(4)
say "java.version:" .bsf4rexx ~System.class ~getProperty('java.version')

::requires BSF.CLS

