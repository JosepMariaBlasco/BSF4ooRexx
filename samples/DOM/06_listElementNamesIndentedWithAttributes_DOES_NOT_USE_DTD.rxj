#!/usr/bin/env rexx
/*
   name:       06_listElementNamesIndentedWithAttributes_DOES_NOT_USE_DTD.rex
   purpose:    - demonstrate how to ignore any defined external DTD's, using a Rexx implementation
                 of "org.xml.sax.EntityResolver"
               - demonstrate how to implement a SAX content handler in Rexx, this version
                 dumps the ElementNames in a hierarchical fashion and gives attribute infos,
                 if attributes are defined for an ElementName;
               - demonstrates how to create directly a Java proxy object for calling back to Rexx
   author:     Rony G. Flatscher, (c) 2009
   date:       2009-06-22
   needs:      ooRexx 4.0, BSF4Rexx 4.0, at least Java 1.4
   resources:  - <http://www.cafeconleche.org/books/xmljava/chapters/index.html> (2009-06-19)
                 ... book on XML processing with Java ("Processing XML with Java", Elliotte Rusty)

               - <http://www.w3.org/DOM/>
                 ... official web site of the DOM project

               - <http://java.sun.com/j2se/1.4.2/docs/api/index.html> (2009-06-20)
                 ... DOM Java package for Java version 1.4 (easier to read because of no generics yet)

               - <http://java.sun.com/j2se/1.4.2/docs/api/org/xml/sax/package-summary.html> (2009-06-19)
                 ... SAX Java package for Java version 1.4 (easier to read because of no generics yet)

   license:    LGPL 3.0 (Lesser Gnu Public License version 3.0), cf. <http://www.gnu.org/licenses/lgpl.html>
               or
               ASF 2.0 (Apache Software Foundation License version 2.0), cf. <http://www.apache.org/licenses/LICENSE-2.0>
*/

parse arg xmlFileName

   /* create an instance of the JAXP DocumentBuilderFactory    */
factory=bsf.loadClass("javax.xml.parsers.DocumentBuilderFactory")~newInstance

   /* make sure that parser is set to be namespace aware       */
factory~setNamespaceAware(.true)

   /* now create the DocumentBuilder object                    */
parser=factory~newDocumentBuilder

   /* create a Rexx object for error handling                  */
eh=.errorHandler~new

   /* create a Java proxy using the Rexx object for error handling   */
javaProxy=BsfCreateRexxProxy(eh, , "org.xml.sax.ErrorHandler")

   /* set the parser's error handler                           */
parser~setErrorHandler(javaProxy)

   /* set the EntityResolver handler to our proxy  */
parser~setEntityResolver(BsfCreateRexxProxy(.EntityResolver~new, , "org.xml.sax.EntityResolver"))


   /* parse the file, result is full DOM-tree                  */
document=parser~parse(xmlFileName)

   /* get constant value to determine node types to filter     */
.local~show_element=bsf.getConstant("org.w3c.dom.traversal.NodeFilter", "SHOW_ELEMENT")
whatToShow=.show_element

   /* create a TreeWalker with only Element nodes              */
walker=document~createTreeWalker(document, whatToShow, .nil, .true)

   /* process list of Element nodes                            */
call walkTheTree walker~firstChild, 0



::requires BSF.CLS      /* get the Java support */


::routine walkTheTree   /* walks the tree recursively                */
  use arg node, level

  say "09"x~copies(level) || ppAtts(node~getNodeName, node~getAttributes)

  child=node~firstChild /* depth first                               */
  do while child<>.nil
     if child~getNodeType=.show_element then /* child could be of different type!*/
        call walkTheTree child, level+1      /* recurse, i.e. one level deeper   */

     child=child~nextSibling  /* breadth next                        */
  end


::routine ppAtts        /* pretty prints element name with attributes, if any; shows attribute typename  */
  use arg strElementName, atts

  tmpStr=strElementName
  tmpStr2=""
  if atts~getLength>0 then    /* o.k. attributes defined for this element  */
  do
      do i=0 to atts~getLength-1   /* iterate over all attributes, 0-based */
         att=atts~item(i)     /* get attribute node                        */
            /* DOM 2.0 is not making attribute types available, hence no type information */
         tmpStr2=tmpStr2 att~getName'="'att~getValue'"'
      end
  end
  return pp((tmpStr tmpStr2~strip)~strip)



::class ErrorHandler    /* will handle "org.xml.sax.ErrorHandler" events*/

::method unknown        /* handles "warning", "error" and "fatalError" events */
  use arg methName, argArray  /* fetch arguments                        */
  exception=argArray[1] /* retrieve SAXException argument               */
                        /* display error message                        */
  tmpStr=""
  publicId=exception~getPublicID
  tmpStr=tmpStr "| publicID="pp(publicID)

  systemID=exception~getSystemID
  if systemID<>.nil then tmpStr=tmpStr "| systemID="pp(systemID)

  tmpStr=methName":" pp("line="exception~getLineNumber",col="exception~getColumnNumber) strip(tmpStr)

  .error~say("///" strip(tmpStr)":" pp(exception~getMessage) "\\\")




::class "EntityResolver"/* implements "org.xml.sax.EntityResolver"      */

::method resolveEntity  /* returns an empty DTD InputSource to satisfy the SAX parser  */
  use arg publicID, systemID

  say "--->" self"::resolveEntity():" "publicID="pp(publicID) "systemID="pp(systemID) "<---"

      /* return an empty DTD instead; one could also supply a DTD from the local
         file system, a database or another URL instead! */
  charArray=.bsf~new("java.lang.String", "<!-- empty external DTD -->")~toCharArray
  reader=.bsf~new("java.io.CharArrayReader", charArray)  /* create a Reader object  */
  return .bsf~new("org.xml.sax.InputSource", reader)     /* create an InputSource   */

