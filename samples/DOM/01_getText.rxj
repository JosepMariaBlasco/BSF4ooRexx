#!/usr/bin/env rexx
/*
   name:       01_getText.rex
   purpose:    - demonstrate how to use DOM from Rexx to extract the text of an XML document from Rexx
               - demonstrate how to create a Java proxy object for calling back to Rexx in case
                 parsing errors occur
   author:     Rony G. Flatscher, (c) 2009
   date:       2009-06-22
   needs:      ooRexx 4.0, BSF4Rexx 4.0, at least Java 1.4
   resources:  - <http://www.cafeconleche.org/books/xmljava/chapters/index.html> (2009-06-19)
                 ... book on XML processing with Java ("Processing XML with Java", Elliotte Rusty)

                  - cf. example 11.10

               - <http://www.saxproject.org/> (2009-06-19)
               - <http://www.w3.org/DOM/>
                 ... official web site of the DOM project

               - <http://java.sun.com/j2se/1.4.2/docs/api/index.html> (2009-06-20)
                 ... DOM Java package for Java version 1.4 (easier to read because of no generics yet)

   license:    LGPL 3.0 (Lesser Gnu Public License version 3.0), cf. <http://www.gnu.org/licenses/lgpl.html>
               or
               ASF 2.0 (Apache Software Foundation License version 2.0), cf. <http://www.apache.org/licenses/LICENSE-2.0>
*/

parse arg xmlFileName

   /* create an instance of the JAXP DocumentBuilderFactory    */
factory=bsf.loadClass("javax.xml.parsers.DocumentBuilderFactory")~newInstance

   /* make sure that parser is set to be namespace aware       */
factory~setNamespaceAware(.true)

   /* now create the DocumentBuilder object                    */
parser=factory~newDocumentBuilder

   /* create a Rexx object for error handling                  */
eh=.errorHandler~new

   /* create a Java proxy using the Rexx object for error handling   */
javaProxy=BsfCreateRexxProxy(eh, , "org.xml.sax.ErrorHandler")

   /* set the parser's error handler                           */
parser~setErrorHandler(javaProxy)

   /* parse the file, result is full DOM-tree                  */
document=parser~parse(xmlFileName)

   /* make important constants available via .local            */
clz=bsf.loadClass("org.w3c.dom.Node")
.local~CDATA_Section_Node=clz~CDATA_SECTION_NODE
.local~TEXT_Node         =clz~TEXT_NODE

   /* now collect all text and CDATA nodes and display them    */
call followNode document


::requires BSF.CLS      /* get the Java support */

::routine followNode    /* walks the document tree recursively */
  use arg node
  call processNode node
  if node~hasChildNodes then
  do
     children=node~getChildNodes /* get NodeList               */
     loop i=0 to children~length-1  /* 0-based indexes!        */
        call followNode children~item(i)  /* recurse           */
     end
  end

::routine processNode   /* processes each node                 */
  use arg node
  nType=node~getNodeType            /* get type of node        */
  if nType=.text_node | nType=.cdata_section_node then
     say pp(node~getData)


::class ErrorHandler    /* will handle "org.xml.sax.ErrorHandler" events*/

::method warning        /* "warning" event                              */
  use arg exc
  .error~say("warning:    "  "line="exc~getLineNumber",col="exc~getColumnNumber":" pp(exc~getMessage))

::method error          /* "error" event                                */
  use arg exc
  .error~say("error:      "  "line="exc~getLineNumber",col="exc~getColumnNumber":" pp(exc~getMessage))

::method fatalError     /* "fatalsError" event                          */
  use arg exc
  .error~say("FATAL error:"  "line="exc~getLineNumber",col="exc~getColumnNumber":" pp(exc~getMessage))

