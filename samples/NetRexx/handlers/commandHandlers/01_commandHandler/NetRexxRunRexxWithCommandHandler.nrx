 *
 * purpose: demonstrate the possibilities of a NetRexx (Java) command handler
 *
 * needs:   testRexxWithCommandHandler.rxj
 *
 * @author  Rony G. Flatscher
 * @since   2022-08-26
 */

class NetRexxRunRexxWithCommandHandler public implements org.rexxla.bsf.engines.rexx.RexxCommandHandler
   properties private
   counter=0 -- count # of undefined commands

method main(s=String[]) static
   parse version v
   say "version:" v

   mgr = org.apache.bsf.BSFManager() -- create an instance of BSFManager
   rexxEngine = org.rexxla.bsf.engines.rexx.RexxEngine mgr.loadScriptingEngine("rexx")

   -- Rexx code to run
   rexxCode= "call 'testRexxWithCommandHandler.rxj'     ;" -
             "::requires BSF.CLS                        ;"      -- get ooRexx support (camouflage Java as ooRexx)

   -- Configure the RexxEngine
   rexxconf=rexxEngine.getRexxConfiguration()
   System.err.println("default rexxconf=["rexxconf"]\n")
       -- configure command handler
   rexxconf.addCommandHandler("EPOQUE", NetRexxRunRexxWithCommandHandler())
   rexxconf.setInitialAddressEnvironment("EPOQUE")

       -- add "rxmath" library, distributed with ooRexx
   rexxconf.addRequiredLibrary("rxmath")

       -- add "./anotherpath" to lookup
   fs=System.getProperty("file.separator")      -- "\" or "/"
   ps=System.getProperty("path.separator")      -- ";" or ":"
   ud=System.getProperty("user.dir")
   dirName="anotherpath"
   rexxconf.setExternalCallPath("."fs||dirName||ps||ud||fs||dirName)

       -- add ",.pre" to default call extensions
   rexxconf.setExternalCallExtensions(rexxconf.getExternalCallExtensions()",.pre")

   System.err.println("edited  rexxconf=["rexxconf"]\n")

   -- invoke the interpreter and run the Rexx program
   rexxEngine.apply("NetRexxRunRexxWithCommandHandler.rex", 0, 0, rexxCode, null, null);

   mgr.terminate()     -- make sure that the Rexx interpreter instance gets terminated!
   System.exit(0)      -- exit Java


method handleCommand(slot=Object, address=String, command=String) returns Object
    counter=counter+1
    System.err.println("[NetRexxRunRexxWithCommandHandler] address=["address"]" -
                         "\tcommand=["command"], counter=["counter"]");

    select case counter
        when 1 then     return "123";
        when 2 then     return GregorianCalendar()
        when 3 then     return null
        when 4 then     return getNil(slot)
        when 5 then     do
                           iv=Rexx getInterpreterVersion(slot) -- turn primitive into NetRexx
                           return "InterpreterVersion: -> as hex string: ["iv.d2x()"] -> as long: ["iv"]"
                        end
        when 6 then     do
                           ll=Rexx getLanguageLevel(slot)      -- turn primitive into NetRexx
                           return "LanguageLevel:      -> as hex string: ["ll.d2x()"] -> as long: ["ll"]"
                        end
        when 7 then     return getGlobalEnvironment(slot)
        when 8 then     return getLocalEnvironment(slot)
        when 9 then     return getCallerContext(slot)
        when 10 then    return getAllContextVariables(slot)
        when 11 then    if checkCondition(slot) then return String("1") -- return String object
                                                else return String("0") -- return String object
        when 12 then    return getConditionInfo(slot)
        when 13 then    if checkCondition(slot) then return String "1"  -- cast to (and return) String object
                                                else return String "0"  -- cast to (and return) String object
        when 14 then    return "This is ""when 14"", hence returning this interesting String... ;)"

        otherwise       return counter
   end

