 *
 * purpose: demonstrate the possibilities of a NetRexx (Java) command handler
 *
 * needs:   testRexxWithCommandHandler.rxj
 *
 * @author  Rony G. Flatscher
 * @since   2022-08-26
 */
 import org.rexxla.bsf.engines.rexx

class NetRexxRunRexxProgram public

method main(s=String[]) static
   parse version v
   say "version:" v

   if s.length=0 then
   do
      System.err.println("You must supply the name of a Rexx program to run.")
      System.exit(-1)
   end
   rexxPgm=s[0]

   mgr = org.apache.bsf.BSFManager() -- create an instance of BSFManager
   re = RexxEngine mgr.loadScriptingEngine("rexx")

   -- Configure the RexxEngine
   rexxconf=re.getRexxConfiguration()
   System.err.println("default rexxconf=["rexxconf"]\n")

   rexxconf.addCommandHandler("ONE"   ,         NetRexxOneCommandHandler())
   rexxconf.addCommandHandler("DEUX"  ,         NetRexxDeuxCommandHandler())
   rexxconf.setInitialAddressEnvironment("ONE")
   System.err.println("\nafter configuration:")
   System.err.println("edited  rexxconf=["rexxconf"]\n")
   say

   System.err.println("now running the Rexx program you supplied in file """rexxPgm""":")
   -- Rexx code to run
   rexxCode= "call """rexxPgm"""        ;" -
             "::requires BSF.CLS        ;"   -- get ooRexx support (camouflage Java as ooRexx)

   -- invoke the interpreter and run the Rexx program
   re.apply(rexxPgm, 0, 0, rexxCode, null, null)

   mgr.terminate()     -- make sure that the Rexx interpreter instance gets terminated!
   System.exit(0)      -- exit Java


-- // ===========================================

-------------------------------------------------------------------------------
class NetRexxOneCommandHandler implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[OneCommandHandler] address=["address"] command=["command"]")

   -- split at (and consume) whitespace
   arrCommand = command.split("\\p{javaWhitespace}+")
   cmd = ""
   if arrCommand.length>0 then
       cmd=arrCommand[0].toUpperCase()    -- get command, uppercase it

   -- excercise the default methods from RexxRedirectingCommandHandler or RexxHandler
   select case cmd
       when "HELLO" then   -- return values set the RC variable in Rexx
           return "Hello, ooRexx! This is your Java OneCommandHandler greeting you!"

       when "INFO" then    -- return information about this handler
           return toString(slot,address)

       when "PING" then    -- return values set the RC variable in Rexx
           return "Pong!"

       otherwise       -- unknown command received create a failure
           strAdditional = String[1]
           strAdditional[0] = String ( "Unknown command ["command"]")
           raiseCondition(slot, "Failure", command, strAdditional, "-1")
           return null  -- uses fourth argument of raiseCondition as RC
   end


-------------------------------------------------------------------------------
class NetRexxDeuxCommandHandler implements RexxRedirectingCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[OneCommandHandler] address=["address"] command=["command"]")

   -- split at (and consume) whitespace
   arrCommand = command.split("\\p{javaWhitespace}+")
   cmd = ""
   if arrCommand.length>0 then
       cmd=arrCommand[0].toUpperCase()    -- get command, uppercase it

   -- excercise the default methods from RexxRedirectingCommandHandler or RexxHandler
   select case cmd
       when "HELLO" then   -- return values set the RC variable in Rexx
           return "Hello, ooRexx! This is your Java OneCommandHandler greeting you!"

       when "INFO" then    -- return information about this handler
           return toString(slot,address)

       when "PING" then    -- return values set the RC variable in Rexx
           return "Pong!"

       otherwise       -- unknown command received create a failure
           strAdditional = String[1]
           strAdditional[0] = String ( "Unknown command ["command"]")
           raiseCondition(slot, "Failure", command, strAdditional, "-1")
           return null  -- uses fourth argument of raiseCondition as RC
   end

