 import org.rexxla.bsf.engines.rexx

class NetRexxCommandHandlers public

-------------------------------------------------------------------------------
class NetRexxCommandHandlers.AliceCommandHandler public implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[NetRexxAliceCommandHandler] address=["address"]" -
                      "\tcommand=["command"]")
   return String "118"

-------------------------------------------------------------------------------
class NetRexxCommandHandlers.DanielCommandHandler public implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[NetRexxDanielCommandHandler] address=["address"]" -
                      "\tcommand=["command"]")
   return "521"

