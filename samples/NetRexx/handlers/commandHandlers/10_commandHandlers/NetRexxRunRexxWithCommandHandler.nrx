 *
 * purpose: demonstrate the possibilities of a NetRexx (Java) command handler
 *
 * needs:   testRexxWithCommandHandler.rxj
 *
 * @author  Rony G. Flatscher
 * @since   2022-08-26
 */
import org.rexxla.bsf.engines.rexx

class NetRexxRunRexxWithCommandHandler public

method main(s=String[]) static
   parse version v
   say "version:" v

   mgr = org.apache.bsf.BSFManager() -- create an instance of BSFManager
   rexxEngine = org.rexxla.bsf.engines.rexx.RexxEngine mgr.loadScriptingEngine("rexx")

   -- Rexx code to run
   rexxCode= "call 'testRexxWithCommandExits.rxj'       ;" -
             "::requires BSF.CLS                        ;"      -- get ooRexx support (camouflage Java as ooRexx)

   -- Configure the RexxEngine
   rexxconf=rexxEngine.getRexxConfiguration()
   System.err.println("default rexxconf=["rexxconf"]\n")
   rexxconf.addCommandHandler("ALICE",          NetRexxAliceCommandHandler())
   rexxconf.addCommandHandler("DANIEL",         NetRexxDanielCommandHandler())
   rexxconf.addCommandHandler("MICHAEL",        NetRexxMichaelCommandHandler())
   rexxconf.addCommandHandler("RONY",           NetRexxRonyCommandHandler())

   rexxconf.addCommandHandler("GREGORIAN",      NetRexxReturnGregorianCalendarCommandHandler())

   rexxconf.addCommandHandler("TESTCONDITION",  NetRexxTestConditionCommandHandler())

   rexxconf.addCommandHandler("TESTEXCEPTION",  NetRexxTestExceptionCommandHandler())
   rexxconf.addCommandHandler("TESTEXCEPTION0", NetRexxTestException0CommandHandler())
   rexxconf.addCommandHandler("TESTEXCEPTION1", NetRexxTestException1CommandHandler())
   rexxconf.addCommandHandler("TESTEXCEPTION2", NetRexxTestException2CommandHandler())

   rexxconf.setInitialAddressEnvironment("ALICE")

   System.err.println("edited  rexxconf=["rexxconf"]\n")

   -- invoke the interpreter and run the Rexx program
   rexxEngine.apply("NetRexxRunRexxWithCommandExits.rex", 0, 0, rexxCode, null, null)

   mgr.terminate()     -- make sure that the Rexx interpreter instance gets terminated!
   System.exit(0)      -- exit Java



-- // ===========================================

-------------------------------------------------------------------------------
class NetRexxRunRexxWithCommandHandler.NetRexxAliceCommandHandler public implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[NetRexxAliceCommandHandler] address=["address"]" -
                      "\tcommand=["command"]")
   return String "118"

-------------------------------------------------------------------------------
class NetRexxRunRexxWithCommandHandler.NetRexxDanielCommandHandler public implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[NetRexxDanielCommandHandler] address=["address"]" -
                      "\tcommand=["command"]")
   return "521"

