-------------------------------------------------------------------------------
class NetRexxRunRexxWithCommandHandler.NetRexxReturnGregorianCalendarCommandHandler public implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
      System.err.println("[NetRexxReturnGregorianCalendarCommandHandler] address=["address"]" -
                           "\tcommand=["command"]")
      return java.util.GregorianCalendar()


-------------------------------------------------------------------------------
class NetRexxRunRexxWithCommandHandler.NetRexxTestConditionCommandHandler public implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[NetRexxTestConditionCommandHandler] address=["address"]" -
                        "\tcommand=["command"]"                                  -
                        "\n--> raising intentionally a 'Failure' condition before returning to Rexx ...\n")

   additional=Object[4]
   additional[0]="additional #1"
   additional[1]="additional #2"
   additional[2]=GregorianCalendar()
   additional[3]="additional #4"
   raiseCondition(slot, "Failure", "description: test", additional, "43 -nixi, noxi")
   return null

-------------------------------------------------------------------------------
class NetRexxRunRexxWithCommandHandler.NetRexxTestExceptionCommandHandler public implements RexxCommandHandler

method handleCommand(slot=Object, address=String, command=String) returns Object
   System.err.println("[NetRexxTestExceptionCommandHandler] address=["address"]" -
                        "\tcommand=["command"]"                                  -
                        "\n--> raising intentionally a syntax exception (# 98.945) before returning to Rexx ...\n")

   substitutions=Object[4]
   substitutions[0]="substitution #1"
   substitutions[1]="substitution #2"
   substitutions[2]=GregorianCalendar()
   substitutions[3]="substitution #4"
   raiseException(slot, 98945, substitutions)   -- some dummy Rexx error number ("98.945")
   return null

-------------------------------------------------------------------------------
