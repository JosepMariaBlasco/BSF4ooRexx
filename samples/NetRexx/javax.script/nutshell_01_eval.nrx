/** Demonstrate evaluating a Rexx script, once without supplying arguements and once supplying
 *  arguments using the scripting language's default <code>ScriptContext</code>.
 *
 *  @author Rony G. Flatscher
 *  @since 2015-05-21
 */

-- Using a ScriptManager to fetch the Rexx script enginge
manager = ScriptEngineManager()
rse=RexxScriptEngine manager.getEngineByName("rexx");
do
   sc=rse.getContext()                 -- get the default ScriptContext
   filename="nutshell_01.rex"
   sc.setAttribute(ScriptEngine.FILENAME,String filename,ScriptContext.ENGINE_SCOPE)

   say "(NetRexx) executing ["filename"] without arguments:"
   rse.eval(FileReader(filename), sc)  -- now let us execute the Rexx script

   say "-------------------------"
   say "(NetRexx) executing ["filename"], now with four arguments, the third one being 'null':"
       -- add arguments for the script to the ENGINE_SCOPE bindings
   sc.setAttribute(ScriptEngine.ARGV, ["one", "zwei", null, "quatre"], ScriptContext.ENGINE_SCOPE)
       -- the RexxScriptEngine always compiles the last script and makes it available with the getCurrentScript() method
   rse.getCurrentScript().eval()       -- now let us re-execute the Rexx script
catch exc=Exception
   say exc
   System.exit(-1)
end
System.exit(0)                         -- end Java
