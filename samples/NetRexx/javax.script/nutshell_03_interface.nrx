/** Demonstrate the usage of the <code>Invocable</code> methods, this time using Java proxies
 *  for executing Java interface methods either with Rexx routines or with Rexx objects.
 *
 *  @author Rony G. Flatscher
 *  @since 2015-05-22
 */

-- Using a ScriptManager to fetch the Rexx script enginge
manager = ScriptEngineManager()
rse=RexxScriptEngine manager.getEngineByName("rexx")
do
   filename="nutshell_03.rex"
   b=rse.getContext().getBindings(ScriptContext.ENGINE_SCOPE)
   b=rse.createBindings()-- if no ENGINE_SCOPE bindings available, create a Bindings
   b.put(ScriptEngine.FILENAME,String filename)

   say "(NetRexx) executing ["filename"] fetching resulting ooRexx object:"
   rp=RexxProxy rse.eval(FileReader(String filename), b) -- now let us execute the Rexx script

       -- use public <T> T getInterface(Class<T> clasz)
   say "(NetRexx) using \"<T> T getInterface(Class<T> clasz)\" using the <RexxScriptEngine>:"
   say "(NetRexx) executing ["filename"] fetching resulting ooRexx object:"
   rp=RexxProxy rse.eval(FileReader(String filename), b)  -- now let us execute the Rexx script
   say "---"

   r=Runnable rse.getInterface(Runnable.class)     -- get an interface implementation
   say "(NetRexx) creating new Thread supplying ["r"]:"
   th = Thread(r)
   th.start()
   th.sleep(100)   -- should be enough time for the thread to end (after running the Rexx code)
   say "---"

   say "--- now using the RexxCompiledScript methods instead ---"
   say "---"
   rcs=rse.getCurrentScript()   -- get current script

       -- use public <T> T getInterface(Class<T> clasz)
   say "(NetRexx) using \"<T> T getInterface(Class<T> clasz)\" using the <RexxCompiledScript>:"
   r=Runnable rcs.getInterface(Runnable.class)     -- get an interface implementation
   say "(NetRexx) creating new Thread supplying ["r"]:"
   th = Thread(r)
   th.start()
   th.sleep(100)   -- should be enough time for the thread to end (after running the Rexx code)
   say "---"

       -- use public <T> T getInterface(Object thiz, Class<T> clasz)
   say "(NetRexx) using \"<T> T getInterface(Object thiz, Class<T> clasz)\" using the <RexxCompiledScript>:"
   r=Runnable rcs.getInterface(rp, Runnable.class)     -- get an interface implementation
   say "(NetRexx) creating new Thread supplying ["r"]:"
   r=Runnable rcs.getInterface(rp, Runnable.class)     -- get an interface implementation
   th = Thread(r)
   th.start()
   th.sleep(100)  -- should be enough time for the thread to end (after running the Rexx code)

catch exc=Exception
   say exc
   exc.printStackTrace()
   System.exit(-1)
end

