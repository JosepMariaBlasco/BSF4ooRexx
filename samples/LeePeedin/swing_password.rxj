#!/usr/bin/env rexx
/* swing_password.rxj */
/*
This demonstration was written in ooRexx by Lee Peedin
using BSF4ooRexx, created and distributed by Dr. Rony Flatscher.
The latest release of BSF4ooRexx can be found at:
<http://wi.wu-wien.ac.at/rgf/rexx/bsf4oorexx/current/>
The latest information on ooRexx can be found at:
<http://www.oorexx.org/>
Some demonstrations may require these additional Java classes
SWT         <http://www.eclipse.org/swt/>
FreeTTS     <http://freetts.sourceforge.net/docs/index.php>

This demonstration has been tested using:
ooRexx              3.0.1
Java Version        1.5.0_06
Windows Version     Microsoft Windows XP [Version 5.1.2600]
Linux Version       Suse 10
-- changed:         2009-10-17, rgf, renamed extension to '.rxj'
                    2010-05-15, rgf, - adapting example to take full advantage of BSF4ooRexx
                                     - replacing bsf.addEventListener with a Rexx event handlers
*/
    parse source os how what
    call SysCls
    lf = '0a'x

-- Import the required classes
    call bsf.importClass 'javax.swing.JButton'           , 'JButton'
    call bsf.importClass 'javax.swing.JLabel'            , 'JLabel'

-- Create a userData directory
    userData=.directory~new         -- a directory which will be passed to Rexx with the event

-- Create a Java RexxProxy for controlling the closing of the application
   rexxCloseEH =.RexxCloseAppEventHandler~new  -- Rexx event handler
      -- Create Java RexxProxy for the Rexx event handler
   rpCloseEH=BsfCreateRexxProxy(rexxCloseEH, userData, "java.awt.event.WindowListener" )

-- Create a Java RexxProxy for resetting the text field
   rexxHelpEH=.RexxHelpEventHandler~new    -- Rexx event handler
   rpHelpEH=BsfCreateRexxProxy(rexxHelpEH, userData, "java.awt.event.ActionListener" )



-- Create a layout for the frame
    flo = .bsf~new('java.awt.FlowLayout')
-- Create the frame and give it a title
    frame = .bsf~new('javax.swing.JFrame', 'Password Input')
-- Add CLOSE event listener to frame
    frame~addWindowListener(rpCloseEH)
-- Get the default pane of the frame
    pane = frame~getContentPane
-- Set the pane layout
    pane~setLayout(flo)
-- Create a panel
    panel = .bsf~new('javax.swing.JPanel')

-- Create a password field
    pwField = .bsf~new('javax.swing.JPasswordField', copies(' ',10))
-- Define the echo character
    pwField~setEchoChar('*')

-- Create a lable
    pwLabel = .JLabel~new('Enter The Password')

-- Create OK button
    okButton = .JButton~new('Ok')
    frame~getRootPane~setDefaultButton(okButton)   -- set default push button
-- Assign a "hot-key" to the button
    okButton~setMnemonic('o')
-- Add listener to button
-- Create a Java RexxProxy for resetting the text field
   rpOkEH=BsfCreateRexxProxy(.RexxOkEventHandler~new, userData, "java.awt.event.ActionListener" )
   okButton~addActionListener(rpOkEH)

-- Create HELP button, hot-key, & listener
    helpButton = .JButton~new('Help')
    helpButton~setMnemonic('x')
    helpButton~addActionListener(rpHelpEH)

-- Add the buttons to the panel
    panel~~add(okbutton)~~add(helpButton)
-- Add the label, field, & panel to the frame
    pane~~add(pwLabel)~~add(pwField)~~add(panel)

-- Select the content of the field - prep for overwrite
    pwField~selectAll

-- Pack & show the frame
    frame~pack
    sw = frame~getToolkit~getScreenSize~getWidth
    sh = frame~getToolkit~getScreenSize~getHeight
    fw = frame~getWidth
    fh = frame~getHeight
    fx = (sw-fw)~format(,0)
    fy = 0
    frame~setLocation(fx,fy)
    frame~~setVisible(.true)~~tofront

    userData~pwField=pwField        -- save Java proxy object to be used in event handler

    rexxCloseEH~waitForExit -- wait until we are allowed to end the program
    call SysSleep .2        -- let Java's RexxProxy finalizations find a running Rexx instance



::requires bsf.cls

/* ------------------------------------------------------------------------ */
/* Rexx event handler to set "close app" indicator */
::class RexxCloseAppEventHandler
::method init        /* constructor */
  expose closeApp
  closeApp  = .false   -- if set to .true, then it is safe to close the app

::method unknown              -- intercept unhandled events, do nothing

::method windowClosing        -- event method (from WindowListener)
  expose closeApp
  closeApp=.true              -- indicate that the app should close

::method waitForExit          -- method blocks until attribute is set to .true
  expose closeApp
  guard on when closeApp=.true


/* ------------------------------------------------------------------------ */
/* Rexx event handler to reset */
::class RexxHelpEventHandler
::method actionPerformed
  use arg eventObject, slotDir

  pwField=slotDir~userData~pwField  -- fetch userData directory from slot argument and get 'pwField' from it

  text = "You can get the password by searching"
  text = text"0a"x"this example's source code"
  .bsf.dialog~messageBox(text,'Help','information')
  pwField~grabFocus


/* ------------------------------------------------------------------------ */
/* Rexx event handler to reset */
::class RexxOkEventHandler
::method actionPerformed
  use arg eventObject, slotDir

  pwField=slotDir~userData~pwField  -- fetch userData directory from slot argument and get 'pwField' from it

  pw = '01110010011001010111100001111000'
  if pwField~getText~c2x~x2b = pw then
      .bsf.dialog~messageBox('Congratulations - You Guessed The Password','Correct','information')
  else
      .bsf.dialog~messageBox('Invalid Password - Click Help','Error','error')
  pwField~setText('')
  pwField~grabFocus

