#!/usr/bin/env rexx
/* swing_xy.rxj */
/*
This demonstration was written in ooRexx by Lee Peedin
using BSF4ooRexx, created and distributed by Dr. Rony Flatscher.
The latest release of BSF4ooRexx can be found at:
<http://wi.wu-wien.ac.at/rgf/rexx/bsf4oorexx/current/>
The latest information on ooRexx can be found at:
<http://www.oorexx.org/>
Some demonstrations may require these additional Java classes
SWT         <http://www.eclipse.org/swt/>
FreeTTS     <http://freetts.sourceforge.net/docs/index.php>

This demonstration has been tested using:
ooRexx              3.0.1
Java Version        1.5.0_06
Windows Version     Microsoft Windows XP [Version 5.1.2600]
Linux Version       Suse 10
-- changed:         2009-10-17, rgf, renamed extension to '.rxj'
                    2010-05-09, rgf, - adapting example to take full advantage of BSF4ooRexx
                                     - replacing bsf.addEventListener[WithEventObject] with a Rexx event handlers

*/
    parse source os how what
    call SysCls
    lf = '0a'x

-- Import those classes that are needed more than once or that make coding (a little bit) simpler
    call bsf.importClass 'java.lang.Math'        , 'Math'
    call bsf.importClass 'javax.swing.JButton'   , 'JButton'
    call bsf.importClass 'javax.swing.JLabel'    , 'JLabel'
    call bsf.importClass 'javax.swing.JTextField', 'JTextField'

-- Create a userData directory
    userData=.directory~new         -- a directory which will be passed to Rexx with the event
-- Create a RexxProxy for controlling the closing of the application
    rexxCloseEH =.RexxCloseAppEventHandler~new  -- an instance of the RexxCloseAppEventHandler class
      -- Create Java RexxProxy and the interfaces it can be used for
    rpCloseEH=BsfCreateRexxProxy(rexxCloseEH, userData, "java.awt.event.ActionListener", -
                                                        "java.awt.event.KeyListener",    -
                                                        "java.awt.event.WindowListener" )

-- Create a RexxProxy for resetting the variables
   rexxResetEH=.RexxResetEventHandler~new       -- an instance of the RexxResetEventHandler
      -- Create Java RexxProxy and the interfaces it can be used for
   rpResetEH=BsfCreateRexxProxy(rexxResetEH, userData, "java.awt.event.ActionListener" )

-- Create a RexxProxy for Calculating
    rexxCalcEH=.RexxCalcEventHandler~new        -- an instance of the RexxCalcEventHandler
      -- Create Java RexxProxy and the interfaces it can be used for
    rpCalcEH=BsfCreateRexxProxy(rexxCalcEH, userData, "java.awt.event.ActionListener",  -
                                                      "java.awt.event.KeyListener")

-- Build the GUI
    gridLayout = .BSF~new('java.awt.GridLayout')   -- Create a gridlayout
    gridlayout~setColumns(2)           -- Set the number of columns
    gridlayout~setRows(5)              -- Set the number of rows

    frame = .BSF~new('javax.swing.JFrame', 'X/Y')  -- Create a frame and give it a title
    pane = frame~getContentPane        -- Get the frame's content pane
    pane~setLayout(gridlayout)         -- Apply the gridlayout to the pane
    frame~addWindowListener(rpCloseEH) -- Listen for WindowClosing

    ratio_label = .JLabel~new('Ratio')       -- Create a label with a value
    ratio_field = .BSF~new('javax.swing.JComboBox')-- Create a combo box
      -- Add several items to the combo box
    ratio_field~~addItem('4:3')~~addItem('16:9')~~addItem('16:10')~~addItem('3:4')
    ratio_field~addActionListener(rpCalcEH)  -- Listen for action in the field

    diagonal_label = .JLabel~new('Diagonal') -- Create a label with a value
    diagonal_field = .JTextField~new         -- Create a text field
    diagonal_field~addKeyListener(rpCalcEH)  -- Listen for key action in the field
    diagonal_field~addKeyListener(rpCloseEH) -- Listen for certain keyboard action

    x_label = .JLabel~new('X Value')   -- Create a label with a value
    x_field = .JTextField~new          -- Create a text field
    x_field~setEditable(.false)        -- Make the field non-editable
    x_field~addKeyListener(rpCloseEH)  -- Listen for certain keyboard action

    y_label = .JLabel~new('Y Value')   -- Create a label with a value
    y_field = .JTextField~new          -- Create a text field
    y_field~setEditable(.false)        -- Make the field non-editable
    y_field~addKeyListener(rpCloseEH)  -- Listen for certain keyboard action

    clearButton = .JButton~new('Clear')      -- Create a CLEAR button
    clearButton~setMnemonic('c')             -- Set the button's hot-key
    clearButton~addActionListener(rpResetEH) -- Listen for action in the field
    clearButton~addKeyListener(rpCloseEH)    -- Listen for certain keyboard action

-- Create an EXIT button, assign hot-key, listen for events
    exitButton = .JButton~new('Exit')
    exitButton~setMnemonic('x')
    exitButton~addActionListener(rpCloseEH)
    exitButton~addKeyListener(rpCloseEH)

-- Add the widgets to the frame
    pane~~add(ratio_label)~~add(ratio_field)
    pane~~add(diagonal_label)~~add(diagonal_field)
    pane~~add(x_label)~~add(x_field)
    pane~~add(y_label)~~add(y_field)
    pane~~add(clearButton)~~add(exitButton)

-- Pack & show the frame
    frame~pack
    sw = frame~getToolkit~getScreenSize~getWidth
    sh = frame~getToolkit~getScreenSize~getHeight
    fw = frame~getWidth
    fh = frame~getHeight
    fx = (sw-fw)~format(,0)
    fy = 0
    frame~setLocation(fx,fy)

-- Add objects to userData directory to which we may need access to in our event handlers
    userData~ratio_field    = ratio_field
    userData~diagonal_field = diagonal_field
    userData~x_field        = x_field
    userData~y_field        = y_field

    frame~~setVisible(.true)~~tofront
    diagonal_field~grabFocus

-- Wait for being allowed to close the app
    rexxCloseEH~waitForExit   -- wait until we are allowed to end the program
    call SysSleep .2          -- let Java's RexxProxy finalizations find a running Rexx instance


::requires bsf.cls

/* ------------------------------------------------------------------------ */
/* Rexx event handler to set "close app" indicator */
::class RexxCloseAppEventHandler
::method init        /* constructor */
  expose vk_escape closeApp bInfo
  closeApp  = .false   -- if set to .true, then it is safe to close the app
  vk_escape = bsf.getstaticvalue("java.awt.event.KeyEvent", "VK_ESCAPE")   -- "27"

::method unknown              -- intercept unhandled events, do nothing

::method actionPerformed      -- event method
  expose closeApp
  closeApp=.true              -- indicate that the app should close

::method keyPressed           -- event method
  expose vk_escape closeApp bInfo
  use arg eventObject

  if eventObject~keyCode= vk_escape then  -- integer value of 27
  do
     closeApp=.true           -- indicate that the app should close
     return
  end

  source=eventObject~getSource
  if source~bsf.isA(.JButton), source~getText="Exit" then
     closeApp=.true

::method windowClosing        -- event method
  expose closeApp
  closeApp=.true              -- indicate that the app should close

::method waitForExit          -- method blocks until attribute is set to .true
  expose closeApp
  guard on when closeApp=.true


/* ------------------------------------------------------------------------ */
/* Rexx event handler to reset */
::class RexxResetEventHandler
::method actionPerformed
  use arg eventObject, slotDir

  userData=slotDir~userData   -- fetch userData directory from slot argument
  userData~diagonal_field~setText('')
  userData~x_field       ~setText('')
  userData~y_field       ~setText('')



/* ------------------------------------------------------------------------ */
/* Rexx event handler to calc */
::class RexxCalcEventHandler
::method unknown              -- intercept unhandled events, do nothing
/*
  use arg methName, args
  eventObject=args[1]
  say "--> unhandled event:" pp(methName) "eventObject" pp(eventObject) "from" pp(eventObject~getSource)
*/

::method actionPerformed
  use arg eventObject, slotDir
  call calcFieldValues slotDir~userData   -- fetch userData directory from slot argument

::method keyReleased -- keyPressed
  use arg eventObject, slotDir
  call calcFieldValues slotDir~userData   -- fetch userData directory from slot argument



/* ------------------------------------------------------------------------ */
::routine calcFieldValues                 -- carry out recalculations
  use arg userData

  x_field = userData~x_field
  y_field = userData~y_field

  ratio   = userData~ratio_field~getSelectedItem
  diag    = userData~diagonal_field~getText
  dlen    = diag~length

  parse var ratio denominator':'numerator

  if diag > 0, diag~datatype('n') then
      do
          xsq=(.Math~pow(diag,2))/((1)+(.Math~pow(numerator,2))/(.Math~pow(denominator,2)))
          x = (.Math~sqrt(xsq)~format(dlen+1,2))~strip
          y = ((x * (numerator/denominator))~format(dlen+1,2))~strip
      end
  else
      do
          x = ''
          y = ''
      end

  x_field~setText(x)
  y_field~setText(y)

