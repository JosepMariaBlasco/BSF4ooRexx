#!/usr/bin/env rexx
/* swing_buttons2.rxj */
/*
This demonstration was written in ooRexx by Lee Peedin
using BSF4ooRexx, created and distributed by Dr. Rony Flatscher.
The latest release of BSF4ooRexx can be found at:
<http://wi.wu-wien.ac.at/rgf/rexx/bsf4oorexx/current/>
The latest information on ooRexx can be found at:
<http://www.oorexx.org/>
Some demonstrations may require these additional Java classes
SWT         <http://www.eclipse.org/swt/>
FreeTTS     <http://freetts.sourceforge.net/docs/index.php>

This demonstration has been tested using:
ooRexx              3.0.1
Java Version        1.5.0_06
Windows Version     Microsoft Windows XP [Version 5.1.2600]
Linux Version       Suse 10
-- changed:         2009-10-17, rgf, renamed extension to '.rxj'
                    2010-05-09, rgf, - using "bsf.createJavaArrayOf" instead of "bsf.createArray"
                                     - adapting example to take full advantage of BSF4ooRexx
                                     - replacing bsf.addEventListener[WithEventObject] with a Rexx event handler
*/
    parse source os how what
    call SysCls
    lf = '0a'x

-- Import those classes that are needed more than once or that make coding (a little bit) simpler
    call bsf.importClass 'javax.swing.JButton'        , 'JButton'
    call bsf.importClass 'javax.swing.JLabel'         , 'JLabel'
    call bsf.importClass 'java.awt.GridBagLayout'     , 'GridBagLayout'
    call bsf.importClass 'java.awt.GridBagConstraints', 'GridBagConstraints'

    blue         = .bsf~bsf.getStaticValue('java.awt.Color','blue')
    white        = .bsf~bsf.getStaticValue('java.awt.Color','white')
    red          = .bsf~bsf.getStaticValue('java.awt.Color','red')

-- Create a RexxProxy for Java
   rexxEH =.RexxEventHandler~new    -- an instance of the RexxEventHandler class
   userData=.directory~new          -- a directory which will be passed to Rexx with the event
      -- Define Java RexxProxy and the interfaces it can be used for
   rexxProxy4Java=BsfCreateRexxProxy(rexxEH, userData,                           -
                                             "java.awt.event.KeyListener",       -
                                             "java.awt.event.WindowListener",    -
                                             "java.awt.event.ActionListener",    -
                                             "javax.swing.event.ChangeListener"  )

-- Create A Frame
    frame = .BSF~new('javax.swing.JFrame', 'Swing Buttons 2')
-- Add a Windows listener
    frame~addWindowListener(rexxProxy4Java)

-- A frame, by default, has a Pane
    pane = frame~getContentPane
-- Apply the gridbaglayout to the pane - it will use the Constraints defined below
    pane~setLayout(.GridBagLayout~new)

-- Create an instance of GridBagConstraints
    c = .GridBagConstraints~new
-- Define the space to place between each widget
    c~insets = .bsf~new('java.awt.Insets', 1,1,1,1)--top, left, bottom, right
-- Indicate that we want each widget "stretched" vertically only (if needed)
    c~fill = .GridBagConstraints~vertical
-- Indicate where we want to place each widget within its grid area
    c~anchor = .GridBagConstraints~line_start

-- Create labels for each of our widgets
    label1 = .JLabel~new('JButton')
    label1~setOpaque(.true)
    label1~setBackground(blue)
    label1~setForeground(white)

    label2 = .JLabel~new('JRadioButton')

    label3 = .JLabel~new('JToggleButton')
    label3~setOpaque(.true)
    label3~setBackground(blue)
    label3~setForeground(white)

    label4 = .JLabel~new('JCheckBox')

    label5 = .JLabel~new('JComboBox')
    label5~setOpaque(.true)
    label5~setBackground(blue)
    label5~setForeground(white)

    label6 = .JLabel~new('JSpinner')

    label7 = .JLabel~new('JSlider')
    label7~setOpaque(.true)
    label7~setBackground(blue)
    label7~setForeground(white)

    label8 = .JLabel~new('JTextField')

-- Create an OK button
    OkButton = .JButton~new('OK')
-- Set its "hot-key"
    OkButton~setMnemonic('o')
-- Add a listener for its click
    OkButton~addActionListener(rexxProxy4Java)
-- Watch for the {esc} key
    OkButton~addKeyListener(rexxProxy4Java)

-- Create a Radio Button and add its mnemonic and listeners
    radioButton = .BSF~new('javax.swing.JRadioButton', 'Radio Button')
    radioButton~setMnemonic('r')
    radioButton~addActionListener(rexxProxy4Java)
-- Watch for the {esc} key
    radioButton~addKeyListener(rexxProxy4Java)

-- Create a Toggle Button and add its mnemonic and listeners
    toggleButton = .BSF~new('javax.swing.JToggleButton', 'Toggle Button')
    toggleButton~setMnemonic('t')
    toggleButton~addActionListener(rexxProxy4Java)
-- Watch for the {esc} key
    toggleButton~addKeyListener(rexxProxy4Java)

-- Create a Check Box and add its mnemonic and listeners
    checkBox = .BSF~new('javax.swing.JCheckBox', 'Check Box')
    checkBox~setMnemonic('c')
    checkBox~addActionListener(rexxProxy4Java)
-- Watch for the {esc} key
    checkBox~addKeyListener(rexxProxy4Java)

-- Create a Combo Box and add its mnemonic and listeners
    comboBox = .BSF~new('javax.swing.JComboBox')
    comboBox~~addItem('Red')~~addItem('Blue')~~addItem('Green')
    comboBox~addActionListener(rexxProxy4Java)
-- Watch for the {esc} key
    comboBox~addKeyListener(rexxProxy4Java)

-- Create a Spinner and add its mnemonic and listeners
    list = bsf.createJavaArrayOf("Object.class", 'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec')
    slm = .BSF~new('javax.swing.SpinnerListModel', list)
    spinner = .BSF~new('javax.swing.JSpinner', slm)
    spinner~setValue(date('m')~left(3))
    spinner~addChangeListener(rexxProxy4Java)

-- Create a Slidder and add its mnemonic and listeners
    slider = .BSF~new('javax.swing.JSlider',0,30,15)
    slider~setMajorTickSpacing(10)
    slider~setMinorTickSpacing(5)
    slider~setPaintTicks(.true)
    slider~setPaintLabels(.true)
    slider~addChangeListener(rexxProxy4Java)

-- Create a textField to display our button activity
    textField = .BSF~new('javax.swing.JTextField','',24)
-- Don't allow the textField to be edited
    textField~setEditable(.false)
    userData~textField=textField          -- save textField object with userdata directory

-- Create an Exit Button and add its mnemonic and listeners
    exitButton = .JButton~new('Exit')
    exitButton~setMnemonic('x')
    exitButton~setBackground(red)
    exitButton~setForeground(white)
    exitButton~addActionListener(rexxProxy4Java)

-- Place label in grid 0,0 (x,y)
    c~gridx = 0
    c~gridY = 0
    pane~add(label1,c)

-- Place widget in grid 1,0
    c~gridx = 1
    c~gridY = 0
    pane~add(OkButton,c)

-- Place label in grid 0,1
    c~gridx = 0
    c~gridY = 1
    pane~add(label2,c)

-- Place widget in grid 1,1
    c~gridx = 1
    c~gridY = 1
    pane~add(radioButton,c)

-- Place label in grid 0,2
    c~gridx = 0
    c~gridY = 2
    pane~add(label3,c)

-- Place widget in grid 1,2
    c~gridx = 1
    c~gridY = 2
    pane~add(toggleButton,c)

-- Place label in grid 0,3
    c~gridx = 0
    c~gridY = 3
    pane~add(label4,c)

-- Place widget in grid 1,3
    c~gridx = 1
    c~gridY = 3
    pane~add(checkBox,c)

-- Place label in grid 0,4
    c~gridx = 0
    c~gridY = 4
    pane~add(label5,c)

-- Place widget in grid 1,4
    c~gridx = 1
    c~gridY = 4
    pane~add(comboBox,c)

-- Place label in grid 0,5
    c~gridx = 0
    c~gridY = 5
    pane~add(label6,c)

-- Place widget in grid 1,5
    c~gridx = 1
    c~gridY = 5
    pane~add(spinner,c)

-- Place label in grid 0,6
    c~gridx = 0
    c~gridY = 6
    pane~add(label7,c)

-- Place widget in grid 1,6
    c~gridx = 1
    c~gridY = 6
    pane~add(slider,c)

-- Place label in grid 0,7
    c~gridx = 0
    c~gridY = 7
    pane~add(label8,c)

-- Place widget in grid 1,7
    c~gridx = 1
    c~gridY = 7
    pane~add(textField,c)

-- Place Exit button in grid 0,1
    c~gridx = 0
    c~gridY = 8
    pane~add(exitButton,c)

-- Pack the frame so we can get its width & height
    frame~pack
-- Get the screen's width & height
    sw = frame~getToolkit~getScreenSize~getWidth
    sh = frame~getToolkit~getScreenSize~getHeight
-- Get the frame's width & height
    fw = frame~getWidth
    fh = frame~getHeight
-- Calculate the x position to place our frame
    fx = (sw-fw)~format(,0)
-- Frame y position will be top of screen
    fy = 0
-- Set the location of our frame
    frame~setLocation(fx,fy)

-- Show the frame and bring it to the front
    frame~~setVisible(.true)~~tofront

   rexxEH~waitForExit   -- wait until we are allowed to end the program
   call SysSleep .2  -- let Java's RexxProxy finalizations find a running Rexx instance


::requires bsf.cls


/* 2010-05-09, rgf: employ BSF4ooRexx ability to implement event handlers in Rexx
               This class' methods get invoked for those awt/swing controls that have
               an instance registered for handling events. It filters key events and
               if the escape key got pressed, then will set the attribute 'escapeKeyPressed'
               to .true.
*/
::class RexxEventHandler
::method init        /* constructor */
  expose vk_escape closeApp bInfo
  closeApp         = .false      -- if set to .true, then it is safe to close the app
  bInfo            = .true       -- if set to .true, then some additional infos are output
  vk_escape        = bsf.getstaticvalue("java.awt.event.KeyEvent", "VK_ESCAPE")

::method unknown     /* intercept unhandled events */
  expose closeApp bInfo
  use arg methName, args

  eventObject=args[1]

   -- handle the following events (from different sources)
  if wordpos(methName, "ACTIONPERFORMED KEYPRESSED STATECHANGED") > 0 then
  do
      source=eventObject~getSource           -- get source of event
      parse var source javaClassName "@" .   -- extract Java class name (beanName contains it)
      uName=javaClassName~substr(javaClassName~lastPos(".")+1)
      select
         when uName="JButton"       then info=source~getText"-"uname "Pressed"
         when uName="JCheckBox"     then info=uname "/ State:"         source~isSelected
         when uName="JComboBox"     then info=uname "/ Selected Item:" source~getSelectedItem
         when uName="JRadioButton"  then info=uname "/ State:"         source~isSelected
         when uName="JSlider"       then info=uname "/ Value:"         source~getValue
         when uName="JSpinner"      then info=uname "/ Value:"         source~getValue
         when uName="JToggleButton" then info=uname "/ State:"         source~isSelected
         otherwise                       info=uname "..."
      end

      -- fetch userData directory which is always supplied in the last argument, get the stored
      -- textField object and set it to the value of 'info'
      args[args~last]~userData~textField~setText(info)
      if bInfo=.true then
         say args[args~last]~userData~textField~getText

      if uName="JButton", source~getText="Exit" then  -- if Exit button was pressed, let app close
         closeApp=.true
  end
  else
  do
      if bInfo=.true then
          say "--> unhandled event:" pp(methName) "eventObject" pp(eventObject) "from" pp(eventObject~getSource)
  end


::method keyPressed           -- event method
  expose vk_escape closeApp bInfo
  use arg eventObject

  if eventObject~keyCode= vk_escape then  -- integer value of 27
  do
     closeApp=.true           -- indicate that the app should close

     if bInfo=.true then
     do
         source=eventObject~getSource           -- get source of event
         parse var source javaClassName "@" .   -- extract Java class name (beanName contains it)
         uName=javaClassName~substr(javaClassName~lastPos(".")+1)

         if uName="JButton" then uName= source~getText"-"uName

         info="ESC key pressed in:" uName
         arg(arg())~userData~textField~setText(info)
         say info
     end
  end


::method windowClosing        -- event method
  expose closeApp
  closeApp=.true              -- indicate that the app should close


::method waitForExit          -- method blocks until attribute is set to .true
  expose closeApp
  guard on when closeApp=.true

