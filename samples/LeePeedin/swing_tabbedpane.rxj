#!/usr/bin/rexx
/* swing_tabbedpane2.rxj */
/*
This demonstration was written in ooRexx by Lee Peedin
using BSF4ooRexx, created and distributed by Dr. Rony Flatscher.
The latest release of BSF4ooRexx can be found at:
<http://wi.wu-wien.ac.at/rgf/rexx/bsf4oorexx/current/>
The latest information on ooRexx can be found at:
<http://www.oorexx.org/>
Some demonstrations may require these additional Java classes
SWT         <http://www.eclipse.org/swt/>
FreeTTS     <http://freetts.sourceforge.net/docs/index.php>

This demonstration has been tested using:
ooRexx              3.0.1
Java Version        1.5.0_06
Windows Version     Microsoft Windows XP [Version 5.1.2600]
Linux Version       Suse 10
-- changed:         2009-10-17, rgf, renamed extension to '.rxj'
                    2010-05-16, rgf, - adapting example to take full advantage of BSF4ooRexx
                                     - replacing bsf.addEventListener[WithEventObject] with a Rexx event handler
*/

   lf='0a'x          -- define a linefeed

-- Create a userData directory
   userData=.directory~new    -- a directory which will be passed to Rexx with the event

-- Retrieve the instances of the color cyan
   cyan = .bsf~bsf.getStaticValue('java.awt.Color','cyan')

-- Load a Java class that is embedded in another Java class
   painter = .bsf~new("javax.swing.text.DefaultHighlighter$DefaultHighlightPainter", cyan)
   userData~painter=painter    -- save object for event handler

-- Need several static values from this class so load them all
   call bsf.importClass 'java.awt.event.KeyEvent', 'KeyEvent'

-- Import the required classes
   call bsf.importClass 'java.awt.Dimension'     , 'Dimension'
   call bsf.importClass 'javax.swing.ImageIcon'  , 'ImageIcon'
   call bsf.importClass 'javax.swing.JFrame'     , 'JFrame'
   call bsf.importClass 'javax.swing.JLabel'     , 'JLabel'
   call bsf.importClass 'javax.swing.JPanel'     , 'JPanel'
   call bsf.importClass 'javax.swing.JTabbedPane', 'JTabbedPane'
   call bsf.importClass 'javax.swing.JTextArea'  , 'JTextArea'
   call bsf.importClass 'javax.swing.JScrollPane', 'JScrollPane'

   center = .JLabel~center       -- need a single static field value

-- Define a dimension to dictate the size (all tab results will be the size of the largest)
   dimension = .Dimension~new(230,150)

-- Create a couple of ImageIcons
   icon_01 = .ImageIcon~new('oorexx.gif')
   icon_02 = .ImageIcon~new('rexxla.gif')

-- Create the frame and give it a name
   frame = .JFrame~new('TabbedPaneDemo')
      -- Create a Java RexxProxy for controlling the closing of the application
   rexxCloseEH =.RexxCloseAppEventHandler~new   -- Rexx event handler
      -- Create Java RexxProxy for the Rexx event handler
   rpCloseEH=BsfCreateRexxProxy(rexxCloseEH, , "java.awt.event.WindowListener" )
   frame~addWindowListener(rpCloseEH)           -- add RexxProxy for Rexx event handler

   glo = .BSF~new('java.awt.GridLayout',1,1)    -- Define a gridlayout to use in our Panels

-- Create a tabbed pane
   tabbedPane = .JTabbedPane~new
   userData~tabbedPane=tabbedPane      -- add tabbedPane object to userData for event handling
   rp=BsfCreateRexxProxy(.RexxTabEventHandler~new, userData, "javax.swing.event.ChangeListener")
   tabbedPane~addChangeListener(rp)

-- Create a JPanel and add it to the JTabbedPane
   panel_01 = .JPanel~new
   filler = .JLabel~new('This is a JPanel')  -- create a label
   filler~setHorizontalAlignment(center)     -- define label's alignment
   panel_01~setLayout(glo)                   -- set gridLayout
   panel_01~add(filler)                      -- add label to panel
   panel_01~setPreferredSize(dimension)      -- set a preferred size
      -- add the panel to the tabbed pane
   tabbedPane~addTab('Tab 1',icon_01,panel_01,'Tool Tip 1')
   tabbedPane~setMnemonicAt(0,.KeyEvent~vk_1)-- define a hot-key for the tab

-- Create a JTextArea and add it to the JTabbedPane
   jtarea_01 = .JTextArea~new(4,18)
       -- define some text for the text area
   text = 'This is a JTextArea That Is Editable & Has Line Wrap Set To .true.  It will only wrap lines between words.'lf''lf
   text = text'Use this as an example of a Java class embedded within another Java class.'lf''lf
   text = text'Every instance of the string "as" will be highlighted as in a multiple search.'lf''lf
   jtarea_01~setText(text)                   -- assign the text
   jtarea_01~setLineWrap(.true)              -- turn on line wrap
   jtarea_01~setWrapStyleWord(.true)
   hiliter = jtarea_01~getHighlighter        -- get the highlighter object
   sp = .JScrollPane~new(jtarea_01)          -- define a scrollPane for the text area
   tabbedPane~addTab('Tab 2',.nil,sp,'Tool Tip 2') -- add the scroll pane to the tabbed pane
   tabbedPane~setMnemonicAt(1,.KeyEvent~vk_2)-- define a hot-key for the tab

-- Create another panel & add it to the tabbed pane
   panel_02 = .JPanel~new
   filler = .JLabel~new('This Is Another JPanel')
   filler~setHorizontalAlignment(center)
   panel_02~setLayout(glo)
   panel_02~add(filler)
   tabbedPane~addTab('Tab 3',.nil,panel_02,'Tool Tip 3')
   tabbedPane~setMnemonicAt(2,.KeyEvent~vk_3)

-- Create another text area & add it to the tabbed pane
   jtarea_02 = .JTextArea~new
   jtarea_02~setText('This is a JTextArea That Is Not Editable')
   jtarea_02~setEditable(.false)
   tabbedPane~addTab('Tab 4',icon_02,jtarea_02,'Tool Tip 4')
   tabbedPane~setMnemonicAt(3,.KeyEvent~vk_4)

-- Allow tabs to be scrolled
   tabbedPane~setTabLayoutPolicy(.JTabbedPane~scroll_tab_layout)
   tabbedPane~setOpaque(.true)

-- Get the content pane of the frame and add the tabbedPane to it
   pane = frame~getContentPane
   pane~add(tabbedPane)

   frame~pack              -- pack the frame so we can get its width & height
   sw = frame~getToolkit~getScreenSize~getWidth -- screen's dimension
   sh = frame~getToolkit~getScreenSize~getHeight
   fw = frame~getWidth     -- frame's dimension
   fh = frame~getHeight
   fx = (sw-fw)~format(,0) -- calculate the x position to place our frame
   fy = 0                  -- frame y position will be top of screen
   frame~setLocation(fx,fy)-- set the location of our frame (upper right hand corner)

-- Add objects we need access to in our Rexx event handlers to the userData directory
   userData~hiliter   = hiliter
   userData~jtarea_01 = jtarea_01

   frame~~setVisible(.true)~~tofront   -- show the frame and bring it to the front

   rexxCloseEH~waitForExit -- wait until we are allowed to end the program
   call SysSleep .2        -- let Java's RexxProxy finalizations find a running Rexx instance


::requires bsf.cls         -- get Java support


/* ------------------------------------------------------------------------ */
/* Rexx event handler to set "close app" indicator */
::class RexxCloseAppEventHandler
::method init        /* constructor */
  expose closeApp
  closeApp  = .false   -- if set to .true, then it is safe to close the app

::attribute closeApp          -- indicates whether app should be closed

::method unknown              -- intercept unhandled events, do nothing

::method windowClosing        -- event method (from WindowListener)
  expose closeApp
  closeApp=.true              -- indicate that the app should close

::method waitForExit          -- method blocks until attribute is set to .true
  expose closeApp
  guard on when closeApp=.true


/* ------------------------------------------------------------------------ */
/* Rexx event handler to process tab changes */
::class RexxTabEventHandler
::method stateChanged
  use arg eventObject, slotDir

  userData=slotDir~userData   -- fetch userData directory from slot argument

  tab = userData~tabbedPane~getSelectedIndex
  say "RexxTabEventHandler, selected index (0-based):" pp(tab) "at" pp(.dateTime~new)

  if tab=1 then
     call Search userData


::routine search              -- clear highlights, set new ones
  use arg userData

  hiliter   = userData~hiliter      -- fetch Java objects
  jtarea_01 = userData~jtarea_01
  painter   = userData~painter

  hiliter~removeAllHighlights       -- glear any previous highlights
  jtarea_01~repaint

  doc = jtarea_01~getDocument       -- get the current document of jtarea_01
  text = doc~getText(0,doc~getLength)  -- get the text in the document
  pattern = 'as'                       -- define pattern to search

   -- find every instance of the pattern and highlight it
  start_pos = text~caselessPos(pattern,1)
  do while start_pos > 0               -- pattern in text?
     end_pos = start_pos + pattern~length
     hiliter~addHighlight(start_pos-1, end_pos-1, painter)  -- highlight pattern
     jtarea_01~setCaretPosition(start_pos-1)
     start_pos = text~caselessPos(pattern,end_pos) -- find next occurrence, if any
  end

