#!/usr/bin/env rexx
/* swt_snippet133.rxj */
/*
This demonstration was written in ooRexx by Lee Peedin
using BSF4ooRexx, created and distributed by Dr. Rony Flatscher.
The latest release of BSF4ooRexx can be found at:
<http://wi.wu-wien.ac.at/rgf/rexx/bsf4oorexx/current/>
The latest information on ooRexx can be found at:
<http://www.oorexx.org/>
Some demonstrations may require these additional Java classes
SWT         <http://www.eclipse.org/swt/>
FreeTTS     <http://freetts.sourceforge.net/docs/index.php>

This demonstration has been tested using:
ooRexx              3.0.1
Java Version        1.5.0_06
Windows Version     Microsoft Windows XP [Version 5.1.2600]
-- changed:         2009-10-17, rgf, renamed extension to '.rxj'
                    2010-05-11, rgf, - adapting example to take full advantage of BSF4ooRexx
                                     - replacing bsf.addEventListener[WithEventObject] with a Rexx event handlers
*/

/* This ooRexx code is based loosely on the Java program found at
<http://dev.eclipse.org/viewcvs/index.cgi/%7Echeckout%7E/org.eclipse.swt.snippets/src/org/eclipse/swt/snippets/Snippet133.java>

The Java code, itself, does not perform as "advertised" in that if the user does not
select a font, the printed data will be in the default font of the printer - not Courier,10
which is what it is susposed to be when a font is not selected.

To prevent this in this ooRexx version, the user is required to select a font before
printing - an errorMessage is shown if no font is selected and the user is allowed to
select a font at print time.

Currently this ooRexx version:
Does not attempt "word-wrap"; therefore any line of text that exceeds the printer width
will be truncated.

Does not substitute spaces for tabs in the data to be printed.

Uses an array vs. a buffer to hold the print data.

Special Note to SELF: gc~stringExtent(whatever)~x will return the length of whatever after
the font & font attributes are set.

*/
    call SysCls
    lf  = '0a'x
    tab = '09'x     -- define a TAB to use in menu text to tab the accelerator text

    .local~lf  = '0a'x

    call bsf.importClass 'org.eclipse.swt.SWT'                    , 'swt'

    call bsf.importClass 'org.eclipse.swt.graphics.Color'         , 'swtColor'
    call bsf.importClass 'org.eclipse.swt.graphics.Font'          , 'swtFont'
    call bsf.importClass 'org.eclipse.swt.graphics.FontData'      , 'swtFontData'
    call bsf.importClass 'org.eclipse.swt.graphics.GC'            , 'swtGC'

    call bsf.importClass 'org.eclipse.swt.layout.FillLayout'      , 'swtFillLayout'

    call bsf.importClass 'org.eclipse.swt.printing.PrintDialog'   , 'swtPrintDialog'
    call bsf.importClass 'org.eclipse.swt.printing.Printer'       , 'swtPrinter'

    call bsf.importClass 'org.eclipse.swt.widgets.ColorDialog'    , 'swtColorDialog'
    call bsf.importClass 'org.eclipse.swt.widgets.Display'        , 'swtDisplay'
    call bsf.importClass 'org.eclipse.swt.widgets.FileDialog'     , 'swtFileDialog'
    call bsf.importClass 'org.eclipse.swt.widgets.FontDialog'     , 'swtFontDialog'
    call bsf.importClass 'org.eclipse.swt.widgets.Menu'           , 'swtMenu'
    call bsf.importClass 'org.eclipse.swt.widgets.MenuItem'       , 'swtMenuItem'
    call bsf.importClass 'org.eclipse.swt.widgets.MessageBox'     , 'swtMessageBox'
    call bsf.importClass 'org.eclipse.swt.widgets.Shell'          , 'swtShell'
    call bsf.importClass 'org.eclipse.swt.widgets.Text'           , 'swtText'

    userData=.directory~new
    interfaceSelectionListener="org.eclipse.swt.events.SelectionListener"  -- name of swt SelectionListener interface

    display  = .swtDisplay~new
    font     = .swtFont~new(display,'Courier',10,.swt~normal)

    fontData = .nil

    foregroundColor = display~getSystemColor(.swt~color_black)
    backgroundColor = display~getSystemColor(.swt~color_white)

    shell = .swtShell~new(display)
    shell~setLayout(.swtFillLayout~new)
    shell~setText('Print Text Using BSF4ooRexx Version:' .bsf4Rexx~version)

    text = .swtText~new(shell,.swt~border + .swt~multi + .swt~v_scroll + .swt~h_scroll)
    text~setFont(font)
    text~setForeground(foregroundColor)
    text~setBackground(backgroundColor)

    menuBar = .swtMenu~new(shell,.swt~bar)
    shell~setMenuBar(menuBar)

    item     = .swtMenuItem~new(menuBar,.swt~cascade)
    item~setText('&File')
    fileMenu = .swtMenu~new(shell,.swt~drop_down)
    item~setMenu(fileMenu)

    item = .swtMenuItem~new(fileMenu,.swt~push)
    item~setText("&Open..."tab"CTRL-O")     -- rgf was here
    item~setAccelerator(.swt~ctrl + 'O'~c2d) --Thanks Rony, you're very welcome, Lee!
    rexxProxyEH=BsfCreateRexxProxy(.menuOpenEH~new, userData, interfaceSelectionListener)
    item~addSelectionListener(rexxProxyEH)

    item = .swtMenuItem~new(fileMenu,.swt~push)
    item~setText('&Font...')
    rexxProxyEH=BsfCreateRexxProxy(.menuFontEH~new, userData, interfaceSelectionListener)
    item~addSelectionListener(rexxProxyEH)

    item = .swtMenuItem~new(fileMenu,.swt~push)
    item~setText('&Foreground Color...')
    rexxProxyEH=BsfCreateRexxProxy(.menuForegroundColorEH~new, userData, interfaceSelectionListener)
    item~addSelectionListener(rexxProxyEH)

    item = .swtMenuItem~new(fileMenu,.swt~push)
    item~setText('&Background Color...')
    rexxProxyEH=BsfCreateRexxProxy(.menuBackgroundColorEH~new, userData, interfaceSelectionListener)
    item~addSelectionListener(rexxProxyEH)

    item = .swtMenuItem~new(fileMenu,.swt~push)
    item~setText('&Print...'tab'CTRL-P')
    item~setAccelerator(.swt~ctrl + 'P'~c2d)
    rexxProxyEH=BsfCreateRexxProxy(.menuPrintEH~new, userData, interfaceSelectionListener)
    item~addSelectionListener(rexxProxyEH)

    item = .swtMenuItem~new(fileMenu,.swt~push)
    item~setText('E&xit...'tab'CTRL-X')
    item~setAccelerator(.swt~ctrl + 'X'~c2d)
    rexxProxyEH=BsfCreateRexxProxy(.exitEH~new, userData, interfaceSelectionListener)
    item~addSelectionListener(rexxProxyEH)

    -- save Java objects we need in the event handlers
    userData~shell   = shell
    userData~display = display
    userData~font    = font
    userData~text    = text
    userData~foregroundColor=foregroundColor
    userData~backgroundColor=backgroundColor

    shell~~open      -- don't pack: would resize (to smallest) window

    do while shell~isDisposed=.false      -- swt event loop
       if display~readAndDispatch=.false then
          display~sleep
    end

    font~dispose
    foregroundColor~dispose
    backgroundColor~dispose
    display~dispose


::requires bsf.cls


::class menuOpenEH
::method unknown     -- intercept unhandled events
  use arg methName, methArgs
  userData=bsf.getSlotDir(methArgs)~userData

  dialog = .swtFileDialog~new(userData~shell,.swt~open)
  dialog~setFilterExtensions(bsf.createJavaArrayOf("java.lang.String", "*.rxj", "*.rxo", "*.rex", "*.*"))

  name   = dialog~open        -- show dialog, fetch selection, if any
  if name<>.nil then
  do
     istream = .stream~new(name)
     iarray  = istream~arrayin
     istream~close
     userData~iarray=iarray
     lf  = '0a'x
     ftext = ''
     do i = 1 to iarray~items
        ftext = ftext||iarray[i]
        if i < iarray~items then
           ftext = ftext||lf
     end
     userData~text~setText(ftext)
  end



::class menuFontEH
::method unknown     -- intercept unhandled events
  use arg methName, methArgs
  userData=bsf.getSlotDir(methArgs)~userData

  fontData=menuFont(userData) -- let user select font
  if fontData<>.nil then      -- show dialog, fetch selection, if any
  do
     font = .swtFont~new(userData~display,fontData)
     userData~font=font       -- save new font
     userData~text~setFont(font)
  end


::routine menuFont
  use arg userData
  fontDialog = .swtFontDialog~new(userData~shell)
  fontDialog~setFontList(userData~font~getFontData)
  return fontDialog~open      -- return selection or .nil, if none


::class menuForegroundColorEH
::method unknown     -- intercept unhandled events
  use arg methName, methArgs
  userData=bsf.getSlotDir(methArgs)~userData

  colorDialog = .swtColorDialog~new(userData~shell)
  colorDialog~setRGB(userData~foregroundColor~getRGB)
  rgb = colorDialog~open
  if rgb<>.nil then           -- show dialog, fetch selection, if any
  do
     foregroundColor = .swtColor~new(userData~display,rgb)
     userData~foregroundColor=foregroundColor   -- save new color
     userData~text~setForeground(userData~foregroundColor)
  end


::class menuBackgroundColorEH
::method unknown     -- intercept unhandled events
  use arg methName, methArgs
  userData=bsf.getSlotDir(methArgs)~userData

  colorDialog = .swtColorDialog~new(userData~shell)
  colorDialog~setRGB(userData~backgroundColor~getRGB)
  rgb = colorDialog~open      -- show dialog, fetch selection, if any
  if rgb<>.nil then
  do
     backgroundColor = .swtColor~new(userData~display,rgb)
     userData~backgroundColor=backgroundColor   -- save new color
     userData~text~setBackground(backgroundColor)
  end



::class menuPrintEH
::method unknown     -- intercept unhandled events
  use arg methName, methArgs
  userData=bsf.getSlotDir(methArgs)~userData

  iarray=userData~iarray
  if iarray=.nil then
  do
     box = .swtMessageBox~new(userData~shell,.swt~icon_error)
     box~setMessage('No Data To Print: You Must Select A File First')
     rv = box~open
     return
  end

  if fontData<>.nil then      -- show dialog, fetch selection, if any
  do
     box = .swtMessageBox~new(userData~shell,.swt~icon_error)
     box~setMessage('You Must Select A Font For The Printer')
     rv = box~open
     fontData=menuFont(userData)
     if fontData=.nil then
         return
  end
  dialog = .swtPrintDialog~new(userData~shell,.swt~none)
  data = dialog~open
  if data=.nil then
      return

  textToPrint = userData~text~getText
  printer = .swtPrinter~new(data)

  call print
  return

print:
  if printer~startJob('Snippet133') then
  do
     clientArea   = printer~getClientArea
     trim         = printer~computeTrim(0,0,0,0)
     dpi          = printer~getDPI
     leftMargin   = dpi~x + trim~y
     rightMargin  = clientArea~width
     topMargin    = dpi~y + trim~y
     bottomMargin = clientArea~height - dpi~y + trim~y + trim~height

     tabs = copies(' ',4)

     gc = .swtGC~new(printer)

     printerFont = .swtFont~new(printer,fontData)

     gc~setFont(printerFont)

     tabWidth   = gc~stringExtent(tabs)~x
     lineHeight = gc~getFontMetrics~getHeight

     rgb = userData~foregroundColor~getRGB
     printerForegroundColor = .swtColor~new(printer,rgb)
     gc~setForeground(printerForegroundColor)

     rgb = userData~backgroundColor~getRGB
     printerBackgroundColor = .swtColor~new(printer,rgb)
     gc~setBackground(printerBackgroundColor)

     call printText
     printer~endJob
  end
  return

printText:
  printer~startPage
  x = leftMargin
  y = topMargin
  do i = 1 to iarray~items
     ftext = iarray[i]
     call printWordBuffer gc
  end
  return

printWordBuffer:
  gc~drawString(ftext,x,y,.false)
  call newLine
  return

newLine:
  x = leftMargin
  y = y + lineHeight
  if y + lineHeight > bottomMargin then
  do
     printer~endPage
     y = topMargin
     printer~startPage
  end
  return


::class exitEH
::method unknown     -- intercept unhandled events
  use arg methName, methArgs
  bsf.getSlotDir(methArgs)~userData~shell~dispose