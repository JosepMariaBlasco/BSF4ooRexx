*/
p = bsf("lookupBean", "centerPanel")   /* reference the entry in BSF registry, put there by
                                          "ScriptedUI.class" */

/* set the layout manager to border */
call bsf "invoke", p, "setLayout", bsf("new", "", "java.awt.BorderLayout")

/* add a few things */
call bsf "invoke", p, "add", "Center", bsf("new", "", "java.awt.Label",     "Middle from Rexx")
call bsf "invoke", p, "add", "North",  bsf("new", "", "java.awt.TextField", "North text from Rexx")
call bsf "invoke", p, "add", "South",  bsf("new", "", "java.awt.TextField", "South from Rexx")
call bsf "invoke", p, "add", "East",   bsf("new", "", "java.awt.Button",    "Inner east from Rexx")
call bsf "invoke", p, "add", "West",   bsf("new", "", "java.awt.Button",    "Inner west from Rexx")

/* configure p a bit */
call bsf "invoke", p, "setBackground", bsf("getStaticValue", "java.awt.Color", "yellow")

/* configure the frame that p is in */
f = bsf("invoke", p, "getParent")
call bsf "invoke", f, "setTitle", "Hello from REXX (title reset from Rexx)"


