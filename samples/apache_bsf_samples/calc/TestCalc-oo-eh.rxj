if      BsfInvokedBy()=1 then say "This Rexx program was invoked by Java!"
else if BsfInvokedBy()=2 then say "This Rexx program was invoked by Rexx, JVM loaded by Rexx!"
else                          say "No JVM present, we got troubles ..."


/*********************************************************
 * A simple four function calculator, written in REXX    *
 *********************************************************/

   -- Create a directory which can be passed on to Rexx event handlers
userData=.directory~new

   -- Create a Java RexxProxy for controlling the closing of the application
rexxCloseEH =.RexxCloseAppEventHandler~new   -- Rexx event handler
   -- Create Java RexxProxy for the Rexx event handler
rpCloseEH=BsfCreateRexxProxy(rexxCloseEH, , "java.awt.event.WindowListener" )

/* *** create a res window                   */
res = .bsf~new("java.awt.TextField", 0)
userData~res=res              -- save text field in userData directory

/* *** create a panel of buttons                */
panel = .bsf~new("java.awt.Panel")
panel~setLayout(.bsf~new("java.awt.GridLayout", 4, 4))

/* *** create RexxProxys for the Rexx event handlers  */
rpClearEH=BsfCreateRexxProxy(.RexxClearEH~new, userData, "java.awt.event.ActionListener")
rpPressEH=BsfCreateRexxProxy(.RexxPressEH~new, userData, "java.awt.event.ActionListener")
rpOpEH   =BsfCreateRexxProxy(.RexxOpEH~new,    userData, "java.awt.event.ActionListener")

buttons = "789*456/123-C0.+"
do i=1 to buttons~length
   label=buttons~substr(i, 1)
   button=.bsf~new("java.awt.Button", label)
   panel~add(button)

   if "*/-+"~pos(label)>0 then
      button~addActionListener(rpOpEH)

   else if label="C" then
      button~addActionListener(rpClearEH)

   else
      button~addActionListener(rpPressEH)
end


/* *** Place everything in the frame            */
-- frame = .bsf~bsf.lookupBean("frame")
frame = bsf.wrap(bsf('getBSFManager'))~lookupBean('frame') -- rgf, 20180102
frame~~setTitle("Object Rexx Calc") ~~resize(130, 200)
frame~~add("North", res) ~~add("Center", panel)
frame~addWindowListener(rpCloseEH)
frame~~validate ~~setVisible(.true)

/* *** Initialize the state of the calculator, saved in the userData dir   */
userData~mem = 0
userData~nextOp = "+"
userData~autoClear = 1              /* true         */

rexxCloseEH~waitForExit -- wait until we are allowed to end the program
call bsf "exit"         -- force Java to exit


::requires BSF.CLS    -- add Object Rexx proxy support


/* ------------------------------------------------------------------------ */
/* Rexx event handler to set "close app" indicator */
::class RexxCloseAppEventHandler
::method init        /* constructor */
  expose closeApp
  closeApp  = .false   -- if set to .true, then it is safe to close the app

::attribute closeApp          -- indicates whether app should be closed

::method unknown              -- intercept unhandled events, do nothing

::method windowClosing        -- event method (from WindowListener)
  expose closeApp
  closeApp=.true              -- indicate that the app should close

::method waitForExit          -- method blocks until attribute is set to .true
  expose closeApp
  guard on when closeApp=.true


/* ------------------------------------------------------------------------ */
/* Rexx event handler to clear the calculator   */
::class RexxClearEH

::method actionPerformed      -- event method (from WindowListener)
  use arg eventObject, slotDir

  userData=slotDir~userData   -- get userData directory
  userData~mem=0              -- clear memory
  userData~nextOp=""          -- no defined next operator
  userData~res~setText(0)     -- reset result to "0"

/* ------------------------------------------------------------------------ */
/* Rexx event handler to dealing with button presses  */
::class RexxPressEH

::method actionPerformed      -- event method (from WindowListener)
  use arg eventObject, slotDir

  userData=slotDir~userData   -- get userData directory from slot argument
  key=eventObject~source~getLabel   -- get button's label
  res=userData~res            -- fetch result text field

  if userData~autoClear then
     res~setText(0)  -- clear result

  if res~getText=="0" & key<>"." then
     res~setText("")

  if key="." then
  do
     if pos(".", res~getText)>0 then
        key=""
  end
  res~setText(res~getText || key)
  userData~autoClear=0           -- set it to false


/* ------------------------------------------------------------------------ */
/* Rexx event handler to dealing with operator button presses  */
::class RexxOpEH

::method actionPerformed      -- event method (from WindowListener)
  use arg eventObject, slotDir

  userData=slotDir~userData   -- get userData directory from slot argument
  key=eventObject~source~getLabel   -- get button's label
  res=userData~res            -- fetch result text field
  mem=userData~mem            -- fetch current memory value
  nextOp=userData~nextOp      -- fetch nextOp
  num=res~getText
  if      nextOp="+" then mem=mem+num
  else if nextOp="-" then mem=mem-num
  else if nextOp="*" then mem=mem*num
  else if nextOp="/" & num<>0 then mem=mem/num

  userData~mem=mem           -- save new memory value
  userData~nextOp=key
  res~setText(mem)
  userData~autoClear=1          /* set to true          */