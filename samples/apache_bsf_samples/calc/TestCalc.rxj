if rxFuncQuery("BSF") then  /* no bsf4rexx support available yet, hence load Java */
do
   call rxFuncAdd "BsfLoadFuncs", "BSF4ooRexx", "BsfLoadFuncs"
   call BsfLoadFuncs    /* load all BSF-functions                    */
   call BsfLoadJava     /* load the JVM and set up BSF4Rexx-support  */
end

if      BsfInvokedBy()=1 then say "This Rexx program was invoked by Java!"
else if BsfInvokedBy()=2 then say "This Rexx program was invoked by Rexx, JVM loaded by Rexx!"
else                          say "No JVM present, we got troubles ..."


/*********************************************************
 * A simple four function calculator, written in REXX    *
 *********************************************************/

/* *** create a res window                   */
tf = bsf("new", "", "java.awt.TextField", 0)

/* *** create a panel of buttons                */
panel = bsf("new", "",  "java.awt.Panel")
call bsf "invoke", panel, "setLayout", bsf("new", "", "java.awt.GridLayout", 4, 4)

buttons = "789*456/123-C0.+"
do i=1 to length(buttons)
   label=substr(buttons, i, 1)
   button=bsf("new", "button_"label, "java.awt.Button", label)
   call bsf "invoke", panel, "add", button
   if pos(label, "*/-+")>0 then
      call bsf "addEventListener", button, "action", "", "call op '" ||label||"'"
   else if label="C" then
      call bsf "addEventListener", button, "action", "", "call clear"
   else
      call bsf "addEventListener", button, "action", "", "call press" label
end


/* *** Place everything in the frame            */
-- frame = bsf("lookupBean", "frame")     /* get access to the frame */
frame = bsf('invoke', bsf('getBSFManager'), 'lookupBean', 'frame') -- rgf, 20180102

call bsf "invoke", frame, "setTitle", "Rexx Calc"
call bsf "invoke", frame, "resize", 130, 200
call bsf "invoke", frame, "add",    "North",  tf
call bsf "invoke", frame, "add",    "Center", panel
call bsf "invoke", frame, "validate"
call bsf "invoke", frame, "show"
call bsf "addEventListener", frame, "window", "windowClosing", "call bsf 'exit'"

/* *** Initialize the state of the calculator   */
mem = 0
nextOp = "+"
autoClear = 1   /* true                         */

do forever      /* get eventText and execute it as a Rexx program       */
   interpret bsf("pollEventText")
end
exit


press:                          /* handle data entry keys       */
   parse arg key

   if autoClear  then
      call bsf "invokeStrict", tf, "setText", "str", 0

   if bsf("invoke", tf, "getText")=="0" & key<>"." then
      call bsf "invoke", tf, "setText", ""

   if key="." then
      if pos(".", bsf("invoke", tf, "getText"))>0 then
         key=""


   call bsf "invokeStrict", tf, "setText", "str", bsf("invoke", tf, "getText") || key
   autoClear=0                  /* set it to false              */
   return

/*  *** handle arithmetic keys  */
op:
   parse arg key
   num=bsf("invoke", tf, "getText")
   if      nextOp="+" then mem=mem+num
   else if nextOp="-" then mem=mem-num
   else if nextOp="*" then mem=mem*num
   else if nextOp="/" & num<>0 then mem=mem/num
   nextOp=key
   call bsf "invoke", tf, "setText", mem
   autoClear=1          /* set to true          */
   return

/* handle the "C" key   */
clear:
   mem=0
   nextOp=""
   call bsf "invokeStrict", tf, "setText", "str", 0
   return
