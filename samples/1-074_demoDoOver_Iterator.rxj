#!/usr/bin/env rexx
/*
    Author:     Rony G. Flatscher
    Name:       1-074_demoDoOver_Iterator.rxj
    Date:       2016-11-07 (refactored from 1070_demoDoOver.rxj)
    Purpose:    Demonstrate how to use DO...OVER and (starting with ooRexx 5) DO WITH...OVER with
                - java.util.Iterator
                     - MAKEARRAY will supply the collected values
                     - SUPPLIER will supply as index and item the collected value (as if they were ooRexx Bags)
    Needs:      - BSF4ooRexx
                - ooRexx 5.0 or later
    Changed:    2016-12-21, rgf: make sure that "DO WITH" is run on ooRexx 5.0.0 or higher
                2018-10-07, rgf: use new entry .bsf4rexx~rexx.version
                2022-01-20, rgf: - removed checks for ooRexx 5.0 or later as previous versions of ooRexx
                                   would cause a syntax error already
                                 - refactored the routines to proper Rexx programs to ease spotting
                                   DoOver samples that may be of interest to the programmer
    License:
    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2022 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

tab="    "                 -- define indentation
line="-"~copies(79)        -- define line


-- demonstrates iterating over a java.util.Iterator
say "Demo DO..OVER a java.util.Iterator object"
say

   -- Rexx languages in historical order
arrList=.BSF~new("java.util.ArrayList")   -- create an ArrayList add values to it
arrList~add("Rexx is great!")
arrList~add("Regina is great!")
arrList~add("NetRexx is great!")
arrList~add("ooRexx is great!")
arrList~add("BSF4ooRexx is great!")

say tab "a) now getting an Iterator from the ArrayList..."
it=arrList~iterator
say
say tab "   iterating over all values after explicitly sending MAKEARRAY to the Java object:"
say
do k over it~makeArray           -- using the Iterator object
   say tab tab "value:" pp(k)
end
say

say tab "b) now getting another Iterator from the ArrayList... (previous one got exhausted)"
it=arrList~iterator
say
say tab "   iterating over all values using DO...OVER (sends MAKEARRAY message implicitly):"
say
do k over it                     -- using the Iterator object
   say tab tab "value:" pp(k)
end
say

say tab "c) now getting another Iterator from the ArrayList... (previous one got exhausted)"
it=arrList~iterator
say
say tab "   iterating over all values using DO WITH...OVER (sends SUPPLIER message implicitly):"
say
do with index i item v over it   -- using the Iterator object
   say tab tab "index:" pp(i)~left(22) "item:" pp(v)
end

say line

::requires "BSF.CLS" -- get Java support
