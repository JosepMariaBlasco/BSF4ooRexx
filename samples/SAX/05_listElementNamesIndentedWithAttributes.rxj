/*
   name:       05_listNamesIndentedWithAttributes.rex
   purpose:    - demonstrate how to implement a SAX content handler in Rexx, this version
                 dumps the ElementNames in a hierarchical fashion and gives attribute infos,
                 if attributes are defined for an ElementName;
               - demonstrates how to create directly a Java proxy object for calling back to Rexx
   author:     Rony G. Flatscher, (c) 2009
   date:       2009-06-22
   needs:      ooRexx 4.0, BSF4Rexx 4.0, at least Java 1.4
   resources:  - <http://www.cafeconleche.org/books/xmljava/chapters/index.html> (2009-06-19)
                 ... book on XML processing with Java ("Processing XML with Java", Elliotte Rusty)

               - <http://www.saxproject.org/> (2009-06-19)
                 ... official web site of the SAX project

               - <http://www.megginson.com/downloads/SAX/> (2009-06-19)
                 ... original SAX project site, still interesting information

               - <http://java.sun.com/j2se/1.4.2/docs/api/org/xml/sax/package-summary.html> (2009-06-19)
                 ... SAX Java package for Java version 1.4 (easier to read because of no generics yet)

   license:    LGPL 3.0 (Lesser Gnu Public License version 3.0), cf. <http://www.gnu.org/licenses/lgpl.html>
               or
               ASF 2.0 (Apache Software Foundation License version 2.0), cf. <http://www.apache.org/licenses/LICENSE-2.0>
*/

parse arg xmlFileName

   /* if one needs only the Java proxy, then a more convenient way is to use
      BsfCreateRexxProxy(), which accepts starting with the third argument
      Java interface classes, names or Java objects implementing interfaces
      in any order */
javaProxy =BsfCreateRexxProxy(.saxHandler~new, , "org.xml.sax.ContentHandler")

   /* create a Java SAX parser object  */
parser=bsf.loadClass("org.xml.sax.helpers.XMLReaderFactory")~createXMLReader

   /* set the content handler to our proxy   */
parser~setContentHandler(javaProxy)

   /* create a Rexx object for error handling                  */
eh=.errorHandler~new
   /* create a Java proxy using the Rexx object for error handling   */
javaEH=BsfCreateRexxProxy(eh, , "org.xml.sax.ErrorHandler")
   /* set the parser's error handler (optional)                */
parser~setErrorHandler(javaEH)

   /* parse the InputStream, the parser will call the content handler   */
parser~parse(xmlFileName)



::requires BSF.CLS      /* get the Java support */

::routine ppAtts        /* pretty prints element name with attributes, if any; shows attribute typename  */
  use arg strElementName, atts

  tmpStr=strElementName
  tmpStr2=""
  if atts~getLength>0 then    /* o.k. attributes defined for this element  */
  do
      do i=0 to atts~getLength-1   /* iterate over all attributes */
         /* uses bsf.invokeStrict(), because getValue() and getType() accept integers and strings as indices;
            in this case we force to pick the method that has the "int" signature   */
         tmpStr2=tmpStr2 atts~getQName(i)'="'atts~bsf.invokeStrict("getValue", "int", i)'"<<'atts~bsf.invokeStrict("getType", "int", i)">>"
      end
  end
  return pp((tmpStr tmpStr2~strip)~strip)


::class "saxHandler"    /* a Rexx content handler, matching the interface "org.xml.sax.ContentHandler"   */

::method init           /* constructor */
  expose tab            /* direct access to attributes   */
  tab="09"x             /* tab char    */

::method startDocument  /* new document*/
  expose level          /* direct access to attributes   */
  level=0               /* indicates current level       */

::method startElement
  expose level tab      /* allow access to attribute  */
  use arg strNameSpaceURI, strLocalName, strQualifiedName, atts

  say tab~copies(level) || ppAtts(strQualifiedName, atts)
  level=level+1         /* increase level counter     */

::method endElement
  expose level          /* allow access to attribute  */
  level=level-1         /* decrease level counter     */

::method unknown        /* intercept all other messages to do nothing   */



::class ErrorHandler    /* will handle "org.xml.sax.ErrorHandler" events*/

::method unknown        /* handles "warning", "error" and "fatalError" events */
  use arg methName, argArray  /* fetch arguments                        */
  exception=argArray[1] /* retrieve SAXException argument               */
                        /* display error message                        */
  .error~say(methName":"  "line="exception~getLineNumber",col="exception~getColumnNumber":" pp(exception~getMessage))

