#!/usr/bin/env rexx
/*
   name:       01_getText.rex
   purpose:    demonstrate how to implement a SAX content handler in Rexx
   author:     Rony G. Flatscher, (c) 2009
   date:       2009-06-22
   needs:      ooRexx 4.0, BSF4Rexx 4.0, at least Java 1.4
   resources:  - <http://www.cafeconleche.org/books/xmljava/chapters/index.html> (2009-06-19)
                 ... book on XML processing with Java ("Processing XML with Java", Elliotte Rusty)

               - <http://www.saxproject.org/> (2009-06-19)
                 ... official web site of the SAX project

               - <http://www.megginson.com/downloads/SAX/> (2009-06-19)
                 ... original SAX project site, still interesting information

               - <http://java.sun.com/j2se/1.4.2/docs/api/org/xml/sax/package-summary.html> (2009-06-19)
                 ... SAX Java package for Java version 1.4 (easier to read because of no generics yet)

   license:    LGPL 3.0 (Lesser Gnu Public License version 3.0), cf. <http://www.gnu.org/licenses/lgpl.html>
               or
               ASF 2.0 (Apache Software Foundation License version 2.0), cf. <http://www.apache.org/licenses/LICENSE-2.0>
*/

parse arg xmlFileName

   /* create a Rexx content handler */
rexxObject=.saxHandler~new

   /* returns a Java object that is able to interact with our Rexx object  */
rexxProxy =BsfCreateRexxProxy(rexxObject)

   /* create a Java array of type "java.lang.Object" with a capacity for one entry  */
objArray=bsf.createArray(bsf.loadClass("java.lang.Object"), 1)
objArray[1]="org.xml.sax.ContentHandler"     /* set the only entry to the Java interface  */

   /* returns a Java proxy, that can be used wherever an argument to any Java method that
      expects an interface of type "org.xml.sax.ContentHandler"); any invocation of
      methods of this interface will be forwarded to the RexxProxy which forwards it
      to the Rexx object via callbacks  */
javaProxy =rexxProxy~newJavaProxyInstance(objArray)

   /* create a Java SAX parser object  */
parser=bsf.loadClass("org.xml.sax.helpers.XMLReaderFactory")~createXMLReader

   /* set the content handler to our proxy   */
parser~setContentHandler(javaProxy)

   /* create a Rexx object for error handling                  */
eh=.errorHandler~new
   /* create a Java proxy using the Rexx object for error handling   */
javaEH=BsfCreateRexxProxy(eh, , "org.xml.sax.ErrorHandler")
   /* set the parser's error handler (optional)                */
parser~setErrorHandler(javaEH)

   /* parse the InputStream, the parser will call the content handler   */
parser~parse(xmlFileName)



::requires BSF.CLS      /* get the Java support */

::class "saxHandler"    /* a Rexx content handler, implements the interface "org.xml.sax.ContentHandler" */

::method characters     /* one of the methods of the Java ContentHandler interface, supplying text */
  use arg textCharArray, start, length

   /* create a String object from the char array with the given start and length, get its string value   */
  say pp(.bsf~new("java.lang.String", textCharArray, start, length)~toString)


::method unknown        /* intercept all other messages to do nothing   */



::class ErrorHandler    /* implements "org.xml.sax.ErrorHandler" events */

::method warning        /* "warning" event                              */
  use arg exc

  .error~say("warning:    "  "line="exc~getLineNumber",col="exc~getColumnNumber":" pp(exc~getMessage))

::method error          /* "error" event                                */
  use arg exc
  .error~say("error:      "  "line="exc~getLineNumber",col="exc~getColumnNumber":" pp(exc~getMessage))

::method fatalError     /* "fatalsError" event                          */
  use arg exc
  .error~say("FATAL error:"  "line="exc~getLineNumber",col="exc~getColumnNumber":" pp(exc~getMessage))

