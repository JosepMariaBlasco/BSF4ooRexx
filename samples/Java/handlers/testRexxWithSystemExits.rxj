 *
 * purpose: demonstrate the possibilities of Java implemented Rexx system exit handlers
 *
 * @author Rony G. Flatscher
 * @since  2012-02-09
 */

say "(Rexx-side) RXNOVAL-Test #1:" test "(first - odd - time not handled)"
say "---"
say

say "(Rexx-side) RXNOVAL-Test #2:" test  "(second - even - time: handled, now has a value!)"
say "---"
say

drop test   -- drop variable
say "(Rexx-side) RXNOVAL-Test #3:" test "(dropped variable, now - odd - not handled)"
say "---"
say

say "(Rexx-side) RXNOVAL-Test #4:" test  "(second - even - time: handled, now has a value!)"
say "---"
say

say "default environment:" address()
"helloWorld"
say "rc="rc
say "---"
say


say "permanent address change to NIXI ..."
address nixi
"aimed at nixi ..."
say "--- The End # 3 ---"
exit

::requires "BSF.CLS"    -- get Java support

::requires "rgf_util2.rex" -- get access to utilities



