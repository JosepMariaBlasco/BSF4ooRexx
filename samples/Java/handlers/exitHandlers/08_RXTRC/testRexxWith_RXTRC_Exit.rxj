say "(Rexx-side) 'traceVar'="pp(traceVar) "about to set var 'traceVar' to '1' (turns on tracing)"
traceVar=1     -- turn on tracing
say "(Rexx-side) hi, #1 - after turning on tracing, 'traceVar'="pp(traceVar)
say

traceVar=0     -- turn off tracing
say "(Rexx-side) hi, #2 - after turning OFF tracing, 'traceVar'="pp(traceVar)

traceVar=1     -- turn on tracing
say "(Rexx-side) hi, #3 - after turning on tracing, 'traceVar'="pp(traceVar)
say

drop traceVar  -- turn off tracing
say "(Rexx-side) hi, #4 - after dropping 'traceVar', which turns OFF tracing, 'traceVar'="pp(traceVar)
say

::requires "BSF.CLS"    -- get Java support