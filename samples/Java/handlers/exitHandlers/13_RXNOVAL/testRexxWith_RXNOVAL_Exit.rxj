say "(Rexx-side) - 1a - rgfVar=["rgfVar"]"
say
say "(Rexx-side) - 1b - rgfVar=["rgfVar"]"
say "---"
say

say "now dropping variable 'rgfVar'..."
drop rgfVar
say "(Rexx-side) - 2a - rgfVar=["rgfVar"]"
say
say "(Rexx-side) - 2b - rgfVar=["rgfVar"]"

::requires "BSF.CLS"    -- get Java support