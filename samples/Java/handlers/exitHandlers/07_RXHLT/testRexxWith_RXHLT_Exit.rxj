 *
 * purpose: demonstrate the possibilities of Java implemented Rexx system exit handlers
 *
 * @author Rony G. Flatscher
 * @since  2012-02-19
 */

call test
say "(Rexx-side) --- after 'call test' ---"
say "(Rexx-side) - hi there, haltVar will be set to '1'"
haltVar="1"    -- this will cause the Java RXHLT handler to raise the HALT condition
say "(Rexx-side) - this should not be executed by Rexx due to the HALT condition "


::requires "BSF.CLS"    -- get Java support

::routine test
  signal on halt
  say "(Rexx-side) in routine TEST, 1, about to define variables 'clearVar=1' and 'haltVar=1'"
  clearVar="1"   -- this will clear the halt condition in the exit handler
  haltVar="1"    -- this will cause the Java RXHLT handler to raise the HALT condition
  say "(Rexx-side) in routine TEST, 2"
  return

halt:
  say "(Rexx-side) in routine TEST, HALT-signal handler"
  return