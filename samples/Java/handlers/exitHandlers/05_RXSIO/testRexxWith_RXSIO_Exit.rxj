 *
 * purpose: demonstrate the possibilities of Java implemented Rexx system exit handlers
 *
 * @author Rony G. Flatscher
 * @since  2012-02-20
 */

sleepTime=0    -- or e.g. 5 for sleeping five seconds in between

say "(Rexx-side) - a normal SAY, about to do a parse pull"
parse pull val
say "(Rexx-side) - after PARSE PULL val=["val"]"

call syssleep sleepTime
trace all
say "(Rexx-side) - a TRACED ALL SAY"
trace off

call syssleep sleepTime

say "(Rexx-side) - after TRACE OFF, about doing a TRACE ?allY"
trace ?all

call syssleep sleepTime

say "(Rexx-side) - after a ?TRACE "
TRACE OFF

say "(Rexx-side) - after a TRACE OFF "


::requires "BSF.CLS"    -- get Java support




