 *
 * purpose: demonstrate the possibilities of Java implemented Rexx system exit handlers
 *
 * @author Rony G. Flatscher
 * @since  2012-02-20
 */

say "(Rexx-side) before PARSE PULL"
parse pull value
say "(Rexx-side) pulled:" pp(value)
say

val="PUSH: abc from Rexx at" .dateTime~new
say "(Rexx-side) before PUSHing" pp(val)
push val
say "(Rexx-side) AFTER  PUSHing"
say

val="QUEUE: abc from Rexx at" .dateTime~new
say "(Rexx-side) before QUEUEing" pp(val)
queue val
say "(Rexx-side) AFTER  QUEUEing"
say

say "(Rexx-side) queued() returns:" pp(queued())
say

newName="thisIsTheNewQueueNameFromRexx"
say "(Rexx-side) setting new queue name to" pp(newName) "res="pp(RxQueue("SET",newName))
say "(Rexx-side) AFTER setting new queue name it is now set to:" pp(RxQueue("GET"))


::requires "BSF.CLS"    -- get Java support

