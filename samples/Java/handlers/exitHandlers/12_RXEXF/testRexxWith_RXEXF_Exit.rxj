 *
 * purpose: demonstrate the possibilities of Java implemented Rexx system exit handlers
 *
 * @author Rony G. Flatscher
 * @since  2012-02-21
 */

handleVar=1    -- Java handler should start processing call requests
say "(Rexx-side) 'handleVar'="pp(handleVar)
call to_no_where one, two
handleVar=0    -- Java handler should stop processing call requests
say "(Rexx-side) 'result'="pp(result)
say

handleVar=1    -- Java handler should start processing call requests
say "(Rexx-side) 'handleVar'="pp(handleVar)
res=to_no_where(one, two)
handleVar=0    -- Java handler should stop processing call requests
say "(Rexx-side) 'res'="pp(res)
say

say "---"
call test_invalid_call_to_routine
say

say "---"
call test_invalid_call_to_routine_as_function
say

say "---"
call test_not_found_error
say

say "---"
call test_not_found_error_as_function

::requires "BSF.CLS"    -- get Java support
::requires "rgf_util2.rex"



::routine test_invalid_call_to_routine
   handleVar=1                -- Java handler should start processing call requests
   invalidCallToRoutineFlag=1 -- set error flag in Java handler
   signal on any
   call "external_not_existing_function1"
   return

any:
   say "(Rexx-side) condition in test_invalid_call_to_routine():"
   say ppCondition2(condition('o'))

::routine test_invalid_call_to_routine_as_function
   handleVar=1                -- Java handler should start processing call requests
   invalidCallToRoutineFlag=1 -- set error flag in Java handler
   signal on any
   a="external_not_existing_function1_invoked_as_function"()
   return

any:
   say "(Rexx-side) condition in test_invalid_call_to_routine():"
   say ppCondition2(condition('o'))


::routine test_not_found_error
   handleVar=1            -- Java handler should start processing call requests
   functionNotFoundFlag=1 -- set error flag in Java handler
   signal on any
   call external_not_existing_function2 "one", "tWo"
   return

any:
   say "(Rexx-side) condition in test_not_found_error():"
   say ppCondition2(condition('o'))

::routine test_not_found_error_as_function
   handleVar=1            -- Java handler should start processing call requests
   functionNotFoundFlag=1 -- set error flag in Java handler
   signal on any
   a=external_not_existing_function2_invoked_as_function("one","tWo")
   return

any:
   say "(Rexx-side) condition in test_not_found_error():"
   say ppCondition2(condition('o'))