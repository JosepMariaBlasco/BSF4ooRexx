 *
 * purpose: demonstrate the possibilities of Java implemented Rexx system exit handlers
 *
 * @author Rony G. Flatscher
 * @since  2012-02-20
 */

say "(Rexx-side) - abc=["abc"]"
say "(Rexx-side) - value('abc',,'ENVIRONMENT')               ="pp(value('abc',,'ENVIRONMENT'))
say

say "the next Rexx statements will invoke the RXVALUE system exit served by Java"
say
say "(Rexx-side) - value('abc',,'RXVALUE_BY_JAVA')           ="pp(value('abc',,'RXVALUE_BY_JAVA'))
say

say "(Rexx-side) - def=["def"]"
say "(Rexx-side) - value('def',,'RXVALUE_BY_JAVA')           ="pp(value('def',,'RXVALUE_BY_JAVA'))
say

say "(Rexx-side) - ghi=["ghi"]"
say "(Rexx-side) - value('ghi','na,sowas!','RXVALUE_BY_JAVA')="pp(value('ghi','na,sowas!','RXVALUE_BY_JAVA'))
say
say "---"
say "abc=["abc"]"
say "def=["def"]"
say "ghi=["ghi"]"
say "---"
say
call nixi_noxi

::requires "BSF.CLS"       -- get Java support
::requires "rgf_util2.rex" -- get access to ppCondition2()

::routine nixi_noxi
   signal on any
   say "... the next VALUE()-statement will raise Rexx condition 40.914..."
   say
   say "(Rexx-side) - value('abc',,'NIXI_NOXI')="pp(value('abc',,'NIXI_NOXI'))
   return
any:
   say ppCondition2(condition("Object"))
   return

