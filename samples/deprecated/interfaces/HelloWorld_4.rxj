#!/usr/bin/env rexx
/*
   Name:    "HelloWorld_03.rxj"

   Invoke:
             "rexxj2 HelloWorld_03.rxj" (Windows)
                or
             "rexxj2.sh HelloWorld_03.rxj" (Unix)
                or
             "rexx HelloWorld_03.rxj"

   Purpose:  Create a window with a button object; pressing the button will end
             the program.

             This version demonstrates how to use Rexx for handling Java events
             synchroneously (new feature in BSF4Rexx 4.0, fall 2009):

               - The processing of Java event messages by Rexx is defined in
                 form of methods of a Rexx Class. An instance of that Rexx class
                 is used to create the RexxProxy and will be the target of all
                 event messages.

               - This version also demonstrates that a RexxProxy may be used for
                 different Java interfaces at the same time. Also, it demonstrates
                 that one RexxProxy object can be used for different Java objects
                 that raise events.

   Needs:    ooRexx 4.0, BSF4Rexx 4.0 or higher

   Date:    2009-10-16

   Author:   Rony G. Flatscher, WU Vienna

   last change: $Revision: 703 $ $Author: rony $ $Date: 2010-05-24 23:13:58 +0200 (Mon, 24 May 2010) $

   changed:
         2009-10-16, demonstrate handling a Java event with Rexx
         2008-08-23, ---rgf, if using BSF.CLS, then do not use BSF() directly (or
                             remove the first three chars from its result string)
         2008-07-19, rgf, added hash-bang line at the top
         2008-06-01, updated text
         2005-12-28, added Apache license
         2001-04-18, 2003-01-23, 2003-05-10, 2005-06-05

   license:

    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2001-2009 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

if      BsfInvokedBy()=1 then say "This Rexx program was invoked by Java!"
else if BsfInvokedBy()=2 then say "This Rexx program was invoked by Rexx, JVM loaded by Rexx!"
else                          say "No JVM present, we got troubles ..."

        /* create a Java awt window and a Java awt button       */
tmpWin = .awtFrame~new('Hello World!')

.bsf~bsf.import("java.awt.Button", "awtButton")     /* another way to define a Java class   */
tmpBut = .awtButton~new('Press me!')

        /* prepare window and show it, using cascading messages (two twiddles '~')   */
tmpWin ~~add(tmpBut) ~~pack ~~show ~~toFront

        /* define which eventText has to be sent on which event         */
tmpWin~bsf.addEventListener('window', 'windowClosing', 'call bsf "exit"')
tmpBut~bsf.addEventListener('action', ''             , 'call BSF exit')

        /* create BsfProxy() and let it show us, what Window event objects get generated */
        /* the following code-fragment will be used as an UNKNOWN method, hence the arguments
           are set up for the UNKNOWN method, arg[1]=unknownName arg[2]=args supplied with message */
-- code="say .DateTime~new pp(arg(1)) pp(arg(2)[1]~toString)"
rp=BsfCreateRexxProxy(.RexxEventHandler~new, , 'java.awt.event.WindowListener', -
                              'java.awt.event.WindowFocusListener', -
                              'java.awt.event.MouseListener')
tmpWin~addWindowListener(rp)
tmpWin~addWindowFocusListener(rp)

tmpBut~addMouseListener(rp)

        /* run the event loop, otherwise this instance of Rexx gets shut down   */
        /* dispatch the strings received as a result of the registered events   */
do forever
   a = bsf.pollEventText()    /* wait for an eventText to be sent     */
   interpret a                /* execute as a Rexx program            */
   say "(in Rexx), polled: ["a"]"
   if result= "SHUTDOWN, REXX !" then leave     /* JVM will be shutdown */
end
say "Now exiting Rexx."


::REQUIRES BSF.CLS    -- requires the BSF-class

        /* one way, how to define a Java class in Object Rexx   */
::CLASS "awtFrame" SUBCLASS bsf
::METHOD init
  self~init:super('java.awt.Frame', ARG(1, 'A'))


::CLASS "RexxEventHandler"

::method unknown                 -- process all unhandled event messages
  say .DateTime~new pp(arg(1))

::method WindowGainedFocus
  use arg eventObject
  say .DateTime~new pp(eventObject~toString)

::method MouseEntered
  use arg eventObject
  say .DateTime~new pp(eventObject~toString)

::method MouseReleased
  use arg eventObject
  say .DateTime~new pp(eventObject~toString)


