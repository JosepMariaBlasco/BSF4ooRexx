#!/usr/bin/env rexx
/*
   name:    1-080_charsetTranslations.rxj
   invoke:  rexx 1-080_charsetTranslations.rxj

             "rexx 1-080_charsetTranslations.rxj"
              ... Rexx script will demonstrate the public Rexx routine "bsf.iconv(string,fromCharset,toCharset)",
                  which allows one to translate a Rexx string from one charset/encoding to another

              or

             "rexxj2 1-080_charsetTranslations.rxj"      (Windows)
             "rexxj2.sh 1-080_charsetTranslations.rxj"   (Unix)
              ... Java will load Rexx and execute the Rexx script, which uses Java classes

   purpose: this program demonstrates charset/codepage translations of strings using the BSF.CLS
            public routine "bsf.iconv(string,inCharset,outCharset)" introduced in July 2018;
            in this case each string consists of one German umlaut or the German sharp-s
            translated to different charsets; all names of Charsets are allowed that are
            supported by Java! Cf. e.g. <https://docs.oracle.com/javase/8/docs/api/java/nio/charset/Charset.html> or
            <https://docs.oracle.com/javase/8/docs/technotes/guides/intl/encoding.doc.html> or
            lookup the Java documentation for the Java class "java.nio.charset.Charset"

   date:    2018-07-19

   changed: 2018-07-22, rgf:
               - using dash in UTF charset names (instead of underline),
               - added UTF-32*, "IBM-273" (IBM EBCIDC Austria, Germany)
               - removed override for MacOSX as not necessary ('file.encoding' is used on Terminal output)
            2018-07-23, rgf:
               - reinserted override for MacOSX, still necessary: output in Terminal needs to be in "UTF-8",
                 Java "file.encoding" may be "MacRoman"

   author:  Rony G. Flatscher


   last change: $Revision$ $Author$ $Date$


   license(s): see end of this file
*/

signal on syntax     -- in case an unsopperted charset/codepage name gets supplied, show the Java error message

propName="sun.stdout.encoding"   -- on Windows the codepage used for output
stdoutCS=.java.lang.System~getProperty(propName)

if stdoutCS=.nil then         -- property does not exist, use value of 'file.encoding' instead
do
   propName="file.encoding"
   stdoutCS=.java.lang.System~getProperty(propName)
end

-- on MacOSX: 'file.encoding' may return MacRoman whereas in the Terminal 'UTF-8' is expected
if stdoutCS="MacRoman" then
do
   propName="overriding (Terminal expects UTF-8)"
   stdoutCS="UTF-8"
   infoString="Current charset/codepage (overriding Java property on MacOSX) used for standard out: '"stdoutCS"'"
   leadinString="using charset/codepage (overriding Java property on MacOSX) '"stdoutCS"' for standard output, hence:"
end
else
do
   infoString="Current charset/codepage (Java property '"propName"') used for standard output: '"stdoutCS"'"
   leadinString="using charset/codepage (Java property '"propName"') '"stdoutCS"' for standard output, hence:"
end

say infoString
say

   -- German umlauts and German sharp-s encoded in 8859-1/Cp1252 hexadecimal code values
inCS="ISO8859_1"     -- charset/codepage the following strings (containing single characters)
chars=.array~of("c4"x, -   -- ISO8859_1 encoded umlaut-A character
                "e4"x, -   -- ISO8859_1 encoded umlaut-a character
                "d6"x, -   -- ISO8859_1 encoded umlaut-O character
                "f6"x, -   -- ISO8859_1 encoded umlaut-o character
                "dc"x, -   -- ISO8859_1 encoded umlaut-U character
                "fc"x, -   -- ISO8859_1 encoded umlaut-u character
                "df"x, -   -- ISO8859_1 encoded sharp-s character
                "fcdf"x )  -- ISO8859_1 encoded sharp-s character

   -- names of the German characters
titles=.array~of("umlaut-A", "umlaut-a", "umlaut-O", "umlaut-o", "umlaut-U", "umlaut-u", "sharp-s", "umlaut-u || sharp-s")
   -- codepages to translate to
toCharsets=.array~of("Cp850", "Cp1252", "ISO8859_1", "MacRoman", "ASCII",  -  -- 8-bit
                     "IBM-273", "UTF-8",                                   -  -- 8-bit
                     "UTF-16", "UTF-16BE", "UTF-16LE",                     -  -- 16-bit (BOM in UTF-16)
                     "UTF-32", "UTF-32BE", "UTF-32LE")                        -- 32-bit

tab="09"x
do i=1 to chars~items
   title=titles[i]
   char=chars[i]
   charStdoutCS=bsf.iconv(char,inCS,stdoutCS)
   say pp(title) leadinString "'"charStdoutCS"' ->" ppX(charStdoutCS)
   say
   do outCS over toCharsets
      encChar=bsf.iconv(char,inCS,outCS)
      say tab outCS~left(10)":" (ppX(encChar)" ")~left(22,'.') "displays:" pp(encChar)
   end
   say
end
exit

syntax:
  co=condition('object')
  say ppCondition2(co)
  exit -1


::requires "BSF.CLS"       -- get Java support
::requires "rgf_util2.rex" -- get access to routine ppCondition2()

::routine ppX        -- "pretty print": return received argument as a valid Rexx hexadecimal string literal
  return '"' || arg(1)~c2x || '"x'


