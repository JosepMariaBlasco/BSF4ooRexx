#!/usr/bin/env rexx
/*
   name:    4-701_compileAndUseEmbeddedJava3.rxj
   author:  Rony G. Flatscher
   purpose: Uses bsf.compile() to compile a Java class from a string or array of strings
            and uses it immediately thereafter from ooRexx
   needs:   ooRexx 5.0 or higher
   date:    2018-03-06
   changed: 2022-01-15, rgf:  - changed Java code slightly,
                              - changed Java class name and method names
                              - added syntax condition handler for demonstration
   usage:   rexx 4-701_compileAndUseEmbeddedJava3.rxj
   license:
    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2018-2022 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

signal on syntax     /* in case a condition gets raised           */
   -- compile a Java program and fetch the returned Java class object
clz=bsf.compile("rgf.MyTestClass", .resources~MyTestClass.java, "Java")
say 'clz~oha("aha"):' pp(clz~oha("abc"))  -- use the static method "oha" from Rexx
say "-"~copies(60)

o=clz~new            -- create an instance of the Java class
say 'o=clz~new     :' pp(o) "(ooRexx)"
say "o~oha('zyx')  :" pp(o~oha('zyx')) -- invoke the class method "oha"
say "o~thisInfo    :" pp(o~thisInfo)   -- invoke the instance method "thisInfo"
say "-"~copies(60)

say "now invoking the main method from ooRexx:"
args=.bsf~bsf.createArrayOf("java.lang.String", "Hello", "from", "ooRexx!")
o~main(args)                           -- invoke the class method "main"
exit

syntax:  /* in case of an error                                */
   co=condition('object')  /* get all condition information    */
   say ppJavaExceptionChain(co)  /* show Java exception chain  */
   say "---> this program needs ooRexx 5.0 or later"
   raise propagate         /* let ooRexx interpreter handle it */


::requires "BSF.CLS" -- get Java support

   /* source of a Java program, defining the class "rgf.MyTestClass" with three methods:

      - the static method "main" and
      - the static method "oha" and
      - the instance method "thisInfo"
   */
::RESOURCE MyTestClass.java  -- Java source code, defining a class "rgf.MyTestClass"
   package rgf;
   import  java.util.Arrays;

   public class MyTestClass {

       public static void main (String args[])
       {
           System.out.println("rgf.MyTestClass.main(String args[]), received arguments: "+
                               Arrays.deepToString(args)+" (Java)");
       }

       public static String oha(String str) // Java static method
       {
           return "--->"+str+"<--- (Java)";
       }

       public String thisInfo()             // Java instance method
       {
           return "===>"+this+"<=== (Java)";
       }
   }
::END
