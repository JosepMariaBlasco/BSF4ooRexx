#!/usr/bin/env rexx
/* ooRexx (http://www.ooRexx.org) template, version: 2018-12-23, Rony G. Flatscher */

/* The following ooRexx code realizes an OOo macro that can be run against each
   OOo document type. It demonstrates how to get the document object and determine
   of which type it is and act accordingly.

   This program can also be executed as a standalone program from outside OOo (AOO or
   LO) via the command line: in this case an empty swriter document gets created to allow
   interacting with it by the rest of the code. To run from the commandline (if saved
   in a file named "template.rxo"):

       rexxj.sh template.rxo

   In addition this ooRexx program demonstrates how to intercept execution errors and
   position the error indicator at the offending line, if invoked via the editor.

   License: Apache Software Foundation (ASF) License 2.0
*/

/*
      This is an ooRexx template script: just delete everything you do not need from
      it and then add your own code. (This template will be able to say hello from ooRexx
      no matter from which kind of OOo document it got invoked from.)

      This template can can be executed as a macro for any document. It demonstrates how to:

      - get at the document object, the desktop object and the ComponentContext object
        as supplied by OOo for this macro invocation; starting with OOo 3.0 also the new
        XScriptInvocationContext object, if the script should run against a different
        document (XModel),

      - determine the document type for which the macro was activated; demonstrate how to
        interact with a text and a spreadsheet document.
*/
signal on syntax                    /* in case of a syntax error jump to label "syntax:" below  */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OOo (AOO or LO), will always be the very last argument    */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object                   */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   oDoc=getDocument(scriptContext,scriptContext~getDocument)  /* get the document service (a XModel) object   */
end
else  /* this program was called from outside of OOo, e.g. from the commandline  */
do
   xContext = UNO.connect()                     /* get a connection to OOo server               */
   xDesktop = UNO.createDesktop(xContext)       /* create the XDesktop from xContext            */
      /* create a word processor document */
   oDoc=xDesktop~XComponentLoader~loadComponentFromURL("private:factory/swriter", "_blank", 0, .UNO~noProps)
end


/* ==> ==> replace the following part with your code (begin)            */
         /* demonstration of how to interact with different document types */
         /* define some text:                                              */
   LF="0a"x
   str="Hello world [".dateTime~new~string"], this is ooRexx (cf. <http://www.RexxLA.org>) speaking !" || LF

   /* --> show some of the environment variables: */
      str ||= "Infrastructure employed:" pp(.bsf4rexx~display.version)"." LF
      str ||= "Operating system:" pp(sysVersion()) LF

      curr_dir =directory()
      str ||= "current directory="pp(curr_dir)". " || LF

      if .bsf4rexx~opsys1="W" then
         curr_user=value("USERNAME",,"ENVIRONMENT")
      else
         curr_user=value("USER"    ,,"ENVIRONMENT")

      str ||= "current user="pp(curr_user)". " || LF

      curr_path=value("PATH", ,ENVIRONMENT)
      str ||= "current settings of environment variable PATH="pp(curr_path)"." LF
      l=min(640,str~length)
      strCoreInfo=str~left(l)"..."   -- keep the leftmost
      str ||= "... and now parsing the individual paths:" LF
      psep=.bsf4rexx~path.separator    /* fetch our operating system's path separator character    */
      do while curr_path<>""
         parse var curr_path path (psep) curr_path
         str ||="      " || pp(path) LF
      end
      str ||= LF     -- add another paragraph
   /* <-- end of fetching values from environment variables */


   if oDoc~uno.supportsService("TextDocument") then   /* a TextDcoument in hand?                   */
   do
      xTextDoc=oDoc~XTextDocument               /* get the XTextDocument interface                 */
      xTextDoc~getText~getEnd~setString(str)    /* add text at the end of the text document        */
   end
   else if oDoc~uno.supportsService("SpreadsheetDocument") then   /* a SpreadsheetDocument?        */
   do
      xSheet = oDoc~XSpreadSheetDocument~getSheets~XIndexAccess~getByIndex(0)~XSpreadSheet
      do i=1 while str<>""                      /* place first line in "A1", second line in "A2"...*/
         address="A" || i                       /* create address, e.g. "A1", "A2" ...             */
         parse var str val (LF) str
         cell=uno.getCell(xSheet, address)      /* fetch cell's current value, if any              */
         currVal=cell~getFormula
         if currVal<>"" then val=val "/|\" currVal
         call uno.setCell xSheet, address, val
      end
   end
   else  /* an unknown document type, display its implemented service(s) instead */
   do
      LF="0a"x                                  /* LF (line-feed) character                        */
      hint="- "                                 /* define a hint string (a dash and a blank)       */

      url=getUrl(oDoc, scriptContext, slotArg)  /* get Document's name, if any (a URL)             */
      if url<>"" then str="Document URL/Name:" url
                 else str="No URL/Name available! (Not loaded from file system?)"

      str=str LF LF "Implemented services:"
         /* get blank delimited service names, prepend blank, then change blank to LF and the hint:*/
      str=str LF || (" "oDoc~uno.getServiceNames)~changestr(" ", LF || hint) LF
      str ||= LF || "/// some information created with ooRexx for this run: \\\" LF LF || strCoreInfo

      title="Unknown Document Type Implementing the Following Service(s)"
      .bsf.dialog~messageBox(str, title, "information")
   end
/* <== <== replace the previous part with your code (end)   */

return



/* this is a sample of how one could exploit ooRexx and BSF4Rexx error information */
syntax:    /* create and display condition/exception information in a popup dialog */
   co=condition("O")    -- get condition object, describing the condition/exception
   LF="0a"x             -- the line-feed character
   TAB="        "       -- blanks simulating a tab character

   tmpStr=""            -- set to empty string
   do idx over co~makeArray~sort /* sort the directory indexes and iterate over them */
      val=co[idx]       -- get the associated value from the condition object (a directory)
      tmpStr=tmpStr || (idx || ":")~left(25)
      if idx="PACKAGE" then tmpStr ||= pp(val~name)
                       else tmpStr ||= pp(val)
      tmpStr||=LF

      if val~hasmethod("items") then   -- a collection? show its content
      do item over val
         tmpStr=tmpStr || tab || tab || pp(item) || LF
      end
   end

   if length(tmpStr)>750 then tmpStr=left(tmpStr,750)"..." -- show only the first 750 chars

   /* Are there any Java error messages/stack traces available, if so, show them */
   if var("BSF_ERROR_MESSAGE") | .local~hasEntry("BSF_ERROR_MESSAGE") then -- a BSF error message ?
   do
      if var("BSF_ERROR_MESSAGE") then errStr=BSF_ERROR_MESSAGE   -- variable from this scope
                                  else errStr=.bsf_error_message  -- value from .local environment

      tmpStr=tmpStr LF LF || "-"~copies(80) LF   -- extend the string
      tmpStr=tmpStr          "*** BSF4Rexx Error Information: ***" LF LF
      if length(errStr)>1000 then
         tmpStr=tmpStr || left(errStr,1000)"..."
      else
         tmpStr=tmpStr || errStr
   end

   -- if invoked from the macro editor, then show/point to error line
   scriptModel=uno.getScriptSourceModel(slotArg)
   if scriptModel<>.nil then scriptModel~indicateErrorLine(co~position)
   call SysSleep 0.001  -- let Java awt/swing get its time to update

   .bsf.dialog~messageBox(tmpStr, "Runtime error #" co~code, "error") -- display the string
   exit -1


::requires UNO.CLS   /* load UNO support (OpenOffice/LibreOffice) for ooRexx   */

/* OOo >= 3.0: get the invocation context (a XScriptInvocationContext) object; if not .nil, then
               use this document instead of the result of scriptContext~getDocument!            */
::routine getDocument
   use arg scriptContext,oDoc
   signal on any
   xInvocationContext=scriptContext~getInvocationContext
   if xInvocationContext<>.nil then          /* this script got invoked for a different document*/
      return xInvocationContext              /* use the supplied document instead               */
any:
  return oDoc                                /* either not 3.0 or script context document to use*/

::routine getUrl
   use arg oDoc, scriptContext, slotArg
   signal on syntax     /* if "getUrl" causes a syntax error, handle it                         */
   return oDoc~getUrl   /* syntax condition, if document has not been retrieved from file system*/

syntax:                 /* message "getUrl" caused a syntax condition                           */
   if scriptContext<>.nil then
   do
      /* demonstrate: if invoked from the macro editor, then show/point to error line           */
      scriptModel=uno.getScriptSourceModel(slotArg)
      if scriptModel<>.nil then scriptModel~indicateErrorLine(sigl)
      call SysSleep 0.001  -- let Java awt/swing get its time to update
   end
   return ""            -- return an empty string



/*
/* A simple "HelloWorld"-macro in ooRexx using a writer document: */

   use arg slotArg                                  /* fetch the "slotArg"              */

   oDoc = uno.getScriptContext(slotArg)~getDocument /* get the document object          */
   xTextRange = oDoc~XTextDocument~getText~getEnd   /* get the end of the text range    */
   xTextRange~setString("Hello World (in ooRexx)")  /* string goes to the end           */

   ::requires UNO.CLS               /* make sure the UNO support for ooRexx is loaded  */
*/
