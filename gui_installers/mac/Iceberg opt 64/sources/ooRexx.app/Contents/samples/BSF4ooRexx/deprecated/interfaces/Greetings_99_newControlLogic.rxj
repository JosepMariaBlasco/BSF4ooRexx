#!/usr/bin/rexx
/*
   Name:    "Greetings_99_newControlLogic.rxj"

   Invoke:  "rexx Greetings_99_newControlLogic.rxj"
                or
            "rexxj Greetings_99_newControlLogic.rxj" (Windows)
                or
            "rexxj.sh Greetings_99_newControlLogic.rxj" (Unix)

   Purpose:  create a window with a choice-object and two text-fields and buttons;
             if the ok-button is pressed then popup another window and display what
             was chosen and entered.

             This version stresses Object Rexx and the wrapper class "BSF.CLS" which
             makes Java look like if it was Object Rexx ...
             ;)

   Needs:    ooRexx, BSF4ooRexx

   Date:    2001-04-18, 2003-01-23, 2003-05-10

   Changes: 2003-09-05 creating java.awt.Color with giving strict types for arguments
            2005-06-05, adjusted for name changes of BSF class methods
            2005-12-28, added Apache license
            2008-06-01, updated text
            2008-08-23, ---rgf, if using BSF.CLS, then do not use BSF() directly (or
                                remove the first three chars from its result string)
            2009-10-19, rgf, changed logic to use new (synchroneous) event handlers only
            2010-02-10, rgf, add a small sleeping time before exiting Rexx; this way
                        pending Java callbacks to Rexx event handlers can be serviced

   Author:   Rony G. Flatscher, University of Essen, WU Wien University,
             derived from Peter Kalender's proof-of-concept work for the "Essener Ski Seminar",
             University of Essen (Oct 2000 to Feb 2001)


   last change: $Revision: 703 $ $Author: rony $ $Date: 2010-05-24 23:13:58 +0200 (Mon, 24 May 2010) $

   license:

    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2001-2010 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/

      /* create a RexxProxy to serve two Java listeners  */
eh=.eventHandler~new    /* create an event handler object   */
userData=.directory~new /* a directory that allows us to store useful ;) information */
proxy=BsfCreateRexxProxy(eh, userData, "java.awt.event.ActionListener", "java.awt.event.WindowListener")

      /* import the following "java"-classes to ooRexx:   */
.BSF~bsf.import('java.awt.Button'    , 'awtButton'      )
.BSF~bsf.import('java.awt.Choice'    , 'awtChoice'      )
.BSF~bsf.import('java.awt.Color'     , 'awtColor'       )
.BSF~bsf.import('java.awt.Frame'     , 'awtFrame'       )
.BSF~bsf.import('java.awt.GridLayout', 'awtGridLayout'  )
.BSF~bsf.import('java.awt.Label'     , 'awtLabel'       )
.BSF~bsf.import('java.awt.TextField' , 'awtTextField'   )

         /* create 3 labels                                      */
Label1 = .awtLabel~new('Gender: ')
Label2 = .awtLabel~new('First Name: ')
Label3 = .awtLabel~new('Surname: ')

         /* create a drop down list with 2 entries               */
DropDown = .awtChoice~new
DropDown~~addItem('male')~~addItem('female')

         /* create 2 textfields                                  */
Surname = .awtTextField~new
Name    = .awtTextField~new

         /* create 2 buttons and add addEventListeners to them   */
OK     = .awtButton~new('OK')
ok~addActionListener(proxy)      -- add our event handler

Cancel = .awtButton~new('Cancel')
cancel~addActionListener(proxy)  -- add our event handler

         /* set the window layout                                */
-- Background = .awtColor~new(150, 150, 250)
Background = .awtColor~newStrict("int", 150, "int", 150, "int", 250)
GLayout    = .awtGridLayout~new(4, 2)
Window     = .awtFrame~new('OO-Greetings!')
window~addWindowListener(proxy)  -- add our event handler

         /* add all the elements to the window                   */
Window~setLayout(GLayout)
Window~~add(Label1)~~add(DropDown)
Window~~add(Label2)~~add(Name)
Window~~add(Label3)~~add(Surname)
Window~~add(OK)    ~~add(Cancel)
Window~setSize(200, 200)
Window~setBackground(Background)

   /* save objects we need direct access to in event handling  */
userData~DropDown = DropDown     -- Java Choice object
userData~Surname  = Surname      -- Java TextField object
userData~Name     = Name         -- Java TextField object
userData~proxy    = proxy        -- RexxProxy representing the ooRexx EventHandler

   /* pack & show & move to front */
Window~~pack~~show~~toFront

        /* no access needed anymore, free the references to
           the objects (just to demonstrate this feature)       */
drop label1 label2 label3

say "waiting for exit..."
eh~waitForExit    /* waits on a control variable to be changed to .true (see implementation below) */
say "wait is over: now exiting Rexx."

call SysSleep .1  /* let Java close gracefully, allow Rexx event handlers to be present for Java callbacks */
exit


::REQUIRES BSF.CLS            /* requires the BSF-class       */

        --open up a new window and greet the user
::ROUTINE Greetings
    use arg userData             -- stores the objects to get to the gender and names

    Window2 = .awtFrame~new     /* create another window        */
    window2~addWindowListener(userData~proxy)   -- add Window event listener

    Greet   = .awtLabel~new     /* create a label               */
    Bye     = .awtButton~new('Bye!')  /* create a button      */
    bye~addActionListener(userData~proxy)       -- add Button event listener

                /* add label and button to the window           */
    Window2~~add('North', Greet)~~add('South', Bye)
    Window2~~pack~~show~~toFront

                /* now prepare to put something into that window        */
    Gender  = userData~DropDown~getSelectedItem    /* get chosen Item      */
    N1      = userData~Name~getText                /* get entered text     */
    N2      = userData~Surname~getText             /* get entered text     */

    if Gender = "male" then Greet~setText('Hello Mr.'  N1 N2)
                       else Greet~setText('Hello Mrs.' N1 N2)


/* ------------------------------------------------------------------------------ */
::CLASS "eventHandler"
::method init                    -- set bExitProgram attribute to .false
  expose bExitProgram
  bExitProgram=.false            -- set control variable "bExitProgram"

::method unknown                 -- do nothing if other events are raised
  use arg methName, args
  -- uncomment the following line to see the unhandled events
  -- say "unknown: method="pp(methName) "eventObject="pp(args[1]~toString)

::method windowClosing           -- clear bExitProgram attribute
  expose bExitProgram
  bExitProgram=.true

::method actionPerformed         -- either show entered data or clear bExitProgram attribute
  expose bExitProgram
  use arg eventObject, slotDir

  if eventObject~getSource~getLabel="OK" then   -- create the popup-window showing the entries
     call greetings slotDir~userData   -- supply the directory we set up initially to allow access to the Java objects
  else      -- exit program
     bExitProgram=.true


::method waitForExit             -- wait for bExitProgram attribute to gain a specific value
  expose bExitProgram

  guard on when bExitProgram=.true  -- control variable "bExitProgram"
  -- say self": waitForExit, lock released, returning ..."

