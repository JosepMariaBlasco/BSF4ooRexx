   frame=.bsf~new("javax.swing.JFrame", "Hello Bsf4ooRexx, here I (rgfScreenShot) am!")
   button=.bsf~new("javax.swing.JButton", "Tyrol")
   frame~add(button)


   frame~~pack~~show

   f=frame

   size=f~getSize
   newWidth =size~width*4
   newHeight=size~height
   f~setSize(newWidth, newHeight)            /* change size of JFrame   */
   loc=f~getLocation

   screenSize=f~getToolkit~getScreenSize
   say "ScreenSize:" screenSize~width"x"screenSize~height
   say

sleepTime=1.

call SysSleep sleepTime
   fn="C1a.test"; type="gif";
   say "component: fully visible, left upper corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"


   -- center component

   f~setLocation(trunc((screenSize~width-newWidth)/2) , trunc((screenSize~height-newHeight)/2))
call SysSleep sleepTime
   fn="C1a-centered.test"; type="gif";
   say "component: fully visible, centered on screen | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"
say "---> now taking button! "
   fn="C1a-centered-button.test"; type="gif";
   say "component: fully visible, button | fn:" fn "save as graphic type:" type
   image=screenShot(button); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"

call SysSleep sleepTime
   fn="C1a-invisible.test"; type="gif";
   say "component: not visible, left upper corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"
say "---"

   f~setLocation(screenSize~width - newWidth, loc~y)
call SysSleep sleepTime
   fn="C1b.test"; type="gif";
   say "component: fully visible, right upper corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"

   f~setLocation(screenSize~width - newWidth, screenSize~height - newHeight)
call SysSleep sleepTime
   fn="C1c.test"; type="gif";
   say "component: fully visible, right lower corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"

   f~setLocation(0, screenSize~height - newHeight)
call SysSleep sleepTime
   fn="C1d.test"; type="gif";
   say "component: fully visible, left lower corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"
   say

say copies("-",50)



   f~setLocation(loc~x-10 , loc~y-10)
call SysSleep sleepTime
   fn="C2a.test"; type="gif";
   say "component: partially visible, left upper corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"

   f~setLocation(screenSize~width - newWidth+10, loc~y-10)
call SysSleep sleepTime
   fn="C2b.test"; type="gif";
   say "component: partially visible, right upper corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"

   f~setLocation(screenSize~width - newWidth+10, screenSize~height - newHeight+10)
call SysSleep sleepTime
   fn="C2c.test"; type="gif";
   say "component: partially visible, right lower corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"

   f~setLocation(loc~x-10, screenSize~height - newHeight+10)
call SysSleep sleepTime
   fn="C2d.test"; type="gif";
   say "component: partially visible, left lower corner | fn:" fn "save as graphic type:" type
   image=screenShot(f); if image<>.nil then call saveScreenShot image, fn, type;else say .nil "returned!"

::requires "bsfScreenShot.cls"      -- get public routines for taking screen shots
