				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>AppleScript ausführen</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input}
	set script_path to POSIX path of (path to me)
	if input is not {} then
		set the_path to POSIX path of input       	set cmd to "rexxj2.sh " &amp; quoted form of the_path &amp; " &amp; exit;"       	tell application "System Events" to set terminalIsRunning to exists application process "Terminal"       	tell application "Terminal"       		activate           	if terminalIsRunning is true then           		do script with command cmd	       	else          		do script with command cmd in window 1 close window 1      	    	end ifdelay 1  if number of windows is 0 then  quit  end if        	end tell
	else 
		tell application "System Events" to set terminalIsRunning to exists application process "Terminal"       	tell application "Terminal"       		activate           	if terminalIsRunning is true then           		do script with command "java -cp \"" &amp; script_path &amp; "Contents/MacOS\" BSF4ooRexx &amp; exit;" delay 1  do script with command "exit" 	       	else
				do script with command "java -cp \"" &amp; script_path &amp; "Contents/MacOS\" BSF4ooRexx &amp; exit;" in window 1        	end if delay 1  if number of windows is 0 then  quit  end if        	end tell
	end ifend run</string>
