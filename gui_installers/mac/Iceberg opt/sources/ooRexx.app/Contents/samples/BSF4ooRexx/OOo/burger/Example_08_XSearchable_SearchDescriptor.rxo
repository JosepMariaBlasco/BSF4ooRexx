#!/usr/bin/rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited by Rony G. Flatscher, 2010-07-07/20 */

/* If your computer has an e-mail system set up that is known to OpenOffice.org, then you
   can use OOo to send simple messages as demonstrated by this program.
*/

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
   thisPath=uno.getScriptPath(.nil, slotArg)    /* will return the physical path to this script */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
   thisPath = directory()                    /* determine path to this script                   */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* create a writer file */
url = uno.convertToURL(thisPath"/myTestDocument.odt")
writerComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0,.UNO~noProps)

   /* create the TextObject and the TextCursor */
xTextDocument = writerComponent~XTextDocument
xText = XTextDocument~getText
xTextCursor = xText~createTextCursor

.bsf.dialog~messageBox("About to create a SearchDescriptor for 'OpenOffice.org', emphasizing all occurrences of this string in the document.", -
                       "Please Press Button to Continue...", "information")

   /* create SearchDescriptor*/
xSearchable = xTextDocument~xSearchable
xSearchDescriptor = xSearchable~createSearchDescriptor
xSearchDescriptor~setSearchString("OpenOffice.org")

xFound = xSearchable~findFirst(xSearchDescriptor)

   /* need to use the BSF message 'bsf.dispatch("start")' in order to dispatch the "start"
      message at the Java side; reason: the ooRexx root class .Object possesses a "start" method
      which would get invoked instead of the intended Java method */
xTextStart=xText~bsf.dispatch("start") /* get the XText cursor representing the start of the text  */

if xFound = .nil then
	xText~insertstring(xTextStart, "/// nothing found \\\ ", .false)
else
do
   bold=box("float", bsf.getConstant("com.sun.star.awt.FontWeight", "BOLD"))
	xFoundProbs = xFound~xPropertySet
	xFoundProbs~setPropertyValue("CharWeight", bold)
	counter = 1

   loop forever
		xFound = xSearchable~findNext(xFound, xSearchDescriptor)
      if xFound = .nil then leave
      xFound~xPropertySet~setPropertyValue("CharWeight", bold)
   	counter = counter + 1
   end

   info="/// In this text part" counter "occurrences of" pp(xSearchDescriptor~getSearchString) "could be found \\\ "
   xText~insertString(xTextStart, info, .false)
end

writerComponent~XModifiable~setModified(.false) /* allow to close (abort) document without saving-dialog */

::requires UNO.CLS   -- load UNO support for OpenOffice.org

