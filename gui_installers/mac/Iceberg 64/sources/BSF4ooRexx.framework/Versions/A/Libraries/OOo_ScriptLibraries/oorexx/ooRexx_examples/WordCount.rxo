/* Modelled after the BeanShell example supplied by OOo.
   Rony G. Flatscher, 2010-06-12, WU, Wien/Vienna, Austria
*/

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  -- get the xScriptContext object
oDoc=scriptContext~getDocument               -- get the document object

xModel = scriptContext~getDocument~XModel

   -- the writer controller impl supports the css.view.XSelectionSupplier interface
xSelectionSupplier = xModel~getCurrentController~XSelectionSupplier
   -- see section 7.5.1 of developers' guide
   -- the getSelection provides an XIndexAccess to the one or more selections
xIndexAccess = xSelectionSupplier~getSelection~XIndexAccess

count = wordcount(xIndexAccess)
say "count =" count
return 0

::requires UNO.CLS   -- get UNO support (using the UNO-Java-bridge)

-- count the words in the selection
::routine wordcount
  use arg xIndexAccess

  res = 0

  -- iterate through each of the selections
  count = xIndexAccess~getCount
  do i=0 to count-1
     -- get the XTextRange of the selection
     xTextRange = xIndexAccess~getByIndex(i)~XTextRange
     -- use the standard J2SE delimiters to tokenize the string
     -- obtained from the XTextRange
     strTok = .BSF~new("java.util.StringTokenizer", xTextRange~getString)
     res   += strTok~countTokens
  end

  call doDisplay res
  return res


-- display the count in a Swing dialog
::routine doDisplay
  use arg numWords

      -- setup Rexx implemented event handler
  userDir=.directory~new  -- a directory which will be passed to Rexx with event callbacks
  rexxCloseEH=.RexxCloseEventHandler~new  -- create Rexx event handler instance
      -- create a Java RexxProxy for the Rexx event handler, supply 'userDir' to be passed to Rexx
  rpCloseEH=BsfCreateRexxProxy(rexxCloseEH, userDir, "java.awt.event.ActionListener")

  frame = .BSF~new("javax.swing.JFrame", "Word Count")
  userDir~frame=frame   -- add JFrame object to Rexx directory (will be passed to Rexx event handler)
  frame~setDefaultCloseOperation(frame~DISPOSE_ON_CLOSE)

  pane=frame~getContentPane
  borderLayout=.BSF~new("java.awt.BorderLayout")
  pane~setLayout(borderLayout)

  wordsLabel = .BSF~new("javax.swing.JLabel", "Word count =" numWords)
  pane~add(wordsLabel,  borderLayout~CENTER)

  closeButton = .BSF~new("javax.swing.JButton", "Close")
  closeButton~addActionListener(rpCloseEH)
  pane~add(closeButton, borderLayout~SOUTH)

  frame~pack
  frame~setSize(190,90)
  frame~setLocation(430,430)
  frame~setVisible(.true)


/* ------------------------------------------------------------------------ */
/* A Rexx class defining event methods for ActionListener and WindowListener */
::class RexxCloseEventHandler
::method unknown                    -- intercept unhandled events, do nothing

::method actionPerformed            -- event method (from ActionListener)
  use arg actionEvent, slotDir
  slotDir~userData~frame~setVisible(.false)  -- hide the frame
  slotDir~userData~frame~dispose    -- dispose of the frame

