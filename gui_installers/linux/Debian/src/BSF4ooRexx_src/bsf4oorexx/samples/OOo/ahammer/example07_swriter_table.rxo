#!/usr/bin/rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited and extended by Rony G. Flatscher, 2010-07-15/16/17/20 */
/* Example 07: create a writer document and insert a TextTable into it and edit it */

   /* Retrieve the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* create a new writer document */
url = "private:factory/swriter"
writerComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

   /* get the text object and the document's factory */
xText = writerComponent~XTextDocument~getText
xDMsf = writerComponent~XMultiServiceFactory /* get the document's factory */

   /* create and insert the TextTable (initialize it to four rows and four columns) */
maxRows=7
xTextTable = xDMsf~createInstance("com.sun.star.text.TextTable")~XTextTable ~~initialize(maxRows, 4)
xText~insertTextContent(xText, xTextTable, .false)

   /* insert colored heading text in the TextTable (first row) */
call setColoredCellText xTextTable, "A1", "One"
call setColoredCellText xTextTable, "B1", "Two"
call setColoredCellText xTextTable, "C1", "Three"
call setColoredCellText xTextTable, "D1", "Four"

   /* insert random values in the TextTable */
do column over .list~of("A", "B", "C", "D")
   do row=2 to maxRows-1
      xTextTable~getCellByName(column||row)~setValue(random(1, 100000)/100)
   end
end


.bsf.dialog~messageBox("About to insert sum formulas into the cells in the last row ("maxRows") ...",,"info")
   /* insert formulas into the TextTable, set a background color */
formula = ("sum <?2:?" || maxRows-1 || ">")  /* ? will be changed to the respective column letter */
do column over .list~of("A", "B", "C", "D")
   address = column||maxRows
   xTextTable~getCellByName(address) ~setFormula(formula~changeStr("?",column))
end

.bsf.dialog~messageBox("About to colour the sum formulas...",,"info")
   /* position on first formula cell */
bgColor = box("int", "00 ff ff"x ~c2d)   /* define background color to use */
xTextTableCursor = xTextTable~createCursorByCellName("A"||maxRows)
xTextTableCursorProps = xTextTableCursor~XPropertySet
xTextTableCursor~gotoCellByName("D"maxRows, .true)    /* now select cells up to the last column */
xTextTableCursorProps~setPropertyValue("BackColor", bgColor)   /* set the color */


   /* get the cell range for all numeric values and access to its properties */
xCellRangeProps = xTextTable~XCellRange~getCellRangeByName("A2:D"||maxRows)~XCellRange~XPropertySet

   /* set the range's number format */
.bsf.dialog~messageBox("About to set number format (key='4') ...",,"info")
formatKey = box("short", 4)   /* key that represents a number format (in the German locale: "#.##0,00") */
xCellRangeProps~setPropertyValue("NumberFormat", formatKey)

   /* set the range's adjustment to right-align */
.bsf.dialog~messageBox("About to right-adjust all numeric cells ...",,"info")
rightAdjust = bsf.getConstant("com.sun.star.style.ParagraphAdjust", "RIGHT")
xCellRangeProps~setPropertyValue("ParaAdjust", rightAdjust)

/*
-- The following would format and right adjust each cell individually yielding the same results slower:
   /* set adjustment of the numeric cells to "right" */
right=bsf.getConstant("com.sun.star.style.ParagraphAdjust", "RIGHT")
numberFormatKey=box("short", 4)  /* key that represents a number format (in the German locale: "#.##0,00") */

do column over .list~of("A", "B", "C", "D")
   do row=2 to maxRows
      xCell=xTextTable~getCellByName(column||row)~XCell
         /* set number format for cell */
      xCell~XPropertySet~setPropertyValue("NumberFormat",  numberFormatKey)
         /* set alignment for text to right-adjust (a paragraph property) */
      xCell~XText~createTextCursor~XParagraphCursor~XPropertySet~setPropertyValue("ParaAdjust", right)
   end
end
*/

   /* set "modified" false -> UNO will not ask if you want to save the current document on close */
writerComponent~XModifiable~setModified(.false)

::requires UNO.CLS    -- get UNO support

/* routine to set the text in a cell
   - xTextTable: the table you want to use
   - cell: the cell you want to write in
   - text: the text you want to write in the cell
*/
::routine setColoredCellText
  	use arg xTextTable, cell, text

	xCellText = xTextTable~getCellByName(cell)~XText
	xCellText~createTextCursor~XPropertySet~setPropertyValue("CharColor", box("int", "ff 00 00"x ~c2d))
	xCellText~setString(text)
   return

