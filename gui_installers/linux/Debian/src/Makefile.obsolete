BUILD_DIR=../build
SRC_DIR=../src
BSF4OOREXX_SRC_DIR=BSF4ooRexx_src
PACKAGE_BASE_NAME=bsf4oorexx
BSF4OOREXX_VERSION=4.0.6.20110608
PACKAGE_NAME=$(PACKAGE_BASE_NAME)-$(BSF4OOREXX_VERSION)

DEBIAN_DIR=$(BUILD_DIR)/$(PACKAGE_NAME)/DEBIAN
OPT_DIR=$(BUILD_DIR)/$(PACKAGE_NAME)/tmp
CONTROL_FILE=$(DEBIAN_DIR)/control

default:
	@echo
	@echo "Usage:"
	@echo "make {clean|deb}"
	@echo
	@echo "clean:"
	@echo "   Cleans the build directory ($(BUILD_DIR))."
	@echo "deb:"
	@echo "   Creates the Debian package."
	@echo
	@echo

clean:
	@echo 
	@echo "Cleaning build directory..."
	@echo 

	rm -rf $(BUILD_DIR)/$(PACKAGE_NAME)*

deb:
	@echo 
	@echo "Building .deb package..."
	@echo

	@echo
	@echo "Creating directory structure..."
	@echo

	mkdir -p $(BUILD_DIR)/$(PACKAGE_NAME)/DEBIAN
	mkdir -p $(BUILD_DIR)/$(PACKAGE_NAME)/tmp/BSF4ooRexxInstall
	
	@echo 
	@echo "Copying package information..."
	@echo

	echo "Package: $(PACKAGE_BASE_NAME)" > $(CONTROL_FILE)
	echo "Version: $(BSF4OOREXX_VERSION)" >> $(CONTROL_FILE)
	cat control >> $(CONTROL_FILE)
	cp postinst $(DEBIAN_DIR)/
	cp preinst $(DEBIAN_DIR)/
	cp prerm $(DEBIAN_DIR)/
	cp copyright $(DEBIAN_DIR)/

	@echo
	@echo "Copying package files..."
	@echo
	cp -r $(BSF4OOREXX_SRC_DIR)/* $(OPT_DIR)/BSF4ooRexxInstall

	@echo
	@echo "Building package file..."
	@echo 
	dpkg-deb --build $(BUILD_DIR)/$(PACKAGE_NAME)
	chmod 777 $(BUILD_DIR)/$(PACKAGE_NAME).deb

	@echo
	@echo "Done."
	@echo
