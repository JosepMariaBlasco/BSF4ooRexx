#!/usr/bin/rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_200601>, edited and extended by Rony G. Flatscher, 2010-07-10/20 */

use arg slotArg   /* fetch the "slotArg", a java.util.Hashtable object which contains invocation
                     information from OpenOffice.org, will always be the very last argument     */

scriptContext=uno.getScriptContext(slotArg)  /* get the xScriptContext object, if any           */
if scriptContext<>.nil then                  /* o.k., we are invoked as a macro from OOo        */
do
   xDesktop=scriptContext~getDesktop            /* get the desktop (a XDesktop) object          */
   xContext=scriptContext~getComponentContext   /* get the context (a XComponentContext) object */
end
else              /* this program was called from outside of OOo, e.g. from the commandline     */
do
   xContext = UNO.connect()                  /* get a connection to OOo server                  */
   xDesktop = UNO.createDesktop(xContext)    /* create the XDesktop from xContext               */
end

xComponentLoader=xDesktop~XComponentLoader   /* get componentLoader interface                   */

   /* create a blank *.ods - file */
url = "private:factory/scalc"
calcComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0,.UNO~noProps)

   /* get first sheet in spreadsheet */
xSheet=calcComponent~XSpreadSheetDocument~getSheets~XIndexAccess~getByIndex(0) ~XSpreadSheet

   /* insert values into tables */
call UNO.setCell xSheet, "B1", 1
call UNO.setCell xSheet, "B2", 1
call UNO.setCell xSheet, "B3", 1
call UNO.setCell xSheet, "B4", 1

call UNO.setCell xSheet, "C1", 1
call UNO.setCell xSheet, "C2", 2
call UNO.setCell xSheet, "C3", 3
call UNO.setCell xSheet, "C4", 1

call UNO.setCell xSheet, "D1", 2
call UNO.setCell xSheet, "D2", 2
call UNO.setCell xSheet, "D3", 3
call UNO.setCell xSheet, "D4", 1

range="B1:D4"
info="Columnwise differences (comparing each cell in a column in the range """range""" to that column's first row value)"
call UNO.setCell xSheet, "A6", info":"

.bsf.dialog~messageBox(info".", "Please Press Button to Continue...", "information")

   /* address cell "B1" (ie. position "1,0"), i.e. column 2, row 1 */
xAddress = xSheet~getCellByPosition(1,0)~xCellAddressable~getCellAddress
/* alternatively, could use the routine uno.getCell(...) to fetch the cell by name instead:
xAddress = uno.getCell(xSheet,"B1")~xCellAddressable~getCellAddress
*/
xCellRangesQuery = xSheet~xCellRange~getCellRangeByName(range)~XCellRangesQuery

differentCells = xCellRangesQuery~queryColumnDifferences(xAddress)
call UNO.setCell xSheet, "B7", differentCells~getRangeAddressesAsString

red=box("int", "ff0000"x ~c2d)
Uno.getCell(xSheet, "B7")~XText~xPropertySet~setPropertyValue("CharColor", red)

enum = differentCells~getCells~createEnumeration
do while enum~hasMoreElements
   enum~nextElement~xPropertySet~setPropertyValue("CellBackColor", red)
end


info="Rowwise differences (comparing each cell in a row in the range """range""" to that row's second column value)"
call UNO.setCell xSheet, "A9", info":"
.bsf.dialog~messageBox(info".", "Please Press Button to Finish...", "information")

differentCells = xCellRangesQuery~queryRowDifferences(xAddress)
call UNO.setCell xSheet, "B10", differentCells~getRangeAddressesAsString


bold = bsf.getConstant("com.sun.star.awt.FontWeight", "BOLD")
blue = "0000ff"x ~c2d                 /* blue (RGB-value)   */

props=uno.getCell(xSheet, "B10")~XText~xPropertySet
props~setPropertyValue("CharWeight", bold)
props~setPropertyValue("CharColor",  blue)

borderLine = .bsf~new("com.sun.star.table.BorderLine")
borderLine~Color = blue               /* blue */
borderLine~InnerLineWidth = 50        /* in 1/100mm  */
borderLine~OuterLineWidth =  0        /* in 1/100mm  */

enum = differentCells~getCells~createEnumeration
do while enum~hasMoreElements
   xCellProps=enum~nextElement~xPropertySet
   xCellProps~setPropertyValue("CharColor",  blue)
   xCellProps~setPropertyValue("CharWeight", bold)
   xCellProps~setPropertyValue("TopBorder"   , borderLine)
   xCellProps~setPropertyValue("BottomBorder", borderLine)
   xCellProps~setPropertyValue("LeftBorder"  , borderLine)
   xCellProps~setPropertyValue("RightBorder" , borderLine)
end

calcComponent~XModifiable~setModified(.false)   /* allow to close (abort) document without saving-dialog */

::requires UNO.CLS   -- load UNO support for OpenOffice.org

