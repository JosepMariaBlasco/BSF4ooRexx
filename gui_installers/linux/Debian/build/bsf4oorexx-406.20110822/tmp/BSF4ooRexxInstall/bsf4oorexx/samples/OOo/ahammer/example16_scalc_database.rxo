#!/usr/bin/rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited by Rony G. Flatscher, 2010-07-17/20 */
/* Example 16: create calc document, fill in values, filter (a database operation) */

   /* create the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get componentLoader interface */

   /* create a new calc document */
url = "private:factory/scalc"
calcComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

   /* get first sheet in spreadsheet */
xSheet = calcComponent~XSpreadSheetDocument~getSheets~XIndexAccess~getByIndex(0) ~XSpreadSheet

   /* insert some text and numbers */
call UNO.setCell xSheet, 0, 0, "Name"                 /* "A1" */
call UNO.setCell xSheet, 1, 0, "Salary"               /* "B1" */

do i=1 to 10
	call UNO.setCell xSheet, 0, i, "Name" i            /* "A"i */
	call UNO.setCell xSheet, 1, i, random(500, 3000)   /* "B"i */
end

   /* create the CellRange to filter */
range = "A1:A11"
msg = "About to define a filter for the cell range" pp(range) "(containing a header) as 'GREATER_EQUAL 2000' and applying it ..."
.bsf.dialog~messageBox(msg, "Defining and Applying a Filter","info")

   /* get range and its extended filter interface */
xFilter     = xSheet~XCellRange~getCellRangeByName(range)~XSheetFilterableEx
xFilterDesc = xFilter~createFilterDescriptor(.true)

   /* define the table filter field[s] */
call UNO.loadClass "com.sun.star.sheet.TableFilterField"
aFilterFields = bsf.createJavaArray(.UNO~TableFilterField, 1)  /* create Java array for one FilterField */

   /* define and set a TableFilterField */
aFilterFields[1] = .UNO~TableFilterField~new /* create and assign the TableFilterField */
aFilterFields[1]~Field        = 1
aFilterFields[1]~Operator     = bsf.getConstant("com.sun.star.sheet.FilterOperator", "GREATER_EQUAL")
aFilterFields[1]~IsNumeric    = .true
aFilterFields[1]~NumericValue = 2000
   /* alternatively defined as a string would have been possible as well: */
-- aFilterFields[1]~IsNumeric   = .false
-- aFilterFields[1]~StringValue = "2000"

xFilterDesc~setFilterFields(aFilterFields)

   /* set the FilterProperties and appy filter */
xFilterProps = xFilterDesc~XPropertySet~setPropertyValue("ContainsHeader", box("boolean", .true))
xFilter~filter(xFilterDesc)
call uno.setCell xSheet, "D1", "Created and applied a filter 'GREATER_EQUAL 2000'"

   /* set "modified" false -> UNO will not ask if you want to save the current document on close */
calcComponent~XModifiable~setModified(.false)

::requires UNO.CLS    -- get UNO support