#!/usr/bin/rexx
/* Cf. <http://wi.wu-wien.ac.at/rgf/diplomarbeiten/index.htm#bakk_07>, edited by Rony G. Flatscher, 2010-07-15/20, 2010-11-30 */
/* Example 01b: open an empty writer document, write some text into it, then close the document */

   /* Retrieve the Desktop object, we need its XComponentLoader interface to load a new document */
xDesktop         = UNO.createDesktop()       /* get the OOo XDesktop interface to the service object  */
xComponentLoader = xDesktop~XComponentLoader /* get XComponentLoader interface */

   /* create a new writer document */
url = "private:factory/swriter"
writerComponent = xComponentLoader~loadComponentFromURL(url, "_blank", 0, .UNO~noProps)

   /* get the text object (a text cursor) */
xText = writerComponent~XTextDocument~getText

   /* insert text */
infoText = "0a"x || "The ooRexx program will close this document, once the user closes the message box."
xText~setString("Hello OpenOffice.org world (from ooRexx at" .dateTime~new ") !" infoText )

   /* inform user about what is going to happen, then dispose the writer document */
.bsf.dialog~messageBox("This writer document will get disposed (closed) by the ooRexx program.", "Closing Dialog", "info")
writerComponent~XCloseable~close(.true)   /*  force closing of the window document, no questions asked ... */

::requires UNO.CLS    -- get UNO support